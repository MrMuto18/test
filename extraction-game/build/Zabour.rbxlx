<roblox version="4"><Item class="ReplicatedFirst" referent="RBX000002"><Properties><string name="Name">ReplicatedFirst</string></Properties><Item class="LocalScript" referent="RBX000001"><Properties><string name="Name">LoadingScreen</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	LoadingScreen (LocalScript in ReplicatedFirst)
	Replaces the default Roblox loader with a black title card and a thin
	indeterminate progress line. Holds until the menu camera is live
	("ClientMenuReady"), then dissolves straight into the 3D scene.
	Uses only engine built-ins: ReplicatedFirst runs before anything else
	has replicated.
]]

local Players = game:GetService("Players")
local ReplicatedFirst = game:GetService("ReplicatedFirst")
local StarterGui = game:GetService("StarterGui")
local TweenService = game:GetService("TweenService")

local READY_TIMEOUT = 25
local ACCENT = Color3.fromRGB(255, 168, 86)
local TEXT = Color3.fromRGB(236, 234, 228)

ReplicatedFirst:RemoveDefaultLoadingScreen()
pcall(function()
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.All, false)
end)

local THIN = utf8.char(0x2009)
local function track(text: string): string
	local out = {}
	for _, code in utf8.codes(text) do
		local char = utf8.char(code)
		table.insert(out, if char == " " then THIN .. THIN .. THIN else char)
	end
	return table.concat(out, THIN)
end

local player = Players.LocalPlayer

local gui = Instance.new("ScreenGui")
gui.Name = "LoadingScreen"
gui.IgnoreGuiInset = true
gui.ResetOnSpawn = false
gui.DisplayOrder = 1000

local backdrop = Instance.new("Frame")
backdrop.Name = "Backdrop"
backdrop.Size = UDim2.fromScale(1, 1)
backdrop.BackgroundColor3 = Color3.new(0, 0, 0)
backdrop.BorderSizePixel = 0
backdrop.Parent = gui

local title = Instance.new("TextLabel")
title.Name = "Title"
title.BackgroundTransparency = 1
title.AnchorPoint = Vector2.new(0.5, 0.5)
title.Position = UDim2.fromScale(0.5, 0.47)
title.Size = UDim2.fromOffset(600, 70)
title.FontFace = Font.new("rbxasset://fonts/families/Montserrat.json", Enum.FontWeight.ExtraBold)
title.TextSize = 52
title.TextColor3 = TEXT
title.TextTransparency = 1
title.Text = track("ZABOUR")
title.Parent = backdrop

local status = Instance.new("TextLabel")
status.Name = "Status"
status.BackgroundTransparency = 1
status.AnchorPoint = Vector2.new(0.5, 0.5)
status.Position = UDim2.fromScale(0.5, 0.535)
status.Size = UDim2.fromOffset(600, 18)
status.FontFace = Font.new("rbxasset://fonts/families/RobotoMono.json", Enum.FontWeight.Regular)
status.TextSize = 11
status.TextColor3 = Color3.fromRGB(150, 150, 146)
status.TextTransparency = 1
status.Text = track("ESTABLISHING SECURE LINK")
status.Parent = backdrop

local trackBar = Instance.new("Frame")
trackBar.Name = "Track"
trackBar.AnchorPoint = Vector2.new(0.5, 0.5)
trackBar.Position = UDim2.fromScale(0.5, 0.57)
trackBar.Size = UDim2.fromOffset(220, 1)
trackBar.BackgroundColor3 = Color3.new(1, 1, 1)
trackBar.BackgroundTransparency = 0.88
trackBar.BorderSizePixel = 0
trackBar.ClipsDescendants = true
trackBar.Parent = backdrop

local fill = Instance.new("Frame")
fill.Name = "Fill"
fill.Size = UDim2.fromScale(0.3, 1)
fill.Position = UDim2.fromScale(-0.3, 0)
fill.BackgroundColor3 = ACCENT
fill.BorderSizePixel = 0
fill.Parent = trackBar

gui.Parent = player:WaitForChild("PlayerGui")

local fadeIn = TweenInfo.new(0.8, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
TweenService:Create(title, fadeIn, { TextTransparency = 0 }):Play()
TweenService:Create(status, fadeIn, { TextTransparency = 0.2 }):Play()
local sweep = TweenService:Create(
	fill,
	TweenInfo.new(1.1, Enum.EasingStyle.Quint, Enum.EasingDirection.InOut, -1, false),
	{ Position = UDim2.fromScale(1, 0) }
)
sweep:Play()

if not game:IsLoaded() then
	game.Loaded:Wait()
end
status.Text = track("SYNCING SAFEHOUSE")

local deadline = os.clock() + READY_TIMEOUT
while player:GetAttribute("ClientMenuReady") ~= true and os.clock() < deadline do
	task.wait(0.1)
end
-- One beat for the menu camera and grade to settle under the card.
task.wait(0.4)

sweep:Cancel()
fill.Position = UDim2.fromScale(0, 0)
local complete = TweenService:Create(fill, TweenInfo.new(0.35, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
	Size = UDim2.fromScale(1, 1),
})
complete:Play()
complete.Completed:Wait()

local out = TweenInfo.new(0.5, Enum.EasingStyle.Sine, Enum.EasingDirection.In)
TweenService:Create(title, out, { TextTransparency = 1 }):Play()
TweenService:Create(status, out, { TextTransparency = 1 }):Play()
TweenService:Create(trackBar, out, { BackgroundTransparency = 1 }):Play()
TweenService:Create(fill, out, { BackgroundTransparency = 1 }):Play()
task.wait(0.35)
local dissolve = TweenService:Create(backdrop, TweenInfo.new(1.3, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
	BackgroundTransparency = 1,
})
dissolve:Play()
dissolve.Completed:Wait()
gui:Destroy()
]]></ProtectedString></Properties></Item></Item><Item class="ReplicatedStorage" referent="RBX000016"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="Folder" referent="RBX000015"><Properties><string name="Name">Shared</string></Properties><Item class="Folder" referent="RBX000007"><Properties><string name="Name">Builders</string></Properties><Item class="ModuleScript" referent="RBX000003"><Properties><string name="Name">GetawayCarBody</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	GetawayCarBody
	Procedural "Zabour" fastback getaway car: ~150 parts, matte-black paint,
	tinted glass, widebody flares, 10-spoke rims, LED headlights with volumetric
	beams, full-width light bar, dual exhausts, diffuser, wing, lit interior.

	Phase 1 uses it as the static showpiece in the safehouse.
	Phase 3 reuses the same body on a physics chassis (pass Anchored = false).

	Local space: origin sits on the ground at the centre of the footprint,
	forward is -Z (origin.LookVector), up is +Y. All numbers are studs.

	Assembly: Root is the only part whose Anchored flag matters; every other
	part is unanchored and welded to Root, so moving Root moves the whole car
	(the client uses this for the idle engine rumble).
]]

local CollectionService = game:GetService("CollectionService")

local PartFactory = require(script.Parent.PartFactory)

export type BuildOptions = {
	Name: string?,
	Anchored: boolean?,
	PaintColor: Color3?,
	Interior: boolean?,
	PlateText: string?,
	-- Phase 3: wheels are NOT welded to the body (VehicleChassis rigs them).
	Physics: boolean?,
}

export type CarHandles = {
	Model: Model,
	Root: BasePart,
	Wheels: { [string]: Model },
	HeadlightLights: { SpotLight },
	HeadlightBeams: { Beam },
	HeadlightLenses: { BasePart },
	BrakeLights: { BasePart },
	BrakeLightSources: { SurfaceLight },
	Exhausts: { Attachment },
	UnderglowStrip: BasePart,
	UnderglowLights: { PointLight },
	EngineBay: BasePart,
	TrunkLid: BasePart,
	TrunkHinge: Weld,
	Indicators: { BasePart },
	ReverseLights: { BasePart },
	DriverDoor: Attachment,
	PassengerDoor: Attachment,
}

type Style = PartFactory.Style

type AddExtra = {
	Class: ("Part" | "WedgePart" | "CornerWedgePart")?,
	Shape: Enum.PartType?,
	Collide: boolean?,
	Parent: Instance?,
	WeldTo: BasePart?,
	NoWeld: boolean?,
}

local GetawayCarBody = {}

local RUBBER = PartFactory.material("Rubber", Enum.Material.SmoothPlastic)
local LEATHER = PartFactory.material("Leather", Enum.Material.Fabric)

-- Brake light brightness range (idle running lights -> full brake).
local BRAKE_IDLE_TRANSPARENCY = 0.35
local BRAKE_IDLE_BRIGHTNESS = 0.9
local BRAKE_FULL_BRIGHTNESS = 3.2

local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

local function makeStyles(paint: Color3): { [string]: Style }
	return {
		Paint = PartFactory.style(paint, Enum.Material.SmoothPlastic, 0.02),
		PaintAccent = PartFactory.style(rgb(150, 18, 24), Enum.Material.SmoothPlastic, 0.05),
		Trim = PartFactory.style(rgb(12, 12, 13), Enum.Material.SmoothPlastic, 0),
		Carbon = PartFactory.style(rgb(20, 20, 22), Enum.Material.Fabric, 0),
		Chrome = PartFactory.style(rgb(168, 170, 176), Enum.Material.Metal, 0.25),
		Gunmetal = PartFactory.style(rgb(96, 98, 104), Enum.Material.Metal, 0.08),
		RimShadow = PartFactory.style(rgb(12, 12, 14), Enum.Material.Metal, 0),
		Rubber = PartFactory.style(rgb(24, 24, 26), RUBBER, 0),
		Glass = PartFactory.style(rgb(10, 12, 15), Enum.Material.Glass, 0.18, 0.32),
		LensDark = PartFactory.style(rgb(18, 20, 24), Enum.Material.Glass, 0.3, 0.1),
		LensRed = PartFactory.style(rgb(70, 8, 10), Enum.Material.Glass, 0.2, 0.15),
		NeonWhite = PartFactory.style(rgb(232, 240, 255), Enum.Material.Neon, 0, 0, false),
		NeonRed = PartFactory.style(rgb(255, 24, 34), Enum.Material.Neon, 0, BRAKE_IDLE_TRANSPARENCY, false),
		NeonGauge = PartFactory.style(rgb(60, 200, 255), Enum.Material.Neon, 0, 0.35, false),
		NeonScreen = PartFactory.style(rgb(255, 140, 60), Enum.Material.Neon, 0, 0.55, false),
		NeonUnder = PartFactory.style(rgb(255, 60, 170), Enum.Material.Neon, 0, 1, false),
		Interior = PartFactory.style(rgb(26, 26, 28), LEATHER, 0),
		Dash = PartFactory.style(rgb(18, 18, 20), Enum.Material.SmoothPlastic, 0),
		Plate = PartFactory.style(rgb(214, 214, 206), Enum.Material.SmoothPlastic, 0.05),
		Invisible = PartFactory.style(rgb(0, 0, 0), Enum.Material.SmoothPlastic, 0, 1, false),
	}
end

function GetawayCarBody.build(origin: CFrame, options: BuildOptions?): CarHandles
	local opts: BuildOptions = options or {}
	local anchored = if opts.Anchored == nil then true else opts.Anchored
	local styles = makeStyles(opts.PaintColor or rgb(16, 16, 18))
	local includeInterior = opts.Interior ~= false
	local physics = opts.Physics == true

	local model = Instance.new("Model")
	model.Name = opts.Name or "Zabour"
	model:SetAttribute("VehicleType", "Zabour")

	local root = PartFactory.make({
		Name = "Root",
		Size = Vector3.new(6.6, 2.1, 16),
		CFrame = origin * CFrame.new(0, 1.8, 0),
		Style = styles.Invisible,
		Anchored = anchored,
		CanCollide = false,
		Parent = model,
	})
	model.PrimaryPart = root

	local bodyFolder = PartFactory.folder("Body", model)
	local glassFolder = PartFactory.folder("Glass", model)
	local lightsFolder = PartFactory.folder("Lights", model)
	local trimFolder = PartFactory.folder("Trim", model)
	local wheelsFolder = PartFactory.folder("Wheels", model)
	local interiorFolder = PartFactory.folder("Interior", model)

	local function add(name: string, size: Vector3, localCF: CFrame, style: Style, extra: AddExtra?): BasePart
		local e: AddExtra = extra or {}
		local part = PartFactory.make({
			Name = name,
			Size = size,
			CFrame = origin * localCF,
			Style = style,
			Class = e.Class,
			Shape = e.Shape,
			CanCollide = e.Collide,
			Anchored = false,
			Parent = e.Parent or bodyFolder,
		})
		if not e.NoWeld then
			PartFactory.weld(e.WeldTo or root, part)
		end
		return part
	end

	local function at(x: number, y: number, z: number): CFrame
		return CFrame.new(x, y, z)
	end

	local SIDES = { -1, 1 }

	----------------------------------------------------------------------------
	-- Structure (sections along Z: bumper | wheel well | doors | wheel well | bumper)
	----------------------------------------------------------------------------
	add("FloorPan", Vector3.new(4.7, 0.25, 15.6), at(0, 0.72, 0), styles.Carbon, { Collide = true })

	-- Front
	add("FrontBumper", Vector3.new(6.6, 1.25, 1.2), at(0, 1.35, -7.4), styles.Paint, { Collide = true })
	add("FrontCore", Vector3.new(4.7, 1.25, 3.2), at(0, 1.35, -5.2), styles.Paint, { Collide = true })
	-- Hood: wedge rising from the nose (y 1.975) to the cowl (y 2.85).
	add("Hood", Vector3.new(6.6, 0.875, 4.4), at(0, 2.4125, -5.8), styles.Paint, { Class = "WedgePart", Collide = true })
	-- Hood power bulge + vents
	add("HoodBulge", Vector3.new(2.2, 0.16, 3.4), at(0, 2.48, -5.4) * CFrame.Angles(math.rad(-11.25), 0, 0), styles.Paint)
	for i = 0, 2 do
		add(
			"HoodVent" .. i,
			Vector3.new(1.6, 0.04, 0.12),
			at(0, 2.565 + i * 0.035, -5.9 + i * 0.3) * CFrame.Angles(math.rad(-11.25), 0, 0),
			styles.Trim
		)
	end

	-- Doors / cabin base
	add("DoorSection", Vector3.new(6.6, 2.1, 7.2), at(0, 1.8, 0), styles.Paint, { Collide = true })

	-- Rear
	add("RearCore", Vector3.new(4.7, 2.1, 2.8), at(0, 1.8, 5.0), styles.Paint, { Collide = true })
	add("RearFenderTop", Vector3.new(6.6, 0.25, 2.8), at(0, 2.725, 5.0), styles.Paint, { Collide = true })
	add("RearBumper", Vector3.new(6.6, 2.1, 1.6), at(0, 1.8, 7.2), styles.Paint, { Collide = true })
	add("Ducktail", Vector3.new(6.2, 0.3, 0.8), at(0, 3.0, 7.6), styles.Paint, { Class = "WedgePart" })

	-- Trunk lid hangs on a hinge Weld at its front edge so it can swing open.
	local trunkLid = add("TrunkLid", Vector3.new(5.6, 0.06, 2.0), at(0, 2.88, 6.4), styles.Paint, { NoWeld = true })
	trunkLid:SetAttribute("LootTrunk", true)
	local trunkHinge = Instance.new("Weld")
	trunkHinge.Name = "TrunkHinge"
	trunkHinge.Part0 = root
	trunkHinge.Part1 = trunkLid
	trunkHinge.C0 = CFrame.new(0, 2.88 - 1.8, 5.4)
	trunkHinge.C1 = CFrame.new(0, 0, -1.0)
	trunkHinge.Parent = trunkLid
	add("TrunkSpoilerLip", Vector3.new(5.6, 0.12, 0.08), at(0, 2.94, 7.38), styles.Paint, { WeldTo = trunkLid })
	local trunkPrompt = Instance.new("Attachment")
	trunkPrompt.Name = "TrunkPrompt"
	trunkPrompt.Position = Vector3.new(0, 0.6, 1.4)
	trunkPrompt.Parent = trunkLid

	-- Fender bulges over the front wheels, following the hood slope.
	for _, s in SIDES do
		add(
			if s < 0 then "FenderBulge_L" else "FenderBulge_R",
			Vector3.new(1.0, 0.3, 3.0),
			at(s * 2.9, 2.63, -5.2) * CFrame.Angles(math.rad(-11.25), 0, 0),
			styles.Paint
		)
	end

	-- Widebody flares: top + angled front/back segments framing each arch.
	local axles = {
		{ Name = "F", Z = -5.2 },
		{ Name = "R", Z = 5.0 },
	}
	for _, axle in axles do
		for _, s in SIDES do
			local tag = axle.Name .. (if s < 0 then "L" else "R")
			local x = s * 3.45
			add("FlareTop_" .. tag, Vector3.new(0.3, 0.22, 2.4), at(x, 2.72, axle.Z), styles.Trim)
			add(
				"FlareFront_" .. tag,
				Vector3.new(0.3, 0.22, 1.3),
				at(x, 2.22, axle.Z - 1.62) * CFrame.Angles(math.rad(-50), 0, 0),
				styles.Trim
			)
			add(
				"FlareRear_" .. tag,
				Vector3.new(0.3, 0.22, 1.3),
				at(x, 2.22, axle.Z + 1.62) * CFrame.Angles(math.rad(50), 0, 0),
				styles.Trim
			)
		end
	end

	-- Side skirts, door seams, handles, character line
	for _, s in SIDES do
		local side = if s < 0 then "L" else "R"
		add("SideSkirt_" .. side, Vector3.new(0.22, 0.3, 7.4), at(s * 3.36, 0.9, -0.1), styles.Carbon, { Parent = trimFolder })
		add("DoorSeamFront_" .. side, Vector3.new(0.04, 1.9, 0.05), at(s * 3.31, 1.85, -3.45), styles.Trim, { Parent = trimFolder })
		add("DoorSeamRear_" .. side, Vector3.new(0.04, 1.9, 0.05), at(s * 3.31, 1.85, 1.45), styles.Trim, { Parent = trimFolder })
		add("DoorSeamBottom_" .. side, Vector3.new(0.04, 0.05, 4.9), at(s * 3.31, 0.92, -1.0), styles.Trim, { Parent = trimFolder })
		add("DoorHandle_" .. side, Vector3.new(0.06, 0.1, 0.5), at(s * 3.33, 2.45, 0.9), styles.Chrome, { Parent = trimFolder })
		add("CharacterLine_" .. side, Vector3.new(0.03, 0.05, 7.1), at(s * 3.31, 2.42, 0), styles.Gunmetal, { Parent = trimFolder })

		-- Mirrors
		add("MirrorStalk_" .. side, Vector3.new(0.5, 0.08, 0.15), at(s * 2.98, 3.02, -2.3), styles.Trim, { Parent = trimFolder })
		add("Mirror_" .. side, Vector3.new(0.35, 0.32, 0.55), at(s * 3.2, 3.18, -2.3), styles.Paint, { Parent = trimFolder })
		add("MirrorGlass_" .. side, Vector3.new(0.3, 0.26, 0.02), at(s * 3.2, 3.18, -2.02), styles.Chrome, { Parent = trimFolder })
	end

	----------------------------------------------------------------------------
	-- Greenhouse (cabin)
	----------------------------------------------------------------------------
	-- Windshield: base (y 2.85, z -2.6) -> roof (y 4.35, z -0.3)
	local windshieldAngle = math.atan2(1.5, 2.3)
	local windshieldLength = math.sqrt(1.5 * 1.5 + 2.3 * 2.3)
	local windshieldCF = at(0, 3.6, -1.45) * CFrame.Angles(-windshieldAngle, 0, 0)
	add("Windshield", Vector3.new(5.2, 0.1, windshieldLength), windshieldCF, styles.Glass, { Parent = glassFolder })

	-- Rear glass: roof (y 4.35, z 2.4) -> deck (y 2.85, z 5.4)
	local rearAngle = math.atan2(1.5, 3.0)
	local rearLength = math.sqrt(1.5 * 1.5 + 3.0 * 3.0)
	add(
		"RearGlass",
		Vector3.new(5.0, 0.1, rearLength),
		at(0, 3.6, 3.9) * CFrame.Angles(rearAngle, 0, 0),
		styles.Glass,
		{ Parent = glassFolder }
	)

	add("Roof", Vector3.new(5.4, 0.22, 2.7), at(0, 4.42, 1.05), styles.Paint, { Collide = true })
	add("SharkFin", Vector3.new(0.15, 0.25, 0.6), at(0, 4.655, 2.0), styles.Paint, { Class = "WedgePart" })

	for _, s in SIDES do
		local side = if s < 0 then "L" else "R"
		add(
			"APillar_" .. side,
			Vector3.new(0.2, 0.2, windshieldLength),
			at(s * 2.66, 3.65, -1.45) * CFrame.Angles(-windshieldAngle, 0, 0),
			styles.Paint
		)
		-- Front quarter glass (triangle, tall at the back)
		add(
			"QuarterGlass_" .. side,
			Vector3.new(0.1, 1.46, 2.3),
			at(s * 2.72, 3.58, -1.45),
			styles.Glass,
			{ Class = "WedgePart", Parent = glassFolder }
		)
		add("SideGlass_" .. side, Vector3.new(0.1, 1.46, 2.7), at(s * 2.72, 3.58, 1.05), styles.Glass, { Parent = glassFolder })
		add("BPillar_" .. side, Vector3.new(0.12, 1.46, 0.22), at(s * 2.74, 3.58, 0.9), styles.Trim, { Parent = trimFolder })
		-- Fastback sail panel (tall at the front)
		add(
			"CPillar_" .. side,
			Vector3.new(0.2, 1.46, 3.0),
			at(s * 2.7, 3.58, 3.9) * CFrame.Angles(0, math.rad(180), 0),
			styles.Paint,
			{ Class = "WedgePart" }
		)
		add("WindowTrim_" .. side, Vector3.new(0.06, 0.05, 6.0), at(s * 2.78, 2.88, 0.2), styles.Chrome, { Parent = trimFolder })
	end

	----------------------------------------------------------------------------
	-- Front fascia
	----------------------------------------------------------------------------
	add("Grille", Vector3.new(3.6, 0.55, 0.12), at(0, 1.35, -8.02), PartFactory.style(rgb(14, 14, 15), Enum.Material.DiamondPlate, 0), { Parent = trimFolder })
	add("GrilleSurround", Vector3.new(3.8, 0.06, 0.14), at(0, 1.66, -8.02), styles.Chrome, { Parent = trimFolder })
	add("LowerIntake", Vector3.new(5.6, 0.3, 0.1), at(0, 0.95, -8.02), styles.Trim, { Parent = trimFolder })
	add("Splitter", Vector3.new(6.9, 0.1, 0.9), at(0, 0.68, -7.75), styles.Carbon, { Parent = trimFolder })
	add("FrontPlate", Vector3.new(1.4, 0.4, 0.04), at(0, 1.02, -8.09), styles.Plate, { Parent = trimFolder })

	local headlightLights: { SpotLight } = {}
	local headlightBeams: { Beam } = {}
	local headlightLenses: { BasePart } = {}

	for _, s in SIDES do
		local side = if s < 0 then "L" else "R"
		add("HeadlightHousing_" .. side, Vector3.new(1.5, 0.32, 0.14), at(s * 2.35, 1.78, -8.02), styles.LensDark, { Parent = lightsFolder })
		local drl = add("HeadlightDRL_" .. side, Vector3.new(1.45, 0.07, 0.06), at(s * 2.35, 1.9, -8.07), styles.NeonWhite, { Parent = lightsFolder })
		local projector = add(
			"HeadlightProjector_" .. side,
			Vector3.new(0.1, 0.24, 0.24),
			at(s * 2.0, 1.74, -8.08) * PartFactory.AxisZ,
			styles.NeonWhite,
			{ Shape = Enum.PartType.Cylinder, Parent = lightsFolder }
		)
		table.insert(headlightLenses, drl)
		table.insert(headlightLenses, projector)

		-- Invisible emitter aligned with the car so SpotLight Face=Front = car forward.
		local source = add("HeadlightSource_" .. side, Vector3.new(0.2, 0.2, 0.2), at(s * 2.2, 1.76, -8.2), styles.Invisible, { Parent = lightsFolder })
		local spot = Instance.new("SpotLight")
		spot.Name = "Beam"
		spot.Face = Enum.NormalId.Front
		spot.Angle = 55
		spot.Range = 60
		spot.Brightness = 5
		spot.Color = rgb(255, 244, 225)
		spot.Shadows = true
		spot.Parent = source
		CollectionService:AddTag(spot, "ShadowLight")
		table.insert(headlightLights, spot)

		-- Volumetric cone: camera-facing beam fading into the fog.
		local a0 = Instance.new("Attachment")
		a0.Name = "BeamStart"
		a0.Parent = source
		local a1 = Instance.new("Attachment")
		a1.Name = "BeamEnd"
		a1.Position = Vector3.new(s * 1.5, -1.3, -26)
		a1.Parent = source
		local beam = Instance.new("Beam")
		beam.Name = "VolumetricBeam"
		beam.Attachment0 = a0
		beam.Attachment1 = a1
		beam.Width0 = 0.9
		beam.Width1 = 9
		beam.FaceCamera = true
		beam.LightEmission = 1
		beam.LightInfluence = 0
		beam.Segments = 1
		beam.Color = ColorSequence.new(rgb(255, 240, 220))
		beam.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.8),
			NumberSequenceKeypoint.new(0.35, 0.88),
			NumberSequenceKeypoint.new(1, 1),
		})
		beam.Parent = source
		CollectionService:AddTag(beam, "VolumetricBeam")
		table.insert(headlightBeams, beam)

		-- Fog lights in the lower intake
		add("FogLight_" .. side, Vector3.new(0.5, 0.12, 0.06), at(s * 2.45, 0.95, -8.07), styles.NeonWhite, { Parent = lightsFolder })
	end

	----------------------------------------------------------------------------
	-- Rear fascia
	----------------------------------------------------------------------------
	local brakeLights: { BasePart } = {}
	local brakeSources: { SurfaceLight } = {}

	local lightBar = add("TailLightBar", Vector3.new(6.0, 0.16, 0.1), at(0, 2.55, 8.03), styles.NeonRed, { Parent = lightsFolder })
	table.insert(brakeLights, lightBar)
	local barGlow = Instance.new("SurfaceLight")
	barGlow.Name = "BrakeGlow"
	barGlow.Face = Enum.NormalId.Back
	barGlow.Angle = 120
	barGlow.Range = 14
	barGlow.Brightness = BRAKE_IDLE_BRIGHTNESS
	barGlow.Color = rgb(255, 30, 36)
	barGlow.Shadows = false
	barGlow.Parent = lightBar
	table.insert(brakeSources, barGlow)

	for _, s in SIDES do
		local side = if s < 0 then "L" else "R"
		add("TailCluster_" .. side, Vector3.new(1.2, 0.38, 0.12), at(s * 2.55, 2.22, 8.02), styles.LensRed, { Parent = lightsFolder })
		local inner = add("TailLamp_" .. side, Vector3.new(1.0, 0.12, 0.05), at(s * 2.55, 2.22, 8.08), styles.NeonRed, { Parent = lightsFolder })
		table.insert(brakeLights, inner)
		add("ReverseLamp_" .. side, Vector3.new(0.3, 0.1, 0.05), at(s * 1.75, 2.22, 8.08), PartFactory.style(rgb(200, 200, 200), Enum.Material.Glass, 0.2, 0.1), { Parent = lightsFolder })
	end

	local indicatorStyle = PartFactory.style(rgb(255, 150, 30), Enum.Material.Neon, 0, 1, false)
	local indicators: { BasePart } = {}
	for _, s in SIDES do
		local side = if s < 0 then "L" else "R"
		table.insert(indicators, add("IndicatorFront_" .. side, Vector3.new(0.3, 0.1, 0.05), at(s * 3.05, 1.6, -8.06), indicatorStyle, { Parent = lightsFolder }))
		table.insert(indicators, add("IndicatorRear_" .. side, Vector3.new(0.3, 0.1, 0.05), at(s * 3.0, 2.42, 8.08), indicatorStyle, { Parent = lightsFolder }))
	end
	local reverseLights: { BasePart } = {}
	for _, child in lightsFolder:GetChildren() do
		if child:IsA("BasePart") and string.sub(child.Name, 1, 11) == "ReverseLamp" then
			table.insert(reverseLights, child)
		end
	end

	local rearPlate = add("RearPlate", Vector3.new(1.6, 0.5, 0.05), at(0, 1.6, 8.03), styles.Plate, { Parent = trimFolder })
	local plateGui = Instance.new("SurfaceGui")
	plateGui.Name = "PlateText"
	plateGui.Face = Enum.NormalId.Back
	plateGui.PixelsPerStud = 80
	plateGui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	plateGui.LightInfluence = 1
	plateGui.Parent = rearPlate
	local plateLabel = Instance.new("TextLabel")
	plateLabel.BackgroundTransparency = 1
	plateLabel.Size = UDim2.fromScale(1, 1)
	plateLabel.Text = opts.PlateText or "ZBR 077"
	plateLabel.TextScaled = true
	plateLabel.TextColor3 = rgb(24, 26, 30)
	plateLabel.FontFace = Font.new("rbxasset://fonts/families/RobotoMono.json", Enum.FontWeight.Bold)
	plateLabel.Parent = plateGui

	-- Diffuser with fins
	add("Diffuser", Vector3.new(5.4, 0.12, 1.3), at(0, 0.69, 7.45), styles.Carbon, { Parent = trimFolder })
	for i = -2, 2 do
		add("DiffuserFin" .. (i + 3), Vector3.new(0.07, 0.3, 1.2), at(i * 0.8, 0.6, 7.5), styles.Carbon, { Parent = trimFolder })
	end

	-- Dual exhausts
	local exhausts: { Attachment } = {}
	for _, s in SIDES do
		local side = if s < 0 then "L" else "R"
		add("ExhaustTip_" .. side, Vector3.new(0.7, 0.5, 0.5), at(s * 1.55, 0.92, 8.05) * PartFactory.AxisZ, styles.Chrome, {
			Shape = Enum.PartType.Cylinder,
			Parent = trimFolder,
		})
		add("ExhaustBore_" .. side, Vector3.new(0.72, 0.36, 0.36), at(s * 1.55, 0.92, 8.06) * PartFactory.AxisZ, styles.Trim, {
			Shape = Enum.PartType.Cylinder,
			Parent = trimFolder,
		})

		local attachment = Instance.new("Attachment")
		attachment.Name = "Exhaust_" .. side
		-- Root sits at y 1.8 in car space.
		attachment.Position = Vector3.new(s * 1.55, 0.92 - 1.8, 8.45)
		attachment.Parent = root
		table.insert(exhausts, attachment)

		local smoke = Instance.new("ParticleEmitter")
		smoke.Name = "ExhaustSmoke"
		smoke.Texture = "rbxasset://textures/particles/smoke_main.dds"
		smoke.EmissionDirection = Enum.NormalId.Back
		smoke.Rate = 5
		smoke.Lifetime = NumberRange.new(1.6, 2.6)
		smoke.Speed = NumberRange.new(1.5, 2.5)
		smoke.SpreadAngle = Vector2.new(12, 12)
		smoke.Drag = 1.2
		smoke.Acceleration = Vector3.new(0, 1.2, 0)
		smoke.Rotation = NumberRange.new(0, 360)
		smoke.RotSpeed = NumberRange.new(-40, 40)
		smoke.LightInfluence = 1
		smoke.Color = ColorSequence.new(rgb(150, 150, 155))
		smoke.Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.25),
			NumberSequenceKeypoint.new(1, 1.6),
		})
		smoke.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.82),
			NumberSequenceKeypoint.new(1, 1),
		})
		smoke.Parent = attachment
		CollectionService:AddTag(smoke, "ExhaustSmoke")
	end

	-- Rear wing on stands with endplates
	for _, s in SIDES do
		local side = if s < 0 then "L" else "R"
		add("WingStand_" .. side, Vector3.new(0.14, 0.55, 0.5), at(s * 2.1, 3.12, 7.35), styles.Trim, { Parent = trimFolder })
		add("WingEndplate_" .. side, Vector3.new(0.08, 0.45, 1.2), at(s * 3.1, 3.4, 7.45), styles.Carbon, { Parent = trimFolder })
	end
	add("Wing", Vector3.new(6.2, 0.1, 1.1), at(0, 3.42, 7.45) * CFrame.Angles(math.rad(6), 0, 0), styles.Carbon, { Parent = trimFolder })

	----------------------------------------------------------------------------
	-- Underglow (Phase 3 toggles it)
	----------------------------------------------------------------------------
	local underglow = add("UnderglowStrip", Vector3.new(4.4, 0.06, 13), at(0, 0.56, 0), styles.NeonUnder, { Parent = lightsFolder })
	local underglowLights: { PointLight } = {}
	for i, z in { -4.5, 0, 4.5 } do
		local glow = Instance.new("PointLight")
		glow.Name = "Underglow" .. i
		glow.Range = 10
		glow.Brightness = 2
		glow.Color = rgb(255, 60, 170)
		glow.Shadows = false
		glow.Enabled = false
		local holder = add("UnderglowEmitter" .. i, Vector3.new(0.2, 0.2, 0.2), at(0, 0.4, z), styles.Invisible, { Parent = lightsFolder })
		glow.Parent = holder
		table.insert(underglowLights, glow)
	end
	model:SetAttribute("Underglow", false)
	model:SetAttribute("Hazards", false)

	----------------------------------------------------------------------------
	-- Interior (visible through tint)
	----------------------------------------------------------------------------
	if includeInterior then
		add("Dashboard", Vector3.new(5.0, 0.5, 0.8), at(0, 3.05, -1.4), styles.Dash, { Parent = interiorFolder })
		add("GaugeCluster", Vector3.new(0.9, 0.22, 0.04), at(-1.3, 3.18, -0.98), styles.NeonGauge, { Parent = interiorFolder })
		add("CenterScreen", Vector3.new(1.0, 0.35, 0.04), at(0.25, 3.12, -0.98), styles.NeonScreen, { Parent = interiorFolder })
		add("AmbientStrip", Vector3.new(4.2, 0.03, 0.03), at(0, 3.3, -1.0), styles.NeonGauge, { Parent = interiorFolder })
		local dashGlowHolder = add("DashGlow", Vector3.new(0.2, 0.2, 0.2), at(-0.5, 3.4, -0.6), styles.Invisible, { Parent = interiorFolder })
		local dashGlow = Instance.new("PointLight")
		dashGlow.Range = 4.5
		dashGlow.Brightness = 0.7
		dashGlow.Color = rgb(70, 190, 255)
		dashGlow.Shadows = false
		dashGlow.Parent = dashGlowHolder

		add(
			"SteeringWheel",
			Vector3.new(0.12, 1.0, 1.0),
			at(-1.3, 3.0, -0.72) * CFrame.Angles(math.rad(-25), 0, 0) * PartFactory.AxisZ,
			styles.Dash,
			{ Shape = Enum.PartType.Cylinder, Parent = interiorFolder }
		)
		add("CenterConsole", Vector3.new(0.6, 0.6, 2.2), at(0, 2.95, 0.2), styles.Dash, { Parent = interiorFolder })
		for _, s in SIDES do
			local side = if s < 0 then "L" else "R"
			add(
				"SeatBack_" .. side,
				Vector3.new(1.3, 1.9, 0.35),
				at(s * 1.3, 2.6, 1.6) * CFrame.Angles(math.rad(14), 0, 0),
				styles.Interior,
				{ Parent = interiorFolder }
			)
			add("SeatBolster_" .. side, Vector3.new(1.45, 1.2, 0.2), at(s * 1.3, 2.9, 1.82) * CFrame.Angles(math.rad(14), 0, 0), styles.Interior, { Parent = interiorFolder })
			add("Headrest_" .. side, Vector3.new(0.9, 0.5, 0.3), at(s * 1.3, 3.85, 1.9) * CFrame.Angles(math.rad(14), 0, 0), styles.Interior, { Parent = interiorFolder })
		end
		add("RollBar", Vector3.new(4.8, 0.14, 0.14), at(0, 4.15, 2.3), styles.Gunmetal, { Parent = interiorFolder })
	end

	----------------------------------------------------------------------------
	-- Wheels
	----------------------------------------------------------------------------
	local wheels: { [string]: Model } = {}
	local wheelDefs = {
		{ Name = "FL", X = -2.95, Z = -5.2 },
		{ Name = "FR", X = 2.95, Z = -5.2 },
		{ Name = "RL", X = -2.95, Z = 5.0 },
		{ Name = "RR", X = 2.95, Z = 5.0 },
	}
	for _, def in wheelDefs do
		local s = if def.X < 0 then -1 else 1
		local wheelModel = Instance.new("Model")
		wheelModel.Name = "Wheel_" .. def.Name
		wheelModel.Parent = wheelsFolder
		local centre = at(def.X, 1.3, def.Z)

		local tire = add("Tire", Vector3.new(1.05, 2.6, 2.6), centre, styles.Rubber, {
			Shape = Enum.PartType.Cylinder,
			Collide = true,
			Parent = wheelModel,
			NoWeld = physics,
		})
		wheelModel.PrimaryPart = tire
		-- In physics mode every wheel part rides on its own tire.
		local wheelAdd = function(name: string, size: Vector3, cf: CFrame, style: Style, extra: AddExtra?): BasePart
			local e: AddExtra = extra or {}
			e.Parent = wheelModel
			if physics then
				e.WeldTo = tire
			end
			return add(name, size, cf, style, e)
		end
		wheelAdd("Sidewall", Vector3.new(1.07, 2.25, 2.25), centre, PartFactory.style(rgb(30, 30, 32), RUBBER, 0), {
			Shape = Enum.PartType.Cylinder,
			Parent = wheelModel,
		})
		wheelAdd("RimBarrel", Vector3.new(1.09, 1.85, 1.85), centre, styles.RimShadow, {
			Shape = Enum.PartType.Cylinder,
			Parent = wheelModel,
		})
		wheelAdd("RimLip", Vector3.new(0.05, 1.95, 1.95), centre * CFrame.new(s * 0.53, 0, 0), styles.Chrome, {
			Shape = Enum.PartType.Cylinder,
			Parent = wheelModel,
		})
		for i = 0, 4 do
			wheelAdd(
				"Spoke" .. i,
				Vector3.new(0.08, 0.16, 1.72),
				centre * CFrame.new(s * 0.56, 0, 0) * CFrame.Angles(math.rad(i * 36), 0, 0),
				styles.Gunmetal,
				{ Parent = wheelModel }
			)
		end
		wheelAdd("Hub", Vector3.new(0.14, 0.55, 0.55), centre * CFrame.new(s * 0.58, 0, 0), styles.Chrome, {
			Shape = Enum.PartType.Cylinder,
			Parent = wheelModel,
		})
		wheelAdd("CenterCap", Vector3.new(0.16, 0.28, 0.28), centre * CFrame.new(s * 0.6, 0, 0), styles.PaintAccent, {
			Shape = Enum.PartType.Cylinder,
			Parent = wheelModel,
		})
		wheels[def.Name] = wheelModel
	end

	----------------------------------------------------------------------------
	-- Anchors for other systems
	----------------------------------------------------------------------------
	local engineBay = add("EngineBay", Vector3.new(1, 1, 1), at(0, 1.6, -5.5), styles.Invisible, { Parent = model })
	local driverDoor = Instance.new("Attachment")
	driverDoor.Name = "DriverDoor"
	driverDoor.Position = Vector3.new(-3.5, 0.6, -0.6)
	driverDoor.Parent = root
	local passengerDoor = Instance.new("Attachment")
	passengerDoor.Name = "PassengerDoor"
	passengerDoor.Position = Vector3.new(3.5, 0.6, -0.6)
	passengerDoor.Parent = root

	model.Parent = nil
	return {
		Model = model,
		Root = root,
		Wheels = wheels,
		HeadlightLights = headlightLights,
		HeadlightBeams = headlightBeams,
		HeadlightLenses = headlightLenses,
		BrakeLights = brakeLights,
		BrakeLightSources = brakeSources,
		Exhausts = exhausts,
		UnderglowStrip = underglow,
		UnderglowLights = underglowLights,
		EngineBay = engineBay,
		TrunkLid = trunkLid,
		TrunkHinge = trunkHinge,
		Indicators = indicators,
		ReverseLights = reverseLights,
		DriverDoor = driverDoor,
		PassengerDoor = passengerDoor,
	}
end

-- 0 = running lights, 1 = full brake.
function GetawayCarBody.setBrakeIntensity(handles: CarHandles, alpha: number)
	local a = math.clamp(alpha, 0, 1)
	for _, part in handles.BrakeLights do
		part.Transparency = BRAKE_IDLE_TRANSPARENCY * (1 - a)
	end
	for _, light in handles.BrakeLightSources do
		light.Brightness = BRAKE_IDLE_BRIGHTNESS + (BRAKE_FULL_BRIGHTNESS - BRAKE_IDLE_BRIGHTNESS) * a
	end
end

function GetawayCarBody.setHeadlights(handles: CarHandles, on: boolean)
	for _, light in handles.HeadlightLights do
		light.Enabled = on
	end
	for _, beam in handles.HeadlightBeams do
		beam.Enabled = on
	end
	for _, lens in handles.HeadlightLenses do
		lens.Material = if on then Enum.Material.Neon else Enum.Material.Glass
	end
end

function GetawayCarBody.setUnderglow(handles: CarHandles, on: boolean)
	handles.UnderglowStrip.Transparency = if on then 0.2 else 1
	for _, light in handles.UnderglowLights do
		light.Enabled = on
	end
	handles.Model:SetAttribute("Underglow", on)
end

function GetawayCarBody.setIndicators(handles: CarHandles, on: boolean)
	for _, part in handles.Indicators do
		part.Transparency = if on then 0 else 1
	end
end

function GetawayCarBody.setReverse(handles: CarHandles, on: boolean)
	for _, part in handles.ReverseLights do
		part.Material = if on then Enum.Material.Neon else Enum.Material.Glass
		part.Transparency = if on then 0 else 0.1
	end
end

-- 0 = closed, 1 = fully open (~65°).
function GetawayCarBody.trunkFrame(alpha: number): CFrame
	return CFrame.new(0, 2.88 - 1.8, 5.4) * CFrame.Angles(-math.rad(65) * math.clamp(alpha, 0, 1), 0, 0)
end

return GetawayCarBody
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000004"><Properties><string name="Name">LootBagBuilder</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	LootBagBuilder
	Heavy duffel loot bag (~20 parts): padded body, rounded end caps, zipper
	track with pull, carry handles, shoulder strap, side pocket, value tag.

	Local space: centre of the bag, long axis = Z, up = +Y.
	"Body" is the PrimaryPart; everything else is welded to it.
	scale < 1 builds the miniature used for trunk cargo.
]]

local PartFactory = require(script.Parent.PartFactory)

export type BagHandles = {
	Model: Model,
	Body: BasePart,
}

local LootBagBuilder = {}

local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

local CANVAS = PartFactory.style(rgb(30, 32, 30), Enum.Material.Fabric)
local CANVAS_DARK = PartFactory.style(rgb(20, 21, 20), Enum.Material.Fabric)
local WEBBING = PartFactory.style(rgb(14, 14, 14), Enum.Material.Fabric)
local METAL = PartFactory.style(rgb(150, 150, 150), Enum.Material.Metal, 0.2)
local TAG = PartFactory.style(rgb(220, 170, 60), Enum.Material.SmoothPlastic)

function LootBagBuilder.build(origin: CFrame, scale: number?, anchored: boolean?): BagHandles
	local k = scale or 1
	local model = Instance.new("Model")
	model.Name = "LootBag"

	local body: BasePart
	local function add(name: string, size: Vector3, offset: CFrame, style: PartFactory.Style, shape: Enum.PartType?, collide: boolean?): BasePart
		local cf = origin * (offset - offset.Position + offset.Position * k)
		local part = PartFactory.make({
			Name = name,
			Size = size * k,
			CFrame = cf,
			Style = style,
			Shape = shape,
			CanCollide = collide == true,
			Anchored = false,
			Parent = model,
		})
		if body then
			part.Massless = true
			PartFactory.weld(body, part)
		end
		return part
	end

	body = add("Body", Vector3.new(1.5, 1.0, 2.3), CFrame.new(), CANVAS, nil, true)
	body.Anchored = anchored == true
	model.PrimaryPart = body

	local axisZ = PartFactory.AxisZ
	add("EndCapFront", Vector3.new(0.16, 1.08, 1.08), CFrame.new(0, 0, -1.15) * axisZ, CANVAS_DARK, Enum.PartType.Cylinder)
	add("EndCapBack", Vector3.new(0.16, 1.08, 1.08), CFrame.new(0, 0, 1.15) * axisZ, CANVAS_DARK, Enum.PartType.Cylinder)
	add("TopPanel", Vector3.new(1.3, 0.1, 2.2), CFrame.new(0, 0.5, 0), CANVAS_DARK)
	add("ZipperTrack", Vector3.new(0.06, 0.04, 2.15), CFrame.new(0, 0.56, 0), WEBBING)
	add("ZipperPull", Vector3.new(0.08, 0.05, 0.16), CFrame.new(0.05, 0.59, -0.6), METAL)
	for _, z in { -0.55, 0.55 } do
		add("StrapWrap", Vector3.new(1.56, 1.06, 0.12), CFrame.new(0, 0, z), WEBBING)
		add("HandleL", Vector3.new(0.08, 0.32, 0.08), CFrame.new(-0.18, 0.68, z), WEBBING)
		add("HandleR", Vector3.new(0.08, 0.32, 0.08), CFrame.new(0.18, 0.68, z), WEBBING)
	end
	add("HandleGrip", Vector3.new(0.44, 0.1, 1.2), CFrame.new(0, 0.86, 0), WEBBING)
	add("ShoulderStrap", Vector3.new(0.06, 0.12, 2.0), CFrame.new(0.78, 0.15, 0) * CFrame.Angles(0, 0, math.rad(-10)), WEBBING)
	add("SidePocket", Vector3.new(0.14, 0.55, 0.9), CFrame.new(-0.78, -0.05, 0.2), CANVAS_DARK)
	add("PocketZip", Vector3.new(0.16, 0.03, 0.85), CFrame.new(-0.79, 0.2, 0.2), WEBBING)
	add("BaseSkid", Vector3.new(1.4, 0.06, 2.1), CFrame.new(0, -0.5, 0), WEBBING)
	add("ValueTag", Vector3.new(0.02, 0.22, 0.16), CFrame.new(0.8, 0.25, -0.75), TAG)
	add("TagRing", Vector3.new(0.05, 0.05, 0.05), CFrame.new(0.79, 0.4, -0.75), METAL)

	model:SetAttribute("LootBag", true)
	return { Model = model, Body = body }
end

return LootBagBuilder
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000005"><Properties><string name="Name">PartFactory</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	PartFactory
	Every procedural part in the game goes through here so surfaces, shadow
	casting and collision defaults stay consistent across builders.
]]

export type Style = {
	Color: Color3,
	Material: Enum.Material,
	Reflectance: number?,
	Transparency: number?,
	CastShadow: boolean?,
}

export type Spec = {
	Name: string,
	Size: Vector3,
	CFrame: CFrame,
	Style: Style,
	Class: ("Part" | "WedgePart" | "CornerWedgePart")?,
	Shape: Enum.PartType?,
	CanCollide: boolean?,
	Anchored: boolean?,
	Parent: Instance?,
}

local PartFactory = {}

-- Rotations that turn a Cylinder (axis = local X) onto other axes.
PartFactory.AxisY = CFrame.Angles(0, 0, math.rad(90))
PartFactory.AxisZ = CFrame.Angles(0, math.rad(90), 0)

-- Resolves newer materials by name and falls back on older engines.
function PartFactory.material(name: string, fallback: Enum.Material): Enum.Material
	local ok, result = pcall(function(): any
		return (Enum.Material :: any)[name]
	end)
	if ok and typeof(result) == "EnumItem" then
		return result :: Enum.Material
	end
	return fallback
end

function PartFactory.style(
	color: Color3,
	material: Enum.Material,
	reflectance: number?,
	transparency: number?,
	castShadow: boolean?
): Style
	return {
		Color = color,
		Material = material,
		Reflectance = reflectance,
		Transparency = transparency,
		CastShadow = castShadow,
	}
end

function PartFactory.make(spec: Spec): BasePart
	local part: BasePart
	if spec.Class == "WedgePart" then
		part = Instance.new("WedgePart")
	elseif spec.Class == "CornerWedgePart" then
		part = Instance.new("CornerWedgePart")
	else
		local basic = Instance.new("Part")
		if spec.Shape then
			basic.Shape = spec.Shape
		end
		part = basic
	end

	local style = spec.Style
	part.Name = spec.Name
	part.Size = spec.Size
	part.CFrame = spec.CFrame
	part.Color = style.Color
	part.Material = style.Material
	part.Reflectance = style.Reflectance or 0
	part.Transparency = style.Transparency or 0
	part.CastShadow = if style.CastShadow == nil then true else style.CastShadow
	part.Anchored = if spec.Anchored == nil then true else spec.Anchored
	part.CanCollide = spec.CanCollide == true
	-- Invisible helpers (light emitters, rigs, roots) never block raycasts.
	part.CanQuery = part.CanCollide or (style.Transparency or 0) < 1
	part.CanTouch = false
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = spec.Parent
	return part
end

function PartFactory.weld(part0: BasePart, part1: BasePart): WeldConstraint
	local weld = Instance.new("WeldConstraint")
	weld.Name = "Weld_" .. part1.Name
	weld.Part0 = part0
	weld.Part1 = part1
	weld.Parent = part1
	return weld
end

-- Thin straight segment between two world points (cables, rails, braces).
function PartFactory.segment(
	name: string,
	from: Vector3,
	to: Vector3,
	thickness: number,
	style: Style,
	parent: Instance
): BasePart
	local length = (to - from).Magnitude
	local mid = (from + to) / 2
	return PartFactory.make({
		Name = name,
		Size = Vector3.new(thickness, thickness, math.max(length, 0.05)),
		CFrame = CFrame.lookAt(mid, to),
		Style = style,
		Parent = parent,
	})
end

function PartFactory.folder(name: string, parent: Instance): Folder
	local folder = Instance.new("Folder")
	folder.Name = name
	folder.Parent = parent
	return folder
end

return PartFactory
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000006"><Properties><string name="Name">WeaponBuilder</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	WeaponBuilder
	Procedural, multi-part tactical weapons (40-70 parts each):

	  SuppressedRifle  VK-9   — black anodized upper/lower, FDE furniture,
	                            picatinny rail with teeth, M-LOK handguard,
	                            vertical foregrip, light module, suppressor,
	                            holographic sight with emissive reticle
	  CompactSMG       KR-45  — polymer receiver, vented shroud, muzzle brake,
	                            angled foregrip, wire folding stock, reflex dot
	  HeavyPistol      M-50   — serrated slide, compensator, rail, rubber grip
	                            panels, micro red-dot

	Local space: origin = right-hand grip point, barrel = -Z, up = +Y.
	Every part is unanchored, massless, non-colliding, non-queryable and welded
	to Handle, so the weapon never blocks bullets or the camera.

	Attachments on Handle: Muzzle, Ejection, GripRight, GripLeft.
	Parts named "Magazine*" are the magazine (hidden/dropped on reload).
]]

local CollectionService = game:GetService("CollectionService")

local PartFactory = require(script.Parent.PartFactory)

export type WeaponHandles = {
	Model: Model,
	Handle: BasePart,
	Muzzle: Attachment,
	Ejection: Attachment,
	GripRight: Attachment,
	GripLeft: Attachment,
	Magazine: { BasePart },
}

type Style = PartFactory.Style

local WeaponBuilder = {}

local RUBBER = PartFactory.material("Rubber", Enum.Material.SmoothPlastic)

local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

local STYLES: { [string]: Style } = {
	Anodized = PartFactory.style(rgb(30, 30, 32), Enum.Material.Metal, 0.05),
	Steel = PartFactory.style(rgb(70, 72, 76), Enum.Material.Metal, 0.12),
	SteelDark = PartFactory.style(rgb(22, 22, 24), Enum.Material.Metal, 0.04),
	Polymer = PartFactory.style(rgb(38, 38, 36), Enum.Material.SmoothPlastic, 0),
	FDE = PartFactory.style(rgb(146, 124, 94), Enum.Material.SmoothPlastic, 0),
	Rubber = PartFactory.style(rgb(26, 26, 26), RUBBER, 0),
	Brass = PartFactory.style(rgb(190, 150, 70), Enum.Material.Metal, 0.2),
	Lens = PartFactory.style(rgb(120, 170, 200), Enum.Material.Glass, 0.25, 0.75, false),
	LensRed = PartFactory.style(rgb(160, 60, 60), Enum.Material.Glass, 0.2, 0.7, false),
	LightLens = PartFactory.style(rgb(220, 235, 255), Enum.Material.Neon, 0, 0.3, false),
	Invisible = PartFactory.style(rgb(0, 0, 0), Enum.Material.SmoothPlastic, 0, 1, false),
}

type Ctx = {
	add: (name: string, size: Vector3, cf: CFrame, style: Style, shape: Enum.PartType?) -> BasePart,
	attach: (name: string, position: Vector3) -> Attachment,
	Handle: BasePart,
	Magazine: { BasePart },
}

local function at(x: number, y: number, z: number): CFrame
	return CFrame.new(x, y, z)
end

local function alongZ(x: number, y: number, z: number): CFrame
	return CFrame.new(x, y, z) * PartFactory.AxisZ
end

local function tilt(degrees: number): CFrame
	return CFrame.Angles(math.rad(degrees), 0, 0)
end

-- Emissive reticle drawn on the shooter-facing side of an optic window.
local function addReticle(window: BasePart, color: Color3, holographic: boolean)
	local gui = Instance.new("SurfaceGui")
	gui.Name = "Reticle"
	gui.Face = Enum.NormalId.Back
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 400
	gui.LightInfluence = 0
	gui.Brightness = 4
	gui.Parent = window

	local function circle(size: number, filled: boolean): Frame
		local frame = Instance.new("Frame")
		frame.AnchorPoint = Vector2.new(0.5, 0.5)
		frame.Position = UDim2.fromScale(0.5, 0.5)
		frame.Size = UDim2.fromOffset(size, size)
		frame.BackgroundColor3 = color
		frame.BackgroundTransparency = if filled then 0 else 1
		frame.BorderSizePixel = 0
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(1, 0)
		corner.Parent = frame
		if not filled then
			local stroke = Instance.new("UIStroke")
			stroke.Color = color
			stroke.Thickness = 2
			stroke.Parent = frame
		end
		frame.Parent = gui
		return frame
	end
	circle(5, true)
	if holographic then
		circle(36, false)
	end
end

local function newCtx(model: Model, origin: CFrame): Ctx
	local handle = PartFactory.make({
		Name = "Handle",
		Size = Vector3.new(0.2, 0.2, 0.2),
		CFrame = origin,
		Style = STYLES.Invisible,
		Anchored = false,
		Parent = model,
	})
	handle.Massless = true
	handle.CanQuery = false
	model.PrimaryPart = handle

	local ctx: Ctx
	ctx = {
		Handle = handle,
		Magazine = {},
		add = function(name: string, size: Vector3, cf: CFrame, style: Style, shape: Enum.PartType?): BasePart
			local part = PartFactory.make({
				Name = name,
				Size = size,
				CFrame = origin * cf,
				Style = style,
				Shape = shape,
				Anchored = false,
				Parent = model,
			})
			part.Massless = true
			part.CanQuery = false
			part.CastShadow = style.Transparency == nil or (style.Transparency :: number) < 0.5
			PartFactory.weld(handle, part)
			if string.sub(name, 1, 8) == "Magazine" then
				table.insert(ctx.Magazine, part)
			end
			return part
		end,
		attach = function(name: string, position: Vector3): Attachment
			local attachment = Instance.new("Attachment")
			attachment.Name = name
			attachment.Position = position
			attachment.Parent = handle
			return attachment
		end,
	}
	return ctx
end

local function railTeeth(ctx: Ctx, y: number, zStart: number, zEnd: number, width: number)
	local count = math.floor((zStart - zEnd) / 0.14)
	for i = 0, count do
		ctx.add("RailTooth" .. i, Vector3.new(width, 0.025, 0.045), at(0, y, zStart - i * 0.14), STYLES.Anodized)
	end
end

--------------------------------------------------------------------------------
-- VK-9 suppressed rifle
--------------------------------------------------------------------------------
local function buildRifle(ctx: Ctx)
	local S = STYLES
	local add = ctx.add

	-- Receivers
	add("LowerReceiver", Vector3.new(0.2, 0.26, 0.85), at(0, 0.16, -0.2), S.Anodized)
	add("MagWell", Vector3.new(0.2, 0.2, 0.3), at(0, 0.0, -0.45), S.Anodized)
	add("UpperReceiver", Vector3.new(0.21, 0.22, 1.05), at(0, 0.39, -0.2), S.Anodized)
	add("EjectionPort", Vector3.new(0.02, 0.09, 0.26), at(0.106, 0.4, -0.15), S.SteelDark)
	add("DustCover", Vector3.new(0.015, 0.1, 0.22), at(0.112, 0.33, -0.15), S.Anodized)
	add("ForwardAssist", Vector3.new(0.06, 0.06, 0.12), at(0.12, 0.42, 0.05), S.Steel)
	add("ChargingHandle", Vector3.new(0.26, 0.05, 0.08), at(0, 0.48, 0.3), S.Anodized)
	add("BoltRelease", Vector3.new(0.03, 0.08, 0.14), at(-0.11, 0.2, -0.32), S.Steel)
	add("Selector", Vector3.new(0.03, 0.05, 0.05), at(-0.11, 0.22, -0.02), S.Steel)

	-- Top rail
	add("TopRail", Vector3.new(0.13, 0.04, 1.75), at(0, 0.52, -0.55), S.Anodized)
	railTeeth(ctx, 0.545, 0.25, -1.35, 0.15)

	-- Handguard (FDE) with M-LOK slots
	add("Handguard", Vector3.new(0.25, 0.25, 1.15), at(0, 0.37, -1.3), S.FDE)
	add("HandguardCap", Vector3.new(0.26, 0.26, 0.05), at(0, 0.37, -1.875), S.Anodized)
	for _, side in { -1, 1 } do
		for i, z in { -0.95, -1.3, -1.65 } do
			add("MLok" .. side .. i, Vector3.new(0.02, 0.06, 0.18), at(side * 0.126, 0.37, z), S.SteelDark)
		end
	end
	add("BottomRail", Vector3.new(0.1, 0.04, 0.6), at(0, 0.23, -1.35), S.Anodized)
	add("Foregrip", Vector3.new(0.1, 0.32, 0.1), at(0, 0.06, -0.85), S.Polymer)
	add("ForegripCap", Vector3.new(0.11, 0.04, 0.11), at(0, -0.1, -0.85), S.Rubber)
	add("ForegripClamp", Vector3.new(0.12, 0.06, 0.16), at(0, 0.21, -0.85), S.Anodized)

	-- Light module
	add("LightBody", Vector3.new(0.07, 0.1, 0.32), at(-0.16, 0.38, -1.55), S.Anodized)
	add("LightLens", Vector3.new(0.05, 0.07, 0.02), at(-0.16, 0.38, -1.72), S.LightLens)
	add("LightMount", Vector3.new(0.05, 0.06, 0.1), at(-0.13, 0.38, -1.5), S.Anodized)

	-- Barrel + suppressor
	add("Barrel", Vector3.new(0.25, 0.09, 0.09), alongZ(0, 0.38, -2.0), S.SteelDark, Enum.PartType.Cylinder)
	add("Suppressor", Vector3.new(0.85, 0.23, 0.23), alongZ(0, 0.38, -2.5), S.Anodized, Enum.PartType.Cylinder)
	add("SuppressorRingA", Vector3.new(0.04, 0.24, 0.24), alongZ(0, 0.38, -2.1), S.Steel, Enum.PartType.Cylinder)
	add("SuppressorRingB", Vector3.new(0.05, 0.24, 0.24), alongZ(0, 0.38, -2.92), S.Steel, Enum.PartType.Cylinder)
	add("SuppressorBore", Vector3.new(0.02, 0.07, 0.07), alongZ(0, 0.38, -2.95), S.SteelDark, Enum.PartType.Cylinder)

	-- Grip, trigger
	add("PistolGrip", Vector3.new(0.15, 0.42, 0.22), at(0, -0.08, 0.06) * tilt(-18), S.Polymer)
	add("GripTexture", Vector3.new(0.155, 0.26, 0.14), at(0, -0.1, 0.07) * tilt(-18), S.Rubber)
	add("TriggerGuard", Vector3.new(0.04, 0.04, 0.32), at(0, 0.02, -0.2), S.Anodized)
	add("Trigger", Vector3.new(0.03, 0.1, 0.03), at(0, 0.07, -0.16), S.Steel)

	-- Curved magazine (two segments + baseplate)
	add("Magazine", Vector3.new(0.14, 0.55, 0.26), at(0, -0.28, -0.5) * tilt(12), S.Polymer)
	add("MagazineLower", Vector3.new(0.14, 0.3, 0.26), at(0, -0.62, -0.6) * tilt(22), S.Polymer)
	add("MagazineBase", Vector3.new(0.16, 0.05, 0.28), at(0, -0.77, -0.66) * tilt(22), S.Rubber)

	-- Stock
	add("BufferTube", Vector3.new(0.55, 0.12, 0.12), alongZ(0, 0.38, 0.55), S.Anodized, Enum.PartType.Cylinder)
	add("Stock", Vector3.new(0.17, 0.3, 0.5), at(0, 0.31, 0.88), S.FDE)
	add("CheekRiser", Vector3.new(0.15, 0.06, 0.36), at(0, 0.48, 0.86), S.FDE)
	add("ButtPad", Vector3.new(0.19, 0.36, 0.06), at(0, 0.3, 1.15), S.Rubber)
	add("SlingPoint", Vector3.new(0.05, 0.05, 0.08), at(0.1, 0.3, 0.72), S.Steel)

	-- Holographic sight
	add("HoloBase", Vector3.new(0.15, 0.07, 0.38), at(0, 0.57, -0.3), S.Anodized)
	add("HoloWallL", Vector3.new(0.025, 0.22, 0.32), at(-0.075, 0.72, -0.32), S.Anodized)
	add("HoloWallR", Vector3.new(0.025, 0.22, 0.32), at(0.075, 0.72, -0.32), S.Anodized)
	add("HoloHood", Vector3.new(0.175, 0.025, 0.32), at(0, 0.835, -0.32), S.Anodized)
	add("HoloKnob", Vector3.new(0.05, 0.07, 0.12), at(0.11, 0.6, -0.25), S.Steel)
	local window = add("HoloWindow", Vector3.new(0.125, 0.19, 0.015), at(0, 0.715, -0.45), S.Lens)
	addReticle(window, rgb(255, 60, 60), true)

	ctx.attach("Muzzle", Vector3.new(0, 0.38, -3.0))
	ctx.attach("Ejection", Vector3.new(0.14, 0.4, -0.15))
	ctx.attach("GripRight", Vector3.new(0, 0, 0))
	ctx.attach("GripLeft", Vector3.new(0, 0.02, -0.85))
end

--------------------------------------------------------------------------------
-- KR-45 compact SMG
--------------------------------------------------------------------------------
local function buildSMG(ctx: Ctx)
	local S = STYLES
	local add = ctx.add

	add("Receiver", Vector3.new(0.22, 0.32, 0.95), at(0, 0.26, -0.25), S.Polymer)
	add("ReceiverTop", Vector3.new(0.2, 0.06, 0.95), at(0, 0.44, -0.25), S.Anodized)
	add("TopRail", Vector3.new(0.12, 0.04, 0.7), at(0, 0.49, -0.3), S.Anodized)
	railTeeth(ctx, 0.515, 0.0, -0.6, 0.14)
	add("EjectionPort", Vector3.new(0.02, 0.08, 0.22), at(0.112, 0.32, -0.2), S.SteelDark)
	add("ChargingKnob", Vector3.new(0.06, 0.05, 0.08), at(-0.13, 0.36, -0.55), S.Steel)
	add("Selector", Vector3.new(0.03, 0.05, 0.05), at(-0.12, 0.2, -0.05), S.Steel)

	-- Vented shroud + brake
	add("Shroud", Vector3.new(0.2, 0.2, 0.45), at(0, 0.3, -0.95), S.Anodized)
	for _, side in { -1, 1 } do
		for i = 0, 2 do
			add("ShroudVent" .. side .. i, Vector3.new(0.02, 0.05, 0.08), at(side * 0.101, 0.32, -0.8 - i * 0.13), S.SteelDark)
		end
	end
	add("Barrel", Vector3.new(0.22, 0.12, 0.12), alongZ(0, 0.3, -1.29), S.SteelDark, Enum.PartType.Cylinder)
	add("MuzzleBrake", Vector3.new(0.14, 0.15, 0.15), alongZ(0, 0.3, -1.36), S.Anodized, Enum.PartType.Cylinder)
	for _, side in { -1, 1 } do
		add("BrakePort" .. side, Vector3.new(0.02, 0.04, 0.08), at(side * 0.07, 0.3, -1.36), S.SteelDark)
	end

	-- Grip, trigger, angled foregrip
	add("PistolGrip", Vector3.new(0.14, 0.38, 0.2), at(0, -0.05, 0.05) * tilt(-15), S.Polymer)
	add("GripTexture", Vector3.new(0.145, 0.24, 0.13), at(0, -0.06, 0.06) * tilt(-15), S.Rubber)
	add("TriggerGuard", Vector3.new(0.04, 0.04, 0.3), at(0, 0.05, -0.18), S.Polymer)
	add("Trigger", Vector3.new(0.03, 0.09, 0.03), at(0, 0.1, -0.15), S.Steel)
	add("AngledGrip", Vector3.new(0.1, 0.1, 0.32), at(0, 0.12, -0.85) * tilt(-20), S.Polymer)
	add("BottomRail", Vector3.new(0.1, 0.04, 0.4), at(0, 0.19, -0.9), S.Anodized)

	-- Straight magazine
	add("Magazine", Vector3.new(0.12, 0.62, 0.2), at(0, -0.18, -0.38) * tilt(6), S.SteelDark)
	add("MagazineBase", Vector3.new(0.14, 0.05, 0.22), at(0, -0.5, -0.36) * tilt(6), S.Polymer)

	-- Wire folding stock
	for _, y in { 0.36, 0.16 } do
		for _, x in { -0.06, 0.06 } do
			add("StockRail", Vector3.new(0.035, 0.035, 0.7), at(x, y, 0.55), S.Steel)
		end
	end
	add("StockHinge", Vector3.new(0.16, 0.26, 0.08), at(0, 0.26, 0.22), S.Anodized)
	add("ButtPlate", Vector3.new(0.16, 0.34, 0.05), at(0, 0.26, 0.92), S.Rubber)

	-- Reflex sight
	add("ReflexBase", Vector3.new(0.12, 0.05, 0.22), at(0, 0.54, -0.3), S.Anodized)
	add("ReflexPostL", Vector3.new(0.02, 0.16, 0.04), at(-0.06, 0.64, -0.36), S.Anodized)
	add("ReflexPostR", Vector3.new(0.02, 0.16, 0.04), at(0.06, 0.64, -0.36), S.Anodized)
	add("ReflexTop", Vector3.new(0.14, 0.02, 0.04), at(0, 0.725, -0.36), S.Anodized)
	local window = add("ReflexWindow", Vector3.new(0.1, 0.14, 0.01), at(0, 0.64, -0.36), S.LensRed)
	addReticle(window, rgb(255, 50, 50), false)

	ctx.attach("Muzzle", Vector3.new(0, 0.3, -1.45))
	ctx.attach("Ejection", Vector3.new(0.14, 0.32, -0.2))
	ctx.attach("GripRight", Vector3.new(0, 0, 0))
	ctx.attach("GripLeft", Vector3.new(0, 0.08, -0.85))
end

--------------------------------------------------------------------------------
-- M-50 heavy pistol
--------------------------------------------------------------------------------
local function buildPistol(ctx: Ctx)
	local S = STYLES
	local add = ctx.add

	add("Slide", Vector3.new(0.15, 0.17, 0.95), at(0, 0.33, -0.28), S.SteelDark)
	for i = 0, 4 do
		add("RearSerration" .. i, Vector3.new(0.155, 0.12, 0.018), at(0, 0.33, 0.06 + i * 0.03), S.Anodized)
	end
	for i = 0, 2 do
		add("FrontSerration" .. i, Vector3.new(0.155, 0.1, 0.018), at(0, 0.33, -0.55 - i * 0.03), S.Anodized)
	end
	add("EjectionPort", Vector3.new(0.02, 0.07, 0.2), at(0.076, 0.36, -0.2), S.Steel)
	add("Frame", Vector3.new(0.14, 0.12, 0.8), at(0, 0.2, -0.3), S.Polymer)
	add("DustRail", Vector3.new(0.1, 0.04, 0.25), at(0, 0.13, -0.55), S.Polymer)
	add("Compensator", Vector3.new(0.15, 0.15, 0.18), at(0, 0.33, -0.84), S.Anodized)
	add("CompPort", Vector3.new(0.06, 0.02, 0.1), at(0, 0.41, -0.84), S.SteelDark)
	add("Bore", Vector3.new(0.02, 0.07, 0.07), alongZ(0, 0.33, -0.94), S.SteelDark, Enum.PartType.Cylinder)

	add("Grip", Vector3.new(0.14, 0.48, 0.24), at(0, -0.08, 0.06) * tilt(-18), S.Polymer)
	add("GripPanel", Vector3.new(0.145, 0.3, 0.16), at(0, -0.06, 0.07) * tilt(-18), S.Rubber)
	add("Beavertail", Vector3.new(0.12, 0.05, 0.14), at(0, 0.2, 0.2) * tilt(-30), S.Polymer)
	add("TriggerGuard", Vector3.new(0.04, 0.04, 0.3), at(0, 0.08, -0.2), S.Polymer)
	add("Trigger", Vector3.new(0.03, 0.09, 0.03), at(0, 0.12, -0.16), S.Steel)
	add("Hammer", Vector3.new(0.05, 0.08, 0.06), at(0, 0.38, 0.22), S.Steel)
	add("SlideStop", Vector3.new(0.02, 0.04, 0.14), at(-0.08, 0.24, -0.25), S.Steel)

	add("Magazine", Vector3.new(0.11, 0.44, 0.19), at(0, -0.1, 0.07) * tilt(-18), S.SteelDark)
	add("MagazineBase", Vector3.new(0.15, 0.06, 0.25), at(0, -0.34, 0.14) * tilt(-18), S.Polymer)

	add("RearSight", Vector3.new(0.12, 0.05, 0.05), at(0, 0.44, 0.12), S.Anodized)
	add("FrontSight", Vector3.new(0.03, 0.05, 0.04), at(0, 0.44, -0.7), S.Anodized)
	add("DotHousing", Vector3.new(0.1, 0.09, 0.16), at(0, 0.46, -0.1), S.Anodized)
	local window = add("DotWindow", Vector3.new(0.08, 0.06, 0.01), at(0, 0.48, -0.18), S.LensRed)
	addReticle(window, rgb(255, 50, 50), false)

	ctx.attach("Muzzle", Vector3.new(0, 0.33, -0.98))
	ctx.attach("Ejection", Vector3.new(0.1, 0.38, -0.2))
	ctx.attach("GripRight", Vector3.new(0, 0, 0))
	ctx.attach("GripLeft", Vector3.new(-0.12, -0.05, 0.02))
end

local BUILDERS: { [string]: (Ctx) -> () } = {
	SuppressedRifle = buildRifle,
	CompactSMG = buildSMG,
	HeavyPistol = buildPistol,
}

function WeaponBuilder.has(weaponId: string): boolean
	return BUILDERS[weaponId] ~= nil
end

-- origin: world CFrame of the grip point. Anchored = true for display props.
function WeaponBuilder.build(weaponId: string, origin: CFrame?, anchored: boolean?): WeaponHandles
	local builder = BUILDERS[weaponId]
	assert(builder, "[WeaponBuilder] unknown weapon " .. tostring(weaponId))

	local model = Instance.new("Model")
	model.Name = weaponId
	model:SetAttribute("WeaponId", weaponId)
	local ctx = newCtx(model, origin or CFrame.identity)
	builder(ctx)
	ctx.Handle.Anchored = anchored == true
	CollectionService:AddTag(model, "Weapon")

	local function need(name: string): Attachment
		local attachment = ctx.Handle:FindFirstChild(name)
		assert(attachment and attachment:IsA("Attachment"), "[WeaponBuilder] missing attachment " .. name)
		return attachment
	end

	return {
		Model = model,
		Handle = ctx.Handle,
		Muzzle = need("Muzzle"),
		Ejection = need("Ejection"),
		GripRight = need("GripRight"),
		GripLeft = need("GripLeft"),
		Magazine = ctx.Magazine,
	}
end

-- Finds the standard attachments on an already-built weapon model.
function WeaponBuilder.resolve(model: Model): WeaponHandles?
	local handle = model:FindFirstChild("Handle")
	if not handle or not handle:IsA("BasePart") then
		return nil
	end
	local function find(name: string): Attachment?
		local attachment = handle:FindFirstChild(name)
		return if attachment and attachment:IsA("Attachment") then attachment else nil
	end
	local muzzle, ejection, right, left = find("Muzzle"), find("Ejection"), find("GripRight"), find("GripLeft")
	if not (muzzle and ejection and right and left) then
		return nil
	end
	local magazine: { BasePart } = {}
	for _, child in model:GetChildren() do
		if child:IsA("BasePart") and string.sub(child.Name, 1, 8) == "Magazine" then
			table.insert(magazine, child)
		end
	end
	return {
		Model = model,
		Handle = handle,
		Muzzle = muzzle,
		Ejection = ejection,
		GripRight = right,
		GripLeft = left,
		Magazine = magazine,
	}
end

return WeaponBuilder
]]></ProtectedString></Properties></Item></Item><Item class="ModuleScript" referent="RBX000008"><Properties><string name="Name">Config</string><ProtectedString name="Source"><![CDATA[--!strict
