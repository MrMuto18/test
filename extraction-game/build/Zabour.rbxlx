<roblox version="4"><Item class="ReplicatedFirst" referent="RBX000002"><Properties><string name="Name">ReplicatedFirst</string></Properties><Item class="LocalScript" referent="RBX000001"><Properties><string name="Name">LoadingScreen</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	LoadingScreen (LocalScript in ReplicatedFirst)
	Replaces the default Roblox loader with a black title card and a thin
	indeterminate progress line. Holds until the menu camera is live
	("ClientMenuReady"), then dissolves straight into the 3D scene.
	Uses only engine built-ins: ReplicatedFirst runs before anything else
	has replicated.
]]

local Players = game:GetService("Players")
local ReplicatedFirst = game:GetService("ReplicatedFirst")
local StarterGui = game:GetService("StarterGui")
local TweenService = game:GetService("TweenService")

local READY_TIMEOUT = 25
local ACCENT = Color3.fromRGB(255, 168, 86)
local TEXT = Color3.fromRGB(236, 234, 228)

ReplicatedFirst:RemoveDefaultLoadingScreen()
pcall(function()
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.All, false)
end)

local THIN = utf8.char(0x2009)
local function track(text: string): string
	local out = {}
	for _, code in utf8.codes(text) do
		local char = utf8.char(code)
		table.insert(out, if char == " " then THIN .. THIN .. THIN else char)
	end
	return table.concat(out, THIN)
end

local player = Players.LocalPlayer

local gui = Instance.new("ScreenGui")
gui.Name = "LoadingScreen"
gui.IgnoreGuiInset = true
gui.ResetOnSpawn = false
gui.DisplayOrder = 1000

local backdrop = Instance.new("Frame")
backdrop.Name = "Backdrop"
backdrop.Size = UDim2.fromScale(1, 1)
backdrop.BackgroundColor3 = Color3.new(0, 0, 0)
backdrop.BorderSizePixel = 0
backdrop.Parent = gui

local title = Instance.new("TextLabel")
title.Name = "Title"
title.BackgroundTransparency = 1
title.AnchorPoint = Vector2.new(0.5, 0.5)
title.Position = UDim2.fromScale(0.5, 0.47)
title.Size = UDim2.fromOffset(600, 70)
title.FontFace = Font.new("rbxasset://fonts/families/Montserrat.json", Enum.FontWeight.ExtraBold)
title.TextSize = 52
title.TextColor3 = TEXT
title.TextTransparency = 1
title.Text = track("ZABOUR")
title.Parent = backdrop

local status = Instance.new("TextLabel")
status.Name = "Status"
status.BackgroundTransparency = 1
status.AnchorPoint = Vector2.new(0.5, 0.5)
status.Position = UDim2.fromScale(0.5, 0.535)
status.Size = UDim2.fromOffset(600, 18)
status.FontFace = Font.new("rbxasset://fonts/families/RobotoMono.json", Enum.FontWeight.Regular)
status.TextSize = 11
status.TextColor3 = Color3.fromRGB(150, 150, 146)
status.TextTransparency = 1
status.Text = track("ESTABLISHING SECURE LINK")
status.Parent = backdrop

local trackBar = Instance.new("Frame")
trackBar.Name = "Track"
trackBar.AnchorPoint = Vector2.new(0.5, 0.5)
trackBar.Position = UDim2.fromScale(0.5, 0.57)
trackBar.Size = UDim2.fromOffset(220, 1)
trackBar.BackgroundColor3 = Color3.new(1, 1, 1)
trackBar.BackgroundTransparency = 0.88
trackBar.BorderSizePixel = 0
trackBar.ClipsDescendants = true
trackBar.Parent = backdrop

local fill = Instance.new("Frame")
fill.Name = "Fill"
fill.Size = UDim2.fromScale(0.3, 1)
fill.Position = UDim2.fromScale(-0.3, 0)
fill.BackgroundColor3 = ACCENT
fill.BorderSizePixel = 0
fill.Parent = trackBar

gui.Parent = player:WaitForChild("PlayerGui")

local fadeIn = TweenInfo.new(0.8, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
TweenService:Create(title, fadeIn, { TextTransparency = 0 }):Play()
TweenService:Create(status, fadeIn, { TextTransparency = 0.2 }):Play()
local sweep = TweenService:Create(
	fill,
	TweenInfo.new(1.1, Enum.EasingStyle.Quint, Enum.EasingDirection.InOut, -1, false),
	{ Position = UDim2.fromScale(1, 0) }
)
sweep:Play()

if not game:IsLoaded() then
	game.Loaded:Wait()
end
status.Text = track("SYNCING SAFEHOUSE")

local deadline = os.clock() + READY_TIMEOUT
while player:GetAttribute("ClientMenuReady") ~= true and os.clock() < deadline do
	task.wait(0.1)
end
-- One beat for the menu camera and grade to settle under the card.
task.wait(0.4)

sweep:Cancel()
fill.Position = UDim2.fromScale(0, 0)
local complete = TweenService:Create(fill, TweenInfo.new(0.35, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
	Size = UDim2.fromScale(1, 1),
})
complete:Play()
complete.Completed:Wait()

local out = TweenInfo.new(0.5, Enum.EasingStyle.Sine, Enum.EasingDirection.In)
TweenService:Create(title, out, { TextTransparency = 1 }):Play()
TweenService:Create(status, out, { TextTransparency = 1 }):Play()
TweenService:Create(trackBar, out, { BackgroundTransparency = 1 }):Play()
TweenService:Create(fill, out, { BackgroundTransparency = 1 }):Play()
task.wait(0.35)
local dissolve = TweenService:Create(backdrop, TweenInfo.new(1.3, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
	BackgroundTransparency = 1,
})
dissolve:Play()
dissolve.Completed:Wait()
gui:Destroy()
]]></ProtectedString></Properties></Item></Item><Item class="ReplicatedStorage" referent="RBX000014"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="Folder" referent="RBX000013"><Properties><string name="Name">Shared</string></Properties><Item class="Folder" referent="RBX000005"><Properties><string name="Name">Builders</string></Properties><Item class="ModuleScript" referent="RBX000003"><Properties><string name="Name">GetawayCarBody</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	GetawayCarBody
	Procedural "Zabour" fastback getaway car: ~150 parts, matte-black paint,
	tinted glass, widebody flares, 10-spoke rims, LED headlights with volumetric
	beams, full-width light bar, dual exhausts, diffuser, wing, lit interior.

	Phase 1 uses it as the static showpiece in the safehouse.
	Phase 3 reuses the same body on a physics chassis (pass Anchored = false).

	Local space: origin sits on the ground at the centre of the footprint,
	forward is -Z (origin.LookVector), up is +Y. All numbers are studs.

	Assembly: Root is the only part whose Anchored flag matters; every other
	part is unanchored and welded to Root, so moving Root moves the whole car
	(the client uses this for the idle engine rumble).
]]

local CollectionService = game:GetService("CollectionService")

local PartFactory = require(script.Parent.PartFactory)

export type BuildOptions = {
	Name: string?,
	Anchored: boolean?,
	PaintColor: Color3?,
	Interior: boolean?,
	PlateText: string?,
}

export type CarHandles = {
	Model: Model,
	Root: BasePart,
	Wheels: { [string]: Model },
	HeadlightLights: { SpotLight },
	HeadlightBeams: { Beam },
	HeadlightLenses: { BasePart },
	BrakeLights: { BasePart },
	BrakeLightSources: { SurfaceLight },
	Exhausts: { Attachment },
	UnderglowStrip: BasePart,
	UnderglowLights: { PointLight },
	EngineBay: BasePart,
	TrunkLid: BasePart,
}

type Style = PartFactory.Style

type AddExtra = {
	Class: ("Part" | "WedgePart" | "CornerWedgePart")?,
	Shape: Enum.PartType?,
	Collide: boolean?,
	Parent: Instance?,
}

local GetawayCarBody = {}

local RUBBER = PartFactory.material("Rubber", Enum.Material.SmoothPlastic)
local LEATHER = PartFactory.material("Leather", Enum.Material.Fabric)

-- Brake light brightness range (idle running lights -> full brake).
local BRAKE_IDLE_TRANSPARENCY = 0.35
local BRAKE_IDLE_BRIGHTNESS = 0.9
local BRAKE_FULL_BRIGHTNESS = 3.2

local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

local function makeStyles(paint: Color3): { [string]: Style }
	return {
		Paint = PartFactory.style(paint, Enum.Material.SmoothPlastic, 0.02),
		PaintAccent = PartFactory.style(rgb(150, 18, 24), Enum.Material.SmoothPlastic, 0.05),
		Trim = PartFactory.style(rgb(12, 12, 13), Enum.Material.SmoothPlastic, 0),
		Carbon = PartFactory.style(rgb(20, 20, 22), Enum.Material.Fabric, 0),
		Chrome = PartFactory.style(rgb(168, 170, 176), Enum.Material.Metal, 0.25),
		Gunmetal = PartFactory.style(rgb(96, 98, 104), Enum.Material.Metal, 0.08),
		RimShadow = PartFactory.style(rgb(12, 12, 14), Enum.Material.Metal, 0),
		Rubber = PartFactory.style(rgb(24, 24, 26), RUBBER, 0),
		Glass = PartFactory.style(rgb(10, 12, 15), Enum.Material.Glass, 0.18, 0.32),
		LensDark = PartFactory.style(rgb(18, 20, 24), Enum.Material.Glass, 0.3, 0.1),
		LensRed = PartFactory.style(rgb(70, 8, 10), Enum.Material.Glass, 0.2, 0.15),
		NeonWhite = PartFactory.style(rgb(232, 240, 255), Enum.Material.Neon, 0, 0, false),
		NeonRed = PartFactory.style(rgb(255, 24, 34), Enum.Material.Neon, 0, BRAKE_IDLE_TRANSPARENCY, false),
		NeonGauge = PartFactory.style(rgb(60, 200, 255), Enum.Material.Neon, 0, 0.35, false),
		NeonScreen = PartFactory.style(rgb(255, 140, 60), Enum.Material.Neon, 0, 0.55, false),
		NeonUnder = PartFactory.style(rgb(255, 60, 170), Enum.Material.Neon, 0, 1, false),
		Interior = PartFactory.style(rgb(26, 26, 28), LEATHER, 0),
		Dash = PartFactory.style(rgb(18, 18, 20), Enum.Material.SmoothPlastic, 0),
		Plate = PartFactory.style(rgb(214, 214, 206), Enum.Material.SmoothPlastic, 0.05),
		Invisible = PartFactory.style(rgb(0, 0, 0), Enum.Material.SmoothPlastic, 0, 1, false),
	}
end

function GetawayCarBody.build(origin: CFrame, options: BuildOptions?): CarHandles
	local opts: BuildOptions = options or {}
	local anchored = if opts.Anchored == nil then true else opts.Anchored
	local styles = makeStyles(opts.PaintColor or rgb(16, 16, 18))
	local includeInterior = opts.Interior ~= false

	local model = Instance.new("Model")
	model.Name = opts.Name or "Zabour"
	model:SetAttribute("VehicleType", "Zabour")

	local root = PartFactory.make({
		Name = "Root",
		Size = Vector3.new(6.6, 2.1, 16),
		CFrame = origin * CFrame.new(0, 1.8, 0),
		Style = styles.Invisible,
		Anchored = anchored,
		CanCollide = false,
		Parent = model,
	})
	model.PrimaryPart = root

	local bodyFolder = PartFactory.folder("Body", model)
	local glassFolder = PartFactory.folder("Glass", model)
	local lightsFolder = PartFactory.folder("Lights", model)
	local trimFolder = PartFactory.folder("Trim", model)
	local wheelsFolder = PartFactory.folder("Wheels", model)
	local interiorFolder = PartFactory.folder("Interior", model)

	local function add(name: string, size: Vector3, localCF: CFrame, style: Style, extra: AddExtra?): BasePart
		local e: AddExtra = extra or {}
		local part = PartFactory.make({
			Name = name,
			Size = size,
			CFrame = origin * localCF,
			Style = style,
			Class = e.Class,
			Shape = e.Shape,
			CanCollide = e.Collide,
			Anchored = false,
			Parent = e.Parent or bodyFolder,
		})
		PartFactory.weld(root, part)
		return part
	end

	local function at(x: number, y: number, z: number): CFrame
		return CFrame.new(x, y, z)
	end

	local SIDES = { -1, 1 }

	----------------------------------------------------------------------------
	-- Structure (sections along Z: bumper | wheel well | doors | wheel well | bumper)
	----------------------------------------------------------------------------
	add("FloorPan", Vector3.new(4.7, 0.25, 15.6), at(0, 0.72, 0), styles.Carbon, { Collide = true })

	-- Front
	add("FrontBumper", Vector3.new(6.6, 1.25, 1.2), at(0, 1.35, -7.4), styles.Paint, { Collide = true })
	add("FrontCore", Vector3.new(4.7, 1.25, 3.2), at(0, 1.35, -5.2), styles.Paint, { Collide = true })
	-- Hood: wedge rising from the nose (y 1.975) to the cowl (y 2.85).
	add("Hood", Vector3.new(6.6, 0.875, 4.4), at(0, 2.4125, -5.8), styles.Paint, { Class = "WedgePart", Collide = true })
	-- Hood power bulge + vents
	add("HoodBulge", Vector3.new(2.2, 0.16, 3.4), at(0, 2.48, -5.4) * CFrame.Angles(math.rad(-11.25), 0, 0), styles.Paint)
	for i = 0, 2 do
		add(
			"HoodVent" .. i,
			Vector3.new(1.6, 0.04, 0.12),
			at(0, 2.565 + i * 0.035, -5.9 + i * 0.3) * CFrame.Angles(math.rad(-11.25), 0, 0),
			styles.Trim
		)
	end

	-- Doors / cabin base
	add("DoorSection", Vector3.new(6.6, 2.1, 7.2), at(0, 1.8, 0), styles.Paint, { Collide = true })

	-- Rear
	add("RearCore", Vector3.new(4.7, 2.1, 2.8), at(0, 1.8, 5.0), styles.Paint, { Collide = true })
	add("RearFenderTop", Vector3.new(6.6, 0.25, 2.8), at(0, 2.725, 5.0), styles.Paint, { Collide = true })
	add("RearBumper", Vector3.new(6.6, 2.1, 1.6), at(0, 1.8, 7.2), styles.Paint, { Collide = true })
	add("Ducktail", Vector3.new(6.2, 0.3, 0.8), at(0, 3.0, 7.6), styles.Paint, { Class = "WedgePart" })

	local trunkLid = add("TrunkLid", Vector3.new(5.6, 0.06, 2.0), at(0, 2.88, 6.4), styles.Paint)
	trunkLid:SetAttribute("LootTrunk", true)
	local trunkPrompt = Instance.new("Attachment")
	trunkPrompt.Name = "TrunkPrompt"
	trunkPrompt.Position = Vector3.new(0, 0.6, 1.4)
	trunkPrompt.Parent = trunkLid

	-- Fender bulges over the front wheels, following the hood slope.
	for _, s in SIDES do
		add(
			if s < 0 then "FenderBulge_L" else "FenderBulge_R",
			Vector3.new(1.0, 0.3, 3.0),
			at(s * 2.9, 2.63, -5.2) * CFrame.Angles(math.rad(-11.25), 0, 0),
			styles.Paint
		)
	end

	-- Widebody flares: top + angled front/back segments framing each arch.
	local axles = {
		{ Name = "F", Z = -5.2 },
		{ Name = "R", Z = 5.0 },
	}
	for _, axle in axles do
		for _, s in SIDES do
			local tag = axle.Name .. (if s < 0 then "L" else "R")
			local x = s * 3.45
			add("FlareTop_" .. tag, Vector3.new(0.3, 0.22, 2.4), at(x, 2.72, axle.Z), styles.Trim)
			add(
				"FlareFront_" .. tag,
				Vector3.new(0.3, 0.22, 1.3),
				at(x, 2.22, axle.Z - 1.62) * CFrame.Angles(math.rad(-50), 0, 0),
				styles.Trim
			)
			add(
				"FlareRear_" .. tag,
				Vector3.new(0.3, 0.22, 1.3),
				at(x, 2.22, axle.Z + 1.62) * CFrame.Angles(math.rad(50), 0, 0),
				styles.Trim
			)
		end
	end

	-- Side skirts, door seams, handles, character line
	for _, s in SIDES do
		local side = if s < 0 then "L" else "R"
		add("SideSkirt_" .. side, Vector3.new(0.22, 0.3, 7.4), at(s * 3.36, 0.9, -0.1), styles.Carbon, { Parent = trimFolder })
		add("DoorSeamFront_" .. side, Vector3.new(0.04, 1.9, 0.05), at(s * 3.31, 1.85, -3.45), styles.Trim, { Parent = trimFolder })
		add("DoorSeamRear_" .. side, Vector3.new(0.04, 1.9, 0.05), at(s * 3.31, 1.85, 1.45), styles.Trim, { Parent = trimFolder })
		add("DoorSeamBottom_" .. side, Vector3.new(0.04, 0.05, 4.9), at(s * 3.31, 0.92, -1.0), styles.Trim, { Parent = trimFolder })
		add("DoorHandle_" .. side, Vector3.new(0.06, 0.1, 0.5), at(s * 3.33, 2.45, 0.9), styles.Chrome, { Parent = trimFolder })
		add("CharacterLine_" .. side, Vector3.new(0.03, 0.05, 7.1), at(s * 3.31, 2.42, 0), styles.Gunmetal, { Parent = trimFolder })

		-- Mirrors
		add("MirrorStalk_" .. side, Vector3.new(0.5, 0.08, 0.15), at(s * 2.98, 3.02, -2.3), styles.Trim, { Parent = trimFolder })
		add("Mirror_" .. side, Vector3.new(0.35, 0.32, 0.55), at(s * 3.2, 3.18, -2.3), styles.Paint, { Parent = trimFolder })
		add("MirrorGlass_" .. side, Vector3.new(0.3, 0.26, 0.02), at(s * 3.2, 3.18, -2.02), styles.Chrome, { Parent = trimFolder })
	end

	----------------------------------------------------------------------------
	-- Greenhouse (cabin)
	----------------------------------------------------------------------------
	-- Windshield: base (y 2.85, z -2.6) -> roof (y 4.35, z -0.3)
	local windshieldAngle = math.atan2(1.5, 2.3)
	local windshieldLength = math.sqrt(1.5 * 1.5 + 2.3 * 2.3)
	local windshieldCF = at(0, 3.6, -1.45) * CFrame.Angles(-windshieldAngle, 0, 0)
	add("Windshield", Vector3.new(5.2, 0.1, windshieldLength), windshieldCF, styles.Glass, { Parent = glassFolder })

	-- Rear glass: roof (y 4.35, z 2.4) -> deck (y 2.85, z 5.4)
	local rearAngle = math.atan2(1.5, 3.0)
	local rearLength = math.sqrt(1.5 * 1.5 + 3.0 * 3.0)
	add(
		"RearGlass",
		Vector3.new(5.0, 0.1, rearLength),
		at(0, 3.6, 3.9) * CFrame.Angles(rearAngle, 0, 0),
		styles.Glass,
		{ Parent = glassFolder }
	)

	add("Roof", Vector3.new(5.4, 0.22, 2.7), at(0, 4.42, 1.05), styles.Paint, { Collide = true })
	add("SharkFin", Vector3.new(0.15, 0.25, 0.6), at(0, 4.655, 2.0), styles.Paint, { Class = "WedgePart" })

	for _, s in SIDES do
		local side = if s < 0 then "L" else "R"
		add(
			"APillar_" .. side,
			Vector3.new(0.2, 0.2, windshieldLength),
			at(s * 2.66, 3.65, -1.45) * CFrame.Angles(-windshieldAngle, 0, 0),
			styles.Paint
		)
		-- Front quarter glass (triangle, tall at the back)
		add(
			"QuarterGlass_" .. side,
			Vector3.new(0.1, 1.46, 2.3),
			at(s * 2.72, 3.58, -1.45),
			styles.Glass,
			{ Class = "WedgePart", Parent = glassFolder }
		)
		add("SideGlass_" .. side, Vector3.new(0.1, 1.46, 2.7), at(s * 2.72, 3.58, 1.05), styles.Glass, { Parent = glassFolder })
		add("BPillar_" .. side, Vector3.new(0.12, 1.46, 0.22), at(s * 2.74, 3.58, 0.9), styles.Trim, { Parent = trimFolder })
		-- Fastback sail panel (tall at the front)
		add(
			"CPillar_" .. side,
			Vector3.new(0.2, 1.46, 3.0),
			at(s * 2.7, 3.58, 3.9) * CFrame.Angles(0, math.rad(180), 0),
			styles.Paint,
			{ Class = "WedgePart" }
		)
		add("WindowTrim_" .. side, Vector3.new(0.06, 0.05, 6.0), at(s * 2.78, 2.88, 0.2), styles.Chrome, { Parent = trimFolder })
	end

	----------------------------------------------------------------------------
	-- Front fascia
	----------------------------------------------------------------------------
	add("Grille", Vector3.new(3.6, 0.55, 0.12), at(0, 1.35, -8.02), PartFactory.style(rgb(14, 14, 15), Enum.Material.DiamondPlate, 0), { Parent = trimFolder })
	add("GrilleSurround", Vector3.new(3.8, 0.06, 0.14), at(0, 1.66, -8.02), styles.Chrome, { Parent = trimFolder })
	add("LowerIntake", Vector3.new(5.6, 0.3, 0.1), at(0, 0.95, -8.02), styles.Trim, { Parent = trimFolder })
	add("Splitter", Vector3.new(6.9, 0.1, 0.9), at(0, 0.68, -7.75), styles.Carbon, { Parent = trimFolder })
	add("FrontPlate", Vector3.new(1.4, 0.4, 0.04), at(0, 1.02, -8.09), styles.Plate, { Parent = trimFolder })

	local headlightLights: { SpotLight } = {}
	local headlightBeams: { Beam } = {}
	local headlightLenses: { BasePart } = {}

	for _, s in SIDES do
		local side = if s < 0 then "L" else "R"
		add("HeadlightHousing_" .. side, Vector3.new(1.5, 0.32, 0.14), at(s * 2.35, 1.78, -8.02), styles.LensDark, { Parent = lightsFolder })
		local drl = add("HeadlightDRL_" .. side, Vector3.new(1.45, 0.07, 0.06), at(s * 2.35, 1.9, -8.07), styles.NeonWhite, { Parent = lightsFolder })
		local projector = add(
			"HeadlightProjector_" .. side,
			Vector3.new(0.1, 0.24, 0.24),
			at(s * 2.0, 1.74, -8.08) * PartFactory.AxisZ,
			styles.NeonWhite,
			{ Shape = Enum.PartType.Cylinder, Parent = lightsFolder }
		)
		table.insert(headlightLenses, drl)
		table.insert(headlightLenses, projector)

		-- Invisible emitter aligned with the car so SpotLight Face=Front = car forward.
		local source = add("HeadlightSource_" .. side, Vector3.new(0.2, 0.2, 0.2), at(s * 2.2, 1.76, -8.2), styles.Invisible, { Parent = lightsFolder })
		local spot = Instance.new("SpotLight")
		spot.Name = "Beam"
		spot.Face = Enum.NormalId.Front
		spot.Angle = 55
		spot.Range = 60
		spot.Brightness = 5
		spot.Color = rgb(255, 244, 225)
		spot.Shadows = true
		spot.Parent = source
		CollectionService:AddTag(spot, "ShadowLight")
		table.insert(headlightLights, spot)

		-- Volumetric cone: camera-facing beam fading into the fog.
		local a0 = Instance.new("Attachment")
		a0.Name = "BeamStart"
		a0.Parent = source
		local a1 = Instance.new("Attachment")
		a1.Name = "BeamEnd"
		a1.Position = Vector3.new(s * 1.5, -1.3, -26)
		a1.Parent = source
		local beam = Instance.new("Beam")
		beam.Name = "VolumetricBeam"
		beam.Attachment0 = a0
		beam.Attachment1 = a1
		beam.Width0 = 0.9
		beam.Width1 = 9
		beam.FaceCamera = true
		beam.LightEmission = 1
		beam.LightInfluence = 0
		beam.Segments = 1
		beam.Color = ColorSequence.new(rgb(255, 240, 220))
		beam.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.8),
			NumberSequenceKeypoint.new(0.35, 0.88),
			NumberSequenceKeypoint.new(1, 1),
		})
		beam.Parent = source
		CollectionService:AddTag(beam, "VolumetricBeam")
		table.insert(headlightBeams, beam)

		-- Fog lights in the lower intake
		add("FogLight_" .. side, Vector3.new(0.5, 0.12, 0.06), at(s * 2.45, 0.95, -8.07), styles.NeonWhite, { Parent = lightsFolder })
	end

	----------------------------------------------------------------------------
	-- Rear fascia
	----------------------------------------------------------------------------
	local brakeLights: { BasePart } = {}
	local brakeSources: { SurfaceLight } = {}

	local lightBar = add("TailLightBar", Vector3.new(6.0, 0.16, 0.1), at(0, 2.55, 8.03), styles.NeonRed, { Parent = lightsFolder })
	table.insert(brakeLights, lightBar)
	local barGlow = Instance.new("SurfaceLight")
	barGlow.Name = "BrakeGlow"
	barGlow.Face = Enum.NormalId.Back
	barGlow.Angle = 120
	barGlow.Range = 14
	barGlow.Brightness = BRAKE_IDLE_BRIGHTNESS
	barGlow.Color = rgb(255, 30, 36)
	barGlow.Shadows = false
	barGlow.Parent = lightBar
	table.insert(brakeSources, barGlow)

	for _, s in SIDES do
		local side = if s < 0 then "L" else "R"
		add("TailCluster_" .. side, Vector3.new(1.2, 0.38, 0.12), at(s * 2.55, 2.22, 8.02), styles.LensRed, { Parent = lightsFolder })
		local inner = add("TailLamp_" .. side, Vector3.new(1.0, 0.12, 0.05), at(s * 2.55, 2.22, 8.08), styles.NeonRed, { Parent = lightsFolder })
		table.insert(brakeLights, inner)
		add("ReverseLamp_" .. side, Vector3.new(0.3, 0.1, 0.05), at(s * 1.75, 2.22, 8.08), PartFactory.style(rgb(200, 200, 200), Enum.Material.Glass, 0.2, 0.1), { Parent = lightsFolder })
	end

	local rearPlate = add("RearPlate", Vector3.new(1.6, 0.5, 0.05), at(0, 1.6, 8.03), styles.Plate, { Parent = trimFolder })
	local plateGui = Instance.new("SurfaceGui")
	plateGui.Name = "PlateText"
	plateGui.Face = Enum.NormalId.Back
	plateGui.PixelsPerStud = 80
	plateGui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	plateGui.LightInfluence = 1
	plateGui.Parent = rearPlate
	local plateLabel = Instance.new("TextLabel")
	plateLabel.BackgroundTransparency = 1
	plateLabel.Size = UDim2.fromScale(1, 1)
	plateLabel.Text = opts.PlateText or "ZBR 077"
	plateLabel.TextScaled = true
	plateLabel.TextColor3 = rgb(24, 26, 30)
	plateLabel.FontFace = Font.new("rbxasset://fonts/families/RobotoMono.json", Enum.FontWeight.Bold)
	plateLabel.Parent = plateGui

	-- Diffuser with fins
	add("Diffuser", Vector3.new(5.4, 0.12, 1.3), at(0, 0.69, 7.45), styles.Carbon, { Parent = trimFolder })
	for i = -2, 2 do
		add("DiffuserFin" .. (i + 3), Vector3.new(0.07, 0.3, 1.2), at(i * 0.8, 0.6, 7.5), styles.Carbon, { Parent = trimFolder })
	end

	-- Dual exhausts
	local exhausts: { Attachment } = {}
	for _, s in SIDES do
		local side = if s < 0 then "L" else "R"
		add("ExhaustTip_" .. side, Vector3.new(0.7, 0.5, 0.5), at(s * 1.55, 0.92, 8.05) * PartFactory.AxisZ, styles.Chrome, {
			Shape = Enum.PartType.Cylinder,
			Parent = trimFolder,
		})
		add("ExhaustBore_" .. side, Vector3.new(0.72, 0.36, 0.36), at(s * 1.55, 0.92, 8.06) * PartFactory.AxisZ, styles.Trim, {
			Shape = Enum.PartType.Cylinder,
			Parent = trimFolder,
		})

		local attachment = Instance.new("Attachment")
		attachment.Name = "Exhaust_" .. side
		-- Root sits at y 1.8 in car space.
		attachment.Position = Vector3.new(s * 1.55, 0.92 - 1.8, 8.45)
		attachment.Parent = root
		table.insert(exhausts, attachment)

		local smoke = Instance.new("ParticleEmitter")
		smoke.Name = "ExhaustSmoke"
		smoke.Texture = "rbxasset://textures/particles/smoke_main.dds"
		smoke.EmissionDirection = Enum.NormalId.Back
		smoke.Rate = 5
		smoke.Lifetime = NumberRange.new(1.6, 2.6)
		smoke.Speed = NumberRange.new(1.5, 2.5)
		smoke.SpreadAngle = Vector2.new(12, 12)
		smoke.Drag = 1.2
		smoke.Acceleration = Vector3.new(0, 1.2, 0)
		smoke.Rotation = NumberRange.new(0, 360)
		smoke.RotSpeed = NumberRange.new(-40, 40)
		smoke.LightInfluence = 1
		smoke.Color = ColorSequence.new(rgb(150, 150, 155))
		smoke.Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.25),
			NumberSequenceKeypoint.new(1, 1.6),
		})
		smoke.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.82),
			NumberSequenceKeypoint.new(1, 1),
		})
		smoke.Parent = attachment
		CollectionService:AddTag(smoke, "ExhaustSmoke")
	end

	-- Rear wing on stands with endplates
	for _, s in SIDES do
		local side = if s < 0 then "L" else "R"
		add("WingStand_" .. side, Vector3.new(0.14, 0.55, 0.5), at(s * 2.1, 3.12, 7.35), styles.Trim, { Parent = trimFolder })
		add("WingEndplate_" .. side, Vector3.new(0.08, 0.45, 1.2), at(s * 3.1, 3.4, 7.45), styles.Carbon, { Parent = trimFolder })
	end
	add("Wing", Vector3.new(6.2, 0.1, 1.1), at(0, 3.42, 7.45) * CFrame.Angles(math.rad(6), 0, 0), styles.Carbon, { Parent = trimFolder })

	----------------------------------------------------------------------------
	-- Underglow (Phase 3 toggles it)
	----------------------------------------------------------------------------
	local underglow = add("UnderglowStrip", Vector3.new(4.4, 0.06, 13), at(0, 0.56, 0), styles.NeonUnder, { Parent = lightsFolder })
	local underglowLights: { PointLight } = {}
	for i, z in { -4.5, 0, 4.5 } do
		local glow = Instance.new("PointLight")
		glow.Name = "Underglow" .. i
		glow.Range = 10
		glow.Brightness = 2
		glow.Color = rgb(255, 60, 170)
		glow.Shadows = false
		glow.Enabled = false
		local holder = add("UnderglowEmitter" .. i, Vector3.new(0.2, 0.2, 0.2), at(0, 0.4, z), styles.Invisible, { Parent = lightsFolder })
		glow.Parent = holder
		table.insert(underglowLights, glow)
	end
	model:SetAttribute("Underglow", false)
	model:SetAttribute("Hazards", false)

	----------------------------------------------------------------------------
	-- Interior (visible through tint)
	----------------------------------------------------------------------------
	if includeInterior then
		add("Dashboard", Vector3.new(5.0, 0.5, 0.8), at(0, 3.05, -1.4), styles.Dash, { Parent = interiorFolder })
		add("GaugeCluster", Vector3.new(0.9, 0.22, 0.04), at(-1.3, 3.18, -0.98), styles.NeonGauge, { Parent = interiorFolder })
		add("CenterScreen", Vector3.new(1.0, 0.35, 0.04), at(0.25, 3.12, -0.98), styles.NeonScreen, { Parent = interiorFolder })
		add("AmbientStrip", Vector3.new(4.2, 0.03, 0.03), at(0, 3.3, -1.0), styles.NeonGauge, { Parent = interiorFolder })
		local dashGlowHolder = add("DashGlow", Vector3.new(0.2, 0.2, 0.2), at(-0.5, 3.4, -0.6), styles.Invisible, { Parent = interiorFolder })
		local dashGlow = Instance.new("PointLight")
		dashGlow.Range = 4.5
		dashGlow.Brightness = 0.7
		dashGlow.Color = rgb(70, 190, 255)
		dashGlow.Shadows = false
		dashGlow.Parent = dashGlowHolder

		add(
			"SteeringWheel",
			Vector3.new(0.12, 1.0, 1.0),
			at(-1.3, 3.0, -0.72) * CFrame.Angles(math.rad(-25), 0, 0) * PartFactory.AxisZ,
			styles.Dash,
			{ Shape = Enum.PartType.Cylinder, Parent = interiorFolder }
		)
		add("CenterConsole", Vector3.new(0.6, 0.6, 2.2), at(0, 2.95, 0.2), styles.Dash, { Parent = interiorFolder })
		for _, s in SIDES do
			local side = if s < 0 then "L" else "R"
			add(
				"SeatBack_" .. side,
				Vector3.new(1.3, 1.9, 0.35),
				at(s * 1.3, 2.6, 1.6) * CFrame.Angles(math.rad(14), 0, 0),
				styles.Interior,
				{ Parent = interiorFolder }
			)
			add("SeatBolster_" .. side, Vector3.new(1.45, 1.2, 0.2), at(s * 1.3, 2.9, 1.82) * CFrame.Angles(math.rad(14), 0, 0), styles.Interior, { Parent = interiorFolder })
			add("Headrest_" .. side, Vector3.new(0.9, 0.5, 0.3), at(s * 1.3, 3.85, 1.9) * CFrame.Angles(math.rad(14), 0, 0), styles.Interior, { Parent = interiorFolder })
		end
		add("RollBar", Vector3.new(4.8, 0.14, 0.14), at(0, 4.15, 2.3), styles.Gunmetal, { Parent = interiorFolder })
	end

	----------------------------------------------------------------------------
	-- Wheels
	----------------------------------------------------------------------------
	local wheels: { [string]: Model } = {}
	local wheelDefs = {
		{ Name = "FL", X = -2.95, Z = -5.2 },
		{ Name = "FR", X = 2.95, Z = -5.2 },
		{ Name = "RL", X = -2.95, Z = 5.0 },
		{ Name = "RR", X = 2.95, Z = 5.0 },
	}
	for _, def in wheelDefs do
		local s = if def.X < 0 then -1 else 1
		local wheelModel = Instance.new("Model")
		wheelModel.Name = "Wheel_" .. def.Name
		wheelModel.Parent = wheelsFolder
		local centre = at(def.X, 1.3, def.Z)

		local tire = add("Tire", Vector3.new(1.05, 2.6, 2.6), centre, styles.Rubber, {
			Shape = Enum.PartType.Cylinder,
			Collide = true,
			Parent = wheelModel,
		})
		wheelModel.PrimaryPart = tire
		add("Sidewall", Vector3.new(1.07, 2.25, 2.25), centre, PartFactory.style(rgb(30, 30, 32), RUBBER, 0), {
			Shape = Enum.PartType.Cylinder,
			Parent = wheelModel,
		})
		add("RimBarrel", Vector3.new(1.09, 1.85, 1.85), centre, styles.RimShadow, {
			Shape = Enum.PartType.Cylinder,
			Parent = wheelModel,
		})
		add("RimLip", Vector3.new(0.05, 1.95, 1.95), centre * CFrame.new(s * 0.53, 0, 0), styles.Chrome, {
			Shape = Enum.PartType.Cylinder,
			Parent = wheelModel,
		})
		for i = 0, 4 do
			add(
				"Spoke" .. i,
				Vector3.new(0.08, 0.16, 1.72),
				centre * CFrame.new(s * 0.56, 0, 0) * CFrame.Angles(math.rad(i * 36), 0, 0),
				styles.Gunmetal,
				{ Parent = wheelModel }
			)
		end
		add("Hub", Vector3.new(0.14, 0.55, 0.55), centre * CFrame.new(s * 0.58, 0, 0), styles.Chrome, {
			Shape = Enum.PartType.Cylinder,
			Parent = wheelModel,
		})
		add("CenterCap", Vector3.new(0.16, 0.28, 0.28), centre * CFrame.new(s * 0.6, 0, 0), styles.PaintAccent, {
			Shape = Enum.PartType.Cylinder,
			Parent = wheelModel,
		})
		wheels[def.Name] = wheelModel
	end

	----------------------------------------------------------------------------
	-- Anchors for other systems
	----------------------------------------------------------------------------
	local engineBay = add("EngineBay", Vector3.new(1, 1, 1), at(0, 1.6, -5.5), styles.Invisible, { Parent = model })

	model.Parent = nil
	return {
		Model = model,
		Root = root,
		Wheels = wheels,
		HeadlightLights = headlightLights,
		HeadlightBeams = headlightBeams,
		HeadlightLenses = headlightLenses,
		BrakeLights = brakeLights,
		BrakeLightSources = brakeSources,
		Exhausts = exhausts,
		UnderglowStrip = underglow,
		UnderglowLights = underglowLights,
		EngineBay = engineBay,
		TrunkLid = trunkLid,
	}
end

-- 0 = running lights, 1 = full brake.
function GetawayCarBody.setBrakeIntensity(handles: CarHandles, alpha: number)
	local a = math.clamp(alpha, 0, 1)
	for _, part in handles.BrakeLights do
		part.Transparency = BRAKE_IDLE_TRANSPARENCY * (1 - a)
	end
	for _, light in handles.BrakeLightSources do
		light.Brightness = BRAKE_IDLE_BRIGHTNESS + (BRAKE_FULL_BRIGHTNESS - BRAKE_IDLE_BRIGHTNESS) * a
	end
end

function GetawayCarBody.setHeadlights(handles: CarHandles, on: boolean)
	for _, light in handles.HeadlightLights do
		light.Enabled = on
	end
	for _, beam in handles.HeadlightBeams do
		beam.Enabled = on
	end
	for _, lens in handles.HeadlightLenses do
		lens.Material = if on then Enum.Material.Neon else Enum.Material.Glass
	end
end

function GetawayCarBody.setUnderglow(handles: CarHandles, on: boolean)
	handles.UnderglowStrip.Transparency = if on then 0.2 else 1
	for _, light in handles.UnderglowLights do
		light.Enabled = on
	end
	handles.Model:SetAttribute("Underglow", on)
end

return GetawayCarBody
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000004"><Properties><string name="Name">PartFactory</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	PartFactory
	Every procedural part in the game goes through here so surfaces, shadow
	casting and collision defaults stay consistent across builders.
]]

export type Style = {
	Color: Color3,
	Material: Enum.Material,
	Reflectance: number?,
	Transparency: number?,
	CastShadow: boolean?,
}

export type Spec = {
	Name: string,
	Size: Vector3,
	CFrame: CFrame,
	Style: Style,
	Class: ("Part" | "WedgePart" | "CornerWedgePart")?,
	Shape: Enum.PartType?,
	CanCollide: boolean?,
	Anchored: boolean?,
	Parent: Instance?,
}

local PartFactory = {}

-- Rotations that turn a Cylinder (axis = local X) onto other axes.
PartFactory.AxisY = CFrame.Angles(0, 0, math.rad(90))
PartFactory.AxisZ = CFrame.Angles(0, math.rad(90), 0)

-- Resolves newer materials by name and falls back on older engines.
function PartFactory.material(name: string, fallback: Enum.Material): Enum.Material
	local ok, result = pcall(function(): any
		return (Enum.Material :: any)[name]
	end)
	if ok and typeof(result) == "EnumItem" then
		return result :: Enum.Material
	end
	return fallback
end

function PartFactory.style(
	color: Color3,
	material: Enum.Material,
	reflectance: number?,
	transparency: number?,
	castShadow: boolean?
): Style
	return {
		Color = color,
		Material = material,
		Reflectance = reflectance,
		Transparency = transparency,
		CastShadow = castShadow,
	}
end

function PartFactory.make(spec: Spec): BasePart
	local part: BasePart
	if spec.Class == "WedgePart" then
		part = Instance.new("WedgePart")
	elseif spec.Class == "CornerWedgePart" then
		part = Instance.new("CornerWedgePart")
	else
		local basic = Instance.new("Part")
		if spec.Shape then
			basic.Shape = spec.Shape
		end
		part = basic
	end

	local style = spec.Style
	part.Name = spec.Name
	part.Size = spec.Size
	part.CFrame = spec.CFrame
	part.Color = style.Color
	part.Material = style.Material
	part.Reflectance = style.Reflectance or 0
	part.Transparency = style.Transparency or 0
	part.CastShadow = if style.CastShadow == nil then true else style.CastShadow
	part.Anchored = if spec.Anchored == nil then true else spec.Anchored
	part.CanCollide = spec.CanCollide == true
	-- Invisible helpers (light emitters, rigs, roots) never block raycasts.
	part.CanQuery = part.CanCollide or (style.Transparency or 0) < 1
	part.CanTouch = false
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = spec.Parent
	return part
end

function PartFactory.weld(part0: BasePart, part1: BasePart): WeldConstraint
	local weld = Instance.new("WeldConstraint")
	weld.Name = "Weld_" .. part1.Name
	weld.Part0 = part0
	weld.Part1 = part1
	weld.Parent = part1
	return weld
end

-- Thin straight segment between two world points (cables, rails, braces).
function PartFactory.segment(
	name: string,
	from: Vector3,
	to: Vector3,
	thickness: number,
	style: Style,
	parent: Instance
): BasePart
	local length = (to - from).Magnitude
	local mid = (from + to) / 2
	return PartFactory.make({
		Name = name,
		Size = Vector3.new(thickness, thickness, math.max(length, 0.05)),
		CFrame = CFrame.lookAt(mid, to),
		Style = style,
		Parent = parent,
	})
end

function PartFactory.folder(name: string, parent: Instance): Folder
	local folder = Instance.new("Folder")
	folder.Name = name
	folder.Parent = parent
	return folder
end

return PartFactory
]]></ProtectedString></Properties></Item></Item><Item class="ModuleScript" referent="RBX000006"><Properties><string name="Name">Config</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Config
	Single source of truth for every tunable shared by server and client.
	Change values here; no other file hard-codes gameplay or look-dev numbers.
]]

local Types = require(script.Parent.Types)

local Config = {}

--------------------------------------------------------------------------------
-- Branding
--------------------------------------------------------------------------------
Config.Branding = {
	Title = "ZABOUR",
	Subtitle = "TACTICAL EXTRACTION",
	Location = "SAFEHOUSE  //  SECTOR 7",
	Build = "BUILD 0.1.0  ·  PHASE 1",
	PlateText = "ZBR 077",
	SignText = "ZABOUR  24H",
}

--------------------------------------------------------------------------------
-- World layout
--------------------------------------------------------------------------------
Config.World = {
	SafehouseName = "Safehouse",
	CarName = "Zabour",
	-- Everything in the safehouse is built relative to this frame.
	-- Lifted 0.2 studs so a leftover template Baseplate (top at y=0) cannot z-fight.
	Origin = CFrame.new(0, 0.2, 0),
	-- Car pose inside the safehouse (relative to Origin). Front faces the menu camera.
	CarPose = CFrame.new(-2, 0, 5) * CFrame.Angles(0, math.rad(-25), 0),
}

--------------------------------------------------------------------------------
-- Lighting / post-processing (gameplay grade). Applied by LightingService.
--------------------------------------------------------------------------------
Config.Lighting = {
	ClockTime = 18.35,
	GeographicLatitude = 38,
	Brightness = 1.6,
	ExposureCompensation = -0.15,
	EnvironmentDiffuseScale = 0.85,
	EnvironmentSpecularScale = 1.0,
	ShadowSoftness = 0.2,
	Ambient = Color3.fromRGB(22, 24, 30),
	OutdoorAmbient = Color3.fromRGB(70, 74, 86),
	ColorShiftTop = Color3.fromRGB(255, 196, 150),
	ColorShiftBottom = Color3.fromRGB(30, 40, 58),

	Atmosphere = {
		Density = 0.42,
		Offset = 0.18,
		Color = Color3.fromRGB(128, 134, 146),
		Decay = Color3.fromRGB(92, 80, 72),
		Glare = 0.12,
		Haze = 2.2,
	},
	Clouds = {
		Cover = 0.82,
		Density = 0.75,
		Color = Color3.fromRGB(104, 110, 122),
	},
	ColorCorrection = {
		Brightness = -0.03,
		Contrast = 0.2,
		Saturation = -0.25,
		TintColor = Color3.fromRGB(255, 243, 230),
	},
	Bloom = {
		Intensity = 0.7,
		Size = 30,
		Threshold = 1.35,
	},
	SunRays = {
		Intensity = 0.035,
		Spread = 0.6,
	},
	DepthOfField = {
		FarIntensity = 0.18,
		FocusDistance = 55,
		InFocusRadius = 70,
		NearIntensity = 0,
	},
}

-- Menu grade: the client blends from this to Config.Lighting while deploying.
Config.MenuGrade = {
	FarIntensity = 0.55,
	NearIntensity = 0.7,
	Contrast = 0.26,
	Saturation = -0.32,
	ExposureCompensation = -0.25,
}

--------------------------------------------------------------------------------
-- Cameras
--------------------------------------------------------------------------------
Config.Camera = {
	Menu = {
		BreathPosition = 0.12, -- studs
		BreathRotation = 0.45, -- degrees
		BreathSpeed = 0.16, -- noise frequency multiplier
		ParallaxYaw = 2.0, -- degrees at screen edge
		ParallaxPitch = 1.2,
		ParallaxFrequency = 1.1, -- spring Hz
		ShotTransitionTime = 1.6,
		DeployPushIn = 1.6, -- studs of dolly while the server spawns you
	},
	DeployTransitionTime = 2.1,
	Tactical = {
		PivotHeight = 1.55,
		ShoulderOffset = Vector3.new(1.85, 0.45, 6.4), -- right, up, back
		MinPitch = -70,
		MaxPitch = 65,
		CollisionRadius = 0.35,
		PivotFrequency = 11, -- spring Hz for follow
		ShoulderFrequency = 4.2,
		ShoulderDamping = 0.82,
		FovFrequency = 3.5,
		MouseRadiansPerPixel = 0.0032,
		GamepadRadiansPerSecond = 4.2,
		GamepadDeadzone = 0.15,
		BodyResponsiveness = 35,
		RollPerStudPerSecond = 0.0045, -- radians of roll per stud/s of strafe speed
		MaxRoll = math.rad(1.2),
		CloseFadeStart = 2.2,
		CloseFadeEnd = 0.9,
	},
}

Config.Keybinds = {
	ShoulderSwap = { Enum.KeyCode.V, Enum.KeyCode.DPadRight },
	MenuUp = { Enum.KeyCode.Up, Enum.KeyCode.W, Enum.KeyCode.DPadUp },
	MenuDown = { Enum.KeyCode.Down, Enum.KeyCode.S, Enum.KeyCode.DPadDown },
	MenuLeft = { Enum.KeyCode.Left, Enum.KeyCode.A, Enum.KeyCode.DPadLeft },
	MenuRight = { Enum.KeyCode.Right, Enum.KeyCode.D, Enum.KeyCode.DPadRight },
	MenuSelect = { Enum.KeyCode.Return, Enum.KeyCode.KeypadEnter, Enum.KeyCode.ButtonA },
	MenuBack = { Enum.KeyCode.Backspace, Enum.KeyCode.ButtonB },
}

--------------------------------------------------------------------------------
-- Settings
--------------------------------------------------------------------------------
local DEFAULT_SETTINGS: Types.PlayerSettings = {
	Quality = "High",
	FieldOfView = 72,
	Sensitivity = 1.0,
}

local QUALITY_LEVELS: { Types.QualityLevel } = { "Low", "Medium", "High", "Ultra" }

Config.Settings = {
	Defaults = DEFAULT_SETTINGS,
	QualityLevels = QUALITY_LEVELS,
	FovMin = 60,
	FovMax = 100,
	SensitivityMin = 0.1,
	SensitivityMax = 3.0,
	SaveDebounce = 1.25,
	ServerSaveCooldown = 0.5,
}

local QUALITY_PRESETS: { [Types.QualityLevel]: Types.QualityPreset } = {
	Low = {
		RainRate = 180,
		Splashes = false,
		GroundMist = false,
		Beams = false,
		SunRays = false,
		DepthOfField = false,
		BloomScale = 0.6,
		Lightning = true,
		ExhaustSmoke = false,
		LightShadows = false,
	},
	Medium = {
		RainRate = 420,
		Splashes = true,
		GroundMist = false,
		Beams = true,
		SunRays = false,
		DepthOfField = true,
		BloomScale = 0.85,
		Lightning = true,
		ExhaustSmoke = true,
		LightShadows = true,
	},
	High = {
		RainRate = 750,
		Splashes = true,
		GroundMist = true,
		Beams = true,
		SunRays = true,
		DepthOfField = true,
		BloomScale = 1,
		Lightning = true,
		ExhaustSmoke = true,
		LightShadows = true,
	},
	Ultra = {
		RainRate = 1100,
		Splashes = true,
		GroundMist = true,
		Beams = true,
		SunRays = true,
		DepthOfField = true,
		BloomScale = 1.1,
		Lightning = true,
		ExhaustSmoke = true,
		LightShadows = true,
	},
}
Config.Quality = QUALITY_PRESETS

--------------------------------------------------------------------------------
-- Weather
--------------------------------------------------------------------------------
Config.Weather = {
	RainAreaSize = 90,
	RainHeight = 32,
	RainSpeed = NumberRange.new(85, 110),
	Wind = Vector3.new(6, 0, 3),
	LightningInterval = NumberRange.new(16, 42),
	ThunderDelay = NumberRange.new(0.6, 2.6),
}

--------------------------------------------------------------------------------
-- Weapons (Phase 2 builds models + gunplay from these definitions)
--------------------------------------------------------------------------------
local WEAPONS: { [string]: Types.WeaponDef } = {
	SuppressedRifle = {
		DisplayName = "VK-9 SUPPRESSED",
		Class = "RIFLE",
		Slot = "Primary",
		Description = "Integrally suppressed 5.56 carbine with holographic optic. Quiet, accurate, deliberate.",
		Stats = { Damage = 0.62, FireRate = 0.68, Handling = 0.52, Range = 0.84 },
		Order = 1,
	},
	CompactSMG = {
		DisplayName = "KR-45 COMPACT",
		Class = "SMG",
		Slot = "Primary",
		Description = "Short-barrel .45 SMG with folding stock. Brutal up close, falls off fast.",
		Stats = { Damage = 0.48, FireRate = 0.92, Handling = 0.86, Range = 0.38 },
		Order = 2,
	},
	HeavyPistol = {
		DisplayName = "M-50 HEAVY",
		Class = "PISTOL",
		Slot = "Secondary",
		Description = "Full-size .50 sidearm with micro red-dot. Two taps, one problem.",
		Stats = { Damage = 0.82, FireRate = 0.34, Handling = 0.66, Range = 0.55 },
		Order = 1,
	},
}
Config.Weapons = WEAPONS

local DEFAULT_LOADOUT: Types.Loadout = {
	Primary = "SuppressedRifle",
	Secondary = "HeavyPistol",
}
Config.DefaultLoadout = DEFAULT_LOADOUT

--------------------------------------------------------------------------------
-- Persistence
--------------------------------------------------------------------------------
Config.Data = {
	StoreName = "ZabourProfiles_v1",
	KeyPrefix = "u_",
	SchemaVersion = 1,
	AutosaveInterval = 120,
	Retries = 4,
	ProfileWaitTimeout = 15,
}

--------------------------------------------------------------------------------
-- Deploy flow
--------------------------------------------------------------------------------
Config.Deploy = {
	RequestCooldown = 2.0,
	ReturnToMenuDelay = 4.0,
	SpawnTimeout = 12,
}

--------------------------------------------------------------------------------
-- Audio
-- Built-in rbxasset:// sounds ship with every Roblox client. Rain / thunder /
-- engine need Creator Store audio you have rights to: paste "rbxassetid://<id>".
-- Empty ids are skipped cleanly (one warning lists what is missing).
--------------------------------------------------------------------------------
local AUDIO: { [string]: Types.AudioDef } = {
	UIHover = { Id = "rbxasset://sounds/clickfast.wav", Volume = 0.22, Speed = 1.7, Group = "UI" },
	UIClick = { Id = "rbxasset://sounds/button.wav", Volume = 0.32, Speed = 1.15, Group = "UI" },
	UIBack = { Id = "rbxasset://sounds/button.wav", Volume = 0.26, Speed = 0.85, Group = "UI" },
	UIDeploy = { Id = "rbxasset://sounds/swoosh.wav", Volume = 0.5, Speed = 0.7, Group = "UI" },
	UITick = { Id = "rbxasset://sounds/clickfast.wav", Volume = 0.12, Speed = 2.4, Group = "UI" },
	RainLoop = { Id = "", Volume = 0.45, Speed = 1, Group = "Ambience" },
	Thunder = { Id = "", Volume = 0.6, Speed = 1, Group = "Ambience" },
	EngineIdle = { Id = "", Volume = 0.55, Speed = 1, Group = "World" },
}
Config.Audio = AUDIO

Config.CoreGui = {
	-- CoreGui types re-enabled once deployed. Everything else stays hidden.
	Gameplay = { Enum.CoreGuiType.Chat },
}

return Config
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000007"><Properties><string name="Name">Net</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Net
	Owns every RemoteEvent / RemoteFunction. The server creates them once in
	Net.init(); both sides fetch them by name through Net.event / Net.func.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local FOLDER_NAME = "Remotes"
local CLIENT_TIMEOUT = 30

local Net = {}

Net.Events = {
	RequestDeploy = "RequestDeploy",
	SetLoadout = "SetLoadout",
	SaveSettings = "SaveSettings",
}

Net.Functions = {
	GetProfile = "GetProfile",
}

local function getFolder(): Instance
	if RunService:IsServer() then
		local existing = ReplicatedStorage:FindFirstChild(FOLDER_NAME)
		if existing then
			return existing
		end
		local folder = Instance.new("Folder")
		folder.Name = FOLDER_NAME
		folder.Parent = ReplicatedStorage
		return folder
	end
	local folder = ReplicatedStorage:WaitForChild(FOLDER_NAME, CLIENT_TIMEOUT)
	if not folder then
		error("[Net] Remotes folder never replicated — is the server Bootstrap running?")
	end
	return folder
end

local function fetch(name: string): Instance
	local folder = getFolder()
	local instance: Instance? = if RunService:IsServer()
		then folder:FindFirstChild(name)
		else folder:WaitForChild(name, CLIENT_TIMEOUT)
	if not instance then
		error(string.format("[Net] remote '%s' does not exist", name))
	end
	return instance
end

function Net.init()
	assert(RunService:IsServer(), "[Net] init() is server-only")
	local folder = getFolder()
	for _, name in Net.Events do
		if not folder:FindFirstChild(name) then
			local remote = Instance.new("RemoteEvent")
			remote.Name = name
			remote.Parent = folder
		end
	end
	for _, name in Net.Functions do
		if not folder:FindFirstChild(name) then
			local remote = Instance.new("RemoteFunction")
			remote.Name = name
			remote.Parent = folder
		end
	end
end

function Net.event(name: string): RemoteEvent
	local instance = fetch(name)
	if instance:IsA("RemoteEvent") then
		return instance
	end
	error(string.format("[Net] '%s' is not a RemoteEvent", name))
end

function Net.func(name: string): RemoteFunction
	local instance = fetch(name)
	if instance:IsA("RemoteFunction") then
		return instance
	end
	error(string.format("[Net] '%s' is not a RemoteFunction", name))
end

return Net
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000008"><Properties><string name="Name">Schema</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Schema
	Validation + sanitising for anything that crosses the network or comes
	out of a DataStore. Server and client run the exact same rules.
]]

local Config = require(script.Parent.Config)
local Types = require(script.Parent.Types)

local Schema = {}

local function isFiniteNumber(value: any): boolean
	return typeof(value) == "number" and value == value and value ~= math.huge and value ~= -math.huge
end
Schema.isFiniteNumber = isFiniteNumber

function Schema.isQuality(value: any): boolean
	if typeof(value) ~= "string" then
		return false
	end
	return table.find(Config.Settings.QualityLevels, value :: any) ~= nil
end

function Schema.sanitizeSettings(raw: any, fallback: Types.PlayerSettings): Types.PlayerSettings
	local result: Types.PlayerSettings = {
		Quality = fallback.Quality,
		FieldOfView = fallback.FieldOfView,
		Sensitivity = fallback.Sensitivity,
	}
	if typeof(raw) ~= "table" then
		return result
	end

	if Schema.isQuality(raw.Quality) then
		result.Quality = raw.Quality
	end
	if isFiniteNumber(raw.FieldOfView) then
		result.FieldOfView = math.clamp(math.round(raw.FieldOfView), Config.Settings.FovMin, Config.Settings.FovMax)
	end
	if isFiniteNumber(raw.Sensitivity) then
		local rounded = math.round(raw.Sensitivity * 100) / 100
		result.Sensitivity = math.clamp(rounded, Config.Settings.SensitivityMin, Config.Settings.SensitivityMax)
	end
	return result
end

function Schema.isWeaponForSlot(slot: any, weaponId: any): boolean
	if typeof(slot) ~= "string" or typeof(weaponId) ~= "string" then
		return false
	end
	local def = Config.Weapons[weaponId]
	return def ~= nil and def.Slot == slot
end

function Schema.sanitizeLoadout(raw: any, fallback: Types.Loadout): Types.Loadout
	local result: Types.Loadout = {
		Primary = fallback.Primary,
		Secondary = fallback.Secondary,
	}
	if typeof(raw) ~= "table" then
		return result
	end
	if Schema.isWeaponForSlot("Primary", raw.Primary) then
		result.Primary = raw.Primary
	end
	if Schema.isWeaponForSlot("Secondary", raw.Secondary) then
		result.Secondary = raw.Secondary
	end
	return result
end

function Schema.weaponsForSlot(slot: Types.WeaponSlot): { string }
	local ids: { string } = {}
	for id, def in Config.Weapons do
		if def.Slot == slot then
			table.insert(ids, id)
		end
	end
	table.sort(ids, function(a: string, b: string): boolean
		return Config.Weapons[a].Order < Config.Weapons[b].Order
	end)
	return ids
end

return Schema
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000009"><Properties><string name="Name">Signal</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Signal
	Lightweight pure-Luau signal. Handlers run in their own thread so a
	yielding or erroring listener never blocks the emitter.
]]

export type Connection = {
	Connected: boolean,
	Disconnect: (self: Connection) -> (),
}

export type Signal = {
	Connect: (self: Signal, handler: (...any) -> ()) -> Connection,
	Once: (self: Signal, handler: (...any) -> ()) -> Connection,
	Fire: (self: Signal, ...any) -> (),
	Wait: (self: Signal) -> ...any,
	DisconnectAll: (self: Signal) -> (),
}

type Record = {
	Handler: (...any) -> (),
	Connected: boolean,
}

local Signal = {}

function Signal.new(): Signal
	local records: { Record } = {}

	local function connect(handler: (...any) -> ()): Connection
		local record: Record = { Handler = handler, Connected = true }
		table.insert(records, record)

		local connection: Connection
		connection = {
			Connected = true,
			Disconnect = function(_self: Connection)
				if not record.Connected then
					return
				end
				record.Connected = false
				connection.Connected = false
				local index = table.find(records, record)
				if index then
					table.remove(records, index)
				end
			end,
		}
		return connection
	end

	local signal: Signal
	signal = {
		Connect = function(_self: Signal, handler: (...any) -> ()): Connection
			return connect(handler)
		end,

		Once = function(_self: Signal, handler: (...any) -> ()): Connection
			local connection: Connection
			connection = connect(function(...: any)
				connection:Disconnect()
				handler(...)
			end)
			return connection
		end,

		Fire = function(_self: Signal, ...: any)
			local snapshot = table.clone(records)
			for _, record in snapshot do
				if record.Connected then
					task.spawn(record.Handler, ...)
				end
			end
		end,

		Wait = function(_self: Signal): ...any
			local thread = coroutine.running()
			signal:Once(function(...: any)
				task.spawn(thread, ...)
			end)
			return coroutine.yield()
		end,

		DisconnectAll = function(_self: Signal)
			for _, record in records do
				record.Connected = false
			end
			table.clear(records)
		end,
	}
	return signal
end

return Signal
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000010"><Properties><string name="Name">Spring</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Spring
	Damped harmonic spring on Vector3 (use the X component for scalars).
	Integrated with fixed sub-steps so it stays stable at any frame rate.

		local s = Spring.new(Vector3.zero, 6, 0.8) -- 6 Hz, damping ratio 0.8
		s.Target = Vector3.new(1, 0, 0)
		local p = s:update(dt)
		s:impulse(Vector3.new(0, 4, 0)) -- add velocity (recoil kicks, bumps)
]]

local SUBSTEP = 1 / 240
local MAX_DT = 0.1

local SpringClass = {}
SpringClass.__index = SpringClass

type SpringData = {
	Position: Vector3,
	Velocity: Vector3,
	Target: Vector3,
	Frequency: number,
	Damping: number,
}

export type Spring = typeof(setmetatable({} :: SpringData, SpringClass))

function SpringClass.new(initial: Vector3, frequency: number, damping: number): Spring
	local data: SpringData = {
		Position = initial,
		Velocity = Vector3.zero,
		Target = initial,
		Frequency = frequency,
		Damping = damping,
	}
	return setmetatable(data, SpringClass)
end

function SpringClass.update(self: Spring, dt: number): Vector3
	local remaining = math.min(dt, MAX_DT)
	local omega = self.Frequency * 2 * math.pi
	local stiffness = omega * omega
	local damping = 2 * self.Damping * omega

	local position = self.Position
	local velocity = self.Velocity
	local target = self.Target

	while remaining > 1e-6 do
		local h = math.min(SUBSTEP, remaining)
		local acceleration = (target - position) * stiffness - velocity * damping
		velocity += acceleration * h
		position += velocity * h
		remaining -= h
	end

	self.Position = position
	self.Velocity = velocity
	return position
end

function SpringClass.impulse(self: Spring, velocity: Vector3)
	self.Velocity += velocity
end

function SpringClass.reset(self: Spring, value: Vector3)
	self.Position = value
	self.Target = value
	self.Velocity = Vector3.zero
end

return SpringClass
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000011"><Properties><string name="Name">Trove</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Trove
	Collects connections, instances, threads and cleanup callbacks so a whole
	feature can be torn down with one Clean() call.
]]

export type Trove = {
	Add: (self: Trove, item: any) -> any,
	Connect: (self: Trove, signal: RBXScriptSignal, handler: (...any) -> ()) -> RBXScriptConnection,
	BindToRenderStep: (self: Trove, name: string, priority: number, fn: (dt: number) -> ()) -> (),
	Clean: (self: Trove) -> (),
}

local RunService = game:GetService("RunService")

local Trove = {}

local function cleanItem(item: any)
	local kind = typeof(item)
	if kind == "RBXScriptConnection" then
		(item :: RBXScriptConnection):Disconnect()
	elseif kind == "Instance" then
		(item :: Instance):Destroy()
	elseif kind == "function" then
		(item :: () -> ())()
	elseif kind == "thread" then
		local thread = item :: thread
		if coroutine.status(thread) ~= "dead" then
			pcall(task.cancel, thread)
		end
	elseif kind == "table" then
		if typeof(item.Destroy) == "function" then
			item:Destroy()
		elseif typeof(item.Disconnect) == "function" then
			item:Disconnect()
		elseif typeof(item.Clean) == "function" then
			item:Clean()
		end
	end
end

function Trove.new(): Trove
	local items: { any } = {}

	local trove: Trove
	trove = {
		Add = function(_self: Trove, item: any): any
			table.insert(items, item)
			return item
		end,

		Connect = function(_self: Trove, signal: RBXScriptSignal, handler: (...any) -> ()): RBXScriptConnection
			local connection = signal:Connect(handler)
			table.insert(items, connection)
			return connection
		end,

		BindToRenderStep = function(_self: Trove, name: string, priority: number, fn: (dt: number) -> ())
			RunService:BindToRenderStep(name, priority, fn)
			table.insert(items, function()
				RunService:UnbindFromRenderStep(name)
			end)
		end,

		Clean = function(_self: Trove)
			-- Clean in reverse so later dependents go first.
			for index = #items, 1, -1 do
				local item = items[index]
				items[index] = nil
				local ok, err = pcall(cleanItem, item)
				if not ok then
					warn("[Trove] cleanup error:", err)
				end
			end
		end,
	}
	return trove
end

return Trove
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000012"><Properties><string name="Name">Types</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Types
	Shared type contracts between server and client. No runtime dependencies.
]]

export type QualityLevel = "Low" | "Medium" | "High" | "Ultra"

export type PlayerState = "Menu" | "Deploying" | "Deployed"

export type WeaponSlot = "Primary" | "Secondary"

export type PlayerSettings = {
	Quality: QualityLevel,
	FieldOfView: number,
	Sensitivity: number,
}

export type Loadout = {
	Primary: string,
	Secondary: string,
}

export type WeaponStats = {
	Damage: number,
	FireRate: number,
	Handling: number,
	Range: number,
}

export type WeaponDef = {
	DisplayName: string,
	Class: string,
	Slot: WeaponSlot,
	Description: string,
	Stats: WeaponStats,
	Order: number,
}

export type ProfileData = {
	Version: number,
	Settings: PlayerSettings,
	Loadout: Loadout,
	Stash: { [string]: number },
	StashValue: number,
}

export type ClientProfile = {
	Settings: PlayerSettings,
	Loadout: Loadout,
	StashValue: number,
}

export type AudioDef = {
	Id: string,
	Volume: number,
	Speed: number,
	Group: "UI" | "Ambience" | "World",
}

export type QualityPreset = {
	RainRate: number,
	Splashes: boolean,
	GroundMist: boolean,
	Beams: boolean,
	SunRays: boolean,
	DepthOfField: boolean,
	BloomScale: number,
	Lightning: boolean,
	ExhaustSmoke: boolean,
	LightShadows: boolean,
}

return {}
]]></ProtectedString></Properties></Item></Item></Item><Item class="ServerScriptService" referent="RBX000023"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Folder" referent="RBX000022"><Properties><string name="Name">Server</string></Properties><Item class="Script" referent="RBX000015"><Properties><string name="Name">Bootstrap</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Bootstrap (Script)
	Server entry point. Order matters:
	  1. Remotes exist before any client asks for them.
	  2. Look-dev + safehouse exist before the first player's camera needs them.
	  3. Data + deploy services start listening for players.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage.Shared.Net)
local LightingService = require(script.Parent.Services.LightingService)
local PlayerDataService = require(script.Parent.Services.PlayerDataService)
local DeployService = require(script.Parent.Services.DeployService)
local SafehouseBuilder = require(script.Parent.World.SafehouseBuilder)

Net.init()
LightingService.apply()
local safehouse = SafehouseBuilder.ensure(false)
PlayerDataService.init()
DeployService.init(safehouse)

print("[Bootstrap] Phase 1 server ready.")
]]></ProtectedString></Properties></Item><Item class="Folder" referent="RBX000019"><Properties><string name="Name">Services</string></Properties><Item class="ModuleScript" referent="RBX000016"><Properties><string name="Name">DeployService</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	DeployService
	Server-authoritative player state machine:

		Menu  --(RequestDeploy)-->  Deploying  --(character spawned)-->  Deployed
		  ^                                                                  |
		  +------------------(death, after ReturnToMenuDelay)----------------+

	Characters never auto-load: you only exist in the world after DEPLOY.
	State is replicated through the "State" player attribute.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local Types = require(Shared.Types)

local DeployService = {}

local deployPoints: { BasePart } = {}
local pointCursor = 0
local lastRequest: { [Player]: number } = {}

local function setState(player: Player, state: Types.PlayerState)
	player:SetAttribute("State", state)
end

local function getState(player: Player): string?
	local value = player:GetAttribute("State")
	return if typeof(value) == "string" then value else nil
end

local function nextDeployCFrame(): CFrame
	if #deployPoints == 0 then
		return Config.World.Origin * CFrame.new(5, 3.5, -2)
	end
	pointCursor = pointCursor % #deployPoints + 1
	local point = deployPoints[pointCursor]
	-- HumanoidRootPart centre ≈ 3 studs above the floor for R15 / R6.
	return point.CFrame + Vector3.new(0, 3.2, 0)
end

local function returnToMenu(player: Player, character: Model)
	if player.Parent == nil or player.Character ~= character then
		return
	end
	player.Character = nil
	character:Destroy()
	setState(player, "Menu")
end

local function watchCharacter(player: Player, character: Model)
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end
	humanoid.Died:Once(function()
		task.delay(Config.Deploy.ReturnToMenuDelay, returnToMenu, player, character)
	end)
	-- Character removed some other way (kick, LoadCharacter elsewhere).
	character.AncestryChanged:Connect(function(_, parent)
		if parent == nil and player.Parent and player.Character == nil and getState(player) == "Deployed" then
			setState(player, "Menu")
		end
	end)
end

local function onDeployRequest(player: Player)
	if getState(player) ~= "Menu" then
		return
	end
	local now = os.clock()
	if (lastRequest[player] or -math.huge) + Config.Deploy.RequestCooldown > now then
		return
	end
	lastRequest[player] = now
	setState(player, "Deploying")

	local spawnCF = nextDeployCFrame()
	local placement = player.CharacterAdded:Connect(function(character: Model)
		character:PivotTo(spawnCF)
	end)
	local ok, err = pcall(function()
		player:LoadCharacter()
	end)
	placement:Disconnect()

	local character = player.Character
	if not ok or not character or not player.Parent then
		warn("[Deploy] spawn failed for", player.Name, err)
		if player.Parent then
			setState(player, "Menu")
		end
		return
	end

	-- Re-assert placement in case appearance loading moved the rig.
	if (character:GetPivot().Position - spawnCF.Position).Magnitude > 4 then
		character:PivotTo(spawnCF)
	end
	watchCharacter(player, character)
	setState(player, "Deployed")
end

function DeployService.init(safehouse: Model)
	Players.CharacterAutoLoads = false

	local folder = safehouse:FindFirstChild("DeployPoints")
	if folder then
		for _, child in folder:GetChildren() do
			if child:IsA("BasePart") then
				table.insert(deployPoints, child)
			end
		end
		table.sort(deployPoints, function(a: BasePart, b: BasePart): boolean
			return a.Name < b.Name
		end)
	else
		warn("[Deploy] Safehouse has no DeployPoints folder; using fallback spawn.")
	end

	local function onPlayerAdded(player: Player)
		-- If CharacterAutoLoads was still on when this player joined, remove
		-- the stray rig so everyone starts in the menu.
		local stray = player.Character
		if stray then
			player.Character = nil
			stray:Destroy()
		end
		setState(player, "Menu")
	end
	Players.PlayerAdded:Connect(onPlayerAdded)
	for _, player in Players:GetPlayers() do
		onPlayerAdded(player)
	end
	Players.PlayerRemoving:Connect(function(player: Player)
		lastRequest[player] = nil
	end)

	Net.event(Net.Events.RequestDeploy).OnServerEvent:Connect(onDeployRequest)
end

return DeployService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000017"><Properties><string name="Name">LightingService</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	LightingService
	Applies the gritty dusk/overcast look-dev to Lighting, MaterialService,
	Terrain clouds and the post-processing stack.

	Works from the server at runtime AND from the Studio Command Bar:
		require(game.ServerScriptService.Server.Services.LightingService).apply()

	Some engine properties are not writable from scripts on every Studio
	build (Lighting.Technology is the usual one). Those writes are attempted
	safely, and anything that failed is printed so you can set it once in
	the Properties panel.
]]

local Lighting = game:GetService("Lighting")
local MaterialService = game:GetService("MaterialService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)

local LightingService = {}

-- Stable names so the client can find and blend the effects.
LightingService.EffectNames = {
	ColorCorrection = "Grade_ColorCorrection",
	Bloom = "Grade_Bloom",
	DepthOfField = "Grade_DepthOfField",
	SunRays = "Grade_SunRays",
	ColorGrading = "Grade_Tonemap",
}

local function trySet(instance: Instance, property: string, value: any, failures: { string })
	local ok = pcall(function()
		(instance :: any)[property] = value
	end)
	if not ok then
		table.insert(failures, string.format("%s.%s = %s", instance.ClassName, property, tostring(value)))
	end
end

local function trySetEnum(instance: Instance, property: string, enumName: string, itemName: string, failures: { string })
	local ok, item = pcall(function(): any
		return ((Enum :: any)[enumName] :: any)[itemName]
	end)
	if ok and item ~= nil then
		trySet(instance, property, item, failures)
	else
		table.insert(failures, string.format("%s.%s = %s (enum unavailable)", instance.ClassName, property, itemName))
	end
end

-- Reuses an existing child of the class (e.g. the template's Bloom) and
-- disables duplicates so effects never stack unpredictably.
local function ensureSingle(parent: Instance, className: string, name: string): Instance
	local chosen: Instance? = parent:FindFirstChild(name)
	if chosen and chosen.ClassName ~= className then
		chosen = nil
	end
	for _, child in parent:GetChildren() do
		if child.ClassName == className then
			if chosen == nil then
				chosen = child
			elseif child ~= chosen then
				pcall(function()
					(child :: any).Enabled = false
				end)
			end
		end
	end
	if chosen == nil then
		local created = Instance.new(className :: any)
		created.Parent = parent
		chosen = created
	end
	local result = chosen :: Instance
	result.Name = name
	return result
end

function LightingService.apply(): { string }
	local failures: { string } = {}
	local L = Config.Lighting

	-- Renderer
	trySetEnum(Lighting, "Technology", "Technology", "Future", failures)
	trySetEnum(Lighting, "LightingStyle", "LightingStyle", "Realistic", failures)
	trySet(Lighting, "PrioritizeLightingQuality", true, failures)
	trySet(MaterialService, "Use2022Materials", true, failures)

	-- Sun, sky and ambient response
	Lighting.GlobalShadows = true
	Lighting.ClockTime = L.ClockTime
	Lighting.GeographicLatitude = L.GeographicLatitude
	Lighting.Brightness = L.Brightness
	Lighting.ExposureCompensation = L.ExposureCompensation
	Lighting.EnvironmentDiffuseScale = L.EnvironmentDiffuseScale
	Lighting.EnvironmentSpecularScale = L.EnvironmentSpecularScale
	Lighting.ShadowSoftness = L.ShadowSoftness
	Lighting.Ambient = L.Ambient
	Lighting.OutdoorAmbient = L.OutdoorAmbient
	Lighting.ColorShift_Top = L.ColorShiftTop
	Lighting.ColorShift_Bottom = L.ColorShiftBottom
	Lighting.FogEnd = 100000 -- Atmosphere owns distance fog.

	local atmosphere = ensureSingle(Lighting, "Atmosphere", "Atmosphere") :: Atmosphere
	atmosphere.Density = L.Atmosphere.Density
	atmosphere.Offset = L.Atmosphere.Offset
	atmosphere.Color = L.Atmosphere.Color
	atmosphere.Decay = L.Atmosphere.Decay
	atmosphere.Glare = L.Atmosphere.Glare
	atmosphere.Haze = L.Atmosphere.Haze

	local sky = ensureSingle(Lighting, "Sky", "Sky") :: Sky
	sky.StarCount = 0
	sky.SunAngularSize = 11
	sky.MoonAngularSize = 9
	sky.CelestialBodiesShown = true

	local clouds = ensureSingle(Workspace.Terrain, "Clouds", "Clouds") :: Clouds
	clouds.Enabled = true
	clouds.Cover = L.Clouds.Cover
	clouds.Density = L.Clouds.Density
	clouds.Color = L.Clouds.Color

	-- Post-processing stack
	local cc = ensureSingle(Lighting, "ColorCorrectionEffect", LightingService.EffectNames.ColorCorrection) :: ColorCorrectionEffect
	cc.Enabled = true
	cc.Brightness = L.ColorCorrection.Brightness
	cc.Contrast = L.ColorCorrection.Contrast
	cc.Saturation = L.ColorCorrection.Saturation
	cc.TintColor = L.ColorCorrection.TintColor

	local bloom = ensureSingle(Lighting, "BloomEffect", LightingService.EffectNames.Bloom) :: BloomEffect
	bloom.Enabled = true
	bloom.Intensity = L.Bloom.Intensity
	bloom.Size = L.Bloom.Size
	bloom.Threshold = L.Bloom.Threshold

	local dof = ensureSingle(Lighting, "DepthOfFieldEffect", LightingService.EffectNames.DepthOfField) :: DepthOfFieldEffect
	dof.Enabled = true
	dof.FarIntensity = L.DepthOfField.FarIntensity
	dof.FocusDistance = L.DepthOfField.FocusDistance
	dof.InFocusRadius = L.DepthOfField.InFocusRadius
	dof.NearIntensity = L.DepthOfField.NearIntensity

	local rays = ensureSingle(Lighting, "SunRaysEffect", LightingService.EffectNames.SunRays) :: SunRaysEffect
	rays.Enabled = true
	rays.Intensity = L.SunRays.Intensity
	rays.Spread = L.SunRays.Spread

	-- Filmic tonemapper (newer engines only).
	local gradingOk = pcall(function()
		local grading: any = ensureSingle(Lighting, "ColorGradingEffect", LightingService.EffectNames.ColorGrading)
		grading.Enabled = true
		grading.TonemapperPreset = (Enum :: any).TonemapperPreset.Default
	end)
	if not gradingOk then
		table.insert(failures, "ColorGradingEffect (not available on this engine build — optional)")
	end

	-- Old blur effects from templates would wreck the grade.
	for _, child in Lighting:GetChildren() do
		if child:IsA("BlurEffect") then
			child.Enabled = false
		end
	end

	if #failures > 0 then
		warn(
			"[LightingService] Set these once in the Properties panel (not writable from this context):\n  • "
				.. table.concat(failures, "\n  • ")
		)
	else
		print("[LightingService] Look-dev applied (Future lighting, 2022 materials, full post stack).")
	end
	return failures
end

return LightingService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000018"><Properties><string name="Name">PlayerDataService</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	PlayerDataService
	Owns each player's persistent profile (settings, loadout, stash).

	• Real DataStore in live servers; automatic in-memory mock in Studio when
	  "Enable Studio Access to API Services" is off or the place is unpublished.
	• Every inbound value is sanitised through Shared.Schema.
	• Retries with exponential backoff, dirty-flag autosave, save on leave,
	  BindToClose flush.

	Phase 4 extends this with stash banking on extraction; the data shape is
	already in place (Stash / StashValue).
]]

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local Schema = require(Shared.Schema)
local Signal = require(Shared.Signal)
local Types = require(Shared.Types)

type Backend = {
	Name: string,
	Load: (key: string) -> (boolean, any),
	Save: (key: string, data: Types.ProfileData) -> boolean,
}

type Profile = {
	Data: Types.ProfileData,
	Dirty: boolean,
	Saving: boolean,
}

local PlayerDataService = {}
PlayerDataService.ProfileLoaded = Signal.new() -- (player, data)

local profiles: { [Player]: Profile } = {}
local lastSettingsSave: { [Player]: number } = {}
local backend: Backend

local function deepCopy(value: any): any
	if typeof(value) ~= "table" then
		return value
	end
	local copy = {}
	for k, v in value do
		copy[deepCopy(k)] = deepCopy(v)
	end
	return copy
end

local function defaultData(): Types.ProfileData
	return {
		Version = Config.Data.SchemaVersion,
		Settings = Schema.sanitizeSettings(nil, Config.Settings.Defaults),
		Loadout = Schema.sanitizeLoadout(nil, Config.DefaultLoadout),
		Stash = {},
		StashValue = 0,
	}
end

local function reconcile(raw: any): Types.ProfileData
	local data = defaultData()
	if typeof(raw) ~= "table" then
		return data
	end
	data.Settings = Schema.sanitizeSettings(raw.Settings, data.Settings)
	data.Loadout = Schema.sanitizeLoadout(raw.Loadout, data.Loadout)
	if typeof(raw.Stash) == "table" then
		for itemId, count in raw.Stash do
			if typeof(itemId) == "string" and Schema.isFiniteNumber(count) and count > 0 then
				data.Stash[itemId] = math.floor(count)
			end
		end
	end
	if Schema.isFiniteNumber(raw.StashValue) then
		data.StashValue = math.max(0, math.floor(raw.StashValue))
	end
	return data
end

--------------------------------------------------------------------------------
-- Backends
--------------------------------------------------------------------------------
local function makeMockBackend(): Backend
	local memory: { [string]: any } = {}
	return {
		Name = "Mock",
		Load = function(key: string): (boolean, any)
			return true, deepCopy(memory[key])
		end,
		Save = function(key: string, data: Types.ProfileData): boolean
			memory[key] = deepCopy(data)
			return true
		end,
	}
end

local function makeDataStoreBackend(store: DataStore): Backend
	local retries = Config.Data.Retries
	return {
		Name = "DataStore",
		Load = function(key: string): (boolean, any)
			for attempt = 1, retries do
				local ok, result = pcall(function(): any
					return store:GetAsync(key)
				end)
				if ok then
					return true, result
				end
				warn(string.format("[PlayerData] load %s failed (attempt %d/%d): %s", key, attempt, retries, tostring(result)))
				task.wait(0.5 * 2 ^ attempt)
			end
			return false, nil
		end,
		Save = function(key: string, data: Types.ProfileData): boolean
			for attempt = 1, retries do
				local ok, err = pcall(function()
					store:UpdateAsync(key, function(_previous: any): any
						return data
					end)
				end)
				if ok then
					return true
				end
				warn(string.format("[PlayerData] save %s failed (attempt %d/%d): %s", key, attempt, retries, tostring(err)))
				task.wait(0.5 * 2 ^ attempt)
			end
			return false
		end,
	}
end

local function resolveBackend(): Backend
	local ok, store = pcall(function(): DataStore
		return DataStoreService:GetDataStore(Config.Data.StoreName)
	end)
	if not ok then
		warn("[PlayerData] DataStoreService unavailable — using in-memory mock (data resets each session).")
		return makeMockBackend()
	end
	if RunService:IsStudio() then
		local probeOk = pcall(function()
			(store :: DataStore):GetAsync("__studio_probe")
		end)
		if not probeOk then
			warn(
				"[PlayerData] Studio has no DataStore access (publish the place + enable 'Studio Access to API Services' to test real saves). Using in-memory mock."
			)
			return makeMockBackend()
		end
	end
	return makeDataStoreBackend(store :: DataStore)
end

--------------------------------------------------------------------------------
-- Profiles
--------------------------------------------------------------------------------
local function keyFor(player: Player): string
	return Config.Data.KeyPrefix .. tostring(player.UserId)
end

local function publishAttributes(player: Player, data: Types.ProfileData)
	player:SetAttribute("Loadout_Primary", data.Loadout.Primary)
	player:SetAttribute("Loadout_Secondary", data.Loadout.Secondary)
	player:SetAttribute("StashValue", data.StashValue)
end

local function saveProfile(player: Player): boolean
	local profile = profiles[player]
	if not profile or profile.Saving then
		return false
	end
	profile.Saving = true
	profile.Dirty = false
	local ok = backend.Save(keyFor(player), profile.Data)
	if not ok then
		profile.Dirty = true
	end
	profile.Saving = false
	return ok
end

local function loadProfile(player: Player)
	local ok, raw = backend.Load(keyFor(player))
	if not player.Parent then
		return
	end
	local data = reconcile(if ok then raw else nil)
	if not ok then
		warn(string.format("[PlayerData] %s: load failed, using defaults this session (saves disabled to protect data).", player.Name))
	end
	profiles[player] = { Data = data, Dirty = false, Saving = not ok }
	publishAttributes(player, data)
	player:SetAttribute("ProfileLoaded", true)
	PlayerDataService.ProfileLoaded:Fire(player, data)
end

local function waitForProfile(player: Player, timeout: number): Profile?
	local deadline = os.clock() + timeout
	while not profiles[player] and player.Parent and os.clock() < deadline do
		task.wait(0.1)
	end
	return profiles[player]
end

--------------------------------------------------------------------------------
-- Public API (used by later phases)
--------------------------------------------------------------------------------
function PlayerDataService.getData(player: Player): Types.ProfileData?
	local profile = profiles[player]
	return if profile then profile.Data else nil
end

function PlayerDataService.markDirty(player: Player)
	local profile = profiles[player]
	if profile then
		profile.Dirty = true
		publishAttributes(player, profile.Data)
	end
end

function PlayerDataService.save(player: Player): boolean
	return saveProfile(player)
end

--------------------------------------------------------------------------------
-- Init
--------------------------------------------------------------------------------
function PlayerDataService.init()
	backend = resolveBackend()
	print("[PlayerData] backend:", backend.Name)

	Net.func(Net.Functions.GetProfile).OnServerInvoke = function(player: Player): any
		local profile = waitForProfile(player, Config.Data.ProfileWaitTimeout)
		if not profile then
			return nil
		end
		local payload: Types.ClientProfile = {
			Settings = table.clone(profile.Data.Settings),
			Loadout = table.clone(profile.Data.Loadout),
			StashValue = profile.Data.StashValue,
		}
		return payload
	end

	Net.event(Net.Events.SaveSettings).OnServerEvent:Connect(function(player: Player, raw: any)
		local profile = profiles[player]
		if not profile then
			return
		end
		local now = os.clock()
		if (lastSettingsSave[player] or 0) + Config.Settings.ServerSaveCooldown > now then
			return
		end
		lastSettingsSave[player] = now
		profile.Data.Settings = Schema.sanitizeSettings(raw, profile.Data.Settings)
		profile.Dirty = true
	end)

	Net.event(Net.Events.SetLoadout).OnServerEvent:Connect(function(player: Player, slot: any, weaponId: any)
		local profile = profiles[player]
		if not profile or not Schema.isWeaponForSlot(slot, weaponId) then
			return
		end
		-- Loadout is locked once deployed; it only changes in the safehouse.
		if player:GetAttribute("State") ~= "Menu" then
			publishAttributes(player, profile.Data)
			return
		end
		if slot == "Primary" then
			profile.Data.Loadout.Primary = weaponId
		elseif slot == "Secondary" then
			profile.Data.Loadout.Secondary = weaponId
		end
		profile.Dirty = true
		publishAttributes(player, profile.Data)
	end)

	Players.PlayerAdded:Connect(loadProfile)
	for _, player in Players:GetPlayers() do
		task.spawn(loadProfile, player)
	end

	Players.PlayerRemoving:Connect(function(player: Player)
		local profile = profiles[player]
		if profile and profile.Dirty then
			saveProfile(player)
		end
		profiles[player] = nil
		lastSettingsSave[player] = nil
	end)

	task.spawn(function()
		while true do
			task.wait(Config.Data.AutosaveInterval)
			for player, profile in profiles do
				if profile.Dirty then
					task.spawn(saveProfile, player)
				end
			end
		end
	end)

	game:BindToClose(function()
		local pending = 0
		for player, profile in profiles do
			if profile.Dirty then
				pending += 1
				task.spawn(function()
					saveProfile(player)
					pending -= 1
				end)
			end
		end
		local deadline = os.clock() + 25
		while pending > 0 and os.clock() < deadline do
			task.wait(0.1)
		end
	end)
end

return PlayerDataService
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX000021"><Properties><string name="Name">World</string></Properties><Item class="ModuleScript" referent="RBX000020"><Properties><string name="Name">SafehouseBuilder</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	SafehouseBuilder
	Procedurally builds the rain-slicked safehouse alley used by the main menu
	and as the post-raid hub:

	  • wet asphalt with layered puddles, curbs, drains, manhole, steam vent
	  • two brick mid-rises with lit/dark windows, floor bands, cornices,
	    drainpipes, AC units, a fire escape and overhead sagging cables
	  • sodium + LED streetlamps with shadowed SpotLights and volumetric beams
	  • magenta/cyan neon sign + rim strips for colour contrast on the car
	  • roll-up garage, security flood light, dumpster, crates, barrels
	  • weapon workbench (Phase 2 mounts weapons on WeaponDisplays anchors)
	  • ground mist emitters, CameraRig shots, DeployPoints
	  • the matte-black "Zabour" getaway car (GetawayCarBody)

	Run in edit mode from the Command Bar to preview/bake (see tools/), or let
	the server Bootstrap build it at runtime when Workspace has no Safehouse.
]]

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local PartFactory = require(Shared.Builders.PartFactory)
local GetawayCarBody = require(Shared.Builders.GetawayCarBody)

type Style = PartFactory.Style

local SafehouseBuilder = {}

local ALLEY_LENGTH = 150
local HALF_LENGTH = ALLEY_LENGTH / 2
local WALL_FACE = 15 -- inner face of both buildings (x = ±15)
local BUILDING_HEIGHT = 48
local FLOOR_CENTRES = { 9, 16.5, 24, 31.5, 39 }
local FLOOR_BANDS = { 6.6, 14.1, 21.6, 29.1, 36.6 }

local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

local PAVEMENT = PartFactory.material("Pavement", Enum.Material.Concrete)
local CARDBOARD = PartFactory.material("Cardboard", Enum.Material.Fabric)

local S: { [string]: Style } = {
	Asphalt = PartFactory.style(rgb(36, 37, 40), Enum.Material.Asphalt, 0.04),
	Puddle = PartFactory.style(rgb(16, 18, 21), Enum.Material.SmoothPlastic, 0.42, 0, false),
	Curb = PartFactory.style(rgb(88, 88, 92), Enum.Material.Concrete),
	Sidewalk = PartFactory.style(rgb(66, 66, 70), PAVEMENT),
	BrickL = PartFactory.style(rgb(74, 50, 42), Enum.Material.Brick),
	BrickR = PartFactory.style(rgb(62, 56, 54), Enum.Material.Brick),
	Concrete = PartFactory.style(rgb(78, 78, 82), Enum.Material.Concrete),
	ConcreteDark = PartFactory.style(rgb(50, 50, 54), Enum.Material.Concrete),
	WindowDark = PartFactory.style(rgb(12, 14, 17), Enum.Material.SmoothPlastic, 0.3),
	WindowLitWarm = PartFactory.style(rgb(150, 96, 52), Enum.Material.Neon, 0, 0.15, false),
	WindowLitCool = PartFactory.style(rgb(70, 110, 150), Enum.Material.Neon, 0, 0.3, false),
	Blinds = PartFactory.style(rgb(20, 18, 16), Enum.Material.SmoothPlastic),
	MetalDark = PartFactory.style(rgb(44, 46, 50), Enum.Material.Metal, 0.05),
	MetalLight = PartFactory.style(rgb(118, 120, 118), Enum.Material.Metal, 0.05),
	MetalRust = PartFactory.style(rgb(96, 72, 58), Enum.Material.CorrodedMetal),
	Shutter = PartFactory.style(rgb(70, 72, 76), Enum.Material.CorrodedMetal),
	Diamond = PartFactory.style(rgb(58, 60, 64), Enum.Material.DiamondPlate),
	DiamondDark = PartFactory.style(rgb(30, 31, 34), Enum.Material.DiamondPlate),
	Wood = PartFactory.style(rgb(92, 70, 50), Enum.Material.WoodPlanks),
	Pegboard = PartFactory.style(rgb(118, 96, 72), Enum.Material.Wood),
	Cardboard = PartFactory.style(rgb(150, 118, 80), CARDBOARD),
	FabricDark = PartFactory.style(rgb(34, 36, 40), Enum.Material.Fabric),
	Olive = PartFactory.style(rgb(64, 72, 48), Enum.Material.Metal, 0.03),
	Dumpster = PartFactory.style(rgb(34, 56, 44), Enum.Material.Metal, 0.03),
	TrashBag = PartFactory.style(rgb(14, 14, 16), Enum.Material.SmoothPlastic, 0.12),
	Cable = PartFactory.style(rgb(10, 10, 10), Enum.Material.SmoothPlastic),
	Sodium = PartFactory.style(rgb(255, 186, 120), Enum.Material.Neon, 0, 0, false),
	LedCool = PartFactory.style(rgb(210, 225, 255), Enum.Material.Neon, 0, 0, false),
	NeonCyan = PartFactory.style(rgb(60, 220, 255), Enum.Material.Neon, 0, 0, false),
	NeonMagenta = PartFactory.style(rgb(255, 70, 175), Enum.Material.Neon, 0, 0, false),
	ScreenGlow = PartFactory.style(rgb(40, 140, 180), Enum.Material.Neon, 0, 0.2, false),
	Invisible = PartFactory.style(rgb(0, 0, 0), Enum.Material.SmoothPlastic, 0, 1, false),
}

local SODIUM_LIGHT = rgb(255, 178, 110)
local LED_LIGHT = rgb(210, 225, 255)
local WARM_LIGHT = rgb(255, 205, 150)

--------------------------------------------------------------------------------
-- Context helpers
--------------------------------------------------------------------------------
type Ctx = {
	Origin: CFrame,
	Rng: Random,
	part: (name: string, size: Vector3, localCF: CFrame, style: Style, parent: Instance, extra: Extra?) -> BasePart,
	segment: (name: string, a: Vector3, b: Vector3, thickness: number, style: Style, parent: Instance) -> BasePart,
}

type Extra = {
	Class: ("Part" | "WedgePart" | "CornerWedgePart")?,
	Shape: Enum.PartType?,
	Collide: boolean?,
}

local function makeCtx(origin: CFrame, seed: number): Ctx
	local ctx: Ctx
	ctx = {
		Origin = origin,
		Rng = Random.new(seed),
		part = function(name: string, size: Vector3, localCF: CFrame, style: Style, parent: Instance, extra: Extra?): BasePart
			local e: Extra = extra or {}
			return PartFactory.make({
				Name = name,
				Size = size,
				CFrame = origin * localCF,
				Style = style,
				Class = e.Class,
				Shape = e.Shape,
				CanCollide = e.Collide,
				Parent = parent,
			})
		end,
		segment = function(name: string, a: Vector3, b: Vector3, thickness: number, style: Style, parent: Instance): BasePart
			return PartFactory.segment(name, origin * a, origin * b, thickness, style, parent)
		end,
	}
	return ctx
end

local function at(x: number, y: number, z: number): CFrame
	return CFrame.new(x, y, z)
end

local function addSpot(parent: BasePart, props: {
	Face: Enum.NormalId,
	Angle: number,
	Range: number,
	Brightness: number,
	Color: Color3,
	Shadows: boolean,
}): SpotLight
	local light = Instance.new("SpotLight")
	light.Face = props.Face
	light.Angle = props.Angle
	light.Range = props.Range
	light.Brightness = props.Brightness
	light.Color = props.Color
	light.Shadows = props.Shadows
	light.Parent = parent
	if props.Shadows then
		CollectionService:AddTag(light, "ShadowLight")
	end
	return light
end

local function addPoint(parent: BasePart, range: number, brightness: number, color: Color3): PointLight
	local light = Instance.new("PointLight")
	light.Range = range
	light.Brightness = brightness
	light.Color = color
	light.Shadows = false
	light.Parent = parent
	return light
end

local function addDownBeam(source: BasePart, length: number, width0: number, width1: number, color: Color3): Beam
	local a0 = Instance.new("Attachment")
	a0.Name = "BeamStart"
	a0.Parent = source
	local a1 = Instance.new("Attachment")
	a1.Name = "BeamEnd"
	a1.Position = Vector3.new(0, -length, 0)
	a1.Parent = source
	local beam = Instance.new("Beam")
	beam.Name = "VolumetricBeam"
	beam.Attachment0 = a0
	beam.Attachment1 = a1
	beam.Width0 = width0
	beam.Width1 = width1
	beam.FaceCamera = true
	beam.LightEmission = 1
	beam.LightInfluence = 0
	beam.Segments = 1
	beam.Color = ColorSequence.new(color)
	beam.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.84),
		NumberSequenceKeypoint.new(0.7, 0.92),
		NumberSequenceKeypoint.new(1, 1),
	})
	beam.Parent = source
	CollectionService:AddTag(beam, "VolumetricBeam")
	return beam
end

local function smokeEmitter(parent: Instance, props: {
	Name: string,
	Rate: number,
	Lifetime: NumberRange,
	Speed: NumberRange,
	Size: NumberSequence,
	Transparency: NumberSequence,
	Color: Color3,
	Direction: Enum.NormalId,
	Spread: Vector2,
	Acceleration: Vector3,
	Drag: number,
}): ParticleEmitter
	local emitter = Instance.new("ParticleEmitter")
	emitter.Name = props.Name
	emitter.Texture = "rbxasset://textures/particles/smoke_main.dds"
	emitter.Rate = props.Rate
	emitter.Lifetime = props.Lifetime
	emitter.Speed = props.Speed
	emitter.Size = props.Size
	emitter.Transparency = props.Transparency
	emitter.Color = ColorSequence.new(props.Color)
	emitter.EmissionDirection = props.Direction
	emitter.SpreadAngle = props.Spread
	emitter.Acceleration = props.Acceleration
	emitter.Drag = props.Drag
	emitter.Rotation = NumberRange.new(0, 360)
	emitter.RotSpeed = NumberRange.new(-8, 8)
	emitter.LightInfluence = 1
	emitter.LightEmission = 0
	emitter.Parent = parent
	return emitter
end

--------------------------------------------------------------------------------
-- Ground
--------------------------------------------------------------------------------
local function buildGround(ctx: Ctx, parent: Instance)
	local folder = PartFactory.folder("Ground", parent)
	ctx.part("Asphalt", Vector3.new(2 * WALL_FACE + 4, 2, ALLEY_LENGTH), at(0, -1, 0), S.Asphalt, folder, { Collide = true })

	for _, side in { -1, 1 } do
		local tag = if side < 0 then "L" else "R"
		ctx.part("Curb_" .. tag, Vector3.new(0.6, 0.45, ALLEY_LENGTH), at(side * 12.3, 0.225, 0), S.Curb, folder, { Collide = true })
		ctx.part("Sidewalk_" .. tag, Vector3.new(2.4, 0.4, ALLEY_LENGTH), at(side * 13.8, 0.2, 0), S.Sidewalk, folder, { Collide = true })
		for _, z in { -50, -20, 10, 40 } do
			ctx.part("Drain_" .. tag .. z, Vector3.new(1.1, 0.04, 2.2), at(side * 11.5, 0.02, z), S.DiamondDark, folder)
		end
	end

	-- Puddles: clusters of 2-3 overlapping discs read as organic shapes.
	local rng = ctx.Rng
	for i = 1, 16 do
		local cx = rng:NextNumber(-10, 10)
		local cz = rng:NextNumber(-34, 44)
		local blobs = rng:NextInteger(2, 3)
		for b = 1, blobs do
			local d = rng:NextNumber(1.6, 4.6)
			local ox = rng:NextNumber(-1.4, 1.4)
			local oz = rng:NextNumber(-1.8, 1.8)
			ctx.part(
				string.format("Puddle_%d_%d", i, b),
				Vector3.new(0.02, d, d),
				at(cx + ox, 0.011 + b * 0.001, cz + oz) * PartFactory.AxisY,
				S.Puddle,
				folder,
				{ Shape = Enum.PartType.Cylinder }
			)
		end
	end

	-- Manhole
	ctx.part("ManholeRing", Vector3.new(0.05, 2.9, 2.9), at(-6, 0.02, -16) * PartFactory.AxisY, S.MetalDark, folder, { Shape = Enum.PartType.Cylinder })
	ctx.part("Manhole", Vector3.new(0.06, 2.6, 2.6), at(-6, 0.03, -16) * PartFactory.AxisY, S.DiamondDark, folder, { Shape = Enum.PartType.Cylinder })

	-- Steam vent
	ctx.part("SteamGrate", Vector3.new(0.06, 2.4, 2.4), at(5, 0.03, 22) * PartFactory.AxisY, S.DiamondDark, folder, { Shape = Enum.PartType.Cylinder })
	local steamSource = ctx.part("SteamSource", Vector3.new(1.8, 0.2, 1.8), at(5, 0.2, 22), S.Invisible, folder)
	local steam = smokeEmitter(steamSource, {
		Name = "Steam",
		Rate = 7,
		Lifetime = NumberRange.new(3, 5),
		Speed = NumberRange.new(3, 5),
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 6) }),
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.15, 0.78),
			NumberSequenceKeypoint.new(1, 1),
		}),
		Color = rgb(200, 200, 205),
		Direction = Enum.NormalId.Top,
		Spread = Vector2.new(10, 10),
		Acceleration = Vector3.new(1.5, 0.5, 0.6),
		Drag = 0.4,
	})
	CollectionService:AddTag(steam, "SteamVent")
end

--------------------------------------------------------------------------------
-- Buildings
--------------------------------------------------------------------------------
local function windowSkipped(side: number, floorIndex: number, z: number): boolean
	if floorIndex ~= 1 then
		return false
	end
	if side > 0 and z >= 14 and z <= 36 then
		return true -- garage header
	end
	if side < 0 and z >= 2 and z <= 14 then
		return true -- neon sign
	end
	return false
end

local function buildWindow(ctx: Ctx, folder: Instance, side: number, y: number, z: number)
	local face = side * WALL_FACE
	local inward = -side -- direction pointing into the alley
	local roll = ctx.Rng:NextNumber()
	local lit = roll < 0.14
	local style = if lit then (if ctx.Rng:NextNumber() < 0.25 then S.WindowLitCool else S.WindowLitWarm) else S.WindowDark
	local name = string.format("Window_%s_%d_%d", if side < 0 then "L" else "R", math.floor(y), math.floor(z))

	ctx.part(name, Vector3.new(0.12, 4.2, 3.2), at(face + inward * 0.06, y, z), style, folder)
	ctx.part(name .. "_Mullion", Vector3.new(0.08, 4.2, 0.1), at(face + inward * 0.12, y, z), S.ConcreteDark, folder)
	ctx.part(name .. "_Sill", Vector3.new(0.45, 0.25, 3.8), at(face + inward * 0.22, y - 2.25, z), S.Concrete, folder)
	ctx.part(name .. "_Lintel", Vector3.new(0.3, 0.3, 3.6), at(face + inward * 0.15, y + 2.25, z), S.Concrete, folder)

	if lit then
		-- Half-drawn blinds
		for slat = 0, 3 do
			ctx.part(name .. "_Blind" .. slat, Vector3.new(0.04, 0.08, 3.1), at(face + inward * 0.14, y + 1.9 - slat * 0.32, z), S.Blinds, folder)
		end
	end
end

local function buildBuilding(ctx: Ctx, parent: Instance, side: number)
	local tag = if side < 0 then "L" else "R"
	local folder = PartFactory.folder("Building_" .. tag, parent)
	local wallStyle = if side < 0 then S.BrickL else S.BrickR
	local face = side * WALL_FACE
	local inward = -side

	ctx.part("Wall", Vector3.new(3, BUILDING_HEIGHT, ALLEY_LENGTH), at(face + side * 1.5, BUILDING_HEIGHT / 2, 0), wallStyle, folder, { Collide = true })
	ctx.part("Plinth", Vector3.new(0.4, 3, ALLEY_LENGTH), at(face + inward * 0.2, 1.5, 0), S.ConcreteDark, folder, { Collide = true })
	ctx.part("Cornice", Vector3.new(1.2, 0.8, ALLEY_LENGTH), at(face + inward * 0.4, BUILDING_HEIGHT - 1.6, 0), S.Concrete, folder)
	ctx.part("CorniceCap", Vector3.new(1.6, 0.3, ALLEY_LENGTH), at(face + inward * 0.5, BUILDING_HEIGHT - 1.05, 0), S.ConcreteDark, folder)
	for i, y in FLOOR_BANDS do
		ctx.part("FloorBand" .. i, Vector3.new(0.3, 0.35, ALLEY_LENGTH), at(face + inward * 0.15, y, 0), S.Concrete, folder)
	end

	local windows = PartFactory.folder("Windows", folder)
	for floorIndex, y in FLOOR_CENTRES do
		for z = -60, 60, 10 do
			if not windowSkipped(side, floorIndex, z) then
				buildWindow(ctx, windows, side, y, z)
			end
		end
	end

	-- Drainpipes
	local pipeZs = if side < 0 then { -18, 30 } else { -34, 38 }
	for _, z in pipeZs do
		ctx.part("Drainpipe_" .. z, Vector3.new(BUILDING_HEIGHT - 2, 0.5, 0.5), at(face + inward * 0.35, (BUILDING_HEIGHT - 2) / 2, z) * PartFactory.AxisY, S.MetalDark, folder, {
			Shape = Enum.PartType.Cylinder,
		})
		ctx.part("DrainShoe_" .. z, Vector3.new(0.8, 0.5, 0.5), at(face + inward * 0.6, 0.45, z) * CFrame.Angles(0, 0, math.rad(side * 30)), S.MetalDark, folder, {
			Shape = Enum.PartType.Cylinder,
		})
		for _, y in { 8, 20, 32 } do
			ctx.part("PipeClamp_" .. z .. "_" .. y, Vector3.new(0.5, 0.12, 0.7), at(face + inward * 0.3, y, z), S.MetalDark, folder)
		end
	end

	-- AC units (right building only)
	if side > 0 then
		for i, spot in { { 12.5, -40 }, { 20, -12 }, { 12.5, 42 }, { 27.5, 8 }, { 20, 52 } } do
			local y, z = spot[1], spot[2]
			ctx.part("ACUnit" .. i, Vector3.new(1.6, 1.4, 2.2), at(face - 0.8, y, z), S.MetalLight, folder)
			ctx.part("ACGrille" .. i, Vector3.new(0.05, 1.1, 1.9), at(face - 1.62, y, z), S.Diamond, folder)
			ctx.part("ACBracket" .. i, Vector3.new(1.4, 0.1, 0.1), at(face - 0.7, y - 0.8, z - 0.9), S.MetalDark, folder)
			ctx.part("ACBracketB" .. i, Vector3.new(1.4, 0.1, 0.1), at(face - 0.7, y - 0.8, z + 0.9), S.MetalDark, folder)
		end
	end

	-- Back door + caged bulb (left building)
	if side < 0 then
		ctx.part("BackDoorFrame", Vector3.new(0.3, 7.6, 4.2), at(face + 0.15, 3.8, -12), S.ConcreteDark, folder)
		ctx.part("BackDoor", Vector3.new(0.2, 7, 3.6), at(face + 0.3, 3.5, -12), S.MetalRust, folder, { Collide = true })
		ctx.part("DoorBar", Vector3.new(0.12, 0.12, 2.6), at(face + 0.45, 3.4, -12), S.MetalDark, folder)
		local bulb = ctx.part("CagedBulb", Vector3.new(0.35, 0.35, 0.35), at(face + 0.5, 8.1, -12), S.Sodium, folder, { Shape = Enum.PartType.Ball })
		ctx.part("BulbCage", Vector3.new(0.5, 0.55, 0.5), at(face + 0.5, 8.1, -12), PartFactory.style(rgb(30, 30, 30), Enum.Material.SmoothPlastic, 0, 0.7), folder)
		addPoint(bulb, 12, 1.3, SODIUM_LIGHT)
		CollectionService:AddTag(bulb, "FlickerLight")
	end

	-- End caps so the alley never shows the void
	ctx.part("EndWall_" .. tag .. "_N", Vector3.new(WALL_FACE + 2, BUILDING_HEIGHT, 3), at(side * (WALL_FACE / 2 + 1), BUILDING_HEIGHT / 2, HALF_LENGTH + 1.5), wallStyle, folder, { Collide = true })
	ctx.part("EndWall_" .. tag .. "_S", Vector3.new(WALL_FACE + 2, BUILDING_HEIGHT, 3), at(side * (WALL_FACE / 2 + 1), BUILDING_HEIGHT / 2, -HALF_LENGTH - 1.5), wallStyle, folder, { Collide = true })
end

local function buildFireEscape(ctx: Ctx, parent: Instance)
	local folder = PartFactory.folder("FireEscape", parent)
	local zc = -30
	local x0 = -WALL_FACE
	local levels = { 6.6, 14.1, 21.6, 29.1 }

	for i, y in levels do
		ctx.part("Platform" .. i, Vector3.new(3.2, 0.18, 9), at(x0 + 1.6, y, zc), S.Diamond, folder, { Collide = true })
		ctx.part("RailTop" .. i, Vector3.new(0.12, 0.12, 9), at(x0 + 3.1, y + 3.1, zc), S.MetalDark, folder)
		ctx.part("RailMid" .. i, Vector3.new(0.08, 0.08, 9), at(x0 + 3.1, y + 1.6, zc), S.MetalDark, folder)
		for p = 0, 5 do
			ctx.part(string.format("Post%d_%d", i, p), Vector3.new(0.12, 3.1, 0.12), at(x0 + 3.1, y + 1.55, zc - 4.4 + p * 1.76), S.MetalDark, folder)
		end
		for _, endZ in { zc - 4.45, zc + 4.45 } do
			ctx.part("RailEnd" .. i .. "_" .. endZ, Vector3.new(3.0, 0.12, 0.12), at(x0 + 1.6, y + 3.1, endZ), S.MetalDark, folder)
		end
		-- Wall braces
		for _, braceZ in { zc - 3.8, zc + 3.8 } do
			ctx.segment("Brace" .. i .. "_" .. braceZ, Vector3.new(x0, y - 2.2, braceZ), Vector3.new(x0 + 3.0, y - 0.1, braceZ), 0.14, S.MetalDark, folder)
		end
		-- Stairs up to the next level
		local nextY = levels[i + 1]
		if nextY then
			local startP = Vector3.new(x0 + 2.3, y, zc - 3)
			local endP = Vector3.new(x0 + 2.3, nextY, zc + 3)
			local rise = nextY - y
			local run = 6
			local angle = math.atan2(rise, run)
			local length = math.sqrt(rise * rise + run * run)
			local mid = (startP + endP) / 2
			for _, offset in { -0.72, 0.72 } do
				ctx.part(
					"Stringer" .. i .. "_" .. offset,
					Vector3.new(0.08, 0.45, length),
					at(mid.X + offset, mid.Y, mid.Z) * CFrame.Angles(-angle, 0, 0),
					S.MetalDark,
					folder
				)
			end
			for step = 1, 8 do
				local p = startP:Lerp(endP, step / 9)
				ctx.part(string.format("Tread%d_%d", i, step), Vector3.new(1.4, 0.08, 0.5), at(p.X, p.Y + 0.1, p.Z), S.Diamond, folder)
			end
		end
	end

	-- Drop ladder below the first platform
	for _, lz in { zc + 3.6, zc + 4.3 } do
		ctx.part("LadderRail_" .. lz, Vector3.new(0.08, 4, 0.08), at(x0 + 2.8, levels[1] - 2.1, lz), S.MetalDark, folder)
	end
	for r = 0, 5 do
		ctx.part("LadderRung" .. r, Vector3.new(0.06, 0.06, 0.7), at(x0 + 2.8, levels[1] - 0.5 - r * 0.65, zc + 3.95), S.MetalDark, folder)
	end
end

--------------------------------------------------------------------------------
-- Lighting fixtures
--------------------------------------------------------------------------------
type LampDef = { X: number, Z: number, Side: number, Led: boolean, Flicker: boolean }

local function buildStreetlamps(ctx: Ctx, parent: Instance)
	local folder = PartFactory.folder("Streetlamps", parent)
	local lamps: { LampDef } = {
		{ X = -13.2, Z = 2, Side = -1, Led = false, Flicker = false },
		{ X = 13.2, Z = 26, Side = 1, Led = false, Flicker = true },
		{ X = -13.2, Z = 50, Side = -1, Led = false, Flicker = false },
		{ X = 13.2, Z = -22, Side = 1, Led = false, Flicker = false },
		{ X = -13.2, Z = -46, Side = -1, Led = true, Flicker = false },
	}
	for i, lamp in lamps do
		local model = Instance.new("Model")
		model.Name = "Streetlamp" .. i
		model.Parent = folder
		local headX = lamp.X - lamp.Side * 3.4
		local lensStyle = if lamp.Led then S.LedCool else S.Sodium
		local lightColor = if lamp.Led then LED_LIGHT else SODIUM_LIGHT

		ctx.part("Base", Vector3.new(1.1, 0.6, 1.1), at(lamp.X, 0.7, lamp.Z), S.ConcreteDark, model, { Collide = true })
		ctx.part("Pole", Vector3.new(14, 0.45, 0.45), at(lamp.X, 7.4, lamp.Z) * PartFactory.AxisY, S.MetalDark, model, {
			Shape = Enum.PartType.Cylinder,
			Collide = true,
		})
		ctx.segment("Arm", Vector3.new(lamp.X, 14, lamp.Z), Vector3.new(headX, 14, lamp.Z), 0.22, S.MetalDark, model)
		ctx.segment("ArmBrace", Vector3.new(lamp.X, 12.6, lamp.Z), Vector3.new(lamp.X - lamp.Side * 1.6, 14, lamp.Z), 0.12, S.MetalDark, model)
		ctx.part("Head", Vector3.new(1.6, 0.45, 0.9), at(headX, 13.8, lamp.Z), S.MetalDark, model)
		ctx.part("Lens", Vector3.new(1.3, 0.06, 0.6), at(headX, 13.55, lamp.Z), lensStyle, model)

		local source = ctx.part("LightSource", Vector3.new(0.2, 0.2, 0.2), at(headX, 13.4, lamp.Z), S.Invisible, model)
		addSpot(source, {
			Face = Enum.NormalId.Bottom,
			Angle = 75,
			Range = 40,
			Brightness = if lamp.Led then 2.8 else 3.5,
			Color = lightColor,
			Shadows = true,
		})
		addDownBeam(source, 13, 1.2, 11, lightColor)
		if lamp.Flicker then
			CollectionService:AddTag(model, "FlickerLight")
		end
	end
end

local function buildNeon(ctx: Ctx, parent: Instance)
	local folder = PartFactory.folder("Neon", parent)

	-- Magenta sign on the left wall above the car.
	local sign = Instance.new("Model")
	sign.Name = "NeonSign"
	sign.Parent = folder
	local x = -WALL_FACE + 0.25
	local panel = ctx.part("Panel", Vector3.new(0.3, 2.6, 9), at(x, 8.2, 8), S.MetalDark, sign)
	ctx.part("TubeTop", Vector3.new(0.12, 0.12, 9.2), at(x + 0.2, 9.55, 8), S.NeonCyan, sign)
	ctx.part("TubeBottom", Vector3.new(0.12, 0.12, 9.2), at(x + 0.2, 6.85, 8), S.NeonCyan, sign)
	ctx.part("TubeEndA", Vector3.new(0.12, 2.82, 0.12), at(x + 0.2, 8.2, 3.45), S.NeonCyan, sign)
	ctx.part("TubeEndB", Vector3.new(0.12, 2.82, 0.12), at(x + 0.2, 8.2, 12.55), S.NeonCyan, sign)
	for _, bz in { 4.5, 11.5 } do
		ctx.part("Bracket_" .. bz, Vector3.new(0.5, 0.14, 0.14), at(x - 0.1, 9.7, bz), S.MetalDark, sign)
	end

	local gui = Instance.new("SurfaceGui")
	gui.Name = "SignText"
	gui.Face = Enum.NormalId.Right
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	gui.LightInfluence = 0
	gui.Brightness = 2.5
	gui.Parent = panel
	local label = Instance.new("TextLabel")
	label.Name = "Text"
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(0.92, 0.8)
	label.Position = UDim2.fromScale(0.04, 0.1)
	label.Text = Config.Branding.SignText
	label.TextScaled = true
	label.TextColor3 = rgb(255, 70, 175)
	label.FontFace = Font.new("rbxasset://fonts/families/Montserrat.json", Enum.FontWeight.Bold)
	label.Parent = gui
	local stroke = Instance.new("UIStroke")
	stroke.Color = rgb(255, 150, 210)
	stroke.Thickness = 1.5
	stroke.Transparency = 0.4
	stroke.Parent = label

	local glow = ctx.part("Glow", Vector3.new(0.2, 0.2, 0.2), at(x + 2.2, 8.2, 8), S.Invisible, sign)
	addPoint(glow, 24, 2.2, rgb(255, 70, 175))
	CollectionService:AddTag(sign, "FlickerLight")
	sign:SetAttribute("FlickerStyle", "Sign")

	-- Cyan rim strips framing the garage (rim-light the car from behind/right).
	for i, z in { 16.9, 33.1 } do
		ctx.part("RimStrip" .. i, Vector3.new(0.15, 7.2, 0.15), at(WALL_FACE - 0.25, 3.8, z), S.NeonCyan, folder)
		local holder = ctx.part("RimGlow" .. i, Vector3.new(0.2, 0.2, 0.2), at(WALL_FACE - 1.5, 3.8, z), S.Invisible, folder)
		addPoint(holder, 16, 1.4, rgb(60, 220, 255))
	end

	-- Hanging bulb on a wire over the car.
	ctx.segment("BulbWire", Vector3.new(-2, 19, 6), Vector3.new(-2, 11.2, 6), 0.05, S.Cable, folder)
	local bulb = ctx.part("HangingBulb", Vector3.new(0.4, 0.4, 0.4), at(-2, 11, 6), S.Sodium, folder, { Shape = Enum.PartType.Ball })
	ctx.part("BulbShade", Vector3.new(0.3, 1.0, 1.0), at(-2, 11.3, 6) * PartFactory.AxisY, S.MetalDark, folder, { Shape = Enum.PartType.Cylinder })
	addPoint(bulb, 11, 0.9, WARM_LIGHT)
end

--------------------------------------------------------------------------------
-- Garage
--------------------------------------------------------------------------------
local function buildGarage(ctx: Ctx, parent: Instance)
	local folder = PartFactory.folder("Garage", parent)
	local x = WALL_FACE
	ctx.part("PillarA", Vector3.new(0.9, 8.6, 0.9), at(x - 0.4, 4.3, 17.4), S.Concrete, folder, { Collide = true })
	ctx.part("PillarB", Vector3.new(0.9, 8.6, 0.9), at(x - 0.4, 4.3, 32.6), S.Concrete, folder, { Collide = true })
	ctx.part("Header", Vector3.new(0.9, 1.0, 16.1), at(x - 0.4, 9.1, 25), S.Concrete, folder)
	ctx.part("Shutter", Vector3.new(0.3, 8.2, 14.4), at(x - 0.15, 4.3, 25), S.Shutter, folder, { Collide = true })
	for i = 0, 11 do
		ctx.part("Rib" .. i, Vector3.new(0.12, 0.1, 14.4), at(x - 0.34, 0.6 + i * 0.66, 25), S.Shutter, folder)
	end
	ctx.part("BottomBar", Vector3.new(0.3, 0.3, 14.4), at(x - 0.3, 0.35, 25), S.MetalDark, folder)
	ctx.part("Handle", Vector3.new(0.15, 0.15, 1.2), at(x - 0.4, 1.2, 25), S.MetalLight, folder)
	-- Hazard chevrons on the pillars
	for i = 0, 3 do
		local y = 0.5 + i * 0.9
		ctx.part("HazardA" .. i, Vector3.new(0.92, 0.35, 0.05), at(x - 0.4, y, 16.93) * CFrame.Angles(0, 0, math.rad(35)), PartFactory.style(rgb(200, 150, 30), Enum.Material.SmoothPlastic), folder)
		ctx.part("HazardB" .. i, Vector3.new(0.92, 0.35, 0.05), at(x - 0.4, y, 33.07) * CFrame.Angles(0, 0, math.rad(35)), PartFactory.style(rgb(200, 150, 30), Enum.Material.SmoothPlastic), folder)
	end

	-- Security flood light angled down into the alley.
	ctx.part("FloodHousing", Vector3.new(0.8, 0.5, 1.2), at(x - 0.6, 10.3, 25), S.MetalDark, folder)
	ctx.part("FloodLens", Vector3.new(0.5, 0.06, 1.0), at(x - 0.75, 10.03, 25), S.Sodium, folder)
	local srcPos = Vector3.new(x - 1.0, 10.0, 25)
	local source = PartFactory.make({
		Name = "FloodSource",
		Size = Vector3.new(0.2, 0.2, 0.2),
		CFrame = ctx.Origin * CFrame.lookAt(srcPos, srcPos + Vector3.new(-1, -1.6, 0)),
		Style = S.Invisible,
		Parent = folder,
	})
	addSpot(source, {
		Face = Enum.NormalId.Front,
		Angle = 80,
		Range = 32,
		Brightness = 2.6,
		Color = WARM_LIGHT,
		Shadows = true,
	})
end

--------------------------------------------------------------------------------
-- Workbench (LOADOUT shot)
--------------------------------------------------------------------------------
local function buildWorkbench(ctx: Ctx, parent: Instance)
	local folder = PartFactory.folder("Workbench", parent)
	local zc = 10

	ctx.part("Top", Vector3.new(2.6, 0.25, 7), at(13.6, 3.1, zc), S.Wood, folder, { Collide = true })
	ctx.part("FrontLip", Vector3.new(0.1, 0.25, 7), at(12.28, 3.1, zc), S.MetalDark, folder)
	for _, lx in { 12.45, 14.75 } do
		for _, lz in { zc - 3.3, zc + 3.3 } do
			ctx.part("Leg", Vector3.new(0.22, 2.95, 0.22), at(lx, 1.5, lz), S.MetalDark, folder, { Collide = true })
		end
	end
	ctx.part("Shelf", Vector3.new(2.4, 0.12, 6.6), at(13.6, 0.9, zc), S.Wood, folder)
	ctx.part("Pegboard", Vector3.new(0.12, 4.2, 7), at(WALL_FACE - 0.12, 5.6, zc), S.Pegboard, folder)
	ctx.part("PegboardFrameTop", Vector3.new(0.16, 0.12, 7.1), at(WALL_FACE - 0.14, 7.7, zc), S.MetalDark, folder)
	ctx.part("PegboardFrameBottom", Vector3.new(0.16, 0.12, 7.1), at(WALL_FACE - 0.14, 3.5, zc), S.MetalDark, folder)

	-- Tools on the pegboard
	local px = WALL_FACE - 0.22
	ctx.part("Wrench", Vector3.new(0.06, 1.3, 0.16), at(px, 6.0, zc - 2.4), S.MetalLight, folder)
	ctx.part("WrenchHead", Vector3.new(0.06, 0.22, 0.38), at(px, 6.68, zc - 2.4), S.MetalLight, folder)
	ctx.part("HammerHandle", Vector3.new(0.08, 1.0, 0.12), at(px, 5.8, zc - 1.6), S.Wood, folder)
	ctx.part("HammerHead", Vector3.new(0.1, 0.18, 0.5), at(px, 6.35, zc - 1.6), S.MetalDark, folder)
	ctx.part("Screwdriver", Vector3.new(0.05, 0.9, 0.05), at(px, 6.1, zc - 0.9), S.MetalLight, folder)
	ctx.part("ScrewdriverGrip", Vector3.new(0.09, 0.35, 0.09), at(px, 6.65, zc - 0.9), PartFactory.style(rgb(170, 40, 30), Enum.Material.SmoothPlastic), folder)
	ctx.part("TapeRoll", Vector3.new(0.18, 0.5, 0.5), at(px - 0.05, 6.2, zc + 2.6), S.FabricDark, folder, { Shape = Enum.PartType.Cylinder })
	ctx.part("Clipboard", Vector3.new(0.04, 0.9, 0.65), at(px, 5.2, zc + 1.6), PartFactory.style(rgb(200, 196, 182), Enum.Material.SmoothPlastic), folder)

	-- Upper shelf with boxes
	ctx.part("UpperShelf", Vector3.new(1.4, 0.12, 7), at(14.3, 8.0, zc), S.Wood, folder)
	for i, bz in { zc - 2.4, zc - 0.9, zc + 2.2 } do
		ctx.part("Box" .. i, Vector3.new(1.0, 0.8, 1.2), at(14.35, 8.46, bz) * CFrame.Angles(0, math.rad((i - 2) * 4), 0), S.Cardboard, folder)
	end

	-- Work lamp
	ctx.segment("LampArm", Vector3.new(WALL_FACE - 0.1, 9.0, zc), Vector3.new(13.2, 9.0, zc), 0.12, S.MetalDark, folder)
	ctx.part("LampShade", Vector3.new(0.9, 0.45, 0.9), at(13.2, 8.7, zc), S.MetalDark, folder)
	ctx.part("LampBulb", Vector3.new(0.4, 0.12, 0.4), at(13.2, 8.45, zc), S.Sodium, folder)
	local lampSource = ctx.part("LampSource", Vector3.new(0.2, 0.2, 0.2), at(13.2, 8.35, zc), S.Invisible, folder)
	addSpot(lampSource, {
		Face = Enum.NormalId.Bottom,
		Angle = 80,
		Range = 16,
		Brightness = 3,
		Color = WARM_LIGHT,
		Shadows = true,
	})
	addDownBeam(lampSource, 5, 0.7, 4.5, WARM_LIGHT)

	-- Bench items
	ctx.part("WeaponMat", Vector3.new(1.9, 0.03, 4.2), at(13.5, 3.24, zc - 0.6), S.FabricDark, folder)
	ctx.part("LaptopBase", Vector3.new(1.0, 0.05, 0.7), at(13.9, 3.25, zc + 2.4), S.MetalDark, folder)
	local screenCF = at(14.38, 3.6, zc + 2.4) * CFrame.Angles(0, 0, math.rad(-12))
	ctx.part("LaptopLid", Vector3.new(0.04, 0.7, 1.0), screenCF, S.MetalDark, folder)
	local screen = ctx.part("LaptopScreen", Vector3.new(0.02, 0.6, 0.9), screenCF * CFrame.new(-0.03, 0, 0), S.ScreenGlow, folder)
	local screenGui = Instance.new("SurfaceGui")
	screenGui.Face = Enum.NormalId.Left
	screenGui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	screenGui.PixelsPerStud = 120
	screenGui.LightInfluence = 0
	screenGui.Brightness = 1.4
	screenGui.Parent = screen
	local screenText = Instance.new("TextLabel")
	screenText.BackgroundTransparency = 1
	screenText.Size = UDim2.fromScale(0.86, 0.7)
	screenText.Position = UDim2.fromScale(0.07, 0.15)
	screenText.Text = "STASH TERMINAL\nAWAITING EXTRACTION"
	screenText.TextScaled = true
	screenText.TextColor3 = rgb(170, 240, 255)
	screenText.FontFace = Font.new("rbxasset://fonts/families/RobotoMono.json", Enum.FontWeight.Medium)
	screenText.Parent = screenGui
	addPoint(screen, 4, 0.8, rgb(60, 170, 220))

	for i, y in { 3.6, 4.37 } do
		ctx.part("AmmoCan" .. i, Vector3.new(0.5, 0.75, 1.1), at(13.85, y, zc + 3.0 - (i - 1) * 0.08), S.Olive, folder)
		ctx.part("AmmoHandle" .. i, Vector3.new(0.08, 0.06, 0.6), at(13.85, y + 0.41, zc + 3.0 - (i - 1) * 0.08), S.MetalDark, folder)
	end

	-- Duffel bag on the floor
	ctx.part("Duffel", Vector3.new(1.6, 1.1, 2.4), at(12.4, 0.75, zc + 5.2), S.FabricDark, folder, { Collide = true })
	for _, ez in { zc + 4.0, zc + 6.4 } do
		ctx.part("DuffelEnd", Vector3.new(0.12, 1.1, 1.1), at(12.4, 0.75, ez) * PartFactory.AxisZ, S.FabricDark, folder, { Shape = Enum.PartType.Cylinder })
	end
	ctx.part("DuffelStrap", Vector3.new(1.65, 0.06, 0.14), at(12.4, 1.32, zc + 5.2), S.MetalDark, folder)

	-- Mounting anchors for Phase 2 weapon models.
	local displays = PartFactory.folder("WeaponDisplays", folder)
	ctx.part("Display_Primary", Vector3.new(0.2, 0.2, 0.2), at(13.4, 3.32, zc - 1.4), S.Invisible, displays)
	ctx.part("Display_Secondary", Vector3.new(0.2, 0.2, 0.2), at(13.3, 3.3, zc + 0.9), S.Invisible, displays)
end

--------------------------------------------------------------------------------
-- Props
--------------------------------------------------------------------------------
local function buildProps(ctx: Ctx, parent: Instance)
	local folder = PartFactory.folder("Props", parent)
	local rng = ctx.Rng

	-- Dumpster
	local dz = 20
	local dx = -13.0
	ctx.part("DumpsterBody", Vector3.new(2.8, 3.0, 5.8), at(dx, 1.7, dz), S.Dumpster, folder, { Collide = true })
	ctx.part("DumpsterLid", Vector3.new(3.0, 0.15, 6.0), at(dx, 3.3, dz) * CFrame.Angles(0, 0, math.rad(-8)), S.Dumpster, folder)
	ctx.part("DumpsterRust", Vector3.new(0.05, 1.2, 2.0), at(dx + 1.42, 1.4, dz + 1.2), S.MetalRust, folder)
	for _, pz in { dz - 1.5, dz + 1.5 } do
		ctx.part("LiftPocket", Vector3.new(0.3, 0.5, 1.2), at(dx + 1.5, 2.3, pz), S.MetalDark, folder)
	end
	for _, wx in { dx - 1.1, dx + 1.1 } do
		for _, wz in { dz - 2.5, dz + 2.5 } do
			ctx.part("Caster", Vector3.new(0.25, 0.4, 0.4), at(wx, 0.2, wz), S.MetalDark, folder, { Shape = Enum.PartType.Cylinder })
		end
	end
	for i = 1, 5 do
		local d = rng:NextNumber(1.3, 1.8)
		ctx.part("TrashBag" .. i, Vector3.new(d, d, d), at(rng:NextNumber(-11.4, -10.4), d / 2 - 0.15, dz - 4 + i * 1.3), S.TrashBag, folder, {
			Shape = Enum.PartType.Ball,
			Collide = true,
		})
	end

	-- Crate stack
	local cratePositions = {
		at(11.2, 1.2, -16),
		at(11.3, 1.2, -18.6),
		at(11.25, 3.6, -17.2) * CFrame.Angles(0, math.rad(12), 0),
	}
	for i, cf in cratePositions do
		ctx.part("Crate" .. i, Vector3.new(2.4, 2.4, 2.4), cf, S.Wood, folder, { Collide = true })
		ctx.part("CrateStrapA" .. i, Vector3.new(2.46, 0.12, 0.08), cf * CFrame.new(0, 0, 0.6), S.MetalDark, folder)
		ctx.part("CrateStrapB" .. i, Vector3.new(2.46, 0.12, 0.08), cf * CFrame.new(0, 0, -0.6), S.MetalDark, folder)
	end

	-- Barrels
	local barrelColors = { rgb(52, 70, 96), rgb(110, 60, 40), rgb(60, 62, 58) }
	for i, pos in { Vector3.new(11.8, 0, -27), Vector3.new(10.2, 0, -28.4), Vector3.new(11.9, 0, -29.6) } do
		local barrelStyle = PartFactory.style(barrelColors[i], Enum.Material.CorrodedMetal)
		ctx.part("Barrel" .. i, Vector3.new(3.0, 2.0, 2.0), at(pos.X, 1.5, pos.Z) * PartFactory.AxisY, barrelStyle, folder, {
			Shape = Enum.PartType.Cylinder,
			Collide = true,
		})
		for _, ry in { 1.0, 2.0 } do
			ctx.part("BarrelRib" .. i .. "_" .. ry, Vector3.new(0.12, 2.06, 2.06), at(pos.X, ry, pos.Z) * PartFactory.AxisY, barrelStyle, folder, {
				Shape = Enum.PartType.Cylinder,
			})
		end
		ctx.part("BarrelLid" .. i, Vector3.new(0.05, 1.9, 1.9), at(pos.X, 3.01, pos.Z) * PartFactory.AxisY, S.MetalDark, folder, { Shape = Enum.PartType.Cylinder })
	end

	-- Pallets leaning on the right wall
	for i, pz in { -6, -8.4 } do
		local cf = at(WALL_FACE - 0.6 - i * 0.25, 1.8, pz) * CFrame.Angles(0, 0, math.rad(10 + i * 3))
		ctx.part("PalletBack" .. i, Vector3.new(0.12, 3.6, 4.0), cf, S.Wood, folder, { Collide = true })
		for slat = -1, 1 do
			ctx.part("PalletSlat" .. i .. "_" .. slat, Vector3.new(0.18, 3.6, 0.35), cf * CFrame.new(-0.12, 0, slat * 1.7), S.Wood, folder)
		end
	end

	-- Overhead cables with sag
	local cables = {
		{ Y = 19, Z = -40, Sag = 1.8 },
		{ Y = 21.5, Z = -18, Sag = 2.2 },
		{ Y = 24, Z = 0, Sag = 1.6 },
		{ Y = 19.5, Z = 12, Sag = 2.4 },
		{ Y = 26, Z = 34, Sag = 1.9 },
		{ Y = 22, Z = 56, Sag = 2.1 },
	}
	for i, cable in cables do
		local drift = rng:NextNumber(-1.2, 1.2)
		local a = Vector3.new(-WALL_FACE, cable.Y, cable.Z)
		local m = Vector3.new(0, cable.Y - cable.Sag, cable.Z + drift)
		local b = Vector3.new(WALL_FACE, cable.Y + rng:NextNumber(-0.8, 0.8), cable.Z + drift * 2)
		ctx.segment("CableA" .. i, a, m, 0.08, S.Cable, folder)
		ctx.segment("CableB" .. i, m, b, 0.08, S.Cable, folder)
	end
end

--------------------------------------------------------------------------------
-- FX, cameras, spawn points
--------------------------------------------------------------------------------
local function buildMist(ctx: Ctx, parent: Instance)
	local folder = PartFactory.folder("GroundMist", parent)
	for i, z in { -40, -6, 28, 62 } do
		local volume = ctx.part("MistVolume" .. i, Vector3.new(26, 0.5, 34), at(0, 0.6, z), S.Invisible, folder)
		local mist = smokeEmitter(volume, {
			Name = "Mist",
			Rate = 2.5,
			Lifetime = NumberRange.new(10, 14),
			Speed = NumberRange.new(0.2, 0.6),
			Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 9), NumberSequenceKeypoint.new(1, 14) }),
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1),
				NumberSequenceKeypoint.new(0.3, 0.9),
				NumberSequenceKeypoint.new(0.7, 0.92),
				NumberSequenceKeypoint.new(1, 1),
			}),
			Color = rgb(170, 176, 186),
			Direction = Enum.NormalId.Top,
			Spread = Vector2.new(60, 60),
			Acceleration = Vector3.new(0.25, 0.02, 0.1),
			Drag = 0.2,
		})
		CollectionService:AddTag(mist, "GroundMist")
	end
end

type ShotDef = { Name: string, From: Vector3, To: Vector3, Fov: number, Focus: number, Radius: number }

local function buildCameraRig(ctx: Ctx, parent: Instance)
	local folder = PartFactory.folder("CameraRig", parent)
	local shots: { ShotDef } = {
		{ Name = "MenuShot", From = Vector3.new(12.5, 3.7, -9.5), To = Vector3.new(0.6, 2.3, 7.6), Fov = 38, Focus = 20.6, Radius = 9 },
		{ Name = "LoadoutShot", From = Vector3.new(7.0, 5.6, 4.4), To = Vector3.new(12.4, 3.5, 11.55), Fov = 44, Focus = 9.1, Radius = 3.5 },
		{ Name = "SettingsShot", From = Vector3.new(-7.5, 1.6, -9.5), To = Vector3.new(-2.25, 1.9, -1.63), Fov = 30, Focus = 9.2, Radius = 2.6 },
	}
	for _, shot in shots do
		local part = PartFactory.make({
			Name = shot.Name,
			Size = Vector3.new(0.4, 0.4, 0.8),
			CFrame = ctx.Origin * CFrame.lookAt(shot.From, shot.To),
			Style = S.Invisible,
			Parent = folder,
		})
		part:SetAttribute("FieldOfView", shot.Fov)
		part:SetAttribute("FocusDistance", shot.Focus)
		part:SetAttribute("InFocusRadius", shot.Radius)
	end
end

local function buildDeployPoints(ctx: Ctx, parent: Instance)
	local folder = PartFactory.folder("DeployPoints", parent)
	for i, p in { Vector3.new(5, 0.1, -2), Vector3.new(7.5, 0.1, -0.8), Vector3.new(2.6, 0.1, -0.4), Vector3.new(9.5, 0.1, -3.2) } do
		PartFactory.make({
			Name = "DeployPoint" .. i,
			Size = Vector3.new(2, 0.2, 2),
			CFrame = ctx.Origin * CFrame.lookAt(p, p + Vector3.zAxis),
			Style = S.Invisible,
			Parent = folder,
		})
	end
end

--------------------------------------------------------------------------------
-- Public API
--------------------------------------------------------------------------------
function SafehouseBuilder.build(): Model
	local origin = Config.World.Origin
	local ctx = makeCtx(origin, 7)

	local model = Instance.new("Model")
	model.Name = Config.World.SafehouseName
	model.ModelStreamingMode = Enum.ModelStreamingMode.Persistent

	buildGround(ctx, model)
	local buildings = PartFactory.folder("Buildings", model)
	buildBuilding(ctx, buildings, -1)
	buildBuilding(ctx, buildings, 1)
	buildFireEscape(ctx, buildings)
	buildStreetlamps(ctx, model)
	buildNeon(ctx, model)
	buildGarage(ctx, model)
	buildWorkbench(ctx, model)
	buildProps(ctx, model)
	buildMist(ctx, model)
	buildCameraRig(ctx, model)
	buildDeployPoints(ctx, model)

	local car = GetawayCarBody.build(origin * Config.World.CarPose, {
		Name = Config.World.CarName,
		Anchored = true,
		PlateText = Config.Branding.PlateText,
	})
	car.Model.Parent = model

	model.PrimaryPart = nil
	model.Parent = Workspace
	return model
end

-- Returns the existing Safehouse (e.g. one baked in edit mode) or builds it.
function SafehouseBuilder.ensure(rebuild: boolean?): Model
	local existing = Workspace:FindFirstChild(Config.World.SafehouseName)
	if existing and existing:IsA("Model") then
		if not rebuild then
			return existing
		end
		existing:Destroy()
	end
	local started = os.clock()
	local model = SafehouseBuilder.build()
	local count = 0
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			count += 1
		end
	end
	print(string.format("[Safehouse] built %d parts in %.1f ms", count, (os.clock() - started) * 1000))
	return model
end

return SafehouseBuilder
]]></ProtectedString></Properties></Item></Item></Item></Item><Item class="StarterPlayer" referent="RBX000039"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX000038"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="Folder" referent="RBX000037"><Properties><string name="Name">Client</string></Properties><Item class="LocalScript" referent="RBX000024"><Properties><string name="Name">ClientBootstrap</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	ClientBootstrap (LocalScript)
	Client entry point. Initialises controllers in dependency order and wires
	the server-driven player state to the menu / gameplay flow.
]]

local Players = game:GetService("Players")

local Controllers = script.Parent.Controllers
local SettingsController = require(Controllers.SettingsController)
local AudioController = require(Controllers.AudioController)
local CinematicGrade = require(Controllers.CinematicGrade)
local AtmosphereController = require(Controllers.AtmosphereController)
local MenuCamera = require(Controllers.MenuCamera)
local MenuController = require(Controllers.MenuController)

local player = Players.LocalPlayer

SettingsController.init()
AudioController.init()
CinematicGrade.init()
AtmosphereController.init({
	Flash = CinematicGrade.flash,
	Thunder = AudioController.thunder,
	EngineSound = function(): Sound?
		return AudioController.get("EngineIdle")
	end,
})

local function applyQuality(settings: any)
	AtmosphereController.applyQuality(settings.Quality)
	CinematicGrade.applyQuality(settings.Quality)
end
applyQuality(SettingsController.get())
SettingsController.Changed:Connect(applyQuality)

MenuCamera.init()
MenuController.init()
MenuController.enter(false)

player:GetAttributeChangedSignal("State"):Connect(function()
	if player:GetAttribute("State") == "Menu" and MenuController.isDeployed() then
		task.spawn(MenuController.returnFromRaid)
	end
end)
]]></ProtectedString></Properties></Item><Item class="Folder" referent="RBX000032"><Properties><string name="Name">Controllers</string></Properties><Item class="ModuleScript" referent="RBX000025"><Properties><string name="Name">AtmosphereController</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	AtmosphereController
	Everything weather/ambience that should run per-client:

	  • Camera-following rain volume (velocity-aligned streaks, wind drift)
	  • Ground splashes snapped to the surface under the camera
	  • Lightning: double-strike exposure flash + delayed thunder
	  • Flicker for anything tagged "FlickerLight" (lamps, neon sign, bulbs)
	  • Idle engine rumble + lope on the parked getaway car
	  • Quality preset toggles for mist, volumetric beams, exhaust smoke and
	    shadow-casting lights
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Types = require(Shared.Types)

type Hooks = {
	Flash: (amount: number) -> (),
	Thunder: (intensity: number) -> (),
	EngineSound: () -> Sound?,
}

local AtmosphereController = {}

local SPARK_TEXTURE = "rbxasset://textures/particles/sparkles_main.dds"
local RAIN_COLOR = Color3.fromRGB(200, 210, 225)

local preset: Types.QualityPreset = Config.Quality.High
local hooks: Hooks
local fxFolder: Folder
local rainPart: BasePart
local rainEmitter: ParticleEmitter
local splashPart: BasePart
local splashEmitter: ParticleEmitter
local rayParams = RaycastParams.new()
local groundY = 0
local groundTimer = 0
local rng = Random.new()

local carRoot: BasePart? = nil
local carBase: CFrame? = nil

local function makeFxPart(name: string, size: Vector3): BasePart
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Transparency = 1
	part.CastShadow = false
	part.Parent = fxFolder
	return part
end

local function buildRain()
	local area = Config.Weather.RainAreaSize
	rainPart = makeFxPart("RainVolume", Vector3.new(area, 1, area))
	rainEmitter = Instance.new("ParticleEmitter")
	rainEmitter.Name = "Rain"
	rainEmitter.Texture = SPARK_TEXTURE
	rainEmitter.EmissionDirection = Enum.NormalId.Bottom
	rainEmitter.Orientation = Enum.ParticleOrientation.VelocityParallel
	rainEmitter.Speed = Config.Weather.RainSpeed
	rainEmitter.SpreadAngle = Vector2.new(3, 3)
	rainEmitter.Acceleration = Config.Weather.Wind
	rainEmitter.Lifetime = NumberRange.new(0.55, 0.75)
	rainEmitter.Size = NumberSequence.new(0.16)
	rainEmitter.Squash = NumberSequence.new(-2.6)
	rainEmitter.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.55),
		NumberSequenceKeypoint.new(0.85, 0.62),
		NumberSequenceKeypoint.new(1, 1),
	})
	rainEmitter.Color = ColorSequence.new(RAIN_COLOR)
	rainEmitter.LightEmission = 0.15
	rainEmitter.LightInfluence = 0.9
	rainEmitter.Rate = preset.RainRate
	rainEmitter.Parent = rainPart

	splashPart = makeFxPart("SplashVolume", Vector3.new(40, 0.2, 40))
	splashEmitter = Instance.new("ParticleEmitter")
	splashEmitter.Name = "Splash"
	splashEmitter.Texture = SPARK_TEXTURE
	splashEmitter.EmissionDirection = Enum.NormalId.Top
	splashEmitter.Speed = NumberRange.new(2, 4)
	splashEmitter.SpreadAngle = Vector2.new(60, 60)
	splashEmitter.Acceleration = Vector3.new(0, -30, 0)
	splashEmitter.Lifetime = NumberRange.new(0.12, 0.22)
	splashEmitter.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.05),
		NumberSequenceKeypoint.new(1, 0.22),
	})
	splashEmitter.Squash = NumberSequence.new(0.8)
	splashEmitter.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.45),
		NumberSequenceKeypoint.new(1, 1),
	})
	splashEmitter.Color = ColorSequence.new(RAIN_COLOR)
	splashEmitter.LightInfluence = 1
	splashEmitter.Rate = preset.RainRate * 0.35
	splashEmitter.Parent = splashPart
end

local function refreshRayFilter()
	local ignore: { Instance } = { fxFolder }
	local character = Players.LocalPlayer.Character
	if character then
		table.insert(ignore, character)
	end
	rayParams.FilterType = Enum.RaycastFilterType.Exclude
	rayParams.FilterDescendantsInstances = ignore
end

local function followCamera(dt: number)
	local camera = Workspace.CurrentCamera
	if not camera then
		return
	end
	local cf = camera.CFrame
	local flatLook = Vector3.new(cf.LookVector.X, 0, cf.LookVector.Z)
	if flatLook.Magnitude > 1e-3 then
		flatLook = flatLook.Unit
	end
	-- Bias the volume ahead of the view and upwind so streaks fill the frame.
	local wind = Config.Weather.Wind
	local upwind = -Vector3.new(wind.X, 0, wind.Z) * 0.25
	rainPart.CFrame = CFrame.new(cf.Position + Vector3.new(0, Config.Weather.RainHeight, 0) + flatLook * 18 + upwind)

	groundTimer -= dt
	if groundTimer <= 0 then
		groundTimer = 0.25
		refreshRayFilter()
		local hit = Workspace:Raycast(cf.Position, Vector3.new(0, -200, 0), rayParams)
		if hit then
			groundY = hit.Position.Y
		end
	end
	splashPart.CFrame = CFrame.new(cf.Position.X + flatLook.X * 10, groundY + 0.15, cf.Position.Z + flatLook.Z * 10)
end

--------------------------------------------------------------------------------
-- Flicker
--------------------------------------------------------------------------------
type FlickerTarget = {
	Lights: { Light },
	Beams: { Beam },
	Neon: { BasePart },
	NeonColors: { Color3 },
	Guis: { SurfaceGui },
	GuiBrightness: { number },
}

local function collectFlicker(root: Instance): FlickerTarget
	local target: FlickerTarget = { Lights = {}, Beams = {}, Neon = {}, NeonColors = {}, Guis = {}, GuiBrightness = {} }
	local candidates = root:GetDescendants()
	table.insert(candidates, root)
	for _, d in candidates do
		if d:IsA("Light") then
			table.insert(target.Lights, d)
		elseif d:IsA("Beam") then
			table.insert(target.Beams, d)
		elseif d:IsA("BasePart") and d.Material == Enum.Material.Neon then
			table.insert(target.Neon, d)
			table.insert(target.NeonColors, d.Color)
		elseif d:IsA("SurfaceGui") then
			table.insert(target.Guis, d)
			table.insert(target.GuiBrightness, d.Brightness)
		end
	end
	return target
end

local function setFlickerOn(target: FlickerTarget, on: boolean, level: number)
	for _, light in target.Lights do
		light.Enabled = on
	end
	for _, beam in target.Beams do
		beam.Enabled = on and preset.Beams
	end
	for i, part in target.Neon do
		local base = target.NeonColors[i]
		part.Color = if on then base else base:Lerp(Color3.new(0, 0, 0), 0.82 * level)
	end
	for i, gui in target.Guis do
		gui.Brightness = if on then target.GuiBrightness[i] else target.GuiBrightness[i] * (1 - 0.85 * level)
	end
end

local function runFlicker(instance: Instance)
	local target = collectFlicker(instance)
	local isSign = instance:GetAttribute("FlickerStyle") == "Sign"
	task.spawn(function()
		while instance.Parent do
			-- Long stable stretch, then a burst of stutters.
			task.wait(if isSign then rng:NextNumber(5, 14) else rng:NextNumber(2.5, 8))
			local bursts = rng:NextInteger(2, if isSign then 4 else 7)
			for _ = 1, bursts do
				if not instance.Parent then
					return
				end
				setFlickerOn(target, false, rng:NextNumber(0.6, 1))
				task.wait(rng:NextNumber(0.03, 0.11))
				setFlickerOn(target, true, 1)
				task.wait(rng:NextNumber(0.04, 0.25))
			end
			-- Occasional long dropout on bad lamps.
			if not isSign and rng:NextNumber() < 0.18 then
				setFlickerOn(target, false, 1)
				task.wait(rng:NextNumber(0.4, 1.4))
				setFlickerOn(target, true, 1)
			end
		end
	end)
end

--------------------------------------------------------------------------------
-- Lightning
--------------------------------------------------------------------------------
local function runLightning()
	task.spawn(function()
		local interval = Config.Weather.LightningInterval
		while true do
			task.wait(rng:NextNumber(interval.Min, interval.Max))
			if preset.Lightning then
				local strength = rng:NextNumber(0.6, 1.25)
				hooks.Flash(1.1 * strength)
				task.wait(rng:NextNumber(0.07, 0.14))
				hooks.Flash(0.65 * strength)
				if rng:NextNumber() < 0.5 then
					task.wait(rng:NextNumber(0.12, 0.25))
					hooks.Flash(0.4 * strength)
				end
				local delay = Config.Weather.ThunderDelay
				task.delay(rng:NextNumber(delay.Min, delay.Max), hooks.Thunder, strength)
			end
		end
	end)
end

--------------------------------------------------------------------------------
-- Car idle
--------------------------------------------------------------------------------
local function bindCar()
	task.spawn(function()
		local safehouse = Workspace:WaitForChild(Config.World.SafehouseName, 60)
		local car = safehouse and safehouse:WaitForChild(Config.World.CarName, 30)
		local root = car and car:WaitForChild("Root", 30)
		if root and root:IsA("BasePart") and root.Anchored then
			carRoot = root
			carBase = root.CFrame
		end
	end)
end

local function idleCar()
	local root = carRoot
	local base = carBase
	local camera = Workspace.CurrentCamera
	if not root or not base or not camera then
		return
	end
	if (camera.CFrame.Position - base.Position).Magnitude > 140 then
		return
	end
	local t = os.clock()
	-- Muscle-car cam lope (~2.2 Hz) on top of high-frequency rumble.
	local lope = math.sin(t * 2.2 * 2 * math.pi) * math.sin(t * 0.7) * 0.5 + 0.5
	local rumble = math.noise(t * 22, 0.3) * 0.012
	local roll = math.noise(t * 17, 4.1) * 0.0016 + (lope - 0.5) * 0.0012
	local pitch = math.noise(t * 19, 9.2) * 0.0012
	root.CFrame = base * CFrame.new(0, rumble + lope * 0.004, 0) * CFrame.Angles(pitch, 0, roll)

	local engine = hooks.EngineSound()
	if engine then
		local def = Config.Audio.EngineIdle
		engine.PlaybackSpeed = def.Speed * (0.97 + lope * 0.05)
	end
end

--------------------------------------------------------------------------------
-- Quality
--------------------------------------------------------------------------------
local function applyTagged(tag: string, apply: (Instance) -> ())
	for _, instance in CollectionService:GetTagged(tag) do
		apply(instance)
	end
end

local function applyPresetToInstance(tag: string, instance: Instance)
	if tag == "GroundMist" and instance:IsA("ParticleEmitter") then
		instance.Enabled = preset.GroundMist
	elseif tag == "VolumetricBeam" and instance:IsA("Beam") then
		instance.Enabled = preset.Beams
	elseif tag == "ExhaustSmoke" and instance:IsA("ParticleEmitter") then
		instance.Enabled = preset.ExhaustSmoke
	elseif tag == "ShadowLight" and instance:IsA("Light") then
		instance.Shadows = preset.LightShadows
	end
end

local QUALITY_TAGS = { "GroundMist", "VolumetricBeam", "ExhaustSmoke", "ShadowLight" }

function AtmosphereController.applyQuality(quality: Types.QualityLevel)
	preset = Config.Quality[quality] or Config.Quality.High
	if rainEmitter then
		rainEmitter.Rate = preset.RainRate
		splashEmitter.Rate = preset.RainRate * 0.35
		splashEmitter.Enabled = preset.Splashes
	end
	for _, tag in QUALITY_TAGS do
		applyTagged(tag, function(instance: Instance)
			applyPresetToInstance(tag, instance)
		end)
	end
end

function AtmosphereController.init(injected: Hooks)
	hooks = injected
	local folder = Instance.new("Folder")
	folder.Name = "ClientFX"
	folder.Parent = Workspace
	fxFolder = folder

	buildRain()
	refreshRayFilter()

	for _, instance in CollectionService:GetTagged("FlickerLight") do
		runFlicker(instance)
	end
	CollectionService:GetInstanceAddedSignal("FlickerLight"):Connect(runFlicker)

	-- Late-streamed tagged instances still get the active preset.
	for _, tag in QUALITY_TAGS do
		CollectionService:GetInstanceAddedSignal(tag):Connect(function(instance: Instance)
			applyPresetToInstance(tag, instance)
		end)
	end

	runLightning()
	bindCar()

	RunService:BindToRenderStep("Atmosphere", Enum.RenderPriority.Camera.Value + 10, function(dt: number)
		followCamera(dt)
		idleCar()
	end)
end

return AtmosphereController
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000026"><Properties><string name="Name">AudioController</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	AudioController
	SoundGroups (UI / Ambience / World), 2D UI one-shots with pitch variance,
	looping rain bed, distant thunder, and the 3D engine idle on the car.
	Any Config.Audio entry with an empty Id is skipped cleanly.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)

local AudioController = {}

local groups: { [string]: SoundGroup } = {}
local sounds: { [string]: Sound } = {}
local rng = Random.new()

local function ensureGroup(name: string, volume: number): SoundGroup
	local existing = SoundService:FindFirstChild(name)
	if existing and existing:IsA("SoundGroup") then
		return existing
	end
	local group = Instance.new("SoundGroup")
	group.Name = name
	group.Volume = volume
	group.Parent = SoundService
	return group
end

local function makeSound(name: string, parent: Instance): Sound?
	local def = Config.Audio[name]
	if not def or def.Id == "" then
		return nil
	end
	local sound = Instance.new("Sound")
	sound.Name = name
	sound.SoundId = def.Id
	sound.Volume = def.Volume
	sound.PlaybackSpeed = def.Speed
	sound.SoundGroup = groups[def.Group]
	sound.Parent = parent
	sounds[name] = sound
	return sound
end

function AudioController.init()
	groups.UI = ensureGroup("UI", 1)
	groups.Ambience = ensureGroup("Ambience", 1)
	groups.World = ensureGroup("World", 1)

	local missing: { string } = {}
	for name, def in Config.Audio do
		if def.Id == "" then
			table.insert(missing, name)
		end
	end
	if #missing > 0 then
		table.sort(missing)
		warn(
			"[Audio] No asset id set for: "
				.. table.concat(missing, ", ")
				.. " — paste rbxassetid:// ids you own into Shared.Config.Audio to enable them."
		)
	end

	for _, name in { "UIHover", "UIClick", "UIBack", "UIDeploy", "UITick", "Thunder" } do
		makeSound(name, SoundService)
	end

	local rain = makeSound("RainLoop", SoundService)
	if rain then
		rain.Looped = true
		rain:Play()
	end

	-- Engine idle lives on the car so it falls off with distance.
	task.spawn(function()
		local safehouse = Workspace:WaitForChild(Config.World.SafehouseName, 60)
		local car = safehouse and safehouse:WaitForChild(Config.World.CarName, 30)
		local bay = car and car:WaitForChild("EngineBay", 30)
		if bay and bay:IsA("BasePart") then
			local engine = makeSound("EngineIdle", bay)
			if engine then
				engine.Looped = true
				engine.RollOffMode = Enum.RollOffMode.InverseTapered
				engine.RollOffMinDistance = 6
				engine.RollOffMaxDistance = 90
				engine:Play()
			end
		end
	end)
end

-- Fire-and-forget 2D one-shot with optional pitch variance (±fraction).
function AudioController.play(name: string, variance: number?)
	local sound = sounds[name]
	local def = Config.Audio[name]
	if not sound or not def then
		return
	end
	local v = variance or 0.04
	sound.PlaybackSpeed = def.Speed * (1 + rng:NextNumber(-v, v))
	SoundService:PlayLocalSound(sound)
end

function AudioController.thunder(intensity: number)
	local sound = sounds.Thunder
	local def = Config.Audio.Thunder
	if not sound or not def then
		return
	end
	sound.Volume = def.Volume * math.clamp(intensity, 0.2, 1.2)
	sound.PlaybackSpeed = def.Speed * rng:NextNumber(0.85, 1.05)
	sound:Play()
end

function AudioController.get(name: string): Sound?
	return sounds[name]
end

-- Ducks the world/ambience while in the menu so UI reads cleanly.
function AudioController.setMenuMix(inMenu: boolean, duration: number?)
	local info = TweenInfo.new(duration or 1.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
	local ambience = groups.Ambience
	local world = groups.World
	if ambience then
		TweenService:Create(ambience, info, { Volume = if inMenu then 0.75 else 1 }):Play()
	end
	if world then
		TweenService:Create(world, info, { Volume = if inMenu then 0.8 else 1 }):Play()
	end
end

return AudioController
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000027"><Properties><string name="Name">CinematicGrade</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	CinematicGrade
	Client-side owner of the post-processing stack created by the server's
	LightingService. Every frame it writes:

		value = lerp(menuGrade, gameplayGrade, blend) + transient offsets

	• blend 0 = menu (heavy DOF focused on the current shot subject, darker,
	  punchier), blend 1 = gameplay grade from Config.Lighting.
	• Menu focus distance/radius glide on a spring when the shot changes.
	• flash() adds a decaying exposure spike (lightning).
	• Quality presets toggle DOF / SunRays and scale Bloom.

	Client writes to replicated Lighting objects stay local to this player.
]]

local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Spring = require(Shared.Spring)
local Types = require(Shared.Types)

local CinematicGrade = {}

local NAMES = {
	ColorCorrection = "Grade_ColorCorrection",
	Bloom = "Grade_Bloom",
	DepthOfField = "Grade_DepthOfField",
	SunRays = "Grade_SunRays",
}

local cc: ColorCorrectionEffect? = nil
local bloom: BloomEffect? = nil
local dof: DepthOfFieldEffect? = nil
local rays: SunRaysEffect? = nil

local blend = 0
local flashOffset = 0
local preset: Types.QualityPreset = Config.Quality.High
local focusSpring = Spring.new(Vector3.new(20, 9, 0), 0.9, 1)

local function lerp(a: number, b: number, t: number): number
	return a + (b - a) * t
end

local function find(name: string, className: string): Instance?
	local inst = Lighting:WaitForChild(name, 10)
	if inst and inst.ClassName == className then
		return inst
	end
	warn("[CinematicGrade] missing Lighting effect:", name)
	return nil
end

local function step(dt: number)
	local G = Config.Lighting
	local M = Config.MenuGrade
	local focus = focusSpring:update(dt)
	local t = blend

	local depth = dof
	if depth then
		depth.Enabled = preset.DepthOfField
		depth.FocusDistance = lerp(focus.X, G.DepthOfField.FocusDistance, t)
		depth.InFocusRadius = lerp(focus.Y, G.DepthOfField.InFocusRadius, t)
		depth.FarIntensity = lerp(M.FarIntensity, G.DepthOfField.FarIntensity, t)
		depth.NearIntensity = lerp(M.NearIntensity, G.DepthOfField.NearIntensity, t)
	end

	local grade = cc
	if grade then
		grade.Contrast = lerp(M.Contrast, G.ColorCorrection.Contrast, t)
		grade.Saturation = lerp(M.Saturation, G.ColorCorrection.Saturation, t)
	end

	local glow = bloom
	if glow then
		glow.Intensity = G.Bloom.Intensity * preset.BloomScale * (1 + flashOffset * 0.25)
	end

	local sun = rays
	if sun then
		sun.Enabled = preset.SunRays
	end

	Lighting.ExposureCompensation = lerp(M.ExposureCompensation, G.ExposureCompensation, t) + flashOffset
	flashOffset *= math.exp(-dt * 9)
	if flashOffset < 0.002 then
		flashOffset = 0
	end
end

function CinematicGrade.init()
	cc = find(NAMES.ColorCorrection, "ColorCorrectionEffect") :: any
	bloom = find(NAMES.Bloom, "BloomEffect") :: any
	dof = find(NAMES.DepthOfField, "DepthOfFieldEffect") :: any
	rays = find(NAMES.SunRays, "SunRaysEffect") :: any
	RunService:BindToRenderStep("CinematicGrade", Enum.RenderPriority.Last.Value, step)
end

-- 0 = menu grade, 1 = gameplay grade.
function CinematicGrade.setBlend(alpha: number)
	blend = math.clamp(alpha, 0, 1)
end

function CinematicGrade.getBlend(): number
	return blend
end

function CinematicGrade.setMenuFocus(distance: number, radius: number, instant: boolean?)
	local target = Vector3.new(distance, radius, 0)
	if instant then
		focusSpring:reset(target)
	else
		focusSpring.Target = target
	end
end

function CinematicGrade.flash(amount: number)
	flashOffset = math.max(flashOffset, amount)
end

function CinematicGrade.applyQuality(quality: Types.QualityLevel)
	preset = Config.Quality[quality] or Config.Quality.High
end

return CinematicGrade
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000028"><Properties><string name="Name">MenuCamera</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	MenuCamera
	Cinematic camera for the safehouse menu.

	final = shotBase(eased between CameraRig parts) * dolly * breathing * parallax

	• Shots are invisible parts under Safehouse.CameraRig. Attributes on each
	  part (FieldOfView, FocusDistance, InFocusRadius) drive lens + DOF, so a
	  designer can re-frame shots in Studio without touching code.
	• Breathing = layered Perlin noise on position + rotation (handheld feel).
	• Parallax = spring-smoothed rotation toward the mouse/right stick.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Spring = require(Shared.Spring)

local CinematicGrade = require(script.Parent.CinematicGrade)

local MenuCamera = {}

local RENDER_NAME = "MenuCamera"
local C = Config.Camera.Menu

local rig: Instance? = nil
local running = false

local fromCF = CFrame.identity
local toCF = CFrame.identity
local fromFov = 38
local toFov = 38
local transitionTime = 0
local transitionDuration = 0

local dollySpring = Spring.new(Vector3.zero, 0.7, 1)
local parallaxSpring = Spring.new(Vector3.zero, C.ParallaxFrequency, 0.9)
local gamepadLook = Vector2.zero

local lastCF = CFrame.identity
local lastFov = 38

local function easeInOutQuint(t: number): number
	if t < 0.5 then
		return 16 * t * t * t * t * t
	end
	local f = -2 * t + 2
	return 1 - (f * f * f * f * f) / 2
end

local function getShot(name: string): BasePart?
	local container = rig
	if not container then
		return nil
	end
	local part = container:FindFirstChild(name)
	if part and part:IsA("BasePart") then
		return part
	end
	return nil
end

local function attrNumber(part: BasePart, name: string, fallback: number): number
	local value = part:GetAttribute(name)
	return if typeof(value) == "number" then value else fallback
end

local function currentBase(): (CFrame, number)
	if transitionDuration <= 0 then
		return toCF, toFov
	end
	local alpha = easeInOutQuint(math.clamp(transitionTime / transitionDuration, 0, 1))
	return fromCF:Lerp(toCF, alpha), fromFov + (toFov - fromFov) * alpha
end

local function step(dt: number)
	local camera = Workspace.CurrentCamera
	if not camera then
		return
	end
	camera.CameraType = Enum.CameraType.Scriptable

	if transitionDuration > 0 then
		transitionTime += dt
		if transitionTime >= transitionDuration then
			transitionDuration = 0
		end
	end
	local base, fov = currentBase()

	-- Breathing (handheld drift)
	local t = os.clock() * C.BreathSpeed
	local pos = Vector3.new(math.noise(t, 1.3), math.noise(t * 0.8, 7.1), math.noise(t * 0.7, 3.7)) * (C.BreathPosition * 2)
	local rotScale = math.rad(C.BreathRotation) * 2
	local breathRot = CFrame.Angles(
		math.noise(t * 1.2, 11.1) * rotScale,
		math.noise(t * 0.9, 5.3) * rotScale,
		math.noise(t * 0.6, 2.9) * rotScale * 0.5
	)

	-- Parallax toward pointer / right stick
	local viewport = camera.ViewportSize
	local mouse = UserInputService:GetMouseLocation()
	local nx = if viewport.X > 0 then math.clamp(mouse.X / viewport.X * 2 - 1, -1, 1) else 0
	local ny = if viewport.Y > 0 then math.clamp(mouse.Y / viewport.Y * 2 - 1, -1, 1) else 0
	if gamepadLook.Magnitude > 0.1 then
		nx, ny = gamepadLook.X, -gamepadLook.Y
	end
	parallaxSpring.Target = Vector3.new(-nx * math.rad(C.ParallaxYaw), -ny * math.rad(C.ParallaxPitch), 0)
	local parallax = parallaxSpring:update(dt)
	local dolly = dollySpring:update(dt)

	local final = base * CFrame.new(0, 0, -dolly.X) * CFrame.new(pos) * breathRot * CFrame.Angles(parallax.Y, parallax.X, 0)
	camera.CFrame = final
	camera.FieldOfView = fov
	lastCF = final
	lastFov = fov
end

function MenuCamera.init()
	local safehouse = Workspace:WaitForChild(Config.World.SafehouseName, 60)
	rig = if safehouse then safehouse:WaitForChild("CameraRig", 30) else nil
	if not rig then
		warn("[MenuCamera] Safehouse.CameraRig not found — menu camera will hold its last frame.")
	end

	UserInputService.InputChanged:Connect(function(input: InputObject)
		if input.KeyCode == Enum.KeyCode.Thumbstick2 then
			gamepadLook = Vector2.new(input.Position.X, input.Position.Y)
		end
	end)
end

-- Moves to a rig shot. instant = cut (used when entering the menu).
function MenuCamera.goTo(shotName: string, instant: boolean?)
	local shot = getShot(shotName)
	if not shot then
		return
	end
	local targetFov = attrNumber(shot, "FieldOfView", 38)
	if instant or not running then
		fromCF, toCF = shot.CFrame, shot.CFrame
		fromFov, toFov = targetFov, targetFov
		transitionDuration = 0
	else
		local currentCF, currentFov = currentBase()
		fromCF, fromFov = currentCF, currentFov
		toCF, toFov = shot.CFrame, targetFov
		transitionTime = 0
		transitionDuration = C.ShotTransitionTime
	end
	CinematicGrade.setMenuFocus(attrNumber(shot, "FocusDistance", 20), attrNumber(shot, "InFocusRadius", 8), instant)
end

function MenuCamera.start(shotName: string)
	dollySpring:reset(Vector3.zero)
	parallaxSpring:reset(Vector3.zero)
	running = false
	MenuCamera.goTo(shotName, true)
	running = true
	RunService:UnbindFromRenderStep(RENDER_NAME)
	RunService:BindToRenderStep(RENDER_NAME, Enum.RenderPriority.Camera.Value + 1, step)
	step(0)
end

function MenuCamera.stop()
	running = false
	RunService:UnbindFromRenderStep(RENDER_NAME)
end

-- Slow push-in while the server spawns the character.
function MenuCamera.pushIn(studs: number)
	dollySpring.Target = Vector3.new(studs, 0, 0)
end

function MenuCamera.getCFrame(): CFrame
	return lastCF
end

function MenuCamera.getFieldOfView(): number
	return lastFov
end

function MenuCamera.isRunning(): boolean
	return running
end

return MenuCamera
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000029"><Properties><string name="Name">MenuController</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	MenuController
	Orchestrates the safehouse menu experience:

	  enter()          CoreGui hidden, menu camera on MenuShot, UI in, input bound
	  LOADOUT/SETTINGS camera glides to the workbench / headlight shot + panel
	  DEPLOY           UI out → server spawns character → camera blends from the
	                   live menu frame into the live tactical camera (no cut),
	                   grade blends menu → gameplay, letterbox retracts
	  returnFromRaid() fade to black → back into the menu (death / extraction)
]]

local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local StarterGui = game:GetService("StarterGui")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Net = require(Shared.Net)

local Controllers = script.Parent
local AudioController = require(Controllers.AudioController)
local CinematicGrade = require(Controllers.CinematicGrade)
local MenuCamera = require(Controllers.MenuCamera)
local SettingsController = require(Controllers.SettingsController)
local TacticalCamera = require(Controllers.TacticalCamera)
local MenuUI = require(Controllers.Parent.UI.MenuUI)

local player = Players.LocalPlayer

local MenuController = {}

local INPUT_ACTION = "ZabourMenuNavigation"
local TRANSITION_STEP = "ZabourDeployTransition"

local ui: MenuUI.MenuUI
local active = false
local busy = false
local deployed = false

local function hasKey(list: { Enum.KeyCode }, key: Enum.KeyCode): boolean
	return table.find(list, key) ~= nil
end

local function setCoreGui(inMenu: boolean)
	pcall(function()
		StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.All, false)
		if not inMenu then
			for _, coreType in Config.CoreGui.Gameplay do
				StarterGui:SetCoreGuiEnabled(coreType, true)
			end
		end
	end)
end

local function smootherstep(t: number): number
	local x = math.clamp(t, 0, 1)
	return x * x * x * (x * (x * 6 - 15) + 10)
end

--------------------------------------------------------------------------------
-- Panels / camera shots
--------------------------------------------------------------------------------
local function closePanel()
	if ui:getPanel() == nil then
		return
	end
	ui:openPanel(nil)
	MenuCamera.goTo("MenuShot")
end

local function togglePanel(name: "Loadout" | "Settings")
	if ui:getPanel() == name then
		closePanel()
		return
	end
	ui:openPanel(name)
	MenuCamera.goTo(name .. "Shot")
end

--------------------------------------------------------------------------------
-- Input
--------------------------------------------------------------------------------
local function onMenuInput(_: string, state: Enum.UserInputState, input: InputObject): Enum.ContextActionResult
	if state ~= Enum.UserInputState.Begin or not active or busy then
		return Enum.ContextActionResult.Pass
	end
	local key = input.KeyCode
	local binds = Config.Keybinds
	if hasKey(binds.MenuUp, key) then
		ui:navigate(-1)
	elseif hasKey(binds.MenuDown, key) then
		ui:navigate(1)
	elseif hasKey(binds.MenuLeft, key) then
		ui:adjust(-1)
	elseif hasKey(binds.MenuRight, key) then
		ui:adjust(1)
	elseif hasKey(binds.MenuSelect, key) then
		ui:activate()
	elseif hasKey(binds.MenuBack, key) then
		if ui:getPanel() then
			AudioController.play("UIBack")
			closePanel()
		end
	else
		return Enum.ContextActionResult.Pass
	end
	return Enum.ContextActionResult.Sink
end

local function bindInput()
	local keys: { Enum.KeyCode } = {}
	local binds = Config.Keybinds
	for _, list in { binds.MenuUp, binds.MenuDown, binds.MenuLeft, binds.MenuRight, binds.MenuSelect, binds.MenuBack } do
		for _, key in list do
			if not table.find(keys, key) then
				table.insert(keys, key)
			end
		end
	end
	ContextActionService:BindActionAtPriority(INPUT_ACTION, onMenuInput, false, Enum.ContextActionPriority.High.Value, table.unpack(keys))
end

local function unbindInput()
	ContextActionService:UnbindAction(INPUT_ACTION)
end

--------------------------------------------------------------------------------
-- Deploy
--------------------------------------------------------------------------------
local function waitForDeployedCharacter(timeout: number): Model?
	local started = os.clock()
	local seenDeploying = false
	while os.clock() - started < timeout do
		local state = player:GetAttribute("State")
		local character = player.Character
		if state == "Deploying" then
			seenDeploying = true
		elseif state == "Deployed" and character and character:FindFirstChild("HumanoidRootPart") then
			return character
		elseif state == "Menu" and (seenDeploying or os.clock() - started > 3) then
			return nil -- rejected or failed server-side
		end
		task.wait()
	end
	return nil
end

local function blendIntoTactical()
	local camera = Workspace.CurrentCamera
	local fromCF = MenuCamera.getCFrame()
	local fromFov = MenuCamera.getFieldOfView()
	MenuCamera.stop()

	local duration = Config.Camera.DeployTransitionTime
	local elapsed = 0
	local finished = false
	UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
	UserInputService.MouseIconEnabled = false

	RunService:BindToRenderStep(TRANSITION_STEP, Enum.RenderPriority.Camera.Value + 1, function(dt: number)
		elapsed += dt
		local alpha = smootherstep(elapsed / duration)
		local targetCF, targetFov = TacticalCamera.evaluate(dt)
		if camera then
			camera.CameraType = Enum.CameraType.Scriptable
			camera.CFrame = fromCF:Lerp(targetCF, alpha)
			camera.FieldOfView = fromFov + (targetFov - fromFov) * alpha
		end
		UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
		CinematicGrade.setBlend(alpha)
		if elapsed >= duration then
			finished = true
		end
	end)
	while not finished do
		RunService.RenderStepped:Wait()
	end
	RunService:UnbindFromRenderStep(TRANSITION_STEP)
	CinematicGrade.setBlend(1)
	TacticalCamera.start()
end

local function deploy()
	if busy or not active then
		return
	end
	busy = true
	ui:hide(0.7)
	MenuCamera.goTo("MenuShot")
	MenuCamera.pushIn(Config.Camera.Menu.DeployPushIn)
	AudioController.setMenuMix(false, 2.5)
	Net.event(Net.Events.RequestDeploy):FireServer()

	local character = waitForDeployedCharacter(Config.Deploy.SpawnTimeout)
	if character then
		TacticalCamera.attach(character)
	end
	if not character or not TacticalCamera.isAttached() then
		MenuCamera.pushIn(0)
		AudioController.setMenuMix(true)
		ui:show(false)
		ui:toast("DEPLOY FAILED — TRY AGAIN")
		busy = false
		return
	end

	active = false
	unbindInput()
	blendIntoTactical()
	setCoreGui(false)
	deployed = true
	busy = false
end

--------------------------------------------------------------------------------
-- Public
--------------------------------------------------------------------------------
function MenuController.init()
	ui = MenuUI.new({
		DisplayName = player.DisplayName,
		Settings = SettingsController.get(),
		Loadout = SettingsController.getLoadout(),
		PlaySound = function(name: string)
			AudioController.play(name)
		end,
	})

	ui.OptionActivated:Connect(function(id: string)
		if id == "Deploy" then
			deploy()
		elseif id == "Loadout" then
			togglePanel("Loadout")
		elseif id == "Settings" then
			togglePanel("Settings")
		end
	end)
	ui.LoadoutSelected:Connect(function(slot: any, weaponId: any)
		SettingsController.setLoadout(slot, weaponId)
	end)
	ui.SettingChanged:Connect(function(key: any, value: any)
		SettingsController.set(key, value)
	end)
	SettingsController.LoadoutChanged:Connect(function(loadout: any)
		ui:setLoadout(loadout)
	end)
	SettingsController.Changed:Connect(function(settings: any)
		ui:setSettings(settings)
	end)
end

function MenuController.enter(instant: boolean)
	active = true
	busy = false
	deployed = false
	setCoreGui(true)
	TacticalCamera.detach()
	UserInputService.MouseBehavior = Enum.MouseBehavior.Default
	UserInputService.MouseIconEnabled = true
	CinematicGrade.setBlend(0)
	MenuCamera.start("MenuShot")
	AudioController.setMenuMix(true, if instant then 0.01 else 1.5)
	ui:openPanel(nil)
	ui:setLoadout(SettingsController.getLoadout())
	ui:show(instant)
	bindInput()
	player:SetAttribute("ClientMenuReady", true)
end

function MenuController.returnFromRaid()
	if active or busy then
		return
	end
	busy = true
	ui:fade(true, 0.6)
	MenuController.enter(true)
	ui:fade(false, 1.4)
end

function MenuController.isDeployed(): boolean
	return deployed
end

return MenuController
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000030"><Properties><string name="Name">SettingsController</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	SettingsController
	Client copy of the player's settings + loadout. Pulls the profile from the
	server once, applies changes instantly (optimistic), debounces saves, and
	re-syncs loadout from the server-confirmed player attributes.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local Schema = require(Shared.Schema)
local Signal = require(Shared.Signal)
local Types = require(Shared.Types)

local player = Players.LocalPlayer

local SettingsController = {}
SettingsController.Changed = Signal.new() -- (settings: PlayerSettings)
SettingsController.LoadoutChanged = Signal.new() -- (loadout: Loadout)

local current: Types.PlayerSettings = Schema.sanitizeSettings(nil, Config.Settings.Defaults)
local loadout: Types.Loadout = Schema.sanitizeLoadout(nil, Config.DefaultLoadout)
local saveToken = 0

local function scheduleSave()
	saveToken += 1
	local token = saveToken
	task.delay(Config.Settings.SaveDebounce, function()
		if token == saveToken then
			Net.event(Net.Events.SaveSettings):FireServer(current)
		end
	end)
end

local function syncLoadoutFromAttributes()
	local confirmed = Schema.sanitizeLoadout({
		Primary = player:GetAttribute("Loadout_Primary"),
		Secondary = player:GetAttribute("Loadout_Secondary"),
	}, loadout)
	if confirmed.Primary ~= loadout.Primary or confirmed.Secondary ~= loadout.Secondary then
		loadout = confirmed
		SettingsController.LoadoutChanged:Fire(table.clone(loadout))
	end
end

function SettingsController.init()
	local ok, profile = pcall(function(): any
		return Net.func(Net.Functions.GetProfile):InvokeServer()
	end)
	if ok and typeof(profile) == "table" then
		current = Schema.sanitizeSettings(profile.Settings, current)
		loadout = Schema.sanitizeLoadout(profile.Loadout, loadout)
	else
		warn("[Settings] profile fetch failed, using defaults:", profile)
	end

	player:GetAttributeChangedSignal("Loadout_Primary"):Connect(syncLoadoutFromAttributes)
	player:GetAttributeChangedSignal("Loadout_Secondary"):Connect(syncLoadoutFromAttributes)
end

function SettingsController.get(): Types.PlayerSettings
	return table.clone(current)
end

function SettingsController.set(key: "Quality" | "FieldOfView" | "Sensitivity", value: any)
	local candidate: any = table.clone(current)
	candidate[key] = value
	local sanitized = Schema.sanitizeSettings(candidate, current)
	if
		sanitized.Quality == current.Quality
		and sanitized.FieldOfView == current.FieldOfView
		and sanitized.Sensitivity == current.Sensitivity
	then
		return
	end
	current = sanitized
	SettingsController.Changed:Fire(table.clone(current))
	scheduleSave()
end

function SettingsController.getLoadout(): Types.Loadout
	return table.clone(loadout)
end

function SettingsController.setLoadout(slot: Types.WeaponSlot, weaponId: string)
	if not Schema.isWeaponForSlot(slot, weaponId) then
		return
	end
	if slot == "Primary" then
		if loadout.Primary == weaponId then
			return
		end
		loadout.Primary = weaponId
	else
		if loadout.Secondary == weaponId then
			return
		end
		loadout.Secondary = weaponId
	end
	SettingsController.LoadoutChanged:Fire(table.clone(loadout))
	Net.event(Net.Events.SetLoadout):FireServer(slot, weaponId)
end

return SettingsController
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000031"><Properties><string name="Name">TacticalCamera</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	TacticalCamera
	Over-the-shoulder third-person camera (Phase 2 layers ADS, recoil springs
	and sprint FOV on top of this).

	• Mouse / right-stick yaw + pitch with user sensitivity
	• Spring-smoothed pivot follow and shoulder offset
	• Shoulder swap (V / D-pad right) with a springy slide
	• Sphere-cast collision: snaps in instantly, eases back out
	• Strafe roll sway driven by lateral velocity
	• FOV spring toward the player's FOV setting
	• Character turns to the camera heading while moving (AlignOrientation)
	• Fades the character out when the camera is forced very close

	evaluate(dt) computes the camera without writing it, which is what lets
	the deploy transition blend from the menu shot into the live tactical
	camera with zero cut.
]]

local ContextActionService = game:GetService("ContextActionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")
local Players = game:GetService("Players")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Spring = require(Shared.Spring)
local Trove = require(Shared.Trove)

local SettingsController = require(script.Parent.SettingsController)

local TacticalCamera = {}

local RENDER_NAME = "TacticalCamera"
local SWAP_ACTION = "TacticalShoulderSwap"
local C = Config.Camera.Tactical

local character: Model? = nil
local root: BasePart? = nil
local humanoid: Humanoid? = nil
local align: AlignOrientation? = nil
local trove: Trove.Trove? = nil
local reticle: ScreenGui? = nil

local yaw = 0
local pitch = 0
local bodyYaw = 0
local shoulder = 1
local currentDistance = C.ShoulderOffset.Z
local gamepadLook = Vector2.zero
local attached = false
local running = false

local pivotSpring = Spring.new(Vector3.zero, C.PivotFrequency, 1)
local shoulderSpring = Spring.new(Vector3.new(1, 0, 0), C.ShoulderFrequency, C.ShoulderDamping)
local rollSpring = Spring.new(Vector3.zero, 3, 0.7)
local fovSpring = Spring.new(Vector3.new(72, 0, 0), C.FovFrequency, 1)

local castParams = RaycastParams.new()
castParams.FilterType = Enum.RaycastFilterType.Exclude

local lastCF = CFrame.identity
local lastFov = 72

local function sphereCast(origin: Vector3, offset: Vector3): Vector3
	local length = offset.Magnitude
	if length < 1e-3 then
		return origin + offset
	end
	local result = Workspace:Spherecast(origin, C.CollisionRadius, offset, castParams)
	if result then
		return origin + offset.Unit * math.max(result.Distance - 0.05, 0)
	end
	return origin + offset
end

local function setCharacterFade(alpha: number)
	local model = character
	if not model then
		return
	end
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") or d:IsA("Decal") then
			(d :: any).LocalTransparencyModifier = alpha
		end
	end
end

local function readInput(dt: number)
	local settings = SettingsController.get()
	if UserInputService.MouseBehavior == Enum.MouseBehavior.LockCenter then
		local delta = UserInputService:GetMouseDelta()
		local k = C.MouseRadiansPerPixel * settings.Sensitivity
		yaw -= delta.X * k
		pitch -= delta.Y * k
	end
	if gamepadLook.Magnitude > C.GamepadDeadzone then
		local speed = C.GamepadRadiansPerSecond * settings.Sensitivity * dt
		yaw -= gamepadLook.X * speed
		pitch += gamepadLook.Y * speed
	end
	pitch = math.clamp(pitch, math.rad(C.MinPitch), math.rad(C.MaxPitch))
end

local function updateBody(dt: number)
	local h = humanoid
	local constraint = align
	if not h or not constraint then
		return
	end
	if h.MoveDirection.Magnitude > 0.1 then
		bodyYaw = yaw
	else
		-- Idle free-look; turn the body only when looking far over the shoulder.
		local diff = math.atan2(math.sin(yaw - bodyYaw), math.cos(yaw - bodyYaw))
		if math.abs(diff) > math.rad(100) then
			bodyYaw += diff * math.min(1, dt * 6)
		end
	end
	constraint.CFrame = CFrame.Angles(0, bodyYaw, 0)
end

function TacticalCamera.evaluate(dt: number): (CFrame, number)
	local r = root
	if not r or not r.Parent then
		return lastCF, lastFov
	end

	readInput(dt)
	updateBody(dt)

	pivotSpring.Target = r.Position + Vector3.new(0, C.PivotHeight, 0)
	local pivot = pivotSpring:update(dt)

	shoulderSpring.Target = Vector3.new(shoulder, 0, 0)
	local side = shoulderSpring:update(dt).X

	local rotation = CFrame.Angles(0, yaw, 0) * CFrame.Angles(pitch, 0, 0)
	local offset = C.ShoulderOffset
	local lateral = rotation.RightVector * (offset.X * side) + rotation.UpVector * offset.Y
	local back = rotation.LookVector * -offset.Z

	local shoulderPoint = sphereCast(pivot, lateral)
	local desired = sphereCast(shoulderPoint, back)
	local desiredDistance = (desired - shoulderPoint).Magnitude
	if desiredDistance < currentDistance then
		currentDistance = desiredDistance
	else
		currentDistance += (desiredDistance - currentDistance) * (1 - math.exp(-dt * 4))
	end
	local cameraPosition = shoulderPoint + rotation.LookVector * -currentDistance

	-- Strafe roll
	local lateralSpeed = rotation.RightVector:Dot(r.AssemblyLinearVelocity)
	rollSpring.Target = Vector3.new(math.clamp(-lateralSpeed * C.RollPerStudPerSecond, -C.MaxRoll, C.MaxRoll), 0, 0)
	local roll = rollSpring:update(dt).X

	fovSpring.Target = Vector3.new(SettingsController.get().FieldOfView, 0, 0)
	local fov = fovSpring:update(dt).X

	local fade = math.clamp((C.CloseFadeStart - currentDistance) / (C.CloseFadeStart - C.CloseFadeEnd), 0, 1)
	setCharacterFade(fade * 0.85)

	lastCF = CFrame.new(cameraPosition) * rotation.Rotation * CFrame.Angles(0, 0, roll)
	lastFov = fov
	return lastCF, lastFov
end

local function buildReticle(): ScreenGui
	local gui = Instance.new("ScreenGui")
	gui.Name = "TacticalReticle"
	gui.IgnoreGuiInset = true
	gui.ResetOnSpawn = false
	gui.DisplayOrder = 5
	local dot = Instance.new("Frame")
	dot.Name = "Dot"
	dot.AnchorPoint = Vector2.new(0.5, 0.5)
	dot.Position = UDim2.fromScale(0.5, 0.5)
	dot.Size = UDim2.fromOffset(4, 4)
	dot.BackgroundColor3 = Color3.new(1, 1, 1)
	dot.BackgroundTransparency = 1
	dot.BorderSizePixel = 0
	dot.Parent = gui
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(1, 0)
	corner.Parent = dot
	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.new(0, 0, 0)
	stroke.Transparency = 1
	stroke.Thickness = 1
	stroke.Parent = dot
	gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
	return gui
end

-- Binds to a freshly spawned character. Call before evaluate()/start().
function TacticalCamera.attach(model: Model)
	TacticalCamera.detach()
	local r = model:WaitForChild("HumanoidRootPart", 5)
	local h = model:FindFirstChildOfClass("Humanoid")
	if not r or not r:IsA("BasePart") or not h then
		warn("[TacticalCamera] character missing HumanoidRootPart/Humanoid")
		return
	end
	character = model
	root = r
	humanoid = h
	local t = Trove.new()
	trove = t

	local look = r.CFrame.LookVector
	yaw = math.atan2(-look.X, -look.Z)
	bodyYaw = yaw
	pitch = math.rad(-8)
	shoulder = 1
	currentDistance = C.ShoulderOffset.Z
	pivotSpring:reset(r.Position + Vector3.new(0, C.PivotHeight, 0))
	shoulderSpring:reset(Vector3.new(1, 0, 0))
	rollSpring:reset(Vector3.zero)
	fovSpring:reset(Vector3.new(SettingsController.get().FieldOfView, 0, 0))
	castParams.FilterDescendantsInstances = { model, Workspace:FindFirstChild("ClientFX") or model }

	h.AutoRotate = false
	local attachment = r:FindFirstChild("RootAttachment")
	if not attachment or not attachment:IsA("Attachment") then
		local created = Instance.new("Attachment")
		created.Name = "RootAttachment"
		created.Parent = r
		attachment = created
	end
	local constraint = Instance.new("AlignOrientation")
	constraint.Name = "TacticalFacing"
	constraint.Mode = Enum.OrientationAlignmentMode.OneAttachment
	constraint.Attachment0 = attachment :: Attachment
	constraint.Responsiveness = C.BodyResponsiveness
	constraint.MaxTorque = math.huge
	constraint.MaxAngularVelocity = math.huge
	constraint.RigidityEnabled = false
	constraint.CFrame = CFrame.Angles(0, yaw, 0)
	constraint.Parent = r
	align = constraint
	t:Add(constraint)

	t:Connect(UserInputService.InputChanged, function(input: InputObject)
		if input.KeyCode == Enum.KeyCode.Thumbstick2 then
			gamepadLook = Vector2.new(input.Position.X, input.Position.Y)
		end
	end)
	t:Connect(model.AncestryChanged, function(_, parent: Instance?)
		if parent == nil then
			TacticalCamera.detach()
		end
	end)

	attached = true
end

function TacticalCamera.start()
	if not attached or running then
		return
	end
	running = true
	UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
	UserInputService.MouseIconEnabled = false

	ContextActionService:BindAction(SWAP_ACTION, function(_: string, state: Enum.UserInputState): Enum.ContextActionResult
		if state == Enum.UserInputState.Begin then
			shoulder = -shoulder
			-- Small roll kick sells the weight of the swap.
			rollSpring:impulse(Vector3.new(shoulder * 0.06, 0, 0))
		end
		return Enum.ContextActionResult.Sink
	end, false, table.unpack(Config.Keybinds.ShoulderSwap))

	RunService:BindToRenderStep(RENDER_NAME, Enum.RenderPriority.Camera.Value + 1, function(dt: number)
		local camera = Workspace.CurrentCamera
		if not camera then
			return
		end
		camera.CameraType = Enum.CameraType.Scriptable
		UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
		local cf, fov = TacticalCamera.evaluate(dt)
		camera.CFrame = cf
		camera.FieldOfView = fov
	end)

	local gui = reticle or buildReticle()
	reticle = gui
	gui.Enabled = true
	local dot = gui:FindFirstChild("Dot")
	if dot and dot:IsA("Frame") then
		dot.BackgroundTransparency = 1
		TweenService:Create(dot, TweenInfo.new(0.6, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), { BackgroundTransparency = 0.15 }):Play()
		local stroke = dot:FindFirstChildOfClass("UIStroke")
		if stroke then
			TweenService:Create(stroke, TweenInfo.new(0.6), { Transparency = 0.6 }):Play()
		end
	end
end

function TacticalCamera.stop()
	if running then
		running = false
		RunService:UnbindFromRenderStep(RENDER_NAME)
		ContextActionService:UnbindAction(SWAP_ACTION)
	end
	UserInputService.MouseBehavior = Enum.MouseBehavior.Default
	UserInputService.MouseIconEnabled = true
	if reticle then
		reticle.Enabled = false
	end
end

function TacticalCamera.detach()
	TacticalCamera.stop()
	if trove then
		local t = trove
		trove = nil
		t:Clean()
	end
	setCharacterFade(0)
	local h = humanoid
	if h and h.Parent then
		h.AutoRotate = true
	end
	character = nil
	root = nil
	humanoid = nil
	align = nil
	attached = false
end

function TacticalCamera.isAttached(): boolean
	return attached
end

function TacticalCamera.isRunning(): boolean
	return running
end

return TacticalCamera
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX000036"><Properties><string name="Name">UI</string></Properties><Item class="ModuleScript" referent="RBX000033"><Properties><string name="Name">MenuUI</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	MenuUI
	Ultra-minimal main menu: boxless left-aligned typography over the live 3D
	scene, cinematic letterbox + edge vignette, and two slide-in panels
	(LOADOUT, SETTINGS). Mouse, keyboard and gamepad share one focus model.

	MenuUI only renders and reports intent through signals; MenuController
	decides what intent means (camera moves, deploy, saving).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Schema = require(Shared.Schema)
local Signal = require(Shared.Signal)
local Types = require(Shared.Types)

local Theme = require(script.Parent.Theme)
local Widgets = require(script.Parent.Widgets)

export type PanelName = "Loadout" | "Settings"

export type Context = {
	DisplayName: string,
	Settings: Types.PlayerSettings,
	Loadout: Types.Loadout,
	PlaySound: (name: string) -> (),
}

export type MenuUI = {
	OptionActivated: Signal.Signal, -- (id: "Deploy" | "Loadout" | "Settings")
	BackRequested: Signal.Signal,
	LoadoutSelected: Signal.Signal, -- (slot: WeaponSlot, weaponId: string)
	SettingChanged: Signal.Signal, -- (key: string, value: any)

	show: (self: MenuUI, instant: boolean?) -> (),
	hide: (self: MenuUI, duration: number?) -> (),
	openPanel: (self: MenuUI, name: PanelName?) -> (),
	getPanel: (self: MenuUI) -> PanelName?,
	setLoadout: (self: MenuUI, loadout: Types.Loadout) -> (),
	setSettings: (self: MenuUI, settings: Types.PlayerSettings) -> (),
	navigate: (self: MenuUI, delta: number) -> (),
	adjust: (self: MenuUI, delta: number) -> (),
	activate: (self: MenuUI) -> (),
	fade: (self: MenuUI, toBlack: boolean, duration: number) -> (),
	toast: (self: MenuUI, text: string) -> (),
	isInteractive: (self: MenuUI) -> boolean,
}

type FocusList = "Main" | "Panel"

type MainOption = {
	Id: string,
	Text: string,
	Hint: string,
	Size: number,
}

local MAIN_OPTIONS: { MainOption } = {
	{ Id = "Deploy", Text = "DEPLOY", Hint = "Drop into the zone. Whatever you carry out is yours.", Size = 36 },
	{ Id = "Loadout", Text = "LOADOUT", Hint = "Pick your kit at the workbench.", Size = 26 },
	{ Id = "Settings", Text = "SETTINGS", Hint = "Effects quality, field of view, sensitivity.", Size = 26 },
}

local SLOTS: { Types.WeaponSlot } = { "Primary", "Secondary" }
local STAT_KEYS = { "Damage", "FireRate", "Handling", "Range" }
local STAT_LABELS = { Damage = "DAMAGE", FireRate = "FIRE RATE", Handling = "HANDLING", Range = "RANGE" }

local LETTERBOX_HEIGHT = 0.065

local function formatThousands(n: number): string
	local s = tostring(math.floor(n))
	local formatted = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	if formatted:sub(1, 1) == "," then
		formatted = formatted:sub(2)
	end
	return formatted
end

local function gradientEdge(parent: Instance, name: string, size: UDim2, position: UDim2, anchor: Vector2, rotation: number, startAlpha: number)
	local frame = Widgets.frame(parent, {
		Name = name,
		Size = size,
		Position = position,
		AnchorPoint = anchor,
		Color = Theme.Colors.Black,
		Transparency = 0,
	})
	local gradient = Instance.new("UIGradient")
	gradient.Rotation = rotation
	gradient.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, startAlpha),
		NumberSequenceKeypoint.new(1, 1),
	})
	gradient.Parent = frame
end

local function addScale(target: Instance): UIScale
	local scale = Instance.new("UIScale")
	scale.Parent = target
	return scale
end

local MenuUI = {}

function MenuUI.new(ctx: Context): MenuUI
	local player = Players.LocalPlayer
	local playerGui = player:WaitForChild("PlayerGui")

	local ui = {} :: MenuUI
	ui.OptionActivated = Signal.new()
	ui.BackRequested = Signal.new()
	ui.LoadoutSelected = Signal.new()
	ui.SettingChanged = Signal.new()

	local interactive = false
	local openPanelName: PanelName? = nil
	local focusList: FocusList = "Main"
	local focusIndex: { [FocusList]: number } = { Main = 1, Panel = 1 }
	local currentLoadout: Types.Loadout = table.clone(ctx.Loadout)
	local scales: { UIScale } = {}

	----------------------------------------------------------------------------
	-- Roots
	----------------------------------------------------------------------------
	local gui = Instance.new("ScreenGui")
	gui.Name = "MainMenu"
	gui.IgnoreGuiInset = true
	gui.ResetOnSpawn = false
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.DisplayOrder = 10
	gui.Parent = playerGui

	local root = Instance.new("CanvasGroup")
	root.Name = "Root"
	root.Size = UDim2.fromScale(1, 1)
	root.BackgroundTransparency = 1
	root.GroupTransparency = 1
	root.Parent = gui

	local faderGui = Instance.new("ScreenGui")
	faderGui.Name = "Fader"
	faderGui.IgnoreGuiInset = true
	faderGui.ResetOnSpawn = false
	faderGui.DisplayOrder = 100
	faderGui.Parent = playerGui
	local fader = Widgets.frame(faderGui, { Name = "Black", Size = UDim2.fromScale(1, 1), Color = Theme.Colors.Black, Transparency = 1 })

	-- Cinematic letterbox (outside the CanvasGroup so it retracts on its own)
	local barTop = Widgets.frame(gui, { Name = "LetterboxTop", Size = UDim2.fromScale(1, 0), Color = Theme.Colors.Black, Transparency = 0, ZIndex = 20 })
	local barBottom = Widgets.frame(gui, {
		Name = "LetterboxBottom",
		Size = UDim2.fromScale(1, 0),
		Position = UDim2.fromScale(0, 1),
		AnchorPoint = Vector2.new(0, 1),
		Color = Theme.Colors.Black,
		Transparency = 0,
		ZIndex = 20,
	})

	-- Edge vignette: heavier on the left where the type sits.
	local vignette = Widgets.frame(root, { Name = "Vignette", Size = UDim2.fromScale(1, 1) })
	gradientEdge(vignette, "Left", UDim2.fromScale(0.5, 1), UDim2.new(), Vector2.zero, 0, 0.2)
	gradientEdge(vignette, "Right", UDim2.fromScale(0.3, 1), UDim2.fromScale(1, 0), Vector2.new(1, 0), 180, 0.45)
	gradientEdge(vignette, "Top", UDim2.fromScale(1, 0.25), UDim2.new(), Vector2.zero, 90, 0.5)
	gradientEdge(vignette, "Bottom", UDim2.fromScale(1, 0.3), UDim2.fromScale(0, 1), Vector2.new(0, 1), -90, 0.35)

	----------------------------------------------------------------------------
	-- Left column: title + options + hint
	----------------------------------------------------------------------------
	local column = Widgets.frame(root, {
		Name = "LeftColumn",
		Size = UDim2.fromOffset(480, 560),
		Position = UDim2.new(0.065, 0, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
	})
	table.insert(scales, addScale(column))

	local titleGroup = Widgets.frame(column, { Name = "TitleGroup", Size = UDim2.new(1, 0, 0, 130) })
	Widgets.label(titleGroup, {
		Name = "Title",
		Text = Theme.track(Config.Branding.Title),
		Font = Theme.Fonts.Display,
		TextSize = 76,
		Size = UDim2.new(1, 0, 0, 84),
	})
	Widgets.label(titleGroup, {
		Name = "Subtitle",
		Text = Theme.track(Config.Branding.Subtitle),
		Font = Theme.Fonts.MonoBold,
		TextSize = 12,
		Color = Theme.Colors.Accent,
		Size = UDim2.new(1, 0, 0, 18),
		Position = UDim2.fromOffset(4, 86),
	})
	Widgets.frame(titleGroup, {
		Name = "Rule",
		Size = UDim2.fromOffset(44, 2),
		Position = UDim2.fromOffset(4, 118),
		Color = Theme.Colors.Accent,
		Transparency = 0.2,
	})

	local optionsFrame = Widgets.frame(column, { Name = "Options", Size = UDim2.new(1, 0, 0, 220), Position = UDim2.fromOffset(0, 158) })
	Widgets.list(optionsFrame, 2)

	local hint = Widgets.label(column, {
		Name = "Hint",
		Text = MAIN_OPTIONS[1].Hint,
		Font = Theme.Fonts.Body,
		TextSize = 14,
		Color = Theme.Colors.Dim,
		Transparency = 0.1,
		Size = UDim2.fromOffset(380, 40),
		Position = UDim2.fromOffset(4, 392),
		Wrapped = true,
		YAlign = Enum.TextYAlignment.Top,
	})

	local mainRows: { Widgets.Row } = {}
	local optionRows: { [string]: Widgets.OptionRow } = {}
	local panelRows: { [PanelName]: { Widgets.Row } } = { Loadout = {}, Settings = {} }
	-- Extra behaviour when a row gains focus (e.g. weapon detail preview).
	local focusHooks: { [any]: () -> () } = {}

	local function rowsFor(list: FocusList): { Widgets.Row }
		if list == "Panel" then
			local name = openPanelName
			if name then
				return panelRows[name]
			end
			return {}
		end
		return mainRows
	end

	local updateDetail: (weaponId: string?) -> () = function(_: string?) end

	local function setHint(text: string)
		if hint.Text == text then
			return
		end
		hint.TextTransparency = 1
		hint.Text = text
		Widgets.tween(hint, Theme.Tween.Medium, { TextTransparency = 0.1 })
	end

	local function setFocus(list: FocusList, index: number, silent: boolean?)
		local previousRows = rowsFor(focusList)
		local previous = previousRows[focusIndex[focusList]]
		local nextRows = rowsFor(list)
		if #nextRows == 0 then
			return
		end
		local clamped = ((index - 1) % #nextRows) + 1
		local nextRow = nextRows[clamped]
		if previous == nextRow then
			return
		end
		if previous then
			previous.SetFocused(false)
		end
		focusList = list
		focusIndex[list] = clamped
		nextRow.SetFocused(true)
		if list == "Main" then
			setHint(MAIN_OPTIONS[clamped].Hint)
		end
		local hook = focusHooks[nextRow]
		if hook then
			hook()
		end
		if not silent then
			ctx.PlaySound("UIHover")
		end
	end

	local function focusRow(list: FocusList, row: Widgets.Row)
		if not interactive then
			return
		end
		local index = table.find(rowsFor(list), row)
		if index then
			setFocus(list, index)
		end
	end

	for i, def in MAIN_OPTIONS do
		local row: Widgets.OptionRow
		row = Widgets.menuOption(optionsFrame, {
			Name = def.Id,
			Index = i,
			Text = def.Text,
			TextSize = def.Size,
			LayoutOrder = i,
			OnHover = function()
				focusRow("Main", row)
			end,
			OnActivate = function()
				if not interactive then
					return
				end
				ctx.PlaySound(if def.Id == "Deploy" then "UIDeploy" else "UIClick")
				ui.OptionActivated:Fire(def.Id)
			end,
		})
		table.insert(mainRows, row)
		optionRows[def.Id] = row
	end

	----------------------------------------------------------------------------
	-- Corners: operator, footer, key hints, toast
	----------------------------------------------------------------------------
	local topRight = Widgets.frame(root, {
		Name = "Operator",
		Size = UDim2.fromOffset(320, 70),
		Position = UDim2.fromScale(0.935, 0.095),
		AnchorPoint = Vector2.new(1, 0),
	})
	table.insert(scales, addScale(topRight))
	Widgets.label(topRight, {
		Name = "Role",
		Text = Theme.track("OPERATOR"),
		Font = Theme.Fonts.Mono,
		TextSize = 10,
		Color = Theme.Colors.Dim,
		Size = UDim2.new(1, 0, 0, 16),
		XAlign = Enum.TextXAlignment.Right,
	})
	Widgets.label(topRight, {
		Name = "Name",
		Text = Theme.track(string.upper(ctx.DisplayName)),
		Font = Theme.Fonts.Heading,
		TextSize = 16,
		Size = UDim2.new(1, 0, 0, 22),
		Position = UDim2.fromOffset(0, 16),
		XAlign = Enum.TextXAlignment.Right,
	})
	local stashLabel = Widgets.label(topRight, {
		Name = "Stash",
		Text = "",
		Font = Theme.Fonts.Mono,
		TextSize = 11,
		Color = Theme.Colors.Accent,
		Size = UDim2.new(1, 0, 0, 16),
		Position = UDim2.fromOffset(0, 42),
		XAlign = Enum.TextXAlignment.Right,
	})
	local function refreshStash()
		local value = player:GetAttribute("StashValue")
		stashLabel.Text = if typeof(value) == "number" then Theme.track("STASH  $" .. formatThousands(value)) else ""
	end
	refreshStash()
	player:GetAttributeChangedSignal("StashValue"):Connect(refreshStash)

	local footer = Widgets.frame(root, {
		Name = "Footer",
		Size = UDim2.fromOffset(520, 40),
		Position = UDim2.fromScale(0.065, 0.905),
		AnchorPoint = Vector2.new(0, 1),
	})
	table.insert(scales, addScale(footer))
	local locationLabel = Widgets.label(footer, {
		Name = "Location",
		Text = "",
		Font = Theme.Fonts.Mono,
		TextSize = 11,
		Color = Theme.Colors.Text,
		Transparency = 0.35,
		Size = UDim2.new(1, 0, 0, 18),
	})
	Widgets.label(footer, {
		Name = "Build",
		Text = Theme.track(Config.Branding.Build),
		Font = Theme.Fonts.Mono,
		TextSize = 10,
		Color = Theme.Colors.Dim,
		Transparency = 0.4,
		Size = UDim2.new(1, 0, 0, 16),
		Position = UDim2.fromOffset(0, 20),
	})
	task.spawn(function()
		while gui.Parent do
			locationLabel.Text = Theme.track(Config.Branding.Location .. "   ·   " .. tostring(os.date("%H:%M")))
			task.wait(1)
		end
	end)

	local keyHints = Widgets.label(root, {
		Name = "KeyHints",
		Text = "",
		Font = Theme.Fonts.Mono,
		TextSize = 11,
		Color = Theme.Colors.Dim,
		Transparency = 0.25,
		Size = UDim2.fromOffset(520, 18),
		Position = UDim2.fromScale(0.935, 0.905),
		AnchorPoint = Vector2.new(1, 1),
		XAlign = Enum.TextXAlignment.Right,
	})
	table.insert(scales, addScale(keyHints))
	local function refreshHints()
		local last = UserInputService:GetLastInputType()
		local gamepad = last.Name:sub(1, 7) == "Gamepad"
		keyHints.Text = Theme.track(if gamepad then "DPAD  NAVIGATE    A  SELECT    B  BACK" else "↑↓  NAVIGATE    ENTER  SELECT    BKSP  BACK")
	end
	refreshHints()
	UserInputService.LastInputTypeChanged:Connect(refreshHints)

	local toastLabel = Widgets.label(root, {
		Name = "Toast",
		Text = "",
		Font = Theme.Fonts.MonoBold,
		TextSize = 12,
		Color = Theme.Colors.Danger,
		Transparency = 1,
		Size = UDim2.fromOffset(600, 20),
		Position = UDim2.fromScale(0.5, 0.84),
		AnchorPoint = Vector2.new(0.5, 0.5),
		XAlign = Enum.TextXAlignment.Center,
	})

	----------------------------------------------------------------------------
	-- Panels
	----------------------------------------------------------------------------
	local panels: { [PanelName]: CanvasGroup } = {}

	local function makePanel(name: PanelName, title: string, subtitle: string): Frame
		local group = Instance.new("CanvasGroup")
		group.Name = name .. "Panel"
		group.Size = UDim2.fromOffset(440, 600)
		group.AnchorPoint = Vector2.new(1, 0.5)
		group.Position = UDim2.new(0.935, 40, 0.5, 0)
		group.BackgroundTransparency = 1
		group.GroupTransparency = 1
		group.Visible = false
		group.Parent = root
		table.insert(scales, addScale(group))
		panels[name] = group

		Widgets.label(group, {
			Name = "Header",
			Text = Theme.track(title),
			Font = Theme.Fonts.Heading,
			TextSize = 30,
			Size = UDim2.new(1, 0, 0, 36),
		})
		Widgets.label(group, {
			Name = "Sub",
			Text = Theme.track(subtitle),
			Font = Theme.Fonts.Mono,
			TextSize = 10,
			Color = Theme.Colors.Dim,
			Size = UDim2.new(1, 0, 0, 16),
			Position = UDim2.fromOffset(2, 38),
		})
		Widgets.frame(group, {
			Name = "Rule",
			Size = UDim2.new(1, 0, 0, 1),
			Position = UDim2.fromOffset(0, 64),
			Color = Theme.Colors.White,
			Transparency = 0.88,
		})
		local body = Widgets.frame(group, { Name = "Body", Size = UDim2.new(1, 0, 1, -76), Position = UDim2.fromOffset(0, 76) })
		Widgets.list(body, 4)
		return body
	end

	-- LOADOUT -----------------------------------------------------------------
	local loadoutBody = makePanel("Loadout", "LOADOUT", "SELECT YOUR KIT  ·  LOCKED ON DEPLOY")
	local weaponRows: { [string]: Widgets.WeaponRow } = {}
	local order = 0
	local function nextOrder(): number
		order += 1
		return order
	end

	for _, slot in SLOTS do
		Widgets.section(loadoutBody, string.upper(slot), nextOrder())
		for _, weaponId in Schema.weaponsForSlot(slot) do
			local def = Config.Weapons[weaponId]
			local row: Widgets.WeaponRow
			row = Widgets.weaponRow(loadoutBody, {
				Name = weaponId,
				Title = def.DisplayName,
				Tag = def.Class,
				LayoutOrder = nextOrder(),
				OnHover = function()
					focusRow("Panel", row)
				end,
				OnActivate = function()
					if not interactive then
						return
					end
					ctx.PlaySound("UIClick")
					ui.LoadoutSelected:Fire(slot, weaponId)
				end,
			})
			weaponRows[weaponId] = row
			focusHooks[row] = function()
				updateDetail(weaponId)
			end
			table.insert(panelRows.Loadout, row)
		end
	end

	Widgets.frame(loadoutBody, { Name = "Spacer", Size = UDim2.new(1, 0, 0, 14), LayoutOrder = nextOrder() })
	local detail = Widgets.frame(loadoutBody, { Name = "Detail", Size = UDim2.new(1, 0, 0, 190), LayoutOrder = nextOrder() })
	local detailName = Widgets.label(detail, {
		Name = "Name",
		Text = "",
		Font = Theme.Fonts.Heading,
		TextSize = 16,
		Size = UDim2.new(1, 0, 0, 22),
	})
	local detailDesc = Widgets.label(detail, {
		Name = "Description",
		Text = "",
		Font = Theme.Fonts.Body,
		TextSize = 13,
		Color = Theme.Colors.Dim,
		Size = UDim2.new(1, 0, 0, 40),
		Position = UDim2.fromOffset(0, 26),
		Wrapped = true,
		YAlign = Enum.TextYAlignment.Top,
	})
	local statsFrame = Widgets.frame(detail, { Name = "Stats", Size = UDim2.new(1, 0, 0, 100), Position = UDim2.fromOffset(0, 80) })
	Widgets.list(statsFrame, 2)
	local statBars: { [string]: Widgets.StatBar } = {}
	for i, key in STAT_KEYS do
		statBars[key] = Widgets.statBar(statsFrame, STAT_LABELS[key], i)
	end

	updateDetail = function(weaponId: string?)
		local id = weaponId or currentLoadout.Primary
		local def = Config.Weapons[id]
		if not def then
			return
		end
		if detailName.Text ~= def.DisplayName then
			detailName.TextTransparency = 1
			detailDesc.TextTransparency = 1
			Widgets.tween(detailName, Theme.Tween.Medium, { TextTransparency = 0 })
			Widgets.tween(detailDesc, Theme.Tween.Medium, { TextTransparency = 0 })
		end
		detailName.Text = def.DisplayName
		detailDesc.Text = def.Description
		for _, key in STAT_KEYS do
			statBars[key].Set((def.Stats :: any)[key])
		end
	end

	-- SETTINGS ----------------------------------------------------------------
	local settingsBody = makePanel("Settings", "SETTINGS", "SAVED AUTOMATICALLY")
	order = 0
	local qualityLevels = Config.Settings.QualityLevels

	Widgets.section(settingsBody, "DISPLAY", nextOrder())
	local qualityRow: Widgets.CycleRow
	qualityRow = Widgets.cycle(settingsBody, {
		Name = "Quality",
		Label = "EFFECTS QUALITY",
		Options = qualityLevels :: any,
		Index = table.find(qualityLevels, ctx.Settings.Quality) or 3,
		LayoutOrder = nextOrder(),
		OnHover = function()
			focusRow("Panel", qualityRow)
		end,
		OnTick = function()
			ctx.PlaySound("UITick")
		end,
		OnChanged = function(index: number)
			ui.SettingChanged:Fire("Quality", qualityLevels[index])
		end,
	})
	table.insert(panelRows.Settings, qualityRow)

	local fovRow: Widgets.SliderRow
	fovRow = Widgets.slider(settingsBody, {
		Name = "FieldOfView",
		Label = "FIELD OF VIEW",
		Min = Config.Settings.FovMin,
		Max = Config.Settings.FovMax,
		Step = 1,
		KeyStep = 2,
		Value = ctx.Settings.FieldOfView,
		Format = function(v: number): string
			return string.format("%d°", v)
		end,
		LayoutOrder = nextOrder(),
		OnHover = function()
			focusRow("Panel", fovRow)
		end,
		OnTick = function()
			ctx.PlaySound("UITick")
		end,
		OnChanged = function(v: number)
			ui.SettingChanged:Fire("FieldOfView", v)
		end,
	})
	table.insert(panelRows.Settings, fovRow)

	Widgets.section(settingsBody, "CONTROLS", nextOrder())
	local sensRow: Widgets.SliderRow
	sensRow = Widgets.slider(settingsBody, {
		Name = "Sensitivity",
		Label = "LOOK SENSITIVITY",
		Min = Config.Settings.SensitivityMin,
		Max = Config.Settings.SensitivityMax,
		Step = 0.05,
		KeyStep = 0.05,
		Value = ctx.Settings.Sensitivity,
		Format = function(v: number): string
			return string.format("%.2f", v)
		end,
		LayoutOrder = nextOrder(),
		OnHover = function()
			focusRow("Panel", sensRow)
		end,
		OnTick = function()
			ctx.PlaySound("UITick")
		end,
		OnChanged = function(v: number)
			ui.SettingChanged:Fire("Sensitivity", v)
		end,
	})
	table.insert(panelRows.Settings, sensRow)

	Widgets.frame(settingsBody, { Name = "Spacer", Size = UDim2.new(1, 0, 0, 10), LayoutOrder = nextOrder() })
	Widgets.label(settingsBody, {
		Name = "Note",
		Text = "Effects quality scales rain, mist, light shafts, shadows and post FX. Engine graphics level stays in the Roblox menu.",
		Font = Theme.Fonts.Body,
		TextSize = 12,
		Color = Theme.Colors.Dim,
		Transparency = 0.2,
		Size = UDim2.new(1, 0, 0, 34),
		Wrapped = true,
		YAlign = Enum.TextYAlignment.Top,
		LayoutOrder = nextOrder(),
	})

	----------------------------------------------------------------------------
	-- Responsive scale
	----------------------------------------------------------------------------
	local function rescale()
		local camera = Workspace.CurrentCamera
		local height = if camera then camera.ViewportSize.Y else 1080
		local s = math.clamp(height / 1080, 0.62, 1.35)
		for _, scale in scales do
			scale.Scale = s
		end
	end
	rescale()
	local function bindViewport()
		local camera = Workspace.CurrentCamera
		if camera then
			camera:GetPropertyChangedSignal("ViewportSize"):Connect(rescale)
		end
	end
	bindViewport()
	Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
		bindViewport()
		rescale()
	end)

	----------------------------------------------------------------------------
	-- Methods
	----------------------------------------------------------------------------
	local function refreshActiveOptions()
		for id, row in optionRows do
			row.SetActive(openPanelName ~= nil and id == openPanelName)
		end
	end

	function ui.getPanel(_self: MenuUI): PanelName?
		return openPanelName
	end

	function ui.openPanel(_self: MenuUI, name: PanelName?)
		if name == openPanelName then
			return
		end
		local previous = openPanelName
		if previous then
			local group = panels[previous]
			for _, row in panelRows[previous] do
				row.SetFocused(false)
			end
			Widgets.tween(group, Theme.Tween.Medium, { GroupTransparency = 1, Position = UDim2.new(0.935, 40, 0.5, 0) })
			task.delay(Theme.Tween.Medium.Time, function()
				if openPanelName ~= previous then
					group.Visible = false
				end
			end)
		end
		openPanelName = name
		if focusList == "Panel" then
			focusList = "Main"
		end
		if name then
			local group = panels[name]
			group.Visible = true
			group.Position = UDim2.new(0.935, 40, 0.5, 0)
			Widgets.tween(group, Theme.Tween.Slow, { GroupTransparency = 0, Position = UDim2.new(0.935, 0, 0.5, 0) })
			focusIndex.Panel = 1
			if name == "Loadout" then
				updateDetail(nil)
			end
		end
		refreshActiveOptions()
	end

	function ui.setLoadout(_self: MenuUI, loadout: Types.Loadout)
		currentLoadout = table.clone(loadout)
		for weaponId, row in weaponRows do
			row.SetSelected(weaponId == loadout.Primary or weaponId == loadout.Secondary)
		end
		if openPanelName == "Loadout" then
			updateDetail(nil)
		end
	end

	function ui.setSettings(_self: MenuUI, settings: Types.PlayerSettings)
		qualityRow.Set(table.find(qualityLevels, settings.Quality) or 3, true)
		fovRow.Set(settings.FieldOfView, true)
		sensRow.Set(settings.Sensitivity, true)
	end

	function ui.navigate(_self: MenuUI, delta: number)
		if not interactive then
			return
		end
		setFocus(focusList, focusIndex[focusList] + delta)
	end

	function ui.adjust(_self: MenuUI, delta: number)
		if not interactive then
			return
		end
		local row = rowsFor(focusList)[focusIndex[focusList]]
		if focusList == "Panel" and row and row.Adjust then
			row.Adjust(delta)
		elseif focusList == "Main" and delta > 0 and openPanelName then
			setFocus("Panel", focusIndex.Panel)
		elseif focusList == "Panel" and delta < 0 then
			local name = openPanelName
			local mainIndex = if name then table.find({ "Deploy", "Loadout", "Settings" }, name) else nil
			setFocus("Main", mainIndex or 1)
		end
	end

	function ui.activate(_self: MenuUI)
		if not interactive then
			return
		end
		local row = rowsFor(focusList)[focusIndex[focusList]]
		if row and row.Activate then
			row.Activate()
		end
	end

	function ui.isInteractive(_self: MenuUI): boolean
		return interactive
	end

	function ui.show(_self: MenuUI, instant: boolean?)
		gui.Enabled = true
		root.Visible = true
		interactive = true
		focusList = "Main"
		for _, row in mainRows do
			row.SetFocused(false)
		end
		focusIndex.Main = 0
		setFocus("Main", 1, true)

		if instant then
			root.GroupTransparency = 0
			barTop.Size = UDim2.fromScale(1, LETTERBOX_HEIGHT)
			barBottom.Size = UDim2.fromScale(1, LETTERBOX_HEIGHT)
		else
			Widgets.tween(root, Theme.Tween.Fade, { GroupTransparency = 0 })
			Widgets.tween(barTop, Theme.Tween.Slow, { Size = UDim2.fromScale(1, LETTERBOX_HEIGHT) })
			Widgets.tween(barBottom, Theme.Tween.Slow, { Size = UDim2.fromScale(1, LETTERBOX_HEIGHT) })
		end

		-- Staggered slide-in for the title and options.
		titleGroup.Position = UDim2.fromOffset(-30, 0)
		Widgets.tween(titleGroup, Theme.Tween.Slow, { Position = UDim2.fromOffset(0, 0) })
		for i, def in MAIN_OPTIONS do
			local content = optionRows[def.Id].Content
			content.Position = UDim2.fromOffset(-40, 0)
			task.delay(0.12 + i * 0.07, function()
				Widgets.tween(content, Theme.Tween.Slow, { Position = UDim2.fromOffset(0, 0) })
			end)
		end
	end

	function ui.hide(_self: MenuUI, duration: number?)
		local d = duration or 0.8
		interactive = false
		ui:openPanel(nil)
		local info = TweenInfo.new(d, Enum.EasingStyle.Quint, Enum.EasingDirection.InOut)
		Widgets.tween(root, info, { GroupTransparency = 1 })
		Widgets.tween(barTop, TweenInfo.new(d * 1.4, Enum.EasingStyle.Quint, Enum.EasingDirection.InOut), { Size = UDim2.fromScale(1, 0) })
		Widgets.tween(barBottom, TweenInfo.new(d * 1.4, Enum.EasingStyle.Quint, Enum.EasingDirection.InOut), { Size = UDim2.fromScale(1, 0) })
		for i, def in MAIN_OPTIONS do
			local content = optionRows[def.Id].Content
			task.delay((i - 1) * 0.04, function()
				Widgets.tween(content, info, { Position = UDim2.fromOffset(-60, 0) })
			end)
		end
		task.delay(d * 1.4, function()
			if not interactive then
				root.Visible = false
			end
		end)
	end

	function ui.fade(_self: MenuUI, toBlack: boolean, duration: number)
		local tween = Widgets.tween(fader, TweenInfo.new(duration, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
			BackgroundTransparency = if toBlack then 0 else 1,
		})
		tween.Completed:Wait()
	end

	local toastToken = 0
	function ui.toast(_self: MenuUI, text: string)
		toastToken += 1
		local token = toastToken
		toastLabel.Text = Theme.track(text)
		Widgets.tween(toastLabel, Theme.Tween.Medium, { TextTransparency = 0 })
		task.delay(3, function()
			if token == toastToken then
				Widgets.tween(toastLabel, Theme.Tween.Slow, { TextTransparency = 1 })
			end
		end)
	end

	ui:setLoadout(currentLoadout)
	ui:setSettings(ctx.Settings)
	return ui
end

return MenuUI
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000034"><Properties><string name="Name">Theme</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Theme
	Typography, colour and motion tokens for every client UI.
]]

local Theme = {}

local MONTSERRAT = "rbxasset://fonts/families/Montserrat.json"
local GOTHAM = "rbxasset://fonts/families/GothamSSm.json"
local MONO = "rbxasset://fonts/families/RobotoMono.json"

Theme.Fonts = {
	Display = Font.new(MONTSERRAT, Enum.FontWeight.ExtraBold),
	Heading = Font.new(MONTSERRAT, Enum.FontWeight.Bold),
	Option = Font.new(MONTSERRAT, Enum.FontWeight.SemiBold),
	Body = Font.new(GOTHAM, Enum.FontWeight.Medium),
	Mono = Font.new(MONO, Enum.FontWeight.Regular),
	MonoBold = Font.new(MONO, Enum.FontWeight.Bold),
}

Theme.Colors = {
	Text = Color3.fromRGB(236, 234, 228),
	Dim = Color3.fromRGB(150, 150, 146),
	Accent = Color3.fromRGB(255, 168, 86),
	AccentCool = Color3.fromRGB(90, 210, 255),
	Danger = Color3.fromRGB(255, 72, 72),
	Black = Color3.new(0, 0, 0),
	White = Color3.new(1, 1, 1),
}

Theme.Tween = {
	Fast = TweenInfo.new(0.16, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
	Medium = TweenInfo.new(0.32, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
	Slow = TweenInfo.new(0.7, Enum.EasingStyle.Quint, Enum.EasingDirection.InOut),
	Fade = TweenInfo.new(0.9, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
}

Theme.Text = {
	IdleTransparency = 0.42,
	DimTransparency = 0.55,
}

-- Wide tracking for small caps labels (thin spaces between glyphs).
local THIN = utf8.char(0x2009)
function Theme.track(text: string): string
	local out = {}
	for _, code in utf8.codes(text) do
		local char = utf8.char(code)
		if char == " " then
			table.insert(out, THIN .. THIN .. THIN)
		else
			table.insert(out, char)
		end
	end
	return table.concat(out, THIN)
end

return Theme
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000035"><Properties><string name="Name">Widgets</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Widgets
	Minimal, boxless UI primitives with motion baked in. Every interactive
	widget returns a Row so MenuUI can drive mouse, keyboard and gamepad
	focus through one navigation model.
]]

local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Theme = require(script.Parent.Theme)

export type Row = {
	Root: GuiObject,
	SetFocused: (focused: boolean) -> (),
	Activate: (() -> ())?,
	Adjust: ((direction: number) -> ())?,
}

export type OptionRow = {
	Root: GuiObject,
	Content: Frame,
	SetFocused: (focused: boolean) -> (),
	Activate: (() -> ())?,
	Adjust: ((direction: number) -> ())?,
	SetActive: (active: boolean) -> (),
}

export type SliderRow = {
	Root: GuiObject,
	SetFocused: (focused: boolean) -> (),
	Activate: (() -> ())?,
	Adjust: ((direction: number) -> ())?,
	Set: (value: number, silent: boolean?) -> (),
}

export type CycleRow = {
	Root: GuiObject,
	SetFocused: (focused: boolean) -> (),
	Activate: (() -> ())?,
	Adjust: ((direction: number) -> ())?,
	Set: (index: number, silent: boolean?) -> (),
}

export type WeaponRow = {
	Root: GuiObject,
	SetFocused: (focused: boolean) -> (),
	Activate: (() -> ())?,
	Adjust: ((direction: number) -> ())?,
	SetSelected: (selected: boolean) -> (),
}

export type StatBar = {
	Root: Frame,
	Set: (alpha: number) -> (),
}

export type LabelProps = {
	Name: string,
	Text: string,
	Font: Font,
	TextSize: number,
	Color: Color3?,
	Transparency: number?,
	Size: UDim2?,
	Position: UDim2?,
	AnchorPoint: Vector2?,
	XAlign: Enum.TextXAlignment?,
	YAlign: Enum.TextYAlignment?,
	AutomaticSize: Enum.AutomaticSize?,
	Wrapped: boolean?,
	LayoutOrder: number?,
	ZIndex: number?,
}

export type FrameProps = {
	Name: string,
	Size: UDim2,
	Position: UDim2?,
	AnchorPoint: Vector2?,
	Color: Color3?,
	Transparency: number?,
	LayoutOrder: number?,
	ZIndex: number?,
	ClipsDescendants: boolean?,
}

local Widgets = {}

function Widgets.tween(instance: Instance, info: TweenInfo, goals: { [string]: any }): Tween
	local tween = TweenService:Create(instance, info, goals)
	tween:Play()
	return tween
end

function Widgets.label(parent: Instance, p: LabelProps): TextLabel
	local label = Instance.new("TextLabel")
	label.Name = p.Name
	label.BackgroundTransparency = 1
	label.BorderSizePixel = 0
	label.Text = p.Text
	label.FontFace = p.Font
	label.TextSize = p.TextSize
	label.TextColor3 = p.Color or Theme.Colors.Text
	label.TextTransparency = p.Transparency or 0
	label.Size = p.Size or UDim2.new(1, 0, 0, p.TextSize + 6)
	label.Position = p.Position or UDim2.new()
	label.AnchorPoint = p.AnchorPoint or Vector2.zero
	label.TextXAlignment = p.XAlign or Enum.TextXAlignment.Left
	label.TextYAlignment = p.YAlign or Enum.TextYAlignment.Center
	label.AutomaticSize = p.AutomaticSize or Enum.AutomaticSize.None
	label.TextWrapped = p.Wrapped == true
	label.LayoutOrder = p.LayoutOrder or 0
	label.ZIndex = p.ZIndex or 1
	label.Parent = parent
	return label
end

function Widgets.frame(parent: Instance, p: FrameProps): Frame
	local frame = Instance.new("Frame")
	frame.Name = p.Name
	frame.Size = p.Size
	frame.Position = p.Position or UDim2.new()
	frame.AnchorPoint = p.AnchorPoint or Vector2.zero
	frame.BackgroundColor3 = p.Color or Theme.Colors.Black
	frame.BackgroundTransparency = if p.Transparency == nil then 1 else p.Transparency
	frame.BorderSizePixel = 0
	frame.LayoutOrder = p.LayoutOrder or 0
	frame.ZIndex = p.ZIndex or 1
	frame.ClipsDescendants = p.ClipsDescendants == true
	frame.Parent = parent
	return frame
end

function Widgets.hitbox(parent: Instance, name: string, size: UDim2?, position: UDim2?): TextButton
	local button = Instance.new("TextButton")
	button.Name = name
	button.Text = ""
	button.AutoButtonColor = false
	button.BackgroundTransparency = 1
	button.BorderSizePixel = 0
	button.Selectable = false
	button.Size = size or UDim2.fromScale(1, 1)
	button.Position = position or UDim2.new()
	button.ZIndex = 5
	button.Parent = parent
	return button
end

function Widgets.list(parent: Instance, padding: number, horizontal: boolean?): UIListLayout
	local layout = Instance.new("UIListLayout")
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Padding = UDim.new(0, padding)
	layout.FillDirection = if horizontal then Enum.FillDirection.Horizontal else Enum.FillDirection.Vertical
	layout.Parent = parent
	return layout
end

function Widgets.section(parent: Instance, text: string, order: number): TextLabel
	return Widgets.label(parent, {
		Name = "Section_" .. text,
		Text = Theme.track(text),
		Font = Theme.Fonts.MonoBold,
		TextSize = 11,
		Color = Theme.Colors.Accent,
		Transparency = 0.1,
		Size = UDim2.new(1, 0, 0, 26),
		YAlign = Enum.TextYAlignment.Bottom,
		LayoutOrder = order,
	})
end

--------------------------------------------------------------------------------
-- Main menu option: "01 — DEPLOY"
--------------------------------------------------------------------------------
export type OptionOpts = {
	Name: string,
	Index: number,
	Text: string,
	TextSize: number,
	LayoutOrder: number,
	OnActivate: () -> (),
	OnHover: () -> (),
}

function Widgets.menuOption(parent: Instance, opts: OptionOpts): OptionRow
	local height = opts.TextSize + 22
	local root = Widgets.frame(parent, { Name = opts.Name, Size = UDim2.new(1, 0, 0, height), LayoutOrder = opts.LayoutOrder })
	local content = Widgets.frame(root, { Name = "Content", Size = UDim2.fromScale(1, 1) })

	local index = Widgets.label(content, {
		Name = "Index",
		Text = string.format("%02d", opts.Index),
		Font = Theme.Fonts.Mono,
		TextSize = 12,
		Color = Theme.Colors.Dim,
		Transparency = 0.6,
		Size = UDim2.new(0, 28, 1, 0),
	})
	local bar = Widgets.frame(content, {
		Name = "Bar",
		Size = UDim2.fromOffset(0, 2),
		Position = UDim2.new(0, 34, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		Color = Theme.Colors.Accent,
		Transparency = 0,
	})
	local label = Widgets.label(content, {
		Name = "Label",
		Text = Theme.track(opts.Text),
		Font = if opts.TextSize >= 30 then Theme.Fonts.Heading else Theme.Fonts.Option,
		TextSize = opts.TextSize,
		Transparency = Theme.Text.IdleTransparency,
		Size = UDim2.new(1, -40, 1, 0),
		Position = UDim2.new(0, 34, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
	})
	local hit = Widgets.hitbox(root, "Hit")

	local focused = false
	local active = false
	local function render()
		local lit = focused or active
		Widgets.tween(label, Theme.Tween.Medium, {
			Position = UDim2.new(0, if lit then 64 else 34, 0.5, 0),
			TextTransparency = if lit then 0 else Theme.Text.IdleTransparency,
			TextColor3 = if active then Theme.Colors.Accent else Theme.Colors.Text,
		})
		Widgets.tween(bar, Theme.Tween.Medium, { Size = UDim2.fromOffset(if lit then 22 else 0, 2) })
		Widgets.tween(index, Theme.Tween.Fast, {
			TextTransparency = if lit then 0.15 else 0.6,
			TextColor3 = if active then Theme.Colors.Accent else Theme.Colors.Dim,
		})
	end

	hit.MouseEnter:Connect(opts.OnHover)
	hit.Activated:Connect(opts.OnActivate)

	return {
		Root = root,
		Content = content,
		SetFocused = function(value: boolean)
			if focused ~= value then
				focused = value
				render()
			end
		end,
		Activate = opts.OnActivate,
		Adjust = nil,
		SetActive = function(value: boolean)
			if active ~= value then
				active = value
				render()
			end
		end,
	}
end

--------------------------------------------------------------------------------
-- Slider
--------------------------------------------------------------------------------
export type SliderOpts = {
	Name: string,
	Label: string,
	Min: number,
	Max: number,
	Step: number,
	KeyStep: number,
	Value: number,
	Format: (value: number) -> string,
	LayoutOrder: number,
	OnChanged: (value: number) -> (),
	OnHover: () -> (),
	OnTick: () -> (),
}

function Widgets.slider(parent: Instance, opts: SliderOpts): SliderRow
	local root = Widgets.frame(parent, { Name = opts.Name, Size = UDim2.new(1, 0, 0, 64), LayoutOrder = opts.LayoutOrder })
	local caption = Widgets.label(root, {
		Name = "Caption",
		Text = Theme.track(opts.Label),
		Font = Theme.Fonts.Mono,
		TextSize = 12,
		Color = Theme.Colors.Text,
		Transparency = Theme.Text.DimTransparency,
		Size = UDim2.new(0.7, 0, 0, 22),
	})
	local valueLabel = Widgets.label(root, {
		Name = "Value",
		Text = opts.Format(opts.Value),
		Font = Theme.Fonts.Heading,
		TextSize = 18,
		Size = UDim2.new(0.3, 0, 0, 22),
		Position = UDim2.fromScale(1, 0),
		AnchorPoint = Vector2.new(1, 0),
		XAlign = Enum.TextXAlignment.Right,
	})
	local track = Widgets.frame(root, {
		Name = "Track",
		Size = UDim2.new(1, 0, 0, 2),
		Position = UDim2.new(0, 0, 0, 44),
		Color = Theme.Colors.White,
		Transparency = 0.85,
	})
	local fill = Widgets.frame(track, {
		Name = "Fill",
		Size = UDim2.fromScale(0, 1),
		Color = Theme.Colors.Accent,
		Transparency = 0,
	})
	local knob = Widgets.frame(track, {
		Name = "Knob",
		Size = UDim2.fromOffset(10, 10),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0, 0.5),
		Color = Theme.Colors.White,
		Transparency = 0,
		ZIndex = 2,
	})
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(1, 0)
	corner.Parent = knob
	local hit = Widgets.hitbox(root, "Hit")

	local value = opts.Value
	local dragging = false
	local focused = false

	local function alphaOf(v: number): number
		return math.clamp((v - opts.Min) / (opts.Max - opts.Min), 0, 1)
	end

	local function render(animate: boolean)
		local a = alphaOf(value)
		local info = if animate then Theme.Tween.Fast else TweenInfo.new(0)
		Widgets.tween(fill, info, { Size = UDim2.fromScale(a, 1) })
		Widgets.tween(knob, info, { Position = UDim2.fromScale(a, 0.5) })
		valueLabel.Text = opts.Format(value)
	end

	local function set(v: number, silent: boolean?)
		local stepped = math.round(v / opts.Step) * opts.Step
		stepped = math.clamp(stepped, opts.Min, opts.Max)
		-- Kill float noise (0.30000000004)
		stepped = math.round(stepped * 1000) / 1000
		if stepped == value then
			return
		end
		value = stepped
		render(true)
		if not silent then
			opts.OnTick()
			opts.OnChanged(value)
		end
	end

	local function setFromScreenX(x: number)
		local absPos = track.AbsolutePosition.X
		local absSize = track.AbsoluteSize.X
		if absSize <= 0 then
			return
		end
		local a = math.clamp((x - absPos) / absSize, 0, 1)
		set(opts.Min + a * (opts.Max - opts.Min))
	end

	local function renderFocus()
		local lit = focused or dragging
		Widgets.tween(caption, Theme.Tween.Fast, { TextTransparency = if lit then 0.05 else Theme.Text.DimTransparency })
		Widgets.tween(knob, Theme.Tween.Fast, { Size = UDim2.fromOffset(if lit then 14 else 10, if lit then 14 else 10) })
		Widgets.tween(track, Theme.Tween.Fast, { BackgroundTransparency = if lit then 0.7 else 0.85 })
	end

	hit.MouseEnter:Connect(opts.OnHover)
	hit.InputBegan:Connect(function(input: InputObject)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			renderFocus()
			setFromScreenX(input.Position.X)
		end
	end)
	UserInputService.InputChanged:Connect(function(input: InputObject)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			setFromScreenX(input.Position.X)
		end
	end)
	UserInputService.InputEnded:Connect(function(input: InputObject)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
			dragging = false
			renderFocus()
		end
	end)

	render(false)

	return {
		Root = root,
		SetFocused = function(v: boolean)
			if focused ~= v then
				focused = v
				renderFocus()
			end
		end,
		Activate = nil,
		Adjust = function(direction: number)
			set(value + direction * opts.KeyStep)
		end,
		Set = function(v: number, silent: boolean?)
			set(v, if silent == nil then true else silent)
		end,
	}
end

--------------------------------------------------------------------------------
-- Cycle selector: LABEL ........ ‹ HIGH ›
--------------------------------------------------------------------------------
export type CycleOpts = {
	Name: string,
	Label: string,
	Options: { string },
	Index: number,
	LayoutOrder: number,
	OnChanged: (index: number) -> (),
	OnHover: () -> (),
	OnTick: () -> (),
}

function Widgets.cycle(parent: Instance, opts: CycleOpts): CycleRow
	local root = Widgets.frame(parent, { Name = opts.Name, Size = UDim2.new(1, 0, 0, 48), LayoutOrder = opts.LayoutOrder })
	local caption = Widgets.label(root, {
		Name = "Caption",
		Text = Theme.track(opts.Label),
		Font = Theme.Fonts.Mono,
		TextSize = 12,
		Transparency = Theme.Text.DimTransparency,
		Size = UDim2.new(0.5, 0, 1, 0),
	})
	local valueLabel = Widgets.label(root, {
		Name = "Value",
		Text = string.upper(opts.Options[opts.Index] or ""),
		Font = Theme.Fonts.Heading,
		TextSize = 18,
		Size = UDim2.new(0, 120, 1, 0),
		Position = UDim2.new(1, -26, 0, 0),
		AnchorPoint = Vector2.new(1, 0),
		XAlign = Enum.TextXAlignment.Center,
	})
	local left = Widgets.label(root, {
		Name = "Left",
		Text = "‹",
		Font = Theme.Fonts.Heading,
		TextSize = 22,
		Color = Theme.Colors.Accent,
		Transparency = 0.5,
		Size = UDim2.new(0, 24, 1, 0),
		Position = UDim2.new(1, -146, 0, 0),
		AnchorPoint = Vector2.new(1, 0),
		XAlign = Enum.TextXAlignment.Center,
	})
	local right = Widgets.label(root, {
		Name = "Right",
		Text = "›",
		Font = Theme.Fonts.Heading,
		TextSize = 22,
		Color = Theme.Colors.Accent,
		Transparency = 0.5,
		Size = UDim2.new(0, 24, 1, 0),
		Position = UDim2.fromScale(1, 0),
		AnchorPoint = Vector2.new(1, 0),
		XAlign = Enum.TextXAlignment.Center,
	})
	local rowHit = Widgets.hitbox(root, "Hit")
	local leftHit = Widgets.hitbox(root, "LeftHit", UDim2.new(0, 40, 1, 0), UDim2.new(1, -170, 0, 0))
	local rightHit = Widgets.hitbox(root, "RightHit", UDim2.new(0, 40, 1, 0), UDim2.new(1, -40, 0, 0))
	leftHit.ZIndex = 6
	rightHit.ZIndex = 6

	local index = opts.Index
	local focused = false

	local function set(i: number, silent: boolean?)
		local count = #opts.Options
		local wrapped = ((i - 1) % count) + 1
		if wrapped == index then
			return
		end
		local direction = if i > index then 1 else -1
		index = wrapped
		valueLabel.Text = string.upper(opts.Options[index])
		-- Slide-in micro motion
		valueLabel.Position = UDim2.new(1, -26 + direction * 10, 0, 0)
		valueLabel.TextTransparency = 0.6
		Widgets.tween(valueLabel, Theme.Tween.Medium, { Position = UDim2.new(1, -26, 0, 0), TextTransparency = 0 })
		if not silent then
			opts.OnTick()
			opts.OnChanged(index)
		end
	end

	local function renderFocus()
		Widgets.tween(caption, Theme.Tween.Fast, { TextTransparency = if focused then 0.05 else Theme.Text.DimTransparency })
		Widgets.tween(left, Theme.Tween.Fast, { TextTransparency = if focused then 0 else 0.5 })
		Widgets.tween(right, Theme.Tween.Fast, { TextTransparency = if focused then 0 else 0.5 })
	end

	for _, hit in { rowHit, leftHit, rightHit } do
		hit.MouseEnter:Connect(opts.OnHover)
	end
	rowHit.Activated:Connect(function()
		set(index + 1)
	end)
	leftHit.Activated:Connect(function()
		set(index - 1)
	end)
	rightHit.Activated:Connect(function()
		set(index + 1)
	end)

	return {
		Root = root,
		SetFocused = function(v: boolean)
			if focused ~= v then
				focused = v
				renderFocus()
			end
		end,
		Activate = function()
			set(index + 1)
		end,
		Adjust = function(direction: number)
			set(index + direction)
		end,
		Set = function(i: number, silent: boolean?)
			set(i, if silent == nil then true else silent)
		end,
	}
end

--------------------------------------------------------------------------------
-- Weapon row (loadout list)
--------------------------------------------------------------------------------
export type WeaponRowOpts = {
	Name: string,
	Title: string,
	Tag: string,
	LayoutOrder: number,
	OnActivate: () -> (),
	OnHover: () -> (),
}

function Widgets.weaponRow(parent: Instance, opts: WeaponRowOpts): WeaponRow
	local root = Widgets.frame(parent, {
		Name = opts.Name,
		Size = UDim2.new(1, 0, 0, 48),
		LayoutOrder = opts.LayoutOrder,
		Color = Theme.Colors.White,
		Transparency = 1,
	})
	local marker = Widgets.frame(root, {
		Name = "Marker",
		Size = UDim2.new(0, 3, 0, 0),
		Position = UDim2.fromScale(0, 0.5),
		AnchorPoint = Vector2.new(0, 0.5),
		Color = Theme.Colors.Accent,
		Transparency = 0,
	})
	local title = Widgets.label(root, {
		Name = "Title",
		Text = opts.Title,
		Font = Theme.Fonts.Option,
		TextSize = 19,
		Transparency = Theme.Text.IdleTransparency,
		Size = UDim2.new(1, -110, 1, 0),
		Position = UDim2.new(0, 16, 0, 0),
	})
	local tag = Widgets.label(root, {
		Name = "Tag",
		Text = Theme.track(opts.Tag),
		Font = Theme.Fonts.Mono,
		TextSize = 11,
		Color = Theme.Colors.Dim,
		Transparency = 0.3,
		Size = UDim2.new(0, 100, 1, 0),
		Position = UDim2.new(1, -12, 0, 0),
		AnchorPoint = Vector2.new(1, 0),
		XAlign = Enum.TextXAlignment.Right,
	})
	local hit = Widgets.hitbox(root, "Hit")

	local focused = false
	local selected = false
	local function render()
		Widgets.tween(root, Theme.Tween.Fast, { BackgroundTransparency = if focused then 0.94 else 1 })
		Widgets.tween(marker, Theme.Tween.Medium, { Size = UDim2.new(0, 3, if selected then 0.62 else 0, 0) })
		Widgets.tween(title, Theme.Tween.Fast, {
			TextTransparency = if selected or focused then 0 else Theme.Text.IdleTransparency,
			TextColor3 = if selected then Theme.Colors.Accent else Theme.Colors.Text,
		})
		Widgets.tween(tag, Theme.Tween.Fast, { TextTransparency = if selected or focused then 0.1 else 0.3 })
	end

	hit.MouseEnter:Connect(opts.OnHover)
	hit.Activated:Connect(opts.OnActivate)

	return {
		Root = root,
		SetFocused = function(v: boolean)
			if focused ~= v then
				focused = v
				render()
			end
		end,
		Activate = opts.OnActivate,
		Adjust = nil,
		SetSelected = function(v: boolean)
			if selected ~= v then
				selected = v
				render()
			end
		end,
	}
end

--------------------------------------------------------------------------------
-- Stat bar
--------------------------------------------------------------------------------
function Widgets.statBar(parent: Instance, name: string, order: number): StatBar
	local root = Widgets.frame(parent, { Name = "Stat_" .. name, Size = UDim2.new(1, 0, 0, 22), LayoutOrder = order })
	Widgets.label(root, {
		Name = "Caption",
		Text = Theme.track(name),
		Font = Theme.Fonts.Mono,
		TextSize = 10,
		Color = Theme.Colors.Dim,
		Size = UDim2.new(0, 110, 1, 0),
	})
	local track = Widgets.frame(root, {
		Name = "Track",
		Size = UDim2.new(1, -120, 0, 2),
		Position = UDim2.new(0, 120, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		Color = Theme.Colors.White,
		Transparency = 0.86,
	})
	local fill = Widgets.frame(track, {
		Name = "Fill",
		Size = UDim2.fromScale(0, 1),
		Color = Theme.Colors.Text,
		Transparency = 0,
	})
	return {
		Root = root,
		Set = function(alpha: number)
			Widgets.tween(fill, Theme.Tween.Slow, { Size = UDim2.fromScale(math.clamp(alpha, 0, 1), 1) })
		end,
	}
end

return Widgets
