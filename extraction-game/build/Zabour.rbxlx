]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000009"><Properties><string name="Name">Net</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Net
	Owns every RemoteEvent / RemoteFunction. The server creates them once in
	Net.init(); both sides fetch them by name through Net.event / Net.func.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local FOLDER_NAME = "Remotes"
local CLIENT_TIMEOUT = 30

local Net = {}

Net.Events = {
	RequestDeploy = "RequestDeploy",
	SetLoadout = "SetLoadout",
	SaveSettings = "SaveSettings",
	-- Phase 2 combat / movement
	EquipSlot = "EquipSlot", -- client -> server (slot)
	Fire = "Fire", -- client -> server (shotId, origin, direction)
	Reload = "Reload", -- client -> server
	SetStance = "SetStance", -- client -> server (stance, sprinting)
	HitConfirm = "HitConfirm", -- server -> shooter (kind, damage, position)
	AmmoSync = "AmmoSync", -- server -> owner (slot, mag, reserve, reloading)
	-- Phase 3 vehicles / loot
	VehicleToggle = "VehicleToggle", -- client -> server (car, "Lights" | "Hazards" | "Underglow")
	VehicleExit = "VehicleExit", -- client -> server
	DropBag = "DropBag", -- client -> server
}

-- High-frequency, loss-tolerant traffic.
Net.Unreliable = {
	AimState = "AimState", -- client -> server (pitch, aiming)
	ShotFx = "ShotFx", -- server -> other clients (character, weaponId, origin, hitPos, normal, material)
	VehicleState = "VehicleState", -- driver -> server (car, throttle, brake, steer, handbrake, rpm, gear, backfires)
}

Net.Functions = {
	GetProfile = "GetProfile",
}

local function getFolder(): Instance
	if RunService:IsServer() then
		local existing = ReplicatedStorage:FindFirstChild(FOLDER_NAME)
		if existing then
			return existing
		end
		local folder = Instance.new("Folder")
		folder.Name = FOLDER_NAME
		folder.Parent = ReplicatedStorage
		return folder
	end
	local folder = ReplicatedStorage:WaitForChild(FOLDER_NAME, CLIENT_TIMEOUT)
	if not folder then
		error("[Net] Remotes folder never replicated — is the server Bootstrap running?")
	end
	return folder
end

local function fetch(name: string): Instance
	local folder = getFolder()
	local instance: Instance? = if RunService:IsServer()
		then folder:FindFirstChild(name)
		else folder:WaitForChild(name, CLIENT_TIMEOUT)
	if not instance then
		error(string.format("[Net] remote '%s' does not exist", name))
	end
	return instance
end

function Net.init()
	assert(RunService:IsServer(), "[Net] init() is server-only")
	local folder = getFolder()
	for _, name in Net.Events do
		if not folder:FindFirstChild(name) then
			local remote = Instance.new("RemoteEvent")
			remote.Name = name
			remote.Parent = folder
		end
	end
	for _, name in Net.Unreliable do
		if not folder:FindFirstChild(name) then
			local remote = Instance.new("UnreliableRemoteEvent")
			remote.Name = name
			remote.Parent = folder
		end
	end
	for _, name in Net.Functions do
		if not folder:FindFirstChild(name) then
			local remote = Instance.new("RemoteFunction")
			remote.Name = name
			remote.Parent = folder
		end
	end
end

function Net.event(name: string): RemoteEvent
	local instance = fetch(name)
	if instance:IsA("RemoteEvent") then
		return instance
	end
	error(string.format("[Net] '%s' is not a RemoteEvent", name))
end

function Net.unreliable(name: string): UnreliableRemoteEvent
	local instance = fetch(name)
	if instance:IsA("UnreliableRemoteEvent") then
		return instance
	end
	error(string.format("[Net] '%s' is not an UnreliableRemoteEvent", name))
end

function Net.func(name: string): RemoteFunction
	local instance = fetch(name)
	if instance:IsA("RemoteFunction") then
		return instance
	end
	error(string.format("[Net] '%s' is not a RemoteFunction", name))
end

return Net
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000010"><Properties><string name="Name">Schema</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Schema
	Validation + sanitising for anything that crosses the network or comes
	out of a DataStore. Server and client run the exact same rules.
]]

local Config = require(script.Parent.Config)
local Types = require(script.Parent.Types)

local Schema = {}

local function isFiniteNumber(value: any): boolean
	return typeof(value) == "number" and value == value and value ~= math.huge and value ~= -math.huge
end
Schema.isFiniteNumber = isFiniteNumber

function Schema.isQuality(value: any): boolean
	if typeof(value) ~= "string" then
		return false
	end
	return table.find(Config.Settings.QualityLevels, value :: any) ~= nil
end

function Schema.sanitizeSettings(raw: any, fallback: Types.PlayerSettings): Types.PlayerSettings
	local result: Types.PlayerSettings = {
		Quality = fallback.Quality,
		FieldOfView = fallback.FieldOfView,
		Sensitivity = fallback.Sensitivity,
	}
	if typeof(raw) ~= "table" then
		return result
	end

	if Schema.isQuality(raw.Quality) then
		result.Quality = raw.Quality
	end
	if isFiniteNumber(raw.FieldOfView) then
		result.FieldOfView = math.clamp(math.round(raw.FieldOfView), Config.Settings.FovMin, Config.Settings.FovMax)
	end
	if isFiniteNumber(raw.Sensitivity) then
		local rounded = math.round(raw.Sensitivity * 100) / 100
		result.Sensitivity = math.clamp(rounded, Config.Settings.SensitivityMin, Config.Settings.SensitivityMax)
	end
	return result
end

function Schema.isWeaponForSlot(slot: any, weaponId: any): boolean
	if typeof(slot) ~= "string" or typeof(weaponId) ~= "string" then
		return false
	end
	local def = Config.Weapons[weaponId]
	return def ~= nil and def.Slot == slot
end

function Schema.sanitizeLoadout(raw: any, fallback: Types.Loadout): Types.Loadout
	local result: Types.Loadout = {
		Primary = fallback.Primary,
		Secondary = fallback.Secondary,
	}
	if typeof(raw) ~= "table" then
		return result
	end
	if Schema.isWeaponForSlot("Primary", raw.Primary) then
		result.Primary = raw.Primary
	end
	if Schema.isWeaponForSlot("Secondary", raw.Secondary) then
		result.Secondary = raw.Secondary
	end
	return result
end

function Schema.weaponsForSlot(slot: Types.WeaponSlot): { string }
	local ids: { string } = {}
	for id, def in Config.Weapons do
		if def.Slot == slot then
			table.insert(ids, id)
		end
	end
	table.sort(ids, function(a: string, b: string): boolean
		return Config.Weapons[a].Order < Config.Weapons[b].Order
	end)
	return ids
end

return Schema
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000011"><Properties><string name="Name">Signal</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Signal
	Lightweight pure-Luau signal. Handlers run in their own thread so a
	yielding or erroring listener never blocks the emitter.
]]

export type Connection = {
	Connected: boolean,
	Disconnect: (self: Connection) -> (),
}

export type Signal = {
	Connect: (self: Signal, handler: (...any) -> ()) -> Connection,
	Once: (self: Signal, handler: (...any) -> ()) -> Connection,
	Fire: (self: Signal, ...any) -> (),
	Wait: (self: Signal) -> ...any,
	DisconnectAll: (self: Signal) -> (),
}

type Record = {
	Handler: (...any) -> (),
	Connected: boolean,
}

local Signal = {}

function Signal.new(): Signal
	local records: { Record } = {}

	local function connect(handler: (...any) -> ()): Connection
		local record: Record = { Handler = handler, Connected = true }
		table.insert(records, record)

		local connection: Connection
		connection = {
			Connected = true,
			Disconnect = function(_self: Connection)
				if not record.Connected then
					return
				end
				record.Connected = false
				connection.Connected = false
				local index = table.find(records, record)
				if index then
					table.remove(records, index)
				end
			end,
		}
		return connection
	end

	local signal: Signal
	signal = {
		Connect = function(_self: Signal, handler: (...any) -> ()): Connection
			return connect(handler)
		end,

		Once = function(_self: Signal, handler: (...any) -> ()): Connection
			local connection: Connection
			connection = connect(function(...: any)
				connection:Disconnect()
				handler(...)
			end)
			return connection
		end,

		Fire = function(_self: Signal, ...: any)
			local snapshot = table.clone(records)
			for _, record in snapshot do
				if record.Connected then
					task.spawn(record.Handler, ...)
				end
			end
		end,

		Wait = function(_self: Signal): ...any
			local thread = coroutine.running()
			signal:Once(function(...: any)
				task.spawn(thread, ...)
			end)
			return coroutine.yield()
		end,

		DisconnectAll = function(_self: Signal)
			for _, record in records do
				record.Connected = false
			end
			table.clear(records)
		end,
	}
	return signal
end

return Signal
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000012"><Properties><string name="Name">Spring</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Spring
	Damped harmonic spring on Vector3 (use the X component for scalars).
	Integrated with fixed sub-steps so it stays stable at any frame rate.

		local s = Spring.new(Vector3.zero, 6, 0.8) -- 6 Hz, damping ratio 0.8
		s.Target = Vector3.new(1, 0, 0)
		local p = s:update(dt)
		s:impulse(Vector3.new(0, 4, 0)) -- add velocity (recoil kicks, bumps)
]]

local SUBSTEP = 1 / 240
local MAX_DT = 0.1

local SpringClass = {}
SpringClass.__index = SpringClass

type SpringData = {
	Position: Vector3,
	Velocity: Vector3,
	Target: Vector3,
	Frequency: number,
	Damping: number,
}

export type Spring = typeof(setmetatable({} :: SpringData, SpringClass))

function SpringClass.new(initial: Vector3, frequency: number, damping: number): Spring
	local data: SpringData = {
		Position = initial,
		Velocity = Vector3.zero,
		Target = initial,
		Frequency = frequency,
		Damping = damping,
	}
	return setmetatable(data, SpringClass)
end

function SpringClass.update(self: Spring, dt: number): Vector3
	local remaining = math.min(dt, MAX_DT)
	local omega = self.Frequency * 2 * math.pi
	local stiffness = omega * omega
	local damping = 2 * self.Damping * omega

	local position = self.Position
	local velocity = self.Velocity
	local target = self.Target

	while remaining > 1e-6 do
		local h = math.min(SUBSTEP, remaining)
		local acceleration = (target - position) * stiffness - velocity * damping
		velocity += acceleration * h
		position += velocity * h
		remaining -= h
	end

	self.Position = position
	self.Velocity = velocity
	return position
end

function SpringClass.impulse(self: Spring, velocity: Vector3)
	self.Velocity += velocity
end

function SpringClass.reset(self: Spring, value: Vector3)
	self.Position = value
	self.Target = value
	self.Velocity = Vector3.zero
end

return SpringClass
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000013"><Properties><string name="Name">Trove</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Trove
	Collects connections, instances, threads and cleanup callbacks so a whole
	feature can be torn down with one Clean() call.
]]

export type Trove = {
	Add: (self: Trove, item: any) -> any,
	Connect: (self: Trove, signal: RBXScriptSignal, handler: (...any) -> ()) -> RBXScriptConnection,
	BindToRenderStep: (self: Trove, name: string, priority: number, fn: (dt: number) -> ()) -> (),
	Clean: (self: Trove) -> (),
}

local RunService = game:GetService("RunService")

local Trove = {}

local function cleanItem(item: any)
	local kind = typeof(item)
	if kind == "RBXScriptConnection" then
		(item :: RBXScriptConnection):Disconnect()
	elseif kind == "Instance" then
		(item :: Instance):Destroy()
	elseif kind == "function" then
		(item :: () -> ())()
	elseif kind == "thread" then
		local thread = item :: thread
		if coroutine.status(thread) ~= "dead" then
			pcall(task.cancel, thread)
		end
	elseif kind == "table" then
		if typeof(item.Destroy) == "function" then
			item:Destroy()
		elseif typeof(item.Disconnect) == "function" then
			item:Disconnect()
		elseif typeof(item.Clean) == "function" then
			item:Clean()
		end
	end
end

function Trove.new(): Trove
	local items: { any } = {}

	local trove: Trove
	trove = {
		Add = function(_self: Trove, item: any): any
			table.insert(items, item)
			return item
		end,

		Connect = function(_self: Trove, signal: RBXScriptSignal, handler: (...any) -> ()): RBXScriptConnection
			local connection = signal:Connect(handler)
			table.insert(items, connection)
			return connection
		end,

		BindToRenderStep = function(_self: Trove, name: string, priority: number, fn: (dt: number) -> ())
			RunService:BindToRenderStep(name, priority, fn)
			table.insert(items, function()
				RunService:UnbindFromRenderStep(name)
			end)
		end,

		Clean = function(_self: Trove)
			-- Clean in reverse so later dependents go first.
			for index = #items, 1, -1 do
				local item = items[index]
				items[index] = nil
				local ok, err = pcall(cleanItem, item)
				if not ok then
					warn("[Trove] cleanup error:", err)
				end
			end
		end,
	}
	return trove
end

return Trove
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000014"><Properties><string name="Name">Types</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Types
	Shared type contracts between server and client. No runtime dependencies.
]]

export type QualityLevel = "Low" | "Medium" | "High" | "Ultra"

export type PlayerState = "Menu" | "Deploying" | "Deployed"

export type WeaponSlot = "Primary" | "Secondary"

export type PlayerSettings = {
	Quality: QualityLevel,
	FieldOfView: number,
	Sensitivity: number,
}

export type Loadout = {
	Primary: string,
	Secondary: string,
}

export type WeaponStats = {
	Damage: number,
	FireRate: number,
	Handling: number,
	Range: number,
}

export type FireMode = "Auto" | "Semi"

export type Stance = "Stand" | "Crouch" | "Slide"

export type WeaponCombat = {
	Damage: number,
	HeadMultiplier: number,
	RPM: number,
	FireMode: FireMode,
	MagSize: number,
	Reserve: number,
	ReloadTime: number,
	EmptyReloadTime: number,
	DrawTime: number,
	Range: number,
	FalloffStart: number,
	MinDamageRatio: number,
	HipSpread: number, -- degrees (cone half-angle)
	AdsSpread: number,
	MoveSpread: number, -- added at full run speed
	SpreadPerShot: number,
	MaxBloom: number,
	BloomRecovery: number, -- degrees per second
	RecoilPitch: number, -- degrees per shot
	RecoilYaw: number, -- max random yaw, degrees
	RecoilRecovery: number, -- 0..1 share of climb that recovers
	AdsFovMultiplier: number,
	AdsTime: number,
	MoveSpeedMultiplier: number,
	Suppressed: boolean,
	TracerColor: Color3,
	FireSound: string, -- key into Config.Audio
}

export type WeaponDef = {
	DisplayName: string,
	Class: "RIFLE" | "SMG" | "PISTOL",
	Slot: WeaponSlot,
	Description: string,
	Stats: WeaponStats,
	Order: number,
	Combat: WeaponCombat,
}

export type ProfileData = {
	Version: number,
	Settings: PlayerSettings,
	Loadout: Loadout,
	Stash: { [string]: number },
	StashValue: number,
}

export type ClientProfile = {
	Settings: PlayerSettings,
	Loadout: Loadout,
	StashValue: number,
}

export type AudioDef = {
	Id: string,
	Volume: number,
	Speed: number,
	Group: "UI" | "Ambience" | "World",
}

export type QualityPreset = {
	RainRate: number,
	Splashes: boolean,
	GroundMist: boolean,
	Beams: boolean,
	SunRays: boolean,
	DepthOfField: boolean,
	BloomScale: number,
	Lightning: boolean,
	ExhaustSmoke: boolean,
	LightShadows: boolean,
}

return {}
]]></ProtectedString></Properties></Item></Item></Item><Item class="ServerScriptService" referent="RBX000032"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Folder" referent="RBX000031"><Properties><string name="Name">Server</string></Properties><Item class="Script" referent="RBX000017"><Properties><string name="Name">Bootstrap</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Bootstrap (Script)
	Server entry point. Order matters:
	  1. Remotes exist before any client asks for them.
	  2. Look-dev + safehouse + training range exist before the first camera needs them.
	  3. Data, deploy and combat services start listening for players.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Net = require(ReplicatedStorage.Shared.Net)
local LightingService = require(script.Parent.Services.LightingService)
local PlayerDataService = require(script.Parent.Services.PlayerDataService)
local DeployService = require(script.Parent.Services.DeployService)
local CombatService = require(script.Parent.Services.CombatService)
local LootService = require(script.Parent.Services.LootService)
local VehicleService = require(script.Parent.Services.VehicleService)
local SafehouseBuilder = require(script.Parent.World.SafehouseBuilder)
local TrainingRange = require(script.Parent.World.TrainingRange)
local ProvingGround = require(script.Parent.World.ProvingGround)

Net.init()
LightingService.apply()
local safehouse = SafehouseBuilder.ensure(false)
TrainingRange.build(safehouse)
ProvingGround.build(safehouse)
PlayerDataService.init()
DeployService.init(safehouse)
CombatService.init(DeployService.Deployed, function(player: Player)
	local data = PlayerDataService.getData(player)
	return if data then data.Loadout else Config.DefaultLoadout
end)

LootService.init(safehouse)
VehicleService.init({
	SetHolstered = CombatService.setHolstered,
	ConsumeCarried = LootService.consumeCarried,
	GiveCarried = LootService.giveCarried,
	IsCarrying = LootService.isCarrying,
})

print("[Bootstrap] Phase 3 server ready.")
]]></ProtectedString></Properties></Item><Item class="Folder" referent="RBX000024"><Properties><string name="Name">Services</string></Properties><Item class="ModuleScript" referent="RBX000018"><Properties><string name="Name">CombatService</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	CombatService
	Server-authoritative gunplay.

	Client predicts everything visual (tracer, flash, recoil, hitmarker
	preview) and sends Fire(shotId, muzzle, direction). The server owns the
	truth:

	  • equipped weapon, magazine + reserve ammo, reload timers, draw time
	  • fire rate via a token bucket (tolerates network jitter, blocks macros)
	  • muzzle must be near the shooter's head and in line of sight from it
	    (no shooting through walls from a muzzle poked through geometry)
	  • its own raycast decides what was hit; damage falloff + headshots
	  • PvP gate (safehouse is a safe zone in Phase 2)

	Results: HitConfirm -> shooter, ShotFx -> everyone else, AmmoSync -> owner.
	Also replicates stance/aim attributes that drive procedural poses.
]]

local Players = game:GetService("Players")
local PhysicsService = game:GetService("PhysicsService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local Schema = require(Shared.Schema)
local Types = require(Shared.Types)
local WeaponBuilder = require(Shared.Builders.WeaponBuilder)

local CombatService = {}

type WeaponState = {
	Id: string,
	Slot: Types.WeaponSlot,
	Def: Types.WeaponDef,
	Mag: number,
	Reserve: number,
	Tokens: number,
	LastShot: number,
	Reloading: boolean,
	ReloadToken: number,
	Handles: WeaponBuilder.WeaponHandles,
	Joint: JointInstance?,
}

type Combatant = {
	Player: Player,
	Character: Model,
	Humanoid: Humanoid,
	Head: BasePart,
	Torso: BasePart,
	Weapons: { [Types.WeaponSlot]: WeaponState },
	Equipped: Types.WeaponSlot,
	ReadyAt: number,
	LastAim: number,
	LastStance: number,
	Holstered: boolean,
}

local SLOTS: { Types.WeaponSlot } = { "Primary", "Secondary" }
local VALID_STANCES = { Stand = true, Crouch = true, Slide = true }

local combatants: { [Player]: Combatant } = {}

local hitConfirm: RemoteEvent
local ammoSync: RemoteEvent
local shotFx: UnreliableRemoteEvent

local function isFiniteVector(v: Vector3): boolean
	return Schema.isFiniteNumber(v.X) and Schema.isFiniteNumber(v.Y) and Schema.isFiniteNumber(v.Z)
end

local function sync(player: Player, weapon: WeaponState)
	ammoSync:FireClient(player, weapon.Slot, weapon.Mag, weapon.Reserve, weapon.Reloading)
end

--------------------------------------------------------------------------------
-- Collision groups: shell casings and debris never push characters around.
--------------------------------------------------------------------------------
local function setupCollisionGroups()
	for _, name in { "Characters", "Debris" } do
		pcall(function()
			PhysicsService:RegisterCollisionGroup(name)
		end)
	end
	PhysicsService:CollisionGroupSetCollidable("Debris", "Characters", false)
	PhysicsService:CollisionGroupSetCollidable("Debris", "Debris", false)
end

local function assignCharacterGroup(character: Model)
	local function apply(d: Instance)
		if d:IsA("BasePart") then
			d.CollisionGroup = "Characters"
		end
	end
	for _, d in character:GetDescendants() do
		apply(d)
	end
	character.DescendantAdded:Connect(apply)
end

--------------------------------------------------------------------------------
-- Holster / equip joints
--------------------------------------------------------------------------------
local function limb(character: Model, r15: string, r6: string): BasePart?
	local part = character:FindFirstChild(r15) or character:FindFirstChild(r6)
	return if part and part:IsA("BasePart") then part else nil
end

local function clearJoint(weapon: WeaponState)
	local joint = weapon.Joint
	if joint then
		joint:Destroy()
		weapon.Joint = nil
	end
end

local function holster(c: Combatant, weapon: WeaponState)
	clearJoint(weapon)
	local weld = Instance.new("Weld")
	weld.Name = "Holster"
	if weapon.Slot == "Primary" then
		-- Slung diagonally across the back, barrel up-left.
		weld.Part0 = c.Torso
		weld.C0 = CFrame.new(0.5, -0.3, 0.62) * CFrame.Angles(0, 0, math.rad(-40)) * CFrame.Angles(0, math.rad(90), 0)
	else
		-- Thigh holster, barrel down.
		local thigh = limb(c.Character, "RightUpperLeg", "Right Leg") or c.Torso
		weld.Part0 = thigh
		weld.C0 = CFrame.new(0.58, 0.15, 0) * CFrame.Angles(math.rad(-90), 0, 0)
	end
	weld.Part1 = weapon.Handles.Handle
	weld.Parent = weld.Part0
	weapon.Joint = weld
	weapon.Handles.Model.Name = "Holstered_" .. weapon.Slot
end

-- R15 tool grip frame: barrel (-Z) runs along the hand's pointing direction.
local DEFAULT_GRIP = CFrame.new(0, -0.15, 0) * CFrame.Angles(math.rad(-90), 0, 0)

local function equip(c: Combatant, weapon: WeaponState)
	clearJoint(weapon)
	local hand = limb(c.Character, "RightHand", "Right Arm") or c.Torso
	local gripAttachment = hand:FindFirstChild("RightGripAttachment")
	local weld = Instance.new("Weld")
	weld.Name = "WeaponGrip"
	weld.Part0 = hand
	weld.Part1 = weapon.Handles.Handle
	weld.C0 = if gripAttachment and gripAttachment:IsA("Attachment") then gripAttachment.CFrame else DEFAULT_GRIP
	weld.Parent = hand
	weapon.Joint = weld
	weapon.Handles.Model.Name = "EquippedWeapon"
	c.Character:SetAttribute("EquippedWeapon", weapon.Id)
	c.Character:SetAttribute("WeaponClass", weapon.Def.Class)
end

local function cancelReload(player: Player, weapon: WeaponState)
	if weapon.Reloading then
		weapon.Reloading = false
		weapon.ReloadToken += 1
		sync(player, weapon)
	end
end

--------------------------------------------------------------------------------
-- Damage
--------------------------------------------------------------------------------
local function findHumanoid(part: BasePart): (Humanoid?, Model?)
	local model = part:FindFirstAncestorOfClass("Model")
	while model do
		local humanoid = model:FindFirstChildOfClass("Humanoid")
		if humanoid then
			return humanoid, model
		end
		model = model:FindFirstAncestorOfClass("Model")
	end
	return nil, nil
end

local function falloff(combat: Types.WeaponCombat, distance: number): number
	if distance <= combat.FalloffStart then
		return 1
	end
	local t = math.clamp((distance - combat.FalloffStart) / math.max(combat.Range - combat.FalloffStart, 1), 0, 1)
	return 1 + (combat.MinDamageRatio - 1) * t
end

local function applyHit(c: Combatant, weapon: WeaponState, result: RaycastResult, distance: number)
	local part = result.Instance
	if not part:IsA("BasePart") then
		return
	end
	local humanoid, model = findHumanoid(part)
	if not humanoid or not model or model == c.Character or humanoid.Health <= 0 then
		return
	end
	if Players:GetPlayerFromCharacter(model) and not Config.Combat.PvPEnabled then
		hitConfirm:FireClient(c.Player, "Blocked", 0, result.Position)
		return
	end

	local combat = weapon.Def.Combat
	local headshot = part.Name == "Head"
	local damage = combat.Damage * falloff(combat, distance) * (if headshot then combat.HeadMultiplier else 1)
	humanoid:TakeDamage(damage)
	model:SetAttribute("LastHitBy", c.Player.UserId)

	local kind = if humanoid.Health <= 0 then "Kill" elseif headshot then "Head" else "Body"
	hitConfirm:FireClient(c.Player, kind, math.round(damage), result.Position)
end

--------------------------------------------------------------------------------
-- Remote handlers
--------------------------------------------------------------------------------
local function onFire(player: Player, _shotId: any, origin: any, direction: any)
	local c = combatants[player]
	if not c or typeof(origin) ~= "Vector3" or typeof(direction) ~= "Vector3" then
		return
	end
	if not isFiniteVector(origin) or not isFiniteVector(direction) or direction.Magnitude < 0.5 then
		return
	end
	if c.Humanoid.Health <= 0 or c.Holstered or player:GetAttribute("State") ~= "Deployed" then
		return
	end

	local now = os.clock()
	if now < c.ReadyAt then
		return
	end
	local weapon = c.Weapons[c.Equipped]
	local combat = weapon.Def.Combat
	if weapon.Reloading or weapon.Mag <= 0 then
		sync(player, weapon)
		return
	end

	-- Fire-rate token bucket
	local interval = 60 / combat.RPM
	local refill = (now - weapon.LastShot) / (interval * Config.Combat.FireRateTolerance)
	weapon.Tokens = math.min(Config.Combat.ShotBurstAllowance, weapon.Tokens + refill)
	weapon.LastShot = now
	if weapon.Tokens < 1 then
		return
	end
	weapon.Tokens -= 1

	-- Origin sanity + line of sight from the head to the claimed muzzle.
	local headPos = c.Head.Position
	if (origin - headPos).Magnitude > Config.Combat.MaxOriginDistance then
		return
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { c.Character }
	local blocked = Workspace:Raycast(headPos, origin - headPos, params)
	local shotOrigin = if blocked then headPos else origin

	weapon.Mag -= 1

	local dir = direction.Unit
	local result = Workspace:Raycast(shotOrigin, dir * combat.Range, params)
	local hitPos = shotOrigin + dir * combat.Range
	local normal = -dir
	local material = "Air"
	if result then
		hitPos = result.Position
		normal = result.Normal
		material = result.Material.Name
		applyHit(c, weapon, result, (hitPos - shotOrigin).Magnitude)
	end

	for _, other in Players:GetPlayers() do
		if other ~= player then
			shotFx:FireClient(other, c.Character, weapon.Id, shotOrigin, hitPos, normal, material)
		end
	end
end

local function onReload(player: Player)
	local c = combatants[player]
	if not c or c.Humanoid.Health <= 0 then
		return
	end
	local weapon = c.Weapons[c.Equipped]
	local combat = weapon.Def.Combat
	if weapon.Reloading or weapon.Mag >= combat.MagSize or weapon.Reserve <= 0 then
		sync(player, weapon)
		return
	end
	weapon.Reloading = true
	weapon.ReloadToken += 1
	local token = weapon.ReloadToken
	local duration = if weapon.Mag == 0 then combat.EmptyReloadTime else combat.ReloadTime
	task.delay(duration, function()
		if combatants[player] ~= c or weapon.ReloadToken ~= token or not weapon.Reloading then
			return
		end
		local take = math.min(combat.MagSize - weapon.Mag, weapon.Reserve)
		weapon.Mag += take
		weapon.Reserve -= take
		weapon.Reloading = false
		sync(player, weapon)
	end)
end

local function onEquip(player: Player, slot: any)
	local c = combatants[player]
	if not c or c.Holstered or (slot ~= "Primary" and slot ~= "Secondary") or c.Equipped == slot then
		return
	end
	if c.Humanoid.Health <= 0 then
		return
	end
	local current = c.Weapons[c.Equipped]
	cancelReload(player, current)
	holster(c, current)
	local nextWeapon = c.Weapons[slot :: Types.WeaponSlot]
	equip(c, nextWeapon)
	c.Equipped = slot
	c.ReadyAt = os.clock() + nextWeapon.Def.Combat.DrawTime * 0.85
end

local function onAim(player: Player, pitch: any, aiming: any)
	local c = combatants[player]
	if not c or not Schema.isFiniteNumber(pitch) then
		return
	end
	local now = os.clock()
	if now - c.LastAim < 1 / 30 then
		return
	end
	c.LastAim = now
	local clamped = math.round(math.clamp(pitch, -1.3, 1.2) * 100) / 100
	if c.Character:GetAttribute("AimPitch") ~= clamped then
		c.Character:SetAttribute("AimPitch", clamped)
	end
	local isAiming = aiming == true
	if c.Character:GetAttribute("Aiming") ~= isAiming then
		c.Character:SetAttribute("Aiming", isAiming)
	end
end

local function onStance(player: Player, stance: any, sprinting: any)
	local c = combatants[player]
	if not c or typeof(stance) ~= "string" or not VALID_STANCES[stance] then
		return
	end
	local now = os.clock()
	if now - c.LastStance < 0.05 then
		return
	end
	c.LastStance = now
	c.Character:SetAttribute("Stance", stance)
	c.Character:SetAttribute("Sprinting", sprinting == true and stance == "Stand")
end

--------------------------------------------------------------------------------
-- Lifecycle
--------------------------------------------------------------------------------
local function onDeployed(player: Player, character: Model, loadout: Types.Loadout)
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local head = limb(character, "Head", "Head")
	local torso = limb(character, "UpperTorso", "Torso")
	if not humanoid or not head or not torso then
		warn("[Combat] character missing Humanoid/Head/Torso for", player.Name)
		return
	end
	assignCharacterGroup(character)

	local weapons: { [Types.WeaponSlot]: WeaponState } = {}
	local c: Combatant = {
		Player = player,
		Character = character,
		Humanoid = humanoid,
		Head = head,
		Torso = torso,
		Weapons = weapons,
		Equipped = "Primary",
		ReadyAt = os.clock() + 0.5,
		LastAim = 0,
		LastStance = 0,
		Holstered = false,
	}

	for _, slot in SLOTS do
		local id = if slot == "Primary" then loadout.Primary else loadout.Secondary
		local def = Config.Weapons[id]
		local handles = WeaponBuilder.build(id)
		weapons[slot] = {
			Id = id,
			Slot = slot,
			Def = def,
			Mag = def.Combat.MagSize,
			Reserve = def.Combat.Reserve,
			Tokens = Config.Combat.ShotBurstAllowance,
			LastShot = 0,
			Reloading = false,
			ReloadToken = 0,
			Handles = handles,
			Joint = nil,
		}
	end

	holster(c, weapons.Secondary)
	equip(c, weapons.Primary)
	for _, slot in SLOTS do
		weapons[slot].Handles.Model.Parent = character
	end

	combatants[player] = c
	for _, slot in SLOTS do
		sync(player, weapons[slot])
	end

	character.AncestryChanged:Connect(function(_, parent)
		if parent == nil and combatants[player] == c then
			combatants[player] = nil
		end
	end)
	humanoid.Died:Once(function()
		if combatants[player] == c then
			combatants[player] = nil
		end
	end)
end

-- Vehicles: weapons go away while seated and come back on exit.
function CombatService.setHolstered(player: Player, holstered: boolean)
	local c = combatants[player]
	if not c or c.Holstered == holstered then
		return
	end
	c.Holstered = holstered
	local weapon = c.Weapons[c.Equipped]
	if holstered then
		cancelReload(player, weapon)
		holster(c, weapon)
		c.Character:SetAttribute("EquippedWeapon", nil)
		c.Character:SetAttribute("WeaponClass", nil)
	else
		equip(c, weapon)
		c.ReadyAt = os.clock() + weapon.Def.Combat.DrawTime
	end
	c.Character:SetAttribute("Holstered", holstered)
end

function CombatService.init(deployed: any, getLoadout: (Player) -> Types.Loadout)
	setupCollisionGroups()

	hitConfirm = Net.event(Net.Events.HitConfirm)
	ammoSync = Net.event(Net.Events.AmmoSync)
	shotFx = Net.unreliable(Net.Unreliable.ShotFx)

	Net.event(Net.Events.Fire).OnServerEvent:Connect(onFire)
	Net.event(Net.Events.Reload).OnServerEvent:Connect(onReload)
	Net.event(Net.Events.EquipSlot).OnServerEvent:Connect(onEquip)
	Net.event(Net.Events.SetStance).OnServerEvent:Connect(onStance)
	Net.unreliable(Net.Unreliable.AimState).OnServerEvent:Connect(onAim)

	deployed:Connect(function(player: Player, character: Model)
		onDeployed(player, character, getLoadout(player))
	end)

	Players.PlayerRemoving:Connect(function(player: Player)
		combatants[player] = nil
	end)
end

return CombatService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000019"><Properties><string name="Name">DeployService</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	DeployService
	Server-authoritative player state machine:

		Menu  --(RequestDeploy)-->  Deploying  --(character spawned)-->  Deployed
		  ^                                                                  |
		  +------------------(death, after ReturnToMenuDelay)----------------+

	Characters never auto-load: you only exist in the world after DEPLOY.
	State is replicated through the "State" player attribute.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local Signal = require(Shared.Signal)
local Types = require(Shared.Types)

local DeployService = {}
DeployService.Deployed = Signal.new() -- (player, character)

local deployPoints: { BasePart } = {}
local pointCursor = 0
local lastRequest: { [Player]: number } = {}

local function setState(player: Player, state: Types.PlayerState)
	player:SetAttribute("State", state)
end

local function getState(player: Player): string?
	local value = player:GetAttribute("State")
	return if typeof(value) == "string" then value else nil
end

local function nextDeployCFrame(): CFrame
	if #deployPoints == 0 then
		return Config.World.Origin * CFrame.new(5, 3.5, -2)
	end
	pointCursor = pointCursor % #deployPoints + 1
	local point = deployPoints[pointCursor]
	-- HumanoidRootPart centre ≈ 3 studs above the floor for R15 / R6.
	return point.CFrame + Vector3.new(0, 3.2, 0)
end

local function returnToMenu(player: Player, character: Model)
	if player.Parent == nil or player.Character ~= character then
		return
	end
	player.Character = nil
	character:Destroy()
	setState(player, "Menu")
end

local function watchCharacter(player: Player, character: Model)
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end
	humanoid.Died:Once(function()
		task.delay(Config.Deploy.ReturnToMenuDelay, returnToMenu, player, character)
	end)
	-- Character removed some other way (kick, LoadCharacter elsewhere).
	character.AncestryChanged:Connect(function(_, parent)
		if parent == nil and player.Parent and player.Character == nil and getState(player) == "Deployed" then
			setState(player, "Menu")
		end
	end)
end

local function onDeployRequest(player: Player)
	if getState(player) ~= "Menu" then
		return
	end
	local now = os.clock()
	if (lastRequest[player] or -math.huge) + Config.Deploy.RequestCooldown > now then
		return
	end
	lastRequest[player] = now
	setState(player, "Deploying")

	local spawnCF = nextDeployCFrame()
	local placement = player.CharacterAdded:Connect(function(character: Model)
		character:PivotTo(spawnCF)
	end)
	local ok, err = pcall(function()
		player:LoadCharacter()
	end)
	placement:Disconnect()

	local character = player.Character
	if not ok or not character or not player.Parent then
		warn("[Deploy] spawn failed for", player.Name, err)
		if player.Parent then
			setState(player, "Menu")
		end
		return
	end

	-- Re-assert placement in case appearance loading moved the rig.
	if (character:GetPivot().Position - spawnCF.Position).Magnitude > 4 then
		character:PivotTo(spawnCF)
	end
	watchCharacter(player, character)
	character:SetAttribute("Stance", "Stand")
	character:SetAttribute("Sprinting", false)
	character:SetAttribute("AimPitch", 0)
	character:SetAttribute("Aiming", false)
	DeployService.Deployed:Fire(player, character)
	setState(player, "Deployed")
end

function DeployService.init(safehouse: Model)
	Players.CharacterAutoLoads = false

	local folder = safehouse:FindFirstChild("DeployPoints")
	if folder then
		for _, child in folder:GetChildren() do
			if child:IsA("BasePart") then
				table.insert(deployPoints, child)
			end
		end
		table.sort(deployPoints, function(a: BasePart, b: BasePart): boolean
			return a.Name < b.Name
		end)
	else
		warn("[Deploy] Safehouse has no DeployPoints folder; using fallback spawn.")
	end

	local function onPlayerAdded(player: Player)
		-- If CharacterAutoLoads was still on when this player joined, remove
		-- the stray rig so everyone starts in the menu.
		local stray = player.Character
		if stray then
			player.Character = nil
			stray:Destroy()
		end
		setState(player, "Menu")
	end
	Players.PlayerAdded:Connect(onPlayerAdded)
	for _, player in Players:GetPlayers() do
		onPlayerAdded(player)
	end
	Players.PlayerRemoving:Connect(function(player: Player)
		lastRequest[player] = nil
	end)

	Net.event(Net.Events.RequestDeploy).OnServerEvent:Connect(onDeployRequest)
end

return DeployService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000020"><Properties><string name="Name">LightingService</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	LightingService
	Applies the gritty dusk/overcast look-dev to Lighting, MaterialService,
	Terrain clouds and the post-processing stack.

	Works from the server at runtime AND from the Studio Command Bar:
		require(game.ServerScriptService.Server.Services.LightingService).apply()

	Some engine properties are not writable from scripts on every Studio
	build (Lighting.Technology is the usual one). Those writes are attempted
	safely, and anything that failed is printed so you can set it once in
	the Properties panel.
]]

local Lighting = game:GetService("Lighting")
local MaterialService = game:GetService("MaterialService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)

local LightingService = {}

-- Stable names so the client can find and blend the effects.
LightingService.EffectNames = {
	ColorCorrection = "Grade_ColorCorrection",
	Bloom = "Grade_Bloom",
	DepthOfField = "Grade_DepthOfField",
	SunRays = "Grade_SunRays",
	ColorGrading = "Grade_Tonemap",
}

local function trySet(instance: Instance, property: string, value: any, failures: { string })
	local ok = pcall(function()
		(instance :: any)[property] = value
	end)
	if not ok then
		table.insert(failures, string.format("%s.%s = %s", instance.ClassName, property, tostring(value)))
	end
end

local function trySetEnum(instance: Instance, property: string, enumName: string, itemName: string, failures: { string })
	local ok, item = pcall(function(): any
		return ((Enum :: any)[enumName] :: any)[itemName]
	end)
	if ok and item ~= nil then
		trySet(instance, property, item, failures)
	else
		table.insert(failures, string.format("%s.%s = %s (enum unavailable)", instance.ClassName, property, itemName))
	end
end

-- Reuses an existing child of the class (e.g. the template's Bloom) and
-- disables duplicates so effects never stack unpredictably.
local function ensureSingle(parent: Instance, className: string, name: string): Instance
	local chosen: Instance? = parent:FindFirstChild(name)
	if chosen and chosen.ClassName ~= className then
		chosen = nil
	end
	for _, child in parent:GetChildren() do
		if child.ClassName == className then
			if chosen == nil then
				chosen = child
			elseif child ~= chosen then
				pcall(function()
					(child :: any).Enabled = false
				end)
			end
		end
	end
	if chosen == nil then
		local created = Instance.new(className :: any)
		created.Parent = parent
		chosen = created
	end
	local result = chosen :: Instance
	result.Name = name
	return result
end

function LightingService.apply(): { string }
	local failures: { string } = {}
	local L = Config.Lighting

	-- Renderer
	trySetEnum(Lighting, "Technology", "Technology", "Future", failures)
	trySetEnum(Lighting, "LightingStyle", "LightingStyle", "Realistic", failures)
	trySet(Lighting, "PrioritizeLightingQuality", true, failures)
	trySet(MaterialService, "Use2022Materials", true, failures)

	-- Sun, sky and ambient response
	Lighting.GlobalShadows = true
	Lighting.ClockTime = L.ClockTime
	Lighting.GeographicLatitude = L.GeographicLatitude
	Lighting.Brightness = L.Brightness
	Lighting.ExposureCompensation = L.ExposureCompensation
	Lighting.EnvironmentDiffuseScale = L.EnvironmentDiffuseScale
	Lighting.EnvironmentSpecularScale = L.EnvironmentSpecularScale
	Lighting.ShadowSoftness = L.ShadowSoftness
	Lighting.Ambient = L.Ambient
	Lighting.OutdoorAmbient = L.OutdoorAmbient
	Lighting.ColorShift_Top = L.ColorShiftTop
	Lighting.ColorShift_Bottom = L.ColorShiftBottom
	Lighting.FogEnd = 100000 -- Atmosphere owns distance fog.

	local atmosphere = ensureSingle(Lighting, "Atmosphere", "Atmosphere") :: Atmosphere
	atmosphere.Density = L.Atmosphere.Density
	atmosphere.Offset = L.Atmosphere.Offset
	atmosphere.Color = L.Atmosphere.Color
	atmosphere.Decay = L.Atmosphere.Decay
	atmosphere.Glare = L.Atmosphere.Glare
	atmosphere.Haze = L.Atmosphere.Haze

	local sky = ensureSingle(Lighting, "Sky", "Sky") :: Sky
	sky.StarCount = 0
	sky.SunAngularSize = 11
	sky.MoonAngularSize = 9
	sky.CelestialBodiesShown = true

	local clouds = ensureSingle(Workspace.Terrain, "Clouds", "Clouds") :: Clouds
	clouds.Enabled = true
	clouds.Cover = L.Clouds.Cover
	clouds.Density = L.Clouds.Density
	clouds.Color = L.Clouds.Color

	-- Post-processing stack
	local cc = ensureSingle(Lighting, "ColorCorrectionEffect", LightingService.EffectNames.ColorCorrection) :: ColorCorrectionEffect
	cc.Enabled = true
	cc.Brightness = L.ColorCorrection.Brightness
	cc.Contrast = L.ColorCorrection.Contrast
	cc.Saturation = L.ColorCorrection.Saturation
	cc.TintColor = L.ColorCorrection.TintColor

	local bloom = ensureSingle(Lighting, "BloomEffect", LightingService.EffectNames.Bloom) :: BloomEffect
	bloom.Enabled = true
	bloom.Intensity = L.Bloom.Intensity
	bloom.Size = L.Bloom.Size
	bloom.Threshold = L.Bloom.Threshold

	local dof = ensureSingle(Lighting, "DepthOfFieldEffect", LightingService.EffectNames.DepthOfField) :: DepthOfFieldEffect
	dof.Enabled = true
	dof.FarIntensity = L.DepthOfField.FarIntensity
	dof.FocusDistance = L.DepthOfField.FocusDistance
	dof.InFocusRadius = L.DepthOfField.InFocusRadius
	dof.NearIntensity = L.DepthOfField.NearIntensity

	local rays = ensureSingle(Lighting, "SunRaysEffect", LightingService.EffectNames.SunRays) :: SunRaysEffect
	rays.Enabled = true
	rays.Intensity = L.SunRays.Intensity
	rays.Spread = L.SunRays.Spread

	-- Filmic tonemapper (newer engines only).
	local gradingOk = pcall(function()
		local grading: any = ensureSingle(Lighting, "ColorGradingEffect", LightingService.EffectNames.ColorGrading)
		grading.Enabled = true
		grading.TonemapperPreset = (Enum :: any).TonemapperPreset.Default
	end)
	if not gradingOk then
		table.insert(failures, "ColorGradingEffect (not available on this engine build — optional)")
	end

	-- Old blur effects from templates would wreck the grade.
	for _, child in Lighting:GetChildren() do
		if child:IsA("BlurEffect") then
			child.Enabled = false
		end
	end

	if #failures > 0 then
		warn(
			"[LightingService] Set these once in the Properties panel (not writable from this context):\n  • "
				.. table.concat(failures, "\n  • ")
		)
	else
		print("[LightingService] Look-dev applied (Future lighting, 2022 materials, full post stack).")
	end
	return failures
end

return LightingService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000021"><Properties><string name="Name">LootService</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	LootService
	Server-authoritative carry system for heavy loot bags.

	  • spawnBag(cframe, value)   physical bag with a "Grab" prompt
	  • Grab → bag is slung on the player's back (massless, no collision),
	    character attributes CarryingBag / CarryValue drive the slowed movement
	  • Drop (G / D-pad down) → bag lands in front of you, grabbable again
	  • Death or leaving drops the bag where you fell (unextracted loot is lost
	    to whoever picks it up)
	  • consumeCarried / giveCarried let the vehicle trunk move bags in and out
	  • Practice bags by the garage respawn after they leave their pad

	Phase 4 lootables call spawnBag(); extraction banks CarryValue + trunk value.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local LootBagBuilder = require(Shared.Builders.LootBagBuilder)
local Net = require(Shared.Net)

local LootService = {}

type Carry = {
	Value: number,
	Model: Model,
}

local carried: { [Player]: Carry } = {}

local function formatValue(value: number): string
	local s = tostring(math.floor(value))
	local out = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	if out:sub(1, 1) == "," then
		out = out:sub(2)
	end
	return "$" .. out
end

local function torsoOf(character: Model): BasePart?
	local torso = character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
	return if torso and torso:IsA("BasePart") then torso else nil
end

local function setCarryAttributes(player: Player, value: number?)
	player:SetAttribute("CarryValue", value or 0)
	local character = player.Character
	if character then
		character:SetAttribute("CarryingBag", value ~= nil)
		character:SetAttribute("CarryValue", value or 0)
	end
end

local function setPhysical(model: Model, physical: boolean)
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			local isBody = d == model.PrimaryPart
			d.Massless = not (physical and isBody)
			d.CanCollide = physical and isBody
			d.CanQuery = physical
		end
	end
end

local pickUp: (player: Player, model: Model, value: number) -> ()

local function addPrompt(model: Model, value: number)
	local body = model.PrimaryPart
	if not body then
		return
	end
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "GrabPrompt"
	prompt.ActionText = "Grab"
	prompt.ObjectText = "LOOT · " .. formatValue(value)
	prompt.HoldDuration = 0.45
	prompt.MaxActivationDistance = 8
	prompt.RequiresLineOfSight = false
	prompt.Style = Enum.ProximityPromptStyle.Custom
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.GamepadKeyCode = Enum.KeyCode.ButtonX
	prompt.Parent = body
	prompt.Triggered:Connect(function(player: Player)
		pickUp(player, model, value)
	end)
end

local function attachToBack(player: Player, model: Model, value: number): boolean
	local character = player.Character
	local torso = if character then torsoOf(character) else nil
	local body = model.PrimaryPart
	if not character or not torso or not body then
		return false
	end
	local prompt = body:FindFirstChild("GrabPrompt")
	if prompt then
		prompt:Destroy()
	end
	setPhysical(model, false)
	body.Anchored = false
	local weld = Instance.new("Weld")
	weld.Name = "CarryWeld"
	weld.Part0 = torso
	weld.Part1 = body
	-- Across the upper back, long axis side to side.
	weld.C0 = CFrame.new(0, 0.15, 1.05) * CFrame.Angles(0, math.rad(90), math.rad(8))
	weld.Parent = body
	model.Parent = character
	carried[player] = { Value = value, Model = model }
	setCarryAttributes(player, value)
	return true
end

pickUp = function(player: Player, model: Model, value: number)
	if carried[player] or player:GetAttribute("State") ~= "Deployed" then
		return
	end
	local character = player.Character
	local humanoid = if character then character:FindFirstChildOfClass("Humanoid") else nil
	if not humanoid or humanoid.Health <= 0 or humanoid.Sit then
		return
	end
	local body = model.PrimaryPart
	local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
	if not body or not root or not root:IsA("BasePart") or (body.Position - root.Position).Magnitude > 12 then
		return
	end
	local pad = model:GetAttribute("PracticePad")
	attachToBack(player, model, value)
	if typeof(pad) == "number" then
		LootService.schedulePracticeRespawn(pad)
	end
end

function LootService.spawnBag(cf: CFrame, value: number, parent: Instance?): Model
	local handles = LootBagBuilder.build(cf, 1, false)
	handles.Model:SetAttribute("Value", value)
	addPrompt(handles.Model, value)
	handles.Model.Parent = parent or workspace
	return handles.Model
end

function LootService.drop(player: Player)
	local carry = carried[player]
	if not carry then
		return
	end
	carried[player] = nil
	local model = carry.Model
	local character = player.Character
	local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
	local weld = model.PrimaryPart and model.PrimaryPart:FindFirstChild("CarryWeld")
	if weld then
		weld:Destroy()
	end
	local dropCF = if root and root:IsA("BasePart")
		then root.CFrame * CFrame.new(0, -1.2, -Config.Loot.DropDistance)
		elseif model.PrimaryPart then model.PrimaryPart.CFrame
		else CFrame.identity
	model.Parent = workspace
	model:PivotTo(dropCF)
	setPhysical(model, true)
	model:SetAttribute("PracticePad", nil)
	addPrompt(model, carry.Value)
	if player.Parent then
		setCarryAttributes(player, nil)
	end
end

function LootService.isCarrying(player: Player): boolean
	return carried[player] ~= nil
end

function LootService.carryValue(player: Player): number
	local carry = carried[player]
	return if carry then carry.Value else 0
end

-- Removes the carried bag (e.g. loaded into a trunk) and returns its value.
function LootService.consumeCarried(player: Player): number?
	local carry = carried[player]
	if not carry then
		return nil
	end
	carried[player] = nil
	carry.Model:Destroy()
	setCarryAttributes(player, nil)
	return carry.Value
end

-- Puts a new bag of `value` straight onto the player's back (e.g. from a trunk).
function LootService.giveCarried(player: Player, value: number): boolean
	if carried[player] then
		return false
	end
	local character = player.Character
	local torso = if character then torsoOf(character) else nil
	if not torso then
		return false
	end
	local handles = LootBagBuilder.build(torso.CFrame, 1, false)
	handles.Model:SetAttribute("Value", value)
	return attachToBack(player, handles.Model, value)
end

--------------------------------------------------------------------------------
-- Practice bags
--------------------------------------------------------------------------------
local practiceFolder: Folder? = nil
local practiceTokens: { [number]: number } = {}

local function spawnPractice(index: number)
	local def = Config.Loot.PracticeBags[index]
	local folder = practiceFolder
	if not def or not folder then
		return
	end
	local cf = Config.World.Origin * CFrame.new(def.Position + Vector3.new(0, 0.3, 0)) * CFrame.Angles(0, math.rad(90), 0)
	local model = LootService.spawnBag(cf, def.Value, folder)
	model:SetAttribute("PracticePad", index)
end

function LootService.schedulePracticeRespawn(index: number)
	practiceTokens[index] = (practiceTokens[index] or 0) + 1
	local token = practiceTokens[index]
	task.delay(Config.Loot.PracticeRespawn, function()
		if practiceTokens[index] == token then
			spawnPractice(index)
		end
	end)
end

function LootService.init(safehouse: Model)
	local folder = Instance.new("Folder")
	folder.Name = "Loot"
	folder.Parent = safehouse
	practiceFolder = folder
	for index in Config.Loot.PracticeBags do
		spawnPractice(index)
	end

	Net.event(Net.Events.DropBag).OnServerEvent:Connect(function(player: Player)
		LootService.drop(player)
	end)

	local function watch(player: Player)
		player.CharacterAdded:Connect(function(character: Model)
			local humanoid = character:WaitForChild("Humanoid", 10)
			if humanoid and humanoid:IsA("Humanoid") then
				humanoid.Died:Once(function()
					LootService.drop(player)
				end)
			end
		end)
	end
	for _, player in Players:GetPlayers() do
		watch(player)
	end
	Players.PlayerAdded:Connect(watch)
	Players.PlayerRemoving:Connect(function(player: Player)
		LootService.drop(player)
	end)
end

return LootService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000022"><Properties><string name="Name">PlayerDataService</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	PlayerDataService
	Owns each player's persistent profile (settings, loadout, stash).

	• Real DataStore in live servers; automatic in-memory mock in Studio when
	  "Enable Studio Access to API Services" is off or the place is unpublished.
	• Every inbound value is sanitised through Shared.Schema.
	• Retries with exponential backoff, dirty-flag autosave, save on leave,
	  BindToClose flush.

	Phase 4 extends this with stash banking on extraction; the data shape is
	already in place (Stash / StashValue).
]]

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local Schema = require(Shared.Schema)
local Signal = require(Shared.Signal)
local Types = require(Shared.Types)

type Backend = {
	Name: string,
	Load: (key: string) -> (boolean, any),
	Save: (key: string, data: Types.ProfileData) -> boolean,
}

type Profile = {
	Data: Types.ProfileData,
	Dirty: boolean,
	Saving: boolean,
}

local PlayerDataService = {}
PlayerDataService.ProfileLoaded = Signal.new() -- (player, data)

local profiles: { [Player]: Profile } = {}
local lastSettingsSave: { [Player]: number } = {}
local backend: Backend

local function deepCopy(value: any): any
	if typeof(value) ~= "table" then
		return value
	end
	local copy = {}
	for k, v in value do
		copy[deepCopy(k)] = deepCopy(v)
	end
	return copy
end

local function defaultData(): Types.ProfileData
	return {
		Version = Config.Data.SchemaVersion,
		Settings = Schema.sanitizeSettings(nil, Config.Settings.Defaults),
		Loadout = Schema.sanitizeLoadout(nil, Config.DefaultLoadout),
		Stash = {},
		StashValue = 0,
	}
end

local function reconcile(raw: any): Types.ProfileData
	local data = defaultData()
	if typeof(raw) ~= "table" then
		return data
	end
	data.Settings = Schema.sanitizeSettings(raw.Settings, data.Settings)
	data.Loadout = Schema.sanitizeLoadout(raw.Loadout, data.Loadout)
	if typeof(raw.Stash) == "table" then
		for itemId, count in raw.Stash do
			if typeof(itemId) == "string" and Schema.isFiniteNumber(count) and count > 0 then
				data.Stash[itemId] = math.floor(count)
			end
		end
	end
	if Schema.isFiniteNumber(raw.StashValue) then
		data.StashValue = math.max(0, math.floor(raw.StashValue))
	end
	return data
end

--------------------------------------------------------------------------------
-- Backends
--------------------------------------------------------------------------------
local function makeMockBackend(): Backend
	local memory: { [string]: any } = {}
	return {
		Name = "Mock",
		Load = function(key: string): (boolean, any)
			return true, deepCopy(memory[key])
		end,
		Save = function(key: string, data: Types.ProfileData): boolean
			memory[key] = deepCopy(data)
			return true
		end,
	}
end

local function makeDataStoreBackend(store: DataStore): Backend
	local retries = Config.Data.Retries
	return {
		Name = "DataStore",
		Load = function(key: string): (boolean, any)
			for attempt = 1, retries do
				local ok, result = pcall(function(): any
					return store:GetAsync(key)
				end)
				if ok then
					return true, result
				end
				warn(string.format("[PlayerData] load %s failed (attempt %d/%d): %s", key, attempt, retries, tostring(result)))
				task.wait(0.5 * 2 ^ attempt)
			end
			return false, nil
		end,
		Save = function(key: string, data: Types.ProfileData): boolean
			for attempt = 1, retries do
				local ok, err = pcall(function()
					store:UpdateAsync(key, function(_previous: any): any
						return data
					end)
				end)
				if ok then
					return true
				end
				warn(string.format("[PlayerData] save %s failed (attempt %d/%d): %s", key, attempt, retries, tostring(err)))
				task.wait(0.5 * 2 ^ attempt)
			end
			return false
		end,
	}
end

local function resolveBackend(): Backend
	local ok, store = pcall(function(): DataStore
		return DataStoreService:GetDataStore(Config.Data.StoreName)
	end)
	if not ok then
		warn("[PlayerData] DataStoreService unavailable — using in-memory mock (data resets each session).")
		return makeMockBackend()
	end
	if RunService:IsStudio() then
		local probeOk = pcall(function()
			(store :: DataStore):GetAsync("__studio_probe")
		end)
		if not probeOk then
			warn(
				"[PlayerData] Studio has no DataStore access (publish the place + enable 'Studio Access to API Services' to test real saves). Using in-memory mock."
			)
			return makeMockBackend()
		end
	end
	return makeDataStoreBackend(store :: DataStore)
end

--------------------------------------------------------------------------------
-- Profiles
--------------------------------------------------------------------------------
local function keyFor(player: Player): string
	return Config.Data.KeyPrefix .. tostring(player.UserId)
end

local function publishAttributes(player: Player, data: Types.ProfileData)
	player:SetAttribute("Loadout_Primary", data.Loadout.Primary)
	player:SetAttribute("Loadout_Secondary", data.Loadout.Secondary)
	player:SetAttribute("StashValue", data.StashValue)
end

local function saveProfile(player: Player): boolean
	local profile = profiles[player]
	if not profile or profile.Saving then
		return false
	end
	profile.Saving = true
	profile.Dirty = false
	local ok = backend.Save(keyFor(player), profile.Data)
	if not ok then
		profile.Dirty = true
	end
	profile.Saving = false
	return ok
end

local function loadProfile(player: Player)
	local ok, raw = backend.Load(keyFor(player))
	if not player.Parent then
		return
	end
	local data = reconcile(if ok then raw else nil)
	if not ok then
		warn(string.format("[PlayerData] %s: load failed, using defaults this session (saves disabled to protect data).", player.Name))
	end
	profiles[player] = { Data = data, Dirty = false, Saving = not ok }
	publishAttributes(player, data)
	player:SetAttribute("ProfileLoaded", true)
	PlayerDataService.ProfileLoaded:Fire(player, data)
end

local function waitForProfile(player: Player, timeout: number): Profile?
	local deadline = os.clock() + timeout
	while not profiles[player] and player.Parent and os.clock() < deadline do
		task.wait(0.1)
	end
	return profiles[player]
end

--------------------------------------------------------------------------------
-- Public API (used by later phases)
--------------------------------------------------------------------------------
function PlayerDataService.getData(player: Player): Types.ProfileData?
	local profile = profiles[player]
	return if profile then profile.Data else nil
end

function PlayerDataService.markDirty(player: Player)
	local profile = profiles[player]
	if profile then
		profile.Dirty = true
		publishAttributes(player, profile.Data)
	end
end

function PlayerDataService.save(player: Player): boolean
	return saveProfile(player)
end

--------------------------------------------------------------------------------
-- Init
--------------------------------------------------------------------------------
function PlayerDataService.init()
	backend = resolveBackend()
	print("[PlayerData] backend:", backend.Name)

	Net.func(Net.Functions.GetProfile).OnServerInvoke = function(player: Player): any
		local profile = waitForProfile(player, Config.Data.ProfileWaitTimeout)
		if not profile then
			return nil
		end
		local payload: Types.ClientProfile = {
			Settings = table.clone(profile.Data.Settings),
			Loadout = table.clone(profile.Data.Loadout),
			StashValue = profile.Data.StashValue,
		}
		return payload
	end

	Net.event(Net.Events.SaveSettings).OnServerEvent:Connect(function(player: Player, raw: any)
		local profile = profiles[player]
		if not profile then
			return
		end
		local now = os.clock()
		if (lastSettingsSave[player] or 0) + Config.Settings.ServerSaveCooldown > now then
			return
		end
		lastSettingsSave[player] = now
		profile.Data.Settings = Schema.sanitizeSettings(raw, profile.Data.Settings)
		profile.Dirty = true
	end)

	Net.event(Net.Events.SetLoadout).OnServerEvent:Connect(function(player: Player, slot: any, weaponId: any)
		local profile = profiles[player]
		if not profile or not Schema.isWeaponForSlot(slot, weaponId) then
			return
		end
		-- Loadout is locked once deployed; it only changes in the safehouse.
		if player:GetAttribute("State") ~= "Menu" then
			publishAttributes(player, profile.Data)
			return
		end
		if slot == "Primary" then
			profile.Data.Loadout.Primary = weaponId
		elseif slot == "Secondary" then
			profile.Data.Loadout.Secondary = weaponId
		end
		profile.Dirty = true
		publishAttributes(player, profile.Data)
	end)

	Players.PlayerAdded:Connect(loadProfile)
	for _, player in Players:GetPlayers() do
		task.spawn(loadProfile, player)
	end

	Players.PlayerRemoving:Connect(function(player: Player)
		local profile = profiles[player]
		if profile and profile.Dirty then
			saveProfile(player)
		end
		profiles[player] = nil
		lastSettingsSave[player] = nil
	end)

	task.spawn(function()
		while true do
			task.wait(Config.Data.AutosaveInterval)
			for player, profile in profiles do
				if profile.Dirty then
					task.spawn(saveProfile, player)
				end
			end
		end
	end)

	game:BindToClose(function()
		local pending = 0
		for player, profile in profiles do
			if profile.Dirty then
				pending += 1
				task.spawn(function()
					saveProfile(player)
					pending -= 1
				end)
			end
		end
		local deadline = os.clock() + 25
		while pending > 0 and os.clock() < deadline do
			task.wait(0.1)
		end
	end)
end

return PlayerDataService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000023"><Properties><string name="Name">VehicleService</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	VehicleService
	Drivable "Zabour" getaway cars.

	  • Spawns a physics car on each Config.Vehicle.SpawnPads entry
	  • Prompts: Drive (driver door), Ride (passenger), Trunk, Flip (only when
	    upside down)
	  • Seating hands network ownership to the driver so the driver's client
	    simulates the car with zero input lag; leaving parks the car and the
	    server takes ownership back
	  • Driver streams throttle/brake/steer/rpm (unreliable, validated) →
	    replicated as attributes; the server renders brake, reverse, hazard,
	    head and underglow lights from them so every client sees the same car
	  • Trunk: load the bag you carry / take a bag out; cargo shows as small
	    bags behind the seats; the lid swings open on use
	  • Weapons are holstered while seated and drawn again on exit
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local CollectionService = game:GetService("CollectionService")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local Schema = require(Shared.Schema)
local GetawayCarBody = require(Shared.Builders.GetawayCarBody)
local LootBagBuilder = require(Shared.Builders.LootBagBuilder)

local VehicleChassis = require(script.Parent.Parent.Vehicles.VehicleChassis)

local VehicleService = {}

local V = Config.Vehicle

type Car = {
	Model: Model,
	Rig: VehicleChassis.Rig,
	Seat: VehicleSeat,
	Passenger: Seat,
	Driver: Player?,
	Cargo: { number },
	CargoModels: { Model },
	TrunkValue: NumberValue,
	FlipPrompt: ProximityPrompt,
	TrunkPrompt: ProximityPrompt,
	LastState: number,
	HazardPhase: number,
}

type Hooks = {
	SetHolstered: (player: Player, holstered: boolean) -> (),
	ConsumeCarried: (player: Player) -> number?,
	GiveCarried: (player: Player, value: number) -> boolean,
	IsCarrying: (player: Player) -> boolean,
}

local cars: { [Model]: Car } = {}
local hooks: Hooks
local folder: Folder

-- Cargo slots behind the front seats (root-local; root sits at car y 1.8).
local CARGO_SLOTS = {
	CFrame.new(-1.2, 1.35, 2.6),
	CFrame.new(1.2, 1.35, 2.6),
	CFrame.new(-1.2, 1.35, 3.9),
	CFrame.new(1.2, 1.35, 3.9),
}

local function formatValue(value: number): string
	local s = tostring(math.floor(value))
	local out = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	if out:sub(1, 1) == "," then
		out = out:sub(2)
	end
	return "$" .. out
end

local function prompt(parent: Instance, name: string, action: string, object: string, hold: number, key: Enum.KeyCode): ProximityPrompt
	local p = Instance.new("ProximityPrompt")
	p.Name = name
	p.ActionText = action
	p.ObjectText = object
	p.HoldDuration = hold
	p.MaxActivationDistance = 9
	p.RequiresLineOfSight = false
	p.Style = Enum.ProximityPromptStyle.Custom
	p.KeyboardKeyCode = key
	p.Parent = parent
	return p
end

local function playerFromSeat(seat: Seat | VehicleSeat): Player?
	local humanoid = seat.Occupant
	if not humanoid then
		return nil
	end
	return Players:GetPlayerFromCharacter(humanoid.Parent)
end

local function sitIn(player: Player, seat: Seat | VehicleSeat)
	if seat.Occupant or player:GetAttribute("State") ~= "Deployed" then
		return
	end
	local character = player.Character
	local humanoid = if character then character:FindFirstChildOfClass("Humanoid") else nil
	if not humanoid or humanoid.Health <= 0 or humanoid.Sit then
		return
	end
	seat:Sit(humanoid)
end

local function exitSeat(player: Player, car: Car)
	local character = player.Character
	local humanoid = if character then character:FindFirstChildOfClass("Humanoid") else nil
	if not character or not humanoid then
		return
	end
	local seat = humanoid.SeatPart
	if seat ~= car.Seat and seat ~= car.Passenger then
		return
	end
	local door = if seat == car.Seat then car.Rig.Handles.DriverDoor else car.Rig.Handles.PassengerDoor
	local weld = (seat :: BasePart):FindFirstChild("SeatWeld")
	if weld then
		weld:Destroy()
	end
	humanoid.Sit = false
	-- Step out beside the door, upright and facing the car's heading.
	local look = car.Rig.Handles.Root.CFrame.LookVector
	local flat = Vector3.new(look.X, 0, look.Z)
	flat = if flat.Magnitude > 0.1 then flat.Unit else Vector3.zAxis
	local position = door.WorldPosition + Vector3.new(0, 2.6, 0)
	character:PivotTo(CFrame.lookAt(position, position + flat))
end

--------------------------------------------------------------------------------
-- Trunk
--------------------------------------------------------------------------------
local function animateTrunk(car: Car)
	local hinge = car.Rig.Handles.TrunkHinge
	local value = Instance.new("NumberValue")
	value.Value = 0
	local connection = value.Changed:Connect(function(v: number)
		hinge.C0 = GetawayCarBody.trunkFrame(v)
	end)
	local open = TweenService:Create(value, TweenInfo.new(0.45, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), { Value = 1 })
	open:Play()
	open.Completed:Once(function()
		task.wait(1.2)
		local close = TweenService:Create(value, TweenInfo.new(0.5, Enum.EasingStyle.Quint, Enum.EasingDirection.In), { Value = 0 })
		close:Play()
		close.Completed:Once(function()
			connection:Disconnect()
			value:Destroy()
		end)
	end)
end

local function refreshCargo(car: Car)
	for _, m in car.CargoModels do
		m:Destroy()
	end
	table.clear(car.CargoModels)
	local root = car.Rig.Handles.Root
	local total = 0
	for i, value in car.Cargo do
		total += value
		local slot = CARGO_SLOTS[i]
		if slot then
			local bag = LootBagBuilder.build(root.CFrame * slot * CFrame.Angles(0, math.rad(90), 0), 0.55, false)
			for _, d in bag.Model:GetDescendants() do
				if d:IsA("BasePart") then
					d.Massless = true
					d.CanCollide = false
					d.CanQuery = false
					d.CollisionGroup = "VehicleBody"
				end
			end
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = root
			weld.Part1 = bag.Body
			weld.Parent = bag.Body
			bag.Model.Name = "Cargo"
			bag.Model.Parent = car.Model
			table.insert(car.CargoModels, bag.Model)
		end
	end
	car.TrunkValue.Value = total
	car.Model:SetAttribute("TrunkValue", total)
	car.Model:SetAttribute("TrunkCount", #car.Cargo)
	car.TrunkPrompt.ObjectText = string.format("TRUNK  %d/%d  ·  %s", #car.Cargo, V.TrunkCapacity, formatValue(total))
end

local function useTrunk(player: Player, car: Car)
	if player:GetAttribute("State") ~= "Deployed" then
		return
	end
	if hooks.IsCarrying(player) then
		if #car.Cargo >= V.TrunkCapacity then
			return
		end
		local value = hooks.ConsumeCarried(player)
		if value then
			table.insert(car.Cargo, value)
			animateTrunk(car)
			refreshCargo(car)
		end
	elseif #car.Cargo > 0 then
		local value = car.Cargo[#car.Cargo]
		if hooks.GiveCarried(player, value) then
			table.remove(car.Cargo)
			animateTrunk(car)
			refreshCargo(car)
		end
	end
end

--------------------------------------------------------------------------------
-- Lights
--------------------------------------------------------------------------------
local function renderLights(car: Car, dt: number)
	local model = car.Model
	local handles = car.Rig.Handles
	local brake = model:GetAttribute("Brake")
	GetawayCarBody.setBrakeIntensity(handles, if typeof(brake) == "number" then brake else 0)
	GetawayCarBody.setReverse(handles, model:GetAttribute("Reversing") == true)
	if model:GetAttribute("Hazards") == true then
		car.HazardPhase = (car.HazardPhase + dt) % 0.9
		GetawayCarBody.setIndicators(handles, car.HazardPhase < 0.45)
	elseif car.HazardPhase ~= -1 then
		car.HazardPhase = -1
		GetawayCarBody.setIndicators(handles, false)
	end
end

local function toggle(player: Player, carModel: any, name: any)
	if typeof(carModel) ~= "Instance" or not carModel:IsA("Model") then
		return
	end
	local car = cars[carModel]
	if not car or car.Driver ~= player then
		return
	end
	local handles = car.Rig.Handles
	if name == "Lights" then
		local on = not (car.Model:GetAttribute("Lights") == true)
		car.Model:SetAttribute("Lights", on)
		GetawayCarBody.setHeadlights(handles, on)
	elseif name == "Hazards" then
		car.Model:SetAttribute("Hazards", not (car.Model:GetAttribute("Hazards") == true))
		car.HazardPhase = 0
	elseif name == "Underglow" then
		GetawayCarBody.setUnderglow(handles, not (car.Model:GetAttribute("Underglow") == true))
	end
end

local function onState(player: Player, carModel: any, throttle: any, brake: any, steer: any, handbrake: any, rpm: any, gear: any, backfires: any)
	if typeof(carModel) ~= "Instance" or not carModel:IsA("Model") then
		return
	end
	local car = cars[carModel]
	if not car or car.Driver ~= player then
		return
	end
	local now = os.clock()
	if now - car.LastState < 1 / 40 then
		return
	end
	car.LastState = now
	local function num(v: any, lo: number, hi: number): number
		return if Schema.isFiniteNumber(v) then math.clamp(v, lo, hi) else 0
	end
	local m = car.Model
	m:SetAttribute("Throttle", math.round(num(throttle, -1, 1) * 100) / 100)
	m:SetAttribute("Brake", math.round(num(brake, 0, 1) * 100) / 100)
	m:SetAttribute("Steer", math.round(num(steer, -1, 1) * 100) / 100)
	m:SetAttribute("Handbrake", handbrake == true)
	m:SetAttribute("RPM", math.round(num(rpm, 0, 1) * 100) / 100)
	m:SetAttribute("Gear", math.floor(num(gear, -1, 6)))
	m:SetAttribute("Reversing", num(throttle, -1, 1) < -0.1 and car.Rig.Handles.Root.AssemblyLinearVelocity:Dot(car.Rig.Handles.Root.CFrame.LookVector) < 1)
	local count = math.floor(num(backfires, 0, 1e6))
	if count ~= m:GetAttribute("Backfires") then
		m:SetAttribute("Backfires", count)
	end
end

--------------------------------------------------------------------------------
-- Spawning
--------------------------------------------------------------------------------
local function onDriverChanged(car: Car)
	local driver = playerFromSeat(car.Seat)
	local previous = car.Driver
	if driver == previous then
		return
	end
	if previous and previous.Parent then
		hooks.SetHolstered(previous, false)
	end
	car.Driver = driver
	local root = car.Rig.Handles.Root
	-- Wheels/knuckles are separate assemblies joined by constraints: hand all
	-- of them to the same owner or the suspension fights across the network.
	local function setOwner(owner: Player?)
		pcall(function()
			root:SetNetworkOwner(owner)
			for _, wheel in car.Rig.Wheels do
				wheel.Tire:SetNetworkOwner(owner)
				wheel.Knuckle:SetNetworkOwner(owner)
			end
		end)
	end
	if driver then
		setOwner(driver)
		car.Model:SetAttribute("Driver", driver.UserId)
		car.Model:SetAttribute("Lights", true)
		GetawayCarBody.setHeadlights(car.Rig.Handles, true)
		hooks.SetHolstered(driver, true)
	else
		car.Model:SetAttribute("Driver", 0)
		car.Model:SetAttribute("Throttle", 0)
		car.Model:SetAttribute("RPM", 0)
		car.Model:SetAttribute("Brake", 0)
		car.Model:SetAttribute("Handbrake", false)
		car.Model:SetAttribute("Reversing", false)
		VehicleChassis.park(car.Rig)
		setOwner(nil)
	end
end

local function spawnCar(index: number, pad: CFrame): Car
	local origin = Config.World.Origin * pad
	local handles = GetawayCarBody.build(origin, {
		Name = "Zabour_" .. index,
		Anchored = false,
		Physics = true,
		PlateText = string.format("ZBR %03d", 100 + index),
	})
	local rig = VehicleChassis.rig(handles)
	local model = handles.Model
	local root = handles.Root

	-- Seats (inside the solid body; same assembly, so no self-collision)
	local seat = Instance.new("VehicleSeat")
	seat.Name = "DriverSeat"
	seat.Size = Vector3.new(1.2, 0.2, 1.2)
	seat.CFrame = root.CFrame * CFrame.new(-1.3, -0.5, 1.0)
	seat.Transparency = 1
	seat.CanCollide = false
	seat.CanQuery = false
	seat.Massless = true
	seat.MaxSpeed = 0
	seat.Torque = 0
	seat.TurnSpeed = 0
	seat.HeadsUpDisplay = false
	seat.CanTouch = false -- no touch-to-sit: only the prompt seats you
	seat.Parent = model
	local seatWeld = Instance.new("WeldConstraint")
	seatWeld.Part0 = root
	seatWeld.Part1 = seat
	seatWeld.Parent = seat

	local passenger = Instance.new("Seat")
	passenger.Name = "PassengerSeat"
	passenger.Size = Vector3.new(1.2, 0.2, 1.2)
	passenger.CFrame = root.CFrame * CFrame.new(1.3, -0.5, 1.0)
	passenger.Transparency = 1
	passenger.CanCollide = false
	passenger.CanQuery = false
	passenger.Massless = true
	passenger.CanTouch = false
	passenger.Parent = model
	local passengerWeld = Instance.new("WeldConstraint")
	passengerWeld.Part0 = root
	passengerWeld.Part1 = passenger
	passengerWeld.Parent = passenger

	local trunkValue = Instance.new("NumberValue")
	trunkValue.Name = "TrunkValue"
	trunkValue.Parent = model

	local trunkAttachment = handles.TrunkLid:FindFirstChild("TrunkPrompt")
	local car: Car = {
		Model = model,
		Rig = rig,
		Seat = seat,
		Passenger = passenger,
		Driver = nil,
		Cargo = {},
		CargoModels = {},
		TrunkValue = trunkValue,
		FlipPrompt = prompt(root, "FlipPrompt", "Flip", "ZABOUR", 1.2, Enum.KeyCode.E),
		TrunkPrompt = prompt(if trunkAttachment then trunkAttachment else handles.TrunkLid, "TrunkPrompt", "Trunk", "", 0.35, Enum.KeyCode.E),
		LastState = 0,
		HazardPhase = -1,
	}
	car.FlipPrompt.Enabled = false

	local drivePrompt = prompt(handles.DriverDoor, "DrivePrompt", "Drive", "ZABOUR", 0.25, Enum.KeyCode.E)
	local ridePrompt = prompt(handles.PassengerDoor, "RidePrompt", "Ride", "ZABOUR", 0.25, Enum.KeyCode.E)
	drivePrompt.Triggered:Connect(function(player: Player)
		sitIn(player, seat)
	end)
	ridePrompt.Triggered:Connect(function(player: Player)
		sitIn(player, passenger)
	end)
	car.TrunkPrompt.Triggered:Connect(function(player: Player)
		useTrunk(player, car)
	end)
	car.FlipPrompt.Triggered:Connect(function()
		local cf = root.CFrame
		local flat = Vector3.new(cf.LookVector.X, 0, cf.LookVector.Z)
		flat = if flat.Magnitude > 0.1 then flat.Unit else Vector3.zAxis
		local upright = cf.Position + Vector3.new(0, 4, 0)
		-- PrimaryPart is Root, so pivoting the model rights the whole car + wheels.
		model:PivotTo(CFrame.lookAt(upright, upright + flat))
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
	end)

	seat:GetPropertyChangedSignal("Occupant"):Connect(function()
		drivePrompt.Enabled = seat.Occupant == nil
		onDriverChanged(car)
	end)
	passenger:GetPropertyChangedSignal("Occupant"):Connect(function()
		ridePrompt.Enabled = passenger.Occupant == nil
		local rider = playerFromSeat(passenger)
		if rider then
			hooks.SetHolstered(rider, true)
		end
	end)

	model:SetAttribute("Lights", false)
	model:SetAttribute("Hazards", false)
	model:SetAttribute("Backfires", 0)
	GetawayCarBody.setHeadlights(handles, false)
	CollectionService:AddTag(model, "DrivableCar")
	model.Parent = folder
	VehicleChassis.park(rig)
	refreshCargo(car)
	cars[model] = car
	return car
end

function VehicleService.init(injected: Hooks)
	hooks = injected
	local f = Instance.new("Folder")
	f.Name = "Vehicles"
	f.Parent = workspace
	folder = f

	for index, pad in V.SpawnPads do
		spawnCar(index, pad)
	end

	Net.unreliable(Net.Unreliable.VehicleState).OnServerEvent:Connect(onState)
	Net.event(Net.Events.VehicleToggle).OnServerEvent:Connect(toggle)
	Net.event(Net.Events.VehicleExit).OnServerEvent:Connect(function(player: Player)
		for _, car in cars do
			local character = player.Character
			local humanoid = if character then character:FindFirstChildOfClass("Humanoid") else nil
			if humanoid and (humanoid.SeatPart == car.Seat or humanoid.SeatPart == car.Passenger) then
				exitSeat(player, car)
				return
			end
		end
	end)

	-- Passenger leaving re-draws their weapon.
	local function watchSeat(player: Player)
		player.CharacterAdded:Connect(function(character: Model)
			local humanoid = character:WaitForChild("Humanoid", 10)
			if humanoid and humanoid:IsA("Humanoid") then
				humanoid.Seated:Connect(function(active: boolean)
					if not active then
						hooks.SetHolstered(player, false)
					end
				end)
			end
		end)
	end
	for _, player in Players:GetPlayers() do
		watchSeat(player)
	end
	Players.PlayerAdded:Connect(watchSeat)

	local flipTimer = 0
	RunService.Heartbeat:Connect(function(dt: number)
		flipTimer += dt
		local checkFlip = flipTimer >= V.FlipCheckInterval
		if checkFlip then
			flipTimer = 0
		end
		for _, car in cars do
			renderLights(car, dt)
			if checkFlip then
				car.FlipPrompt.Enabled = car.Rig.Handles.Root.CFrame.UpVector.Y < 0.35 and car.Driver == nil
			end
		end
	end)
end

-- Phase 4 extraction reads trunk contents through this.
function VehicleService.getCars(): { [Model]: any }
	return cars
end

function VehicleService.emptyTrunk(carModel: Model): number
	local car = cars[carModel]
	if not car then
		return 0
	end
	local total = 0
	for _, value in car.Cargo do
		total += value
	end
	table.clear(car.Cargo)
	refreshCargo(car)
	return total
end

return VehicleService
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX000026"><Properties><string name="Name">Vehicles</string></Properties><Item class="ModuleScript" referent="RBX000025"><Properties><string name="Name">VehicleChassis</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	VehicleChassis
	Turns a GetawayCarBody built with Physics = true into a real constraint car.

	Per wheel:
	  Root ──CylindricalConstraint──▶ Knuckle ──HingeConstraint(Motor)──▶ Tire
	         (vertical slide = suspension travel,
	          rotation about vertical = steering servo on the fronts,
	          rotation locked on the rears)
	  Root ──SpringConstraint──▶ Knuckle   (stiffness/damping solved from the
	                                         real sprung mass so the car sits at
	                                         its designed ride height)

	Mass: every body part is massless; one low invisible Ballast part carries
	the weight, which puts the centre of mass near axle height (stable, still
	rolls into corners). Tires use high-weight custom friction so the tire
	material, not the road, decides grip — the driver lowers rear friction for
	handbrake drifts.

	Collision groups keep spinning/steering wheels from fighting the body.
]]

local PhysicsService = game:GetService("PhysicsService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local GetawayCarBody = require(Shared.Builders.GetawayCarBody)

export type WheelRig = {
	Name: string,
	Front: boolean,
	Tire: BasePart,
	Knuckle: BasePart,
	Slide: CylindricalConstraint,
	Spring: SpringConstraint,
	Hinge: HingeConstraint,
}

export type Rig = {
	Handles: GetawayCarBody.CarHandles,
	Wheels: { WheelRig },
	Ballast: BasePart,
	Downforce: VectorForce,
}

local VehicleChassis = {}

local V = Config.Vehicle
local SPRING_TOP = 1.6 -- spring anchor height above the wheel centre (studs)

local groupsReady = false
local function ensureGroups()
	if groupsReady then
		return
	end
	groupsReady = true
	for _, name in { "VehicleBody", "VehicleWheels" } do
		pcall(function()
			PhysicsService:RegisterCollisionGroup(name)
		end)
	end
	PhysicsService:CollisionGroupSetCollidable("VehicleBody", "VehicleWheels", false)
	PhysicsService:CollisionGroupSetCollidable("VehicleWheels", "VehicleWheels", false)
	pcall(function()
		PhysicsService:CollisionGroupSetCollidable("VehicleWheels", "Debris", false)
	end)
end

local function attachment(parent: BasePart, name: string, cf: CFrame): Attachment
	local a = Instance.new("Attachment")
	a.Name = name
	a.CFrame = cf
	a.Parent = parent
	return a
end

-- Attachment frame whose primary axis (X) points up in the car's frame.
local UP_AXIS = CFrame.Angles(0, 0, math.rad(90))

function VehicleChassis.rig(handles: GetawayCarBody.CarHandles): Rig
	ensureGroups()
	local model = handles.Model
	local root = handles.Root

	-- Body: massless, body collision group.
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			d.Massless = true
			d.CollisionGroup = "VehicleBody"
		end
	end

	-- Low ballast carries the mass.
	local ballast = Instance.new("Part")
	ballast.Name = "Ballast"
	ballast.Size = Vector3.new(4.2, 0.5, 12)
	ballast.CFrame = root.CFrame * CFrame.new(0, -0.9, 0)
	ballast.Transparency = 1
	ballast.CanCollide = false
	ballast.CanQuery = false
	ballast.CanTouch = false
	ballast.Massless = false
	ballast.CustomPhysicalProperties = PhysicalProperties.new(V.BallastDensity, 0.3, 0)
	ballast.CollisionGroup = "VehicleBody"
	ballast.Parent = model
	local ballastWeld = Instance.new("WeldConstraint")
	ballastWeld.Part0 = root
	ballastWeld.Part1 = ballast
	ballastWeld.Parent = ballast

	local wheels: { WheelRig } = {}
	for name, wheelModel in handles.Wheels do
		local tire = wheelModel.PrimaryPart
		assert(tire, "[VehicleChassis] wheel without Tire")
		local front = string.sub(name, 1, 1) == "F"

		for _, d in wheelModel:GetDescendants() do
			if d:IsA("BasePart") then
				d.CollisionGroup = "VehicleWheels"
				d.Massless = d ~= tire
				d.CanCollide = d == tire
			end
		end
		tire.Massless = false
		tire.CustomPhysicalProperties = PhysicalProperties.new(0.7, V.TireFriction, 0, 100, 100)

		-- Wheel centre in the root's frame (car frame, root sits at y 1.8).
		local centre = root.CFrame:ToObjectSpace(tire.CFrame).Position

		local knuckle = Instance.new("Part")
		knuckle.Name = "Knuckle_" .. name
		knuckle.Size = Vector3.new(0.4, 0.4, 0.4)
		knuckle.CFrame = root.CFrame * CFrame.new(centre)
		knuckle.Transparency = 1
		knuckle.CanCollide = false
		knuckle.CanQuery = false
		knuckle.CanTouch = false
		knuckle.CustomPhysicalProperties = PhysicalProperties.new(2, 0.3, 0)
		knuckle.CollisionGroup = "VehicleWheels"
		knuckle.Parent = wheelModel

		-- Suspension slide + steering
		local mount = attachment(root, "Mount_" .. name, CFrame.new(centre) * UP_AXIS)
		local knuckleAxis = attachment(knuckle, "SlideAxis", UP_AXIS)
		local slide = Instance.new("CylindricalConstraint")
		slide.Name = "Suspension"
		slide.Attachment0 = mount
		slide.Attachment1 = knuckleAxis
		slide.LimitsEnabled = true
		slide.LowerLimit = -V.SuspensionTravel
		slide.UpperLimit = V.SuspensionTravel
		slide.Restitution = 0
		if front then
			slide.AngularActuatorType = Enum.ActuatorType.Servo
			slide.ServoMaxTorque = 1e6
			slide.AngularSpeed = 8
			slide.AngularResponsiveness = 45
			slide.TargetAngle = 0
		else
			slide.AngularLimitsEnabled = true
			slide.LowerAngle = 0
			slide.UpperAngle = 0
		end
		slide.Parent = knuckle

		-- Spring (anchored above the wheel)
		local springTop = attachment(root, "SpringTop_" .. name, CFrame.new(centre + Vector3.new(0, SPRING_TOP, 0)))
		local springBottom = attachment(knuckle, "SpringBottom", CFrame.identity)
		local spring = Instance.new("SpringConstraint")
		spring.Name = "Spring"
		spring.Attachment0 = springTop
		spring.Attachment1 = springBottom
		spring.Visible = false
		spring.Parent = knuckle

		-- Axle motor
		local axleKnuckle = attachment(knuckle, "Axle", CFrame.identity)
		local axleTire = attachment(tire, "Axle", CFrame.identity)
		local hinge = Instance.new("HingeConstraint")
		hinge.Name = "Axle"
		hinge.Attachment0 = axleKnuckle
		hinge.Attachment1 = axleTire
		hinge.ActuatorType = Enum.ActuatorType.Motor
		hinge.MotorMaxAcceleration = math.huge
		hinge.MotorMaxTorque = 0
		hinge.AngularVelocity = 0
		hinge.Parent = knuckle

		table.insert(wheels, {
			Name = name,
			Front = front,
			Tire = tire,
			Knuckle = knuckle,
			Slide = slide,
			Spring = spring,
			Hinge = hinge,
		})
	end

	-- Solve spring rates from the real sprung mass so the car rests at its design height.
	-- Everything on the body is massless except the ballast, so its mass IS the
	-- sprung mass (GetMass works before the model is parented to Workspace).
	local sprungMass = ballast:GetMass()
	local cornerMass = sprungMass / 4
	local omega = 2 * math.pi * V.SuspensionFrequency
	local stiffness = cornerMass * omega * omega
	local damping = 2 * V.SuspensionDamping * math.sqrt(stiffness * cornerMass)
	local cornerWeight = cornerMass * Workspace.Gravity
	for _, wheel in wheels do
		wheel.Spring.Stiffness = stiffness
		wheel.Spring.Damping = damping
		wheel.Spring.FreeLength = SPRING_TOP + cornerWeight / stiffness
		wheel.Spring.LimitsEnabled = false
	end

	-- Speed-squared downforce, updated by the driver.
	local forceAttachment = attachment(root, "DownforcePoint", CFrame.new(0, -0.9, 0))
	local downforce = Instance.new("VectorForce")
	downforce.Name = "Downforce"
	downforce.Attachment0 = forceAttachment
	downforce.RelativeTo = Enum.ActuatorRelativeTo.World
	downforce.ApplyAtCenterOfMass = true
	downforce.Force = Vector3.zero
	downforce.Parent = root

	model:SetAttribute("SprungMass", sprungMass)
	return {
		Handles = handles,
		Wheels = wheels,
		Ballast = ballast,
		Downforce = downforce,
	}
end

-- Parking brake / no driver: hold every wheel still.
function VehicleChassis.park(rig: Rig)
	for _, wheel in rig.Wheels do
		wheel.Hinge.AngularVelocity = 0
		wheel.Hinge.MotorMaxTorque = Config.Vehicle.HandbrakeTorque
		if wheel.Front then
			wheel.Slide.TargetAngle = 0
		end
	end
	rig.Downforce.Force = Vector3.zero
end

return VehicleChassis
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX000030"><Properties><string name="Name">World</string></Properties><Item class="ModuleScript" referent="RBX000027"><Properties><string name="Name">ProvingGround</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	ProvingGround
	Opens the north end of the safehouse alley onto a fog-soaked industrial
	lot for driving (Phase 4 turns this space into the raid zone):

	  • gate pillars + overhead sign where the alley end wall used to be
	  • 300 × 400 wet asphalt lot with painted lanes, perimeter jersey walls
	  • cone slalom, launch ramp, painted drift circle with tyre stacks
	  • rusted shipping containers as cover / obstacles
	  • sodium high-mast lights (no shadows, for performance) with light shafts
]]

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local PartFactory = require(Shared.Builders.PartFactory)

local ProvingGround = {}

local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

local S = {
	Asphalt = PartFactory.style(rgb(34, 35, 38), Enum.Material.Asphalt, 0.05),
	Paint = PartFactory.style(rgb(200, 196, 180), Enum.Material.SmoothPlastic, 0, 0.25, false),
	PaintYellow = PartFactory.style(rgb(210, 170, 50), Enum.Material.SmoothPlastic, 0, 0.25, false),
	Concrete = PartFactory.style(rgb(110, 108, 104), Enum.Material.Concrete),
	ConcreteDark = PartFactory.style(rgb(60, 60, 64), Enum.Material.Concrete),
	Metal = PartFactory.style(rgb(44, 46, 50), Enum.Material.Metal, 0.05),
	ConeOrange = PartFactory.style(rgb(230, 100, 30), Enum.Material.SmoothPlastic),
	ConeBand = PartFactory.style(rgb(230, 230, 230), Enum.Material.SmoothPlastic, 0.2),
	Rubber = PartFactory.style(rgb(22, 22, 22), PartFactory.material("Rubber", Enum.Material.SmoothPlastic)),
	Sodium = PartFactory.style(rgb(255, 186, 120), Enum.Material.Neon, 0, 0, false),
	Puddle = PartFactory.style(rgb(16, 18, 21), Enum.Material.SmoothPlastic, 0.42, 0, false),
	Invisible = PartFactory.style(rgb(0, 0, 0), Enum.Material.SmoothPlastic, 0, 1, false),
}

local CONTAINER_COLORS = { rgb(120, 46, 32), rgb(40, 70, 90), rgb(70, 80, 50), rgb(130, 100, 40) }

local LOT_WIDTH = 300
local LOT_LENGTH = 400
local LOT_START = 75 -- alley ends at z = 75

function ProvingGround.build(safehouse: Model)
	local origin = Config.World.Origin
	local rng = Random.new(11)
	local existing = safehouse:FindFirstChild("ProvingGround")
	if existing then
		existing:Destroy()
	end
	local folder = PartFactory.folder("ProvingGround", safehouse)

	local function part(name: string, size: Vector3, cf: CFrame, style: PartFactory.Style, collide: boolean?, parent: Instance?, shape: Enum.PartType?, class: ("Part" | "WedgePart")?): BasePart
		return PartFactory.make({
			Name = name,
			Size = size,
			CFrame = origin * cf,
			Style = style,
			CanCollide = collide == true,
			Parent = parent or folder,
			Shape = shape,
			Class = class,
		})
	end

	-- Open the alley's north end.
	local buildings = safehouse:FindFirstChild("Buildings")
	if buildings then
		for _, d in buildings:GetDescendants() do
			if d:IsA("BasePart") and (d.Name == "EndWall_L_N" or d.Name == "EndWall_R_N") then
				d:Destroy()
			end
		end
	end

	-- Gate
	local zc = LOT_START
	for _, x in { -14.2, 14.2 } do
		part("GatePillar", Vector3.new(1.6, 12, 1.6), CFrame.new(x, 6, zc), S.ConcreteDark, true)
		part("GateStripe", Vector3.new(1.62, 0.5, 1.62), CFrame.new(x, 2, zc), S.PaintYellow)
	end
	local sign = part("GateSign", Vector3.new(29, 2, 0.4), CFrame.new(0, 11.4, zc), S.Metal, true)
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 30
	gui.LightInfluence = 0.3
	gui.Brightness = 1.5
	gui.Parent = sign
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Text = "PROVING GROUND  ·  SECTOR 7"
	label.TextScaled = true
	label.TextColor3 = rgb(255, 168, 86)
	label.FontFace = Font.new("rbxasset://fonts/families/RobotoMono.json", Enum.FontWeight.Bold)
	label.Parent = gui

	-- Lot surface + perimeter
	local zMid = LOT_START + LOT_LENGTH / 2
	part("LotAsphalt", Vector3.new(LOT_WIDTH, 2, LOT_LENGTH), CFrame.new(0, -1, zMid), S.Asphalt, true)
	local zEnd = LOT_START + LOT_LENGTH
	local walls = PartFactory.folder("Perimeter", folder)
	part("WallN", Vector3.new(LOT_WIDTH, 5, 2), CFrame.new(0, 2.5, zEnd), S.Concrete, true, walls)
	for _, side in { -1, 1 } do
		part("WallSide", Vector3.new(2, 5, LOT_LENGTH), CFrame.new(side * LOT_WIDTH / 2, 2.5, zMid), S.Concrete, true, walls)
		part("WallSouth", Vector3.new(LOT_WIDTH / 2 - 15, 5, 2), CFrame.new(side * (15 + (LOT_WIDTH / 2 - 15) / 2), 2.5, LOT_START), S.Concrete, true, walls)
	end

	-- Painted main road (centre dashes + edge lines)
	local paint = PartFactory.folder("Markings", folder)
	for z = LOT_START + 8, zEnd - 10, 14 do
		part("CentreDash", Vector3.new(0.4, 0.02, 7), CFrame.new(0, 0.011, z), S.PaintYellow, false, paint)
	end
	for _, x in { -11, 11 } do
		part("EdgeLine", Vector3.new(0.35, 0.02, LOT_LENGTH - 20), CFrame.new(x, 0.011, zMid), S.Paint, false, paint)
	end

	-- Cone slalom (left lane)
	local cones = PartFactory.folder("Slalom", folder)
	for i = 0, 7 do
		local x = -40 + (if i % 2 == 0 then -3 else 3)
		local z = 150 + i * 20
		local cone = Instance.new("Model")
		cone.Name = "Cone"
		cone.Parent = cones
		part("Base", Vector3.new(1.4, 0.15, 1.4), CFrame.new(x, 0.075, z), S.ConeOrange, true, cone)
		part("Body", Vector3.new(1.8, 0.7, 0.7), CFrame.new(x, 1.05, z) * PartFactory.AxisY, S.ConeOrange, true, cone, Enum.PartType.Cylinder)
		part("Band", Vector3.new(0.35, 0.74, 0.74), CFrame.new(x, 1.2, z) * PartFactory.AxisY, S.ConeBand, false, cone, Enum.PartType.Cylinder)
	end

	-- Launch ramp (right lane)
	local ramp = PartFactory.folder("Ramp", folder)
	part("RampWedge", Vector3.new(14, 3.5, 22), CFrame.new(45, 1.75, 210), S.ConcreteDark, true, ramp, nil, "WedgePart")
	part("RampDeck", Vector3.new(14, 3.5, 8), CFrame.new(45, 1.75, 225), S.ConcreteDark, true, ramp)
	part("RampLanding", Vector3.new(14, 3.5, 22), CFrame.new(45, 1.75, 270) * CFrame.Angles(0, math.pi, 0), S.ConcreteDark, true, ramp, nil, "WedgePart")
	for _, x in { 38.2, 51.8 } do
		part("RampStripe", Vector3.new(0.4, 0.05, 22), CFrame.new(x, 1.78, 210) * CFrame.Angles(-math.atan2(3.5, 22), 0, 0), S.PaintYellow, false, ramp)
	end

	-- Drift circle with tyre stacks
	local drift = PartFactory.folder("DriftPad", folder)
	local centre = Vector3.new(-70, 0, 340)
	local segments = 36
	for i = 0, segments - 1 do
		local a0 = i / segments * 2 * math.pi
		local a1 = (i + 0.6) / segments * 2 * math.pi
		local p0 = centre + Vector3.new(math.cos(a0) * 32, 0.011, math.sin(a0) * 32)
		local p1 = centre + Vector3.new(math.cos(a1) * 32, 0.011, math.sin(a1) * 32)
		part("CircleDash", Vector3.new(0.5, 0.02, (p1 - p0).Magnitude), CFrame.lookAt((p0 + p1) / 2, p1), S.Paint, false, drift)
	end
	for i = 0, 5 do
		local a = i / 6 * 2 * math.pi
		local base = centre + Vector3.new(math.cos(a) * 8, 0, math.sin(a) * 8)
		for level = 0, 2 do
			part("Tyre", Vector3.new(0.7, 2.4, 2.4), CFrame.new(base.X, 0.35 + level * 0.7, base.Z) * PartFactory.AxisY, S.Rubber, true, drift, Enum.PartType.Cylinder)
		end
	end

	-- Shipping containers
	local containers = PartFactory.folder("Containers", folder)
	local spots = {
		{ CFrame.new(90, 0, 120), 0 },
		{ CFrame.new(98, 0, 150), 8 },
		{ CFrame.new(-95, 0, 190), 90 },
		{ CFrame.new(100, 0, 330), 4 },
		{ CFrame.new(-110, 0, 420), 0 },
		{ CFrame.new(20, 0, 400), 90 },
	}
	for i, spot in spots do
		local base = (spot[1] :: CFrame) * CFrame.Angles(0, math.rad(spot[2] :: number), 0)
		local color = CONTAINER_COLORS[(i - 1) % #CONTAINER_COLORS + 1]
		local style = PartFactory.style(color, Enum.Material.CorrodedMetal)
		local model = Instance.new("Model")
		model.Name = "Container"
		model.Parent = containers
		part("Box", Vector3.new(8, 8.5, 20), base * CFrame.new(0, 4.25, 0), style, true, model)
		for r = -8, 8, 2 do
			part("RibL", Vector3.new(0.2, 8.1, 0.35), base * CFrame.new(-4.05, 4.25, r), style, false, model)
			part("RibR", Vector3.new(0.2, 8.1, 0.35), base * CFrame.new(4.05, 4.25, r), style, false, model)
		end
		part("DoorBars", Vector3.new(7.6, 8, 0.2), base * CFrame.new(0, 4.25, 10.05), PartFactory.style(color:Lerp(Color3.new(0, 0, 0), 0.3), Enum.Material.CorrodedMetal), false, model)
		if i % 2 == 0 then
			-- Stack a second one on every other spot.
			part("BoxTop", Vector3.new(8, 8.5, 20), base * CFrame.new(0, 12.75, 1) * CFrame.Angles(0, math.rad(rng:NextNumber(-4, 4)), 0), PartFactory.style(CONTAINER_COLORS[(i % #CONTAINER_COLORS) + 1], Enum.Material.CorrodedMetal), true, model)
		end
	end

	-- Puddles
	for i = 1, 40 do
		local d = rng:NextNumber(3, 9)
		part("Puddle" .. i, Vector3.new(0.02, d, d), CFrame.new(rng:NextNumber(-130, 130), 0.012, rng:NextNumber(LOT_START + 10, zEnd - 10)) * PartFactory.AxisY, S.Puddle, false, paint, Enum.PartType.Cylinder)
	end

	-- High-mast sodium lights
	local lights = PartFactory.folder("Lights", folder)
	for i = 0, 7 do
		local x = if i % 2 == 0 then -16 else 16
		local z = LOT_START + 30 + i * 48
		part("Mast", Vector3.new(26, 0.7, 0.7), CFrame.new(x, 13, z) * PartFactory.AxisY, S.Metal, true, lights, Enum.PartType.Cylinder)
		part("MastBase", Vector3.new(1.6, 0.8, 1.6), CFrame.new(x, 0.4, z), S.ConcreteDark, true, lights)
		part("Head", Vector3.new(3, 0.6, 1.4), CFrame.new(x, 26, z), S.Metal, false, lights)
		part("Lens", Vector3.new(2.6, 0.08, 1.1), CFrame.new(x, 25.66, z), S.Sodium, false, lights)
		local source = part("Source", Vector3.new(0.2, 0.2, 0.2), CFrame.new(x, 25.4, z), S.Invisible, false, lights)
		local spot = Instance.new("SpotLight")
		spot.Face = Enum.NormalId.Bottom
		spot.Angle = 100
		spot.Range = 60
		spot.Brightness = 3
		spot.Color = rgb(255, 178, 110)
		spot.Shadows = false
		spot.Parent = source
		local a0 = Instance.new("Attachment")
		a0.Parent = source
		local a1 = Instance.new("Attachment")
		a1.Position = Vector3.new(0, -25, 0)
		a1.Parent = source
		local beam = Instance.new("Beam")
		beam.Name = "VolumetricBeam"
		beam.Attachment0 = a0
		beam.Attachment1 = a1
		beam.Width0 = 2
		beam.Width1 = 24
		beam.FaceCamera = true
		beam.LightEmission = 1
		beam.LightInfluence = 0
		beam.Color = ColorSequence.new(rgb(255, 178, 110))
		beam.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.86),
			NumberSequenceKeypoint.new(0.7, 0.93),
			NumberSequenceKeypoint.new(1, 1),
		})
		beam.Parent = source
		CollectionService:AddTag(beam, "VolumetricBeam")
	end

end

return ProvingGround
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000028"><Properties><string name="Name">SafehouseBuilder</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	SafehouseBuilder
	Procedurally builds the rain-slicked safehouse alley used by the main menu
	and as the post-raid hub:

	  • wet asphalt with layered puddles, curbs, drains, manhole, steam vent
	  • two brick mid-rises with lit/dark windows, floor bands, cornices,
	    drainpipes, AC units, a fire escape and overhead sagging cables
	  • sodium + LED streetlamps with shadowed SpotLights and volumetric beams
	  • magenta/cyan neon sign + rim strips for colour contrast on the car
	  • roll-up garage, security flood light, dumpster, crates, barrels
	  • weapon workbench (Phase 2 mounts weapons on WeaponDisplays anchors)
	  • ground mist emitters, CameraRig shots, DeployPoints
	  • the matte-black "Zabour" getaway car (GetawayCarBody)

	Run in edit mode from the Command Bar to preview/bake (see tools/), or let
	the server Bootstrap build it at runtime when Workspace has no Safehouse.
]]

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local PartFactory = require(Shared.Builders.PartFactory)
local GetawayCarBody = require(Shared.Builders.GetawayCarBody)

type Style = PartFactory.Style

local SafehouseBuilder = {}

local ALLEY_LENGTH = 150
local HALF_LENGTH = ALLEY_LENGTH / 2
local WALL_FACE = 15 -- inner face of both buildings (x = ±15)
local BUILDING_HEIGHT = 48
local FLOOR_CENTRES = { 9, 16.5, 24, 31.5, 39 }
local FLOOR_BANDS = { 6.6, 14.1, 21.6, 29.1, 36.6 }

local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

local PAVEMENT = PartFactory.material("Pavement", Enum.Material.Concrete)
local CARDBOARD = PartFactory.material("Cardboard", Enum.Material.Fabric)

local S: { [string]: Style } = {
	Asphalt = PartFactory.style(rgb(36, 37, 40), Enum.Material.Asphalt, 0.04),
	Puddle = PartFactory.style(rgb(16, 18, 21), Enum.Material.SmoothPlastic, 0.42, 0, false),
	Curb = PartFactory.style(rgb(88, 88, 92), Enum.Material.Concrete),
	Sidewalk = PartFactory.style(rgb(66, 66, 70), PAVEMENT),
	BrickL = PartFactory.style(rgb(74, 50, 42), Enum.Material.Brick),
	BrickR = PartFactory.style(rgb(62, 56, 54), Enum.Material.Brick),
	Concrete = PartFactory.style(rgb(78, 78, 82), Enum.Material.Concrete),
	ConcreteDark = PartFactory.style(rgb(50, 50, 54), Enum.Material.Concrete),
	WindowDark = PartFactory.style(rgb(12, 14, 17), Enum.Material.SmoothPlastic, 0.3),
	WindowLitWarm = PartFactory.style(rgb(150, 96, 52), Enum.Material.Neon, 0, 0.15, false),
	WindowLitCool = PartFactory.style(rgb(70, 110, 150), Enum.Material.Neon, 0, 0.3, false),
	Blinds = PartFactory.style(rgb(20, 18, 16), Enum.Material.SmoothPlastic),
	MetalDark = PartFactory.style(rgb(44, 46, 50), Enum.Material.Metal, 0.05),
	MetalLight = PartFactory.style(rgb(118, 120, 118), Enum.Material.Metal, 0.05),
	MetalRust = PartFactory.style(rgb(96, 72, 58), Enum.Material.CorrodedMetal),
	Shutter = PartFactory.style(rgb(70, 72, 76), Enum.Material.CorrodedMetal),
	Diamond = PartFactory.style(rgb(58, 60, 64), Enum.Material.DiamondPlate),
	DiamondDark = PartFactory.style(rgb(30, 31, 34), Enum.Material.DiamondPlate),
	Wood = PartFactory.style(rgb(92, 70, 50), Enum.Material.WoodPlanks),
	Pegboard = PartFactory.style(rgb(118, 96, 72), Enum.Material.Wood),
	Cardboard = PartFactory.style(rgb(150, 118, 80), CARDBOARD),
	FabricDark = PartFactory.style(rgb(34, 36, 40), Enum.Material.Fabric),
	Olive = PartFactory.style(rgb(64, 72, 48), Enum.Material.Metal, 0.03),
	Dumpster = PartFactory.style(rgb(34, 56, 44), Enum.Material.Metal, 0.03),
	TrashBag = PartFactory.style(rgb(14, 14, 16), Enum.Material.SmoothPlastic, 0.12),
	Cable = PartFactory.style(rgb(10, 10, 10), Enum.Material.SmoothPlastic),
	Sodium = PartFactory.style(rgb(255, 186, 120), Enum.Material.Neon, 0, 0, false),
	LedCool = PartFactory.style(rgb(210, 225, 255), Enum.Material.Neon, 0, 0, false),
	NeonCyan = PartFactory.style(rgb(60, 220, 255), Enum.Material.Neon, 0, 0, false),
	NeonMagenta = PartFactory.style(rgb(255, 70, 175), Enum.Material.Neon, 0, 0, false),
	ScreenGlow = PartFactory.style(rgb(40, 140, 180), Enum.Material.Neon, 0, 0.2, false),
	Invisible = PartFactory.style(rgb(0, 0, 0), Enum.Material.SmoothPlastic, 0, 1, false),
}

local SODIUM_LIGHT = rgb(255, 178, 110)
local LED_LIGHT = rgb(210, 225, 255)
local WARM_LIGHT = rgb(255, 205, 150)

--------------------------------------------------------------------------------
-- Context helpers
--------------------------------------------------------------------------------
type Ctx = {
	Origin: CFrame,
	Rng: Random,
	part: (name: string, size: Vector3, localCF: CFrame, style: Style, parent: Instance, extra: Extra?) -> BasePart,
	segment: (name: string, a: Vector3, b: Vector3, thickness: number, style: Style, parent: Instance) -> BasePart,
}

type Extra = {
	Class: ("Part" | "WedgePart" | "CornerWedgePart")?,
	Shape: Enum.PartType?,
	Collide: boolean?,
}

local function makeCtx(origin: CFrame, seed: number): Ctx
	local ctx: Ctx
	ctx = {
		Origin = origin,
		Rng = Random.new(seed),
		part = function(name: string, size: Vector3, localCF: CFrame, style: Style, parent: Instance, extra: Extra?): BasePart
			local e: Extra = extra or {}
			return PartFactory.make({
				Name = name,
				Size = size,
				CFrame = origin * localCF,
				Style = style,
				Class = e.Class,
				Shape = e.Shape,
				CanCollide = e.Collide,
				Parent = parent,
			})
		end,
		segment = function(name: string, a: Vector3, b: Vector3, thickness: number, style: Style, parent: Instance): BasePart
			return PartFactory.segment(name, origin * a, origin * b, thickness, style, parent)
		end,
	}
	return ctx
end

local function at(x: number, y: number, z: number): CFrame
	return CFrame.new(x, y, z)
end

local function addSpot(parent: BasePart, props: {
	Face: Enum.NormalId,
	Angle: number,
	Range: number,
	Brightness: number,
	Color: Color3,
	Shadows: boolean,
}): SpotLight
	local light = Instance.new("SpotLight")
	light.Face = props.Face
	light.Angle = props.Angle
	light.Range = props.Range
	light.Brightness = props.Brightness
	light.Color = props.Color
	light.Shadows = props.Shadows
	light.Parent = parent
	if props.Shadows then
		CollectionService:AddTag(light, "ShadowLight")
	end
	return light
end

local function addPoint(parent: BasePart, range: number, brightness: number, color: Color3): PointLight
	local light = Instance.new("PointLight")
	light.Range = range
	light.Brightness = brightness
	light.Color = color
	light.Shadows = false
	light.Parent = parent
	return light
end

local function addDownBeam(source: BasePart, length: number, width0: number, width1: number, color: Color3): Beam
	local a0 = Instance.new("Attachment")
	a0.Name = "BeamStart"
	a0.Parent = source
	local a1 = Instance.new("Attachment")
	a1.Name = "BeamEnd"
	a1.Position = Vector3.new(0, -length, 0)
	a1.Parent = source
	local beam = Instance.new("Beam")
	beam.Name = "VolumetricBeam"
	beam.Attachment0 = a0
	beam.Attachment1 = a1
	beam.Width0 = width0
	beam.Width1 = width1
	beam.FaceCamera = true
	beam.LightEmission = 1
	beam.LightInfluence = 0
	beam.Segments = 1
	beam.Color = ColorSequence.new(color)
	beam.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.84),
		NumberSequenceKeypoint.new(0.7, 0.92),
		NumberSequenceKeypoint.new(1, 1),
	})
	beam.Parent = source
	CollectionService:AddTag(beam, "VolumetricBeam")
	return beam
end

local function smokeEmitter(parent: Instance, props: {
	Name: string,
	Rate: number,
	Lifetime: NumberRange,
	Speed: NumberRange,
	Size: NumberSequence,
	Transparency: NumberSequence,
	Color: Color3,
	Direction: Enum.NormalId,
	Spread: Vector2,
	Acceleration: Vector3,
	Drag: number,
}): ParticleEmitter
	local emitter = Instance.new("ParticleEmitter")
	emitter.Name = props.Name
	emitter.Texture = "rbxasset://textures/particles/smoke_main.dds"
	emitter.Rate = props.Rate
	emitter.Lifetime = props.Lifetime
	emitter.Speed = props.Speed
	emitter.Size = props.Size
	emitter.Transparency = props.Transparency
	emitter.Color = ColorSequence.new(props.Color)
	emitter.EmissionDirection = props.Direction
	emitter.SpreadAngle = props.Spread
	emitter.Acceleration = props.Acceleration
	emitter.Drag = props.Drag
	emitter.Rotation = NumberRange.new(0, 360)
	emitter.RotSpeed = NumberRange.new(-8, 8)
	emitter.LightInfluence = 1
	emitter.LightEmission = 0
	emitter.Parent = parent
	return emitter
end

--------------------------------------------------------------------------------
-- Ground
--------------------------------------------------------------------------------
local function buildGround(ctx: Ctx, parent: Instance)
	local folder = PartFactory.folder("Ground", parent)
	ctx.part("Asphalt", Vector3.new(2 * WALL_FACE + 4, 2, ALLEY_LENGTH), at(0, -1, 0), S.Asphalt, folder, { Collide = true })

	for _, side in { -1, 1 } do
		local tag = if side < 0 then "L" else "R"
		ctx.part("Curb_" .. tag, Vector3.new(0.6, 0.45, ALLEY_LENGTH), at(side * 12.3, 0.225, 0), S.Curb, folder, { Collide = true })
		ctx.part("Sidewalk_" .. tag, Vector3.new(2.4, 0.4, ALLEY_LENGTH), at(side * 13.8, 0.2, 0), S.Sidewalk, folder, { Collide = true })
		for _, z in { -50, -20, 10, 40 } do
			ctx.part("Drain_" .. tag .. z, Vector3.new(1.1, 0.04, 2.2), at(side * 11.5, 0.02, z), S.DiamondDark, folder)
		end
	end

	-- Puddles: clusters of 2-3 overlapping discs read as organic shapes.
	local rng = ctx.Rng
	for i = 1, 16 do
		local cx = rng:NextNumber(-10, 10)
		local cz = rng:NextNumber(-34, 44)
		local blobs = rng:NextInteger(2, 3)
		for b = 1, blobs do
			local d = rng:NextNumber(1.6, 4.6)
			local ox = rng:NextNumber(-1.4, 1.4)
			local oz = rng:NextNumber(-1.8, 1.8)
			ctx.part(
				string.format("Puddle_%d_%d", i, b),
				Vector3.new(0.02, d, d),
				at(cx + ox, 0.011 + b * 0.001, cz + oz) * PartFactory.AxisY,
				S.Puddle,
				folder,
				{ Shape = Enum.PartType.Cylinder }
			)
		end
	end

	-- Manhole
	ctx.part("ManholeRing", Vector3.new(0.05, 2.9, 2.9), at(-6, 0.02, -16) * PartFactory.AxisY, S.MetalDark, folder, { Shape = Enum.PartType.Cylinder })
	ctx.part("Manhole", Vector3.new(0.06, 2.6, 2.6), at(-6, 0.03, -16) * PartFactory.AxisY, S.DiamondDark, folder, { Shape = Enum.PartType.Cylinder })

	-- Steam vent
	ctx.part("SteamGrate", Vector3.new(0.06, 2.4, 2.4), at(5, 0.03, 22) * PartFactory.AxisY, S.DiamondDark, folder, { Shape = Enum.PartType.Cylinder })
	local steamSource = ctx.part("SteamSource", Vector3.new(1.8, 0.2, 1.8), at(5, 0.2, 22), S.Invisible, folder)
	local steam = smokeEmitter(steamSource, {
		Name = "Steam",
		Rate = 7,
		Lifetime = NumberRange.new(3, 5),
		Speed = NumberRange.new(3, 5),
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 6) }),
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.15, 0.78),
			NumberSequenceKeypoint.new(1, 1),
		}),
		Color = rgb(200, 200, 205),
		Direction = Enum.NormalId.Top,
		Spread = Vector2.new(10, 10),
		Acceleration = Vector3.new(1.5, 0.5, 0.6),
		Drag = 0.4,
	})
	CollectionService:AddTag(steam, "SteamVent")
end

--------------------------------------------------------------------------------
-- Buildings
--------------------------------------------------------------------------------
local function windowSkipped(side: number, floorIndex: number, z: number): boolean
	if floorIndex ~= 1 then
		return false
	end
	if side > 0 and z >= 14 and z <= 36 then
		return true -- garage header
	end
	if side < 0 and z >= 2 and z <= 14 then
		return true -- neon sign
	end
	return false
end

local function buildWindow(ctx: Ctx, folder: Instance, side: number, y: number, z: number)
	local face = side * WALL_FACE
	local inward = -side -- direction pointing into the alley
	local roll = ctx.Rng:NextNumber()
	local lit = roll < 0.14
	local style = if lit then (if ctx.Rng:NextNumber() < 0.25 then S.WindowLitCool else S.WindowLitWarm) else S.WindowDark
	local name = string.format("Window_%s_%d_%d", if side < 0 then "L" else "R", math.floor(y), math.floor(z))

	ctx.part(name, Vector3.new(0.12, 4.2, 3.2), at(face + inward * 0.06, y, z), style, folder)
	ctx.part(name .. "_Mullion", Vector3.new(0.08, 4.2, 0.1), at(face + inward * 0.12, y, z), S.ConcreteDark, folder)
	ctx.part(name .. "_Sill", Vector3.new(0.45, 0.25, 3.8), at(face + inward * 0.22, y - 2.25, z), S.Concrete, folder)
	ctx.part(name .. "_Lintel", Vector3.new(0.3, 0.3, 3.6), at(face + inward * 0.15, y + 2.25, z), S.Concrete, folder)

	if lit then
		-- Half-drawn blinds
		for slat = 0, 3 do
			ctx.part(name .. "_Blind" .. slat, Vector3.new(0.04, 0.08, 3.1), at(face + inward * 0.14, y + 1.9 - slat * 0.32, z), S.Blinds, folder)
		end
	end
end

local function buildBuilding(ctx: Ctx, parent: Instance, side: number)
	local tag = if side < 0 then "L" else "R"
	local folder = PartFactory.folder("Building_" .. tag, parent)
	local wallStyle = if side < 0 then S.BrickL else S.BrickR
	local face = side * WALL_FACE
	local inward = -side

	ctx.part("Wall", Vector3.new(3, BUILDING_HEIGHT, ALLEY_LENGTH), at(face + side * 1.5, BUILDING_HEIGHT / 2, 0), wallStyle, folder, { Collide = true })
	ctx.part("Plinth", Vector3.new(0.4, 3, ALLEY_LENGTH), at(face + inward * 0.2, 1.5, 0), S.ConcreteDark, folder, { Collide = true })
	ctx.part("Cornice", Vector3.new(1.2, 0.8, ALLEY_LENGTH), at(face + inward * 0.4, BUILDING_HEIGHT - 1.6, 0), S.Concrete, folder)
	ctx.part("CorniceCap", Vector3.new(1.6, 0.3, ALLEY_LENGTH), at(face + inward * 0.5, BUILDING_HEIGHT - 1.05, 0), S.ConcreteDark, folder)
	for i, y in FLOOR_BANDS do
		ctx.part("FloorBand" .. i, Vector3.new(0.3, 0.35, ALLEY_LENGTH), at(face + inward * 0.15, y, 0), S.Concrete, folder)
	end

	local windows = PartFactory.folder("Windows", folder)
	for floorIndex, y in FLOOR_CENTRES do
		for z = -60, 60, 10 do
			if not windowSkipped(side, floorIndex, z) then
				buildWindow(ctx, windows, side, y, z)
			end
		end
	end

	-- Drainpipes
	local pipeZs = if side < 0 then { -18, 30 } else { -34, 38 }
	for _, z in pipeZs do
		ctx.part("Drainpipe_" .. z, Vector3.new(BUILDING_HEIGHT - 2, 0.5, 0.5), at(face + inward * 0.35, (BUILDING_HEIGHT - 2) / 2, z) * PartFactory.AxisY, S.MetalDark, folder, {
			Shape = Enum.PartType.Cylinder,
		})
		ctx.part("DrainShoe_" .. z, Vector3.new(0.8, 0.5, 0.5), at(face + inward * 0.6, 0.45, z) * CFrame.Angles(0, 0, math.rad(side * 30)), S.MetalDark, folder, {
			Shape = Enum.PartType.Cylinder,
		})
		for _, y in { 8, 20, 32 } do
			ctx.part("PipeClamp_" .. z .. "_" .. y, Vector3.new(0.5, 0.12, 0.7), at(face + inward * 0.3, y, z), S.MetalDark, folder)
		end
	end

	-- AC units (right building only)
	if side > 0 then
		for i, spot in { { 12.5, -40 }, { 20, -12 }, { 12.5, 42 }, { 27.5, 8 }, { 20, 52 } } do
			local y, z = spot[1], spot[2]
			ctx.part("ACUnit" .. i, Vector3.new(1.6, 1.4, 2.2), at(face - 0.8, y, z), S.MetalLight, folder)
			ctx.part("ACGrille" .. i, Vector3.new(0.05, 1.1, 1.9), at(face - 1.62, y, z), S.Diamond, folder)
			ctx.part("ACBracket" .. i, Vector3.new(1.4, 0.1, 0.1), at(face - 0.7, y - 0.8, z - 0.9), S.MetalDark, folder)
			ctx.part("ACBracketB" .. i, Vector3.new(1.4, 0.1, 0.1), at(face - 0.7, y - 0.8, z + 0.9), S.MetalDark, folder)
		end
	end

	-- Back door + caged bulb (left building)
	if side < 0 then
		ctx.part("BackDoorFrame", Vector3.new(0.3, 7.6, 4.2), at(face + 0.15, 3.8, -12), S.ConcreteDark, folder)
		ctx.part("BackDoor", Vector3.new(0.2, 7, 3.6), at(face + 0.3, 3.5, -12), S.MetalRust, folder, { Collide = true })
		ctx.part("DoorBar", Vector3.new(0.12, 0.12, 2.6), at(face + 0.45, 3.4, -12), S.MetalDark, folder)
		local bulb = ctx.part("CagedBulb", Vector3.new(0.35, 0.35, 0.35), at(face + 0.5, 8.1, -12), S.Sodium, folder, { Shape = Enum.PartType.Ball })
		ctx.part("BulbCage", Vector3.new(0.5, 0.55, 0.5), at(face + 0.5, 8.1, -12), PartFactory.style(rgb(30, 30, 30), Enum.Material.SmoothPlastic, 0, 0.7), folder)
		addPoint(bulb, 12, 1.3, SODIUM_LIGHT)
		CollectionService:AddTag(bulb, "FlickerLight")
	end

	-- End caps so the alley never shows the void
	ctx.part("EndWall_" .. tag .. "_N", Vector3.new(WALL_FACE + 2, BUILDING_HEIGHT, 3), at(side * (WALL_FACE / 2 + 1), BUILDING_HEIGHT / 2, HALF_LENGTH + 1.5), wallStyle, folder, { Collide = true })
	ctx.part("EndWall_" .. tag .. "_S", Vector3.new(WALL_FACE + 2, BUILDING_HEIGHT, 3), at(side * (WALL_FACE / 2 + 1), BUILDING_HEIGHT / 2, -HALF_LENGTH - 1.5), wallStyle, folder, { Collide = true })
end

local function buildFireEscape(ctx: Ctx, parent: Instance)
	local folder = PartFactory.folder("FireEscape", parent)
	local zc = -30
	local x0 = -WALL_FACE
	local levels = { 6.6, 14.1, 21.6, 29.1 }

	for i, y in levels do
		ctx.part("Platform" .. i, Vector3.new(3.2, 0.18, 9), at(x0 + 1.6, y, zc), S.Diamond, folder, { Collide = true })
		ctx.part("RailTop" .. i, Vector3.new(0.12, 0.12, 9), at(x0 + 3.1, y + 3.1, zc), S.MetalDark, folder)
		ctx.part("RailMid" .. i, Vector3.new(0.08, 0.08, 9), at(x0 + 3.1, y + 1.6, zc), S.MetalDark, folder)
		for p = 0, 5 do
			ctx.part(string.format("Post%d_%d", i, p), Vector3.new(0.12, 3.1, 0.12), at(x0 + 3.1, y + 1.55, zc - 4.4 + p * 1.76), S.MetalDark, folder)
		end
		for _, endZ in { zc - 4.45, zc + 4.45 } do
			ctx.part("RailEnd" .. i .. "_" .. endZ, Vector3.new(3.0, 0.12, 0.12), at(x0 + 1.6, y + 3.1, endZ), S.MetalDark, folder)
		end
		-- Wall braces
		for _, braceZ in { zc - 3.8, zc + 3.8 } do
			ctx.segment("Brace" .. i .. "_" .. braceZ, Vector3.new(x0, y - 2.2, braceZ), Vector3.new(x0 + 3.0, y - 0.1, braceZ), 0.14, S.MetalDark, folder)
		end
		-- Stairs up to the next level
		local nextY = levels[i + 1]
		if nextY then
			local startP = Vector3.new(x0 + 2.3, y, zc - 3)
			local endP = Vector3.new(x0 + 2.3, nextY, zc + 3)
			local rise = nextY - y
			local run = 6
			local angle = math.atan2(rise, run)
			local length = math.sqrt(rise * rise + run * run)
			local mid = (startP + endP) / 2
			for _, offset in { -0.72, 0.72 } do
				ctx.part(
					"Stringer" .. i .. "_" .. offset,
					Vector3.new(0.08, 0.45, length),
					at(mid.X + offset, mid.Y, mid.Z) * CFrame.Angles(-angle, 0, 0),
					S.MetalDark,
					folder
				)
			end
			for step = 1, 8 do
				local p = startP:Lerp(endP, step / 9)
				ctx.part(string.format("Tread%d_%d", i, step), Vector3.new(1.4, 0.08, 0.5), at(p.X, p.Y + 0.1, p.Z), S.Diamond, folder)
			end
		end
	end

	-- Drop ladder below the first platform
	for _, lz in { zc + 3.6, zc + 4.3 } do
		ctx.part("LadderRail_" .. lz, Vector3.new(0.08, 4, 0.08), at(x0 + 2.8, levels[1] - 2.1, lz), S.MetalDark, folder)
	end
	for r = 0, 5 do
		ctx.part("LadderRung" .. r, Vector3.new(0.06, 0.06, 0.7), at(x0 + 2.8, levels[1] - 0.5 - r * 0.65, zc + 3.95), S.MetalDark, folder)
	end
end

--------------------------------------------------------------------------------
-- Lighting fixtures
--------------------------------------------------------------------------------
type LampDef = { X: number, Z: number, Side: number, Led: boolean, Flicker: boolean }

local function buildStreetlamps(ctx: Ctx, parent: Instance)
	local folder = PartFactory.folder("Streetlamps", parent)
	local lamps: { LampDef } = {
		{ X = -13.2, Z = 2, Side = -1, Led = false, Flicker = false },
		{ X = 13.2, Z = 26, Side = 1, Led = false, Flicker = true },
		{ X = -13.2, Z = 50, Side = -1, Led = false, Flicker = false },
		{ X = 13.2, Z = -22, Side = 1, Led = false, Flicker = false },
		{ X = -13.2, Z = -46, Side = -1, Led = true, Flicker = false },
	}
	for i, lamp in lamps do
		local model = Instance.new("Model")
		model.Name = "Streetlamp" .. i
		model.Parent = folder
		local headX = lamp.X - lamp.Side * 3.4
		local lensStyle = if lamp.Led then S.LedCool else S.Sodium
		local lightColor = if lamp.Led then LED_LIGHT else SODIUM_LIGHT

		ctx.part("Base", Vector3.new(1.1, 0.6, 1.1), at(lamp.X, 0.7, lamp.Z), S.ConcreteDark, model, { Collide = true })
		ctx.part("Pole", Vector3.new(14, 0.45, 0.45), at(lamp.X, 7.4, lamp.Z) * PartFactory.AxisY, S.MetalDark, model, {
			Shape = Enum.PartType.Cylinder,
			Collide = true,
		})
		ctx.segment("Arm", Vector3.new(lamp.X, 14, lamp.Z), Vector3.new(headX, 14, lamp.Z), 0.22, S.MetalDark, model)
		ctx.segment("ArmBrace", Vector3.new(lamp.X, 12.6, lamp.Z), Vector3.new(lamp.X - lamp.Side * 1.6, 14, lamp.Z), 0.12, S.MetalDark, model)
		ctx.part("Head", Vector3.new(1.6, 0.45, 0.9), at(headX, 13.8, lamp.Z), S.MetalDark, model)
		ctx.part("Lens", Vector3.new(1.3, 0.06, 0.6), at(headX, 13.55, lamp.Z), lensStyle, model)

		local source = ctx.part("LightSource", Vector3.new(0.2, 0.2, 0.2), at(headX, 13.4, lamp.Z), S.Invisible, model)
		addSpot(source, {
			Face = Enum.NormalId.Bottom,
			Angle = 75,
			Range = 40,
			Brightness = if lamp.Led then 2.8 else 3.5,
			Color = lightColor,
			Shadows = true,
		})
		addDownBeam(source, 13, 1.2, 11, lightColor)
		if lamp.Flicker then
			CollectionService:AddTag(model, "FlickerLight")
		end
	end
end

local function buildNeon(ctx: Ctx, parent: Instance)
	local folder = PartFactory.folder("Neon", parent)

	-- Magenta sign on the left wall above the car.
	local sign = Instance.new("Model")
	sign.Name = "NeonSign"
	sign.Parent = folder
	local x = -WALL_FACE + 0.25
	local panel = ctx.part("Panel", Vector3.new(0.3, 2.6, 9), at(x, 8.2, 8), S.MetalDark, sign)
	ctx.part("TubeTop", Vector3.new(0.12, 0.12, 9.2), at(x + 0.2, 9.55, 8), S.NeonCyan, sign)
	ctx.part("TubeBottom", Vector3.new(0.12, 0.12, 9.2), at(x + 0.2, 6.85, 8), S.NeonCyan, sign)
	ctx.part("TubeEndA", Vector3.new(0.12, 2.82, 0.12), at(x + 0.2, 8.2, 3.45), S.NeonCyan, sign)
	ctx.part("TubeEndB", Vector3.new(0.12, 2.82, 0.12), at(x + 0.2, 8.2, 12.55), S.NeonCyan, sign)
	for _, bz in { 4.5, 11.5 } do
		ctx.part("Bracket_" .. bz, Vector3.new(0.5, 0.14, 0.14), at(x - 0.1, 9.7, bz), S.MetalDark, sign)
	end

	local gui = Instance.new("SurfaceGui")
	gui.Name = "SignText"
	gui.Face = Enum.NormalId.Right
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	gui.LightInfluence = 0
	gui.Brightness = 2.5
	gui.Parent = panel
	local label = Instance.new("TextLabel")
	label.Name = "Text"
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(0.92, 0.8)
	label.Position = UDim2.fromScale(0.04, 0.1)
	label.Text = Config.Branding.SignText
	label.TextScaled = true
	label.TextColor3 = rgb(255, 70, 175)
	label.FontFace = Font.new("rbxasset://fonts/families/Montserrat.json", Enum.FontWeight.Bold)
	label.Parent = gui
	local stroke = Instance.new("UIStroke")
	stroke.Color = rgb(255, 150, 210)
	stroke.Thickness = 1.5
	stroke.Transparency = 0.4
	stroke.Parent = label

	local glow = ctx.part("Glow", Vector3.new(0.2, 0.2, 0.2), at(x + 2.2, 8.2, 8), S.Invisible, sign)
	addPoint(glow, 24, 2.2, rgb(255, 70, 175))
	CollectionService:AddTag(sign, "FlickerLight")
	sign:SetAttribute("FlickerStyle", "Sign")

	-- Cyan rim strips framing the garage (rim-light the car from behind/right).
	for i, z in { 16.9, 33.1 } do
		ctx.part("RimStrip" .. i, Vector3.new(0.15, 7.2, 0.15), at(WALL_FACE - 0.25, 3.8, z), S.NeonCyan, folder)
		local holder = ctx.part("RimGlow" .. i, Vector3.new(0.2, 0.2, 0.2), at(WALL_FACE - 1.5, 3.8, z), S.Invisible, folder)
		addPoint(holder, 16, 1.4, rgb(60, 220, 255))
	end

	-- Hanging bulb on a wire over the car.
	ctx.segment("BulbWire", Vector3.new(-2, 19, 6), Vector3.new(-2, 11.2, 6), 0.05, S.Cable, folder)
	local bulb = ctx.part("HangingBulb", Vector3.new(0.4, 0.4, 0.4), at(-2, 11, 6), S.Sodium, folder, { Shape = Enum.PartType.Ball })
	ctx.part("BulbShade", Vector3.new(0.3, 1.0, 1.0), at(-2, 11.3, 6) * PartFactory.AxisY, S.MetalDark, folder, { Shape = Enum.PartType.Cylinder })
	addPoint(bulb, 11, 0.9, WARM_LIGHT)
end

