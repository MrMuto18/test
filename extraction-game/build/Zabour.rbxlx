local function buildWorkbench(ctx: Ctx, parent: Instance)
	local folder = PartFactory.folder("Workbench", parent)
	local zc = 10

	ctx.part("Top", Vector3.new(2.6, 0.25, 7), at(13.6, 3.1, zc), S.Wood, folder, { Collide = true })
	ctx.part("FrontLip", Vector3.new(0.1, 0.25, 7), at(12.28, 3.1, zc), S.MetalDark, folder)
	for _, lx in { 12.45, 14.75 } do
		for _, lz in { zc - 3.3, zc + 3.3 } do
			ctx.part("Leg", Vector3.new(0.22, 2.95, 0.22), at(lx, 1.5, lz), S.MetalDark, folder, { Collide = true })
		end
	end
	ctx.part("Shelf", Vector3.new(2.4, 0.12, 6.6), at(13.6, 0.9, zc), S.Wood, folder)
	ctx.part("Pegboard", Vector3.new(0.12, 4.2, 7), at(WALL_FACE - 0.12, 5.6, zc), S.Pegboard, folder)
	ctx.part("PegboardFrameTop", Vector3.new(0.16, 0.12, 7.1), at(WALL_FACE - 0.14, 7.7, zc), S.MetalDark, folder)
	ctx.part("PegboardFrameBottom", Vector3.new(0.16, 0.12, 7.1), at(WALL_FACE - 0.14, 3.5, zc), S.MetalDark, folder)

	-- Tools on the pegboard
	local px = WALL_FACE - 0.22
	ctx.part("Wrench", Vector3.new(0.06, 1.3, 0.16), at(px, 6.0, zc - 2.4), S.MetalLight, folder)
	ctx.part("WrenchHead", Vector3.new(0.06, 0.22, 0.38), at(px, 6.68, zc - 2.4), S.MetalLight, folder)
	ctx.part("HammerHandle", Vector3.new(0.08, 1.0, 0.12), at(px, 5.8, zc - 1.6), S.Wood, folder)
	ctx.part("HammerHead", Vector3.new(0.1, 0.18, 0.5), at(px, 6.35, zc - 1.6), S.MetalDark, folder)
	ctx.part("Screwdriver", Vector3.new(0.05, 0.9, 0.05), at(px, 6.1, zc - 0.9), S.MetalLight, folder)
	ctx.part("ScrewdriverGrip", Vector3.new(0.09, 0.35, 0.09), at(px, 6.65, zc - 0.9), PartFactory.style(rgb(170, 40, 30), Enum.Material.SmoothPlastic), folder)
	ctx.part("TapeRoll", Vector3.new(0.18, 0.5, 0.5), at(px - 0.05, 6.2, zc + 2.6), S.FabricDark, folder, { Shape = Enum.PartType.Cylinder })
	ctx.part("Clipboard", Vector3.new(0.04, 0.9, 0.65), at(px, 5.2, zc + 1.6), PartFactory.style(rgb(200, 196, 182), Enum.Material.SmoothPlastic), folder)

	-- Upper shelf with boxes
	ctx.part("UpperShelf", Vector3.new(1.4, 0.12, 7), at(14.3, 8.0, zc), S.Wood, folder)
	for i, bz in { zc - 2.4, zc - 0.9, zc + 2.2 } do
		ctx.part("Box" .. i, Vector3.new(1.0, 0.8, 1.2), at(14.35, 8.46, bz) * CFrame.Angles(0, math.rad((i - 2) * 4), 0), S.Cardboard, folder)
	end

	-- Work lamp
	ctx.segment("LampArm", Vector3.new(WALL_FACE - 0.1, 9.0, zc), Vector3.new(13.2, 9.0, zc), 0.12, S.MetalDark, folder)
	ctx.part("LampShade", Vector3.new(0.9, 0.45, 0.9), at(13.2, 8.7, zc), S.MetalDark, folder)
	ctx.part("LampBulb", Vector3.new(0.4, 0.12, 0.4), at(13.2, 8.45, zc), S.Sodium, folder)
	local lampSource = ctx.part("LampSource", Vector3.new(0.2, 0.2, 0.2), at(13.2, 8.35, zc), S.Invisible, folder)
	addSpot(lampSource, {
		Face = Enum.NormalId.Bottom,
		Angle = 80,
		Range = 16,
		Brightness = 3,
		Color = WARM_LIGHT,
		Shadows = true,
	})
	addDownBeam(lampSource, 5, 0.7, 4.5, WARM_LIGHT)

	-- Bench items
	ctx.part("WeaponMat", Vector3.new(1.9, 0.03, 4.2), at(13.5, 3.24, zc - 0.6), S.FabricDark, folder)
	ctx.part("LaptopBase", Vector3.new(1.0, 0.05, 0.7), at(13.9, 3.25, zc + 2.4), S.MetalDark, folder)
	local screenCF = at(14.38, 3.6, zc + 2.4) * CFrame.Angles(0, 0, math.rad(-12))
	ctx.part("LaptopLid", Vector3.new(0.04, 0.7, 1.0), screenCF, S.MetalDark, folder)
	local screen = ctx.part("LaptopScreen", Vector3.new(0.02, 0.6, 0.9), screenCF * CFrame.new(-0.03, 0, 0), S.ScreenGlow, folder)
	local screenGui = Instance.new("SurfaceGui")
	screenGui.Face = Enum.NormalId.Left
	screenGui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	screenGui.PixelsPerStud = 120
	screenGui.LightInfluence = 0
	screenGui.Brightness = 1.4
	screenGui.Parent = screen
	local screenText = Instance.new("TextLabel")
	screenText.BackgroundTransparency = 1
	screenText.Size = UDim2.fromScale(0.86, 0.7)
	screenText.Position = UDim2.fromScale(0.07, 0.15)
	screenText.Text = "STASH TERMINAL\nAWAITING EXTRACTION"
	screenText.TextScaled = true
	screenText.TextColor3 = rgb(170, 240, 255)
	screenText.FontFace = Font.new("rbxasset://fonts/families/RobotoMono.json", Enum.FontWeight.Medium)
	screenText.Parent = screenGui
	addPoint(screen, 4, 0.8, rgb(60, 170, 220))

	for i, y in { 3.6, 4.37 } do
		ctx.part("AmmoCan" .. i, Vector3.new(0.5, 0.75, 1.1), at(13.85, y, zc + 3.0 - (i - 1) * 0.08), S.Olive, folder)
		ctx.part("AmmoHandle" .. i, Vector3.new(0.08, 0.06, 0.6), at(13.85, y + 0.41, zc + 3.0 - (i - 1) * 0.08), S.MetalDark, folder)
	end

	-- Duffel bag on the floor
	ctx.part("Duffel", Vector3.new(1.6, 1.1, 2.4), at(12.4, 0.75, zc + 5.2), S.FabricDark, folder, { Collide = true })
	for _, ez in { zc + 4.0, zc + 6.4 } do
		ctx.part("DuffelEnd", Vector3.new(0.12, 1.1, 1.1), at(12.4, 0.75, ez) * PartFactory.AxisZ, S.FabricDark, folder, { Shape = Enum.PartType.Cylinder })
	end
	ctx.part("DuffelStrap", Vector3.new(1.65, 0.06, 0.14), at(12.4, 1.32, zc + 5.2), S.MetalDark, folder)

	-- Mounting anchors for Phase 2 weapon models.
	local displays = PartFactory.folder("WeaponDisplays", folder)
	ctx.part("Display_Primary", Vector3.new(0.2, 0.2, 0.2), at(13.4, 3.32, zc - 1.4), S.Invisible, displays)
	ctx.part("Display_Secondary", Vector3.new(0.2, 0.2, 0.2), at(13.3, 3.3, zc + 0.9), S.Invisible, displays)
end

--------------------------------------------------------------------------------
-- Props
--------------------------------------------------------------------------------
local function buildProps(ctx: Ctx, parent: Instance)
	local folder = PartFactory.folder("Props", parent)
	local rng = ctx.Rng

	-- Dumpster
	local dz = 20
	local dx = -13.0
	ctx.part("DumpsterBody", Vector3.new(2.8, 3.0, 5.8), at(dx, 1.7, dz), S.Dumpster, folder, { Collide = true })
	ctx.part("DumpsterLid", Vector3.new(3.0, 0.15, 6.0), at(dx, 3.3, dz) * CFrame.Angles(0, 0, math.rad(-8)), S.Dumpster, folder)
	ctx.part("DumpsterRust", Vector3.new(0.05, 1.2, 2.0), at(dx + 1.42, 1.4, dz + 1.2), S.MetalRust, folder)
	for _, pz in { dz - 1.5, dz + 1.5 } do
		ctx.part("LiftPocket", Vector3.new(0.3, 0.5, 1.2), at(dx + 1.5, 2.3, pz), S.MetalDark, folder)
	end
	for _, wx in { dx - 1.1, dx + 1.1 } do
		for _, wz in { dz - 2.5, dz + 2.5 } do
			ctx.part("Caster", Vector3.new(0.25, 0.4, 0.4), at(wx, 0.2, wz), S.MetalDark, folder, { Shape = Enum.PartType.Cylinder })
		end
	end
	for i = 1, 5 do
		local d = rng:NextNumber(1.3, 1.8)
		ctx.part("TrashBag" .. i, Vector3.new(d, d, d), at(rng:NextNumber(-11.4, -10.4), d / 2 - 0.15, dz - 4 + i * 1.3), S.TrashBag, folder, {
			Shape = Enum.PartType.Ball,
			Collide = true,
		})
	end

	-- Crate stack
	local cratePositions = {
		at(11.2, 1.2, -16),
		at(11.3, 1.2, -18.6),
		at(11.25, 3.6, -17.2) * CFrame.Angles(0, math.rad(12), 0),
	}
	for i, cf in cratePositions do
		ctx.part("Crate" .. i, Vector3.new(2.4, 2.4, 2.4), cf, S.Wood, folder, { Collide = true })
		ctx.part("CrateStrapA" .. i, Vector3.new(2.46, 0.12, 0.08), cf * CFrame.new(0, 0, 0.6), S.MetalDark, folder)
		ctx.part("CrateStrapB" .. i, Vector3.new(2.46, 0.12, 0.08), cf * CFrame.new(0, 0, -0.6), S.MetalDark, folder)
	end

	-- Barrels
	local barrelColors = { rgb(52, 70, 96), rgb(110, 60, 40), rgb(60, 62, 58) }
	for i, pos in { Vector3.new(11.8, 0, -27), Vector3.new(10.2, 0, -28.4), Vector3.new(11.9, 0, -29.6) } do
		local barrelStyle = PartFactory.style(barrelColors[i], Enum.Material.CorrodedMetal)
		ctx.part("Barrel" .. i, Vector3.new(3.0, 2.0, 2.0), at(pos.X, 1.5, pos.Z) * PartFactory.AxisY, barrelStyle, folder, {
			Shape = Enum.PartType.Cylinder,
			Collide = true,
		})
		for _, ry in { 1.0, 2.0 } do
			ctx.part("BarrelRib" .. i .. "_" .. ry, Vector3.new(0.12, 2.06, 2.06), at(pos.X, ry, pos.Z) * PartFactory.AxisY, barrelStyle, folder, {
				Shape = Enum.PartType.Cylinder,
			})
		end
		ctx.part("BarrelLid" .. i, Vector3.new(0.05, 1.9, 1.9), at(pos.X, 3.01, pos.Z) * PartFactory.AxisY, S.MetalDark, folder, { Shape = Enum.PartType.Cylinder })
	end

	-- Pallets leaning on the right wall
	for i, pz in { -6, -8.4 } do
		local cf = at(WALL_FACE - 0.6 - i * 0.25, 1.8, pz) * CFrame.Angles(0, 0, math.rad(10 + i * 3))
		ctx.part("PalletBack" .. i, Vector3.new(0.12, 3.6, 4.0), cf, S.Wood, folder, { Collide = true })
		for slat = -1, 1 do
			ctx.part("PalletSlat" .. i .. "_" .. slat, Vector3.new(0.18, 3.6, 0.35), cf * CFrame.new(-0.12, 0, slat * 1.7), S.Wood, folder)
		end
	end

	-- Overhead cables with sag
	local cables = {
		{ Y = 19, Z = -40, Sag = 1.8 },
		{ Y = 21.5, Z = -18, Sag = 2.2 },
		{ Y = 24, Z = 0, Sag = 1.6 },
		{ Y = 19.5, Z = 12, Sag = 2.4 },
		{ Y = 26, Z = 34, Sag = 1.9 },
		{ Y = 22, Z = 56, Sag = 2.1 },
	}
	for i, cable in cables do
		local drift = rng:NextNumber(-1.2, 1.2)
		local a = Vector3.new(-WALL_FACE, cable.Y, cable.Z)
		local m = Vector3.new(0, cable.Y - cable.Sag, cable.Z + drift)
		local b = Vector3.new(WALL_FACE, cable.Y + rng:NextNumber(-0.8, 0.8), cable.Z + drift * 2)
		ctx.segment("CableA" .. i, a, m, 0.08, S.Cable, folder)
		ctx.segment("CableB" .. i, m, b, 0.08, S.Cable, folder)
	end
end

--------------------------------------------------------------------------------
-- FX, cameras, spawn points
--------------------------------------------------------------------------------
local function buildMist(ctx: Ctx, parent: Instance)
	local folder = PartFactory.folder("GroundMist", parent)
	for i, z in { -40, -6, 28, 62 } do
		local volume = ctx.part("MistVolume" .. i, Vector3.new(26, 0.5, 34), at(0, 0.6, z), S.Invisible, folder)
		local mist = smokeEmitter(volume, {
			Name = "Mist",
			Rate = 2.5,
			Lifetime = NumberRange.new(10, 14),
			Speed = NumberRange.new(0.2, 0.6),
			Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 9), NumberSequenceKeypoint.new(1, 14) }),
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1),
				NumberSequenceKeypoint.new(0.3, 0.9),
				NumberSequenceKeypoint.new(0.7, 0.92),
				NumberSequenceKeypoint.new(1, 1),
			}),
			Color = rgb(170, 176, 186),
			Direction = Enum.NormalId.Top,
			Spread = Vector2.new(60, 60),
			Acceleration = Vector3.new(0.25, 0.02, 0.1),
			Drag = 0.2,
		})
		CollectionService:AddTag(mist, "GroundMist")
	end
end

type ShotDef = { Name: string, From: Vector3, To: Vector3, Fov: number, Focus: number, Radius: number }

local function buildCameraRig(ctx: Ctx, parent: Instance)
	local folder = PartFactory.folder("CameraRig", parent)
	local shots: { ShotDef } = {
		{ Name = "MenuShot", From = Vector3.new(12.5, 3.7, -9.5), To = Vector3.new(0.6, 2.3, 7.6), Fov = 38, Focus = 20.6, Radius = 9 },
		{ Name = "LoadoutShot", From = Vector3.new(7.0, 5.6, 4.4), To = Vector3.new(12.4, 3.5, 11.55), Fov = 44, Focus = 9.1, Radius = 3.5 },
		{ Name = "SettingsShot", From = Vector3.new(-7.5, 1.6, -9.5), To = Vector3.new(-2.25, 1.9, -1.63), Fov = 30, Focus = 9.2, Radius = 2.6 },
	}
	for _, shot in shots do
		local part = PartFactory.make({
			Name = shot.Name,
			Size = Vector3.new(0.4, 0.4, 0.8),
			CFrame = ctx.Origin * CFrame.lookAt(shot.From, shot.To),
			Style = S.Invisible,
			Parent = folder,
		})
		part:SetAttribute("FieldOfView", shot.Fov)
		part:SetAttribute("FocusDistance", shot.Focus)
		part:SetAttribute("InFocusRadius", shot.Radius)
	end
end

local function buildDeployPoints(ctx: Ctx, parent: Instance)
	local folder = PartFactory.folder("DeployPoints", parent)
	for i, p in { Vector3.new(5, 0.1, -2), Vector3.new(7.5, 0.1, -0.8), Vector3.new(2.6, 0.1, -0.4), Vector3.new(9.5, 0.1, -3.2) } do
		PartFactory.make({
			Name = "DeployPoint" .. i,
			Size = Vector3.new(2, 0.2, 2),
			CFrame = ctx.Origin * CFrame.lookAt(p, p + Vector3.zAxis),
			Style = S.Invisible,
			Parent = folder,
		})
	end
end

--------------------------------------------------------------------------------
-- Public API
--------------------------------------------------------------------------------
function SafehouseBuilder.build(): Model
	local origin = Config.World.Origin
	local ctx = makeCtx(origin, 7)

	local model = Instance.new("Model")
	model.Name = Config.World.SafehouseName
	model.ModelStreamingMode = Enum.ModelStreamingMode.Persistent

	buildGround(ctx, model)
	local buildings = PartFactory.folder("Buildings", model)
	buildBuilding(ctx, buildings, -1)
	buildBuilding(ctx, buildings, 1)
	buildFireEscape(ctx, buildings)
	buildStreetlamps(ctx, model)
	buildNeon(ctx, model)
	buildGarage(ctx, model)
	buildWorkbench(ctx, model)
	buildProps(ctx, model)
	buildMist(ctx, model)
	buildCameraRig(ctx, model)
	buildDeployPoints(ctx, model)

	local car = GetawayCarBody.build(origin * Config.World.CarPose, {
		Name = Config.World.CarName,
		Anchored = true,
		PlateText = Config.Branding.PlateText,
	})
	car.Model.Parent = model

	model.PrimaryPart = nil
	model.Parent = Workspace
	return model
end

-- Returns the existing Safehouse (e.g. one baked in edit mode) or builds it.
function SafehouseBuilder.ensure(rebuild: boolean?): Model
	local existing = Workspace:FindFirstChild(Config.World.SafehouseName)
	if existing and existing:IsA("Model") then
		if not rebuild then
			return existing
		end
		existing:Destroy()
	end
	local started = os.clock()
	local model = SafehouseBuilder.build()
	local count = 0
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			count += 1
		end
	end
	print(string.format("[Safehouse] built %d parts in %.1f ms", count, (os.clock() - started) * 1000))
	return model
end

return SafehouseBuilder
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000029"><Properties><string name="Name">TrainingRange</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	TrainingRange
	Shooting lane down the alley for testing gunplay before Phase 4 brings real
	threats. Three armoured mannequins (Humanoid-driven: headshots, kills,
	falloff all work through the real CombatService path), distance boards and
	a steel gong plate for impact sparks.

	Mannequins flash on hit, regenerate when left alone, collapse on death and
	respawn after Config.Combat.TrainingDummyRespawn seconds.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local PartFactory = require(Shared.Builders.PartFactory)

local TrainingRange = {}

local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

local S = {
	Mannequin = PartFactory.style(rgb(184, 172, 152), Enum.Material.SmoothPlastic, 0.02),
	Joint = PartFactory.style(rgb(60, 60, 64), Enum.Material.Metal, 0.05),
	Carrier = PartFactory.style(rgb(74, 80, 58), Enum.Material.Fabric),
	Pouch = PartFactory.style(rgb(62, 68, 48), Enum.Material.Fabric),
	Steel = PartFactory.style(rgb(80, 82, 86), Enum.Material.Metal, 0.1),
	SteelDark = PartFactory.style(rgb(40, 42, 46), Enum.Material.DiamondPlate),
	Board = PartFactory.style(rgb(30, 30, 32), Enum.Material.SmoothPlastic),
	Invisible = PartFactory.style(rgb(0, 0, 0), Enum.Material.SmoothPlastic, 0, 1, false),
}

local function rings(part: BasePart)
	local gui = Instance.new("SurfaceGui")
	gui.Name = "Target"
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 60
	gui.LightInfluence = 1
	gui.Parent = part
	for i, size in { 90, 60, 30 } do
		local ring = Instance.new("Frame")
		ring.AnchorPoint = Vector2.new(0.5, 0.5)
		ring.Position = UDim2.fromScale(0.5, 0.45)
		ring.Size = UDim2.fromOffset(size, size)
		ring.BackgroundTransparency = if i == 3 then 0.1 else 1
		ring.BackgroundColor3 = rgb(200, 60, 40)
		ring.BorderSizePixel = 0
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(1, 0)
		corner.Parent = ring
		local stroke = Instance.new("UIStroke")
		stroke.Color = rgb(200, 60, 40)
		stroke.Thickness = 3
		stroke.Parent = ring
		ring.Parent = gui
	end
end

local function buildDummy(parent: Instance, base: CFrame, index: number)
	local model = Instance.new("Model")
	model.Name = "TrainingDummy" .. index

	local function add(name: string, size: Vector3, offset: CFrame, style: PartFactory.Style, anchored: boolean?): BasePart
		return PartFactory.make({
			Name = name,
			Size = size,
			CFrame = base * offset,
			Style = style,
			CanCollide = true,
			Anchored = anchored == true,
			Parent = model,
		})
	end

	-- Stand (separate, stays when the mannequin collapses)
	local stand = Instance.new("Model")
	stand.Name = "DummyStand" .. index
	stand.Parent = parent
	PartFactory.make({ Name = "StandPlate", Size = Vector3.new(2.2, 0.2, 2.2), CFrame = base * CFrame.new(0, 0.1, 0), Style = S.SteelDark, CanCollide = true, Parent = stand })

	local root = add("HumanoidRootPart", Vector3.new(2, 2, 1), CFrame.new(0, 3.1, 0), S.Invisible, true)
	root.CanCollide = false
	model.PrimaryPart = root

	local limbs: { BasePart } = {}
	local function limb(name: string, size: Vector3, offset: CFrame, style: PartFactory.Style): BasePart
		local part = add(name, size, offset, style)
		PartFactory.weld(root, part)
		table.insert(limbs, part)
		return part
	end

	limb("LeftLeg", Vector3.new(0.85, 2.0, 0.85), CFrame.new(-0.5, 1.2, 0), S.Mannequin)
	limb("RightLeg", Vector3.new(0.85, 2.0, 0.85), CFrame.new(0.5, 1.2, 0), S.Mannequin)
	local torso = limb("Torso", Vector3.new(2, 2, 1), CFrame.new(0, 3.2, 0), S.Mannequin)
	limb("LeftArm", Vector3.new(0.85, 1.9, 0.85), CFrame.new(-1.45, 3.15, 0), S.Mannequin)
	limb("RightArm", Vector3.new(0.85, 1.9, 0.85), CFrame.new(1.45, 3.15, 0), S.Mannequin)
	limb("Neck", Vector3.new(0.45, 0.3, 0.45), CFrame.new(0, 4.35, 0), S.Joint)
	limb("Head", Vector3.new(1.1, 1.15, 1.1), CFrame.new(0, 4.95, 0), S.Mannequin)
	limb("PlateCarrier", Vector3.new(2.12, 1.45, 1.14), CFrame.new(0, 3.3, 0), S.Carrier)
	for i, x in { -0.6, 0, 0.6 } do
		limb("MagPouch" .. i, Vector3.new(0.45, 0.55, 0.2), CFrame.new(x, 2.95, -0.66), S.Pouch)
	end
	rings(torso)

	local humanoid = Instance.new("Humanoid")
	humanoid.MaxHealth = Config.Combat.TrainingDummyHealth
	humanoid.Health = Config.Combat.TrainingDummyHealth
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	humanoid.BreakJointsOnDeath = false
	humanoid.RequiresNeck = false
	humanoid.Parent = model

	local flash = Instance.new("Highlight")
	flash.FillColor = rgb(255, 255, 255)
	flash.FillTransparency = 1
	flash.OutlineTransparency = 1
	flash.DepthMode = Enum.HighlightDepthMode.Occluded
	flash.Parent = model

	model.Parent = parent

	local lastHealth = humanoid.Health
	local lastHit = 0
	humanoid.HealthChanged:Connect(function(health: number)
		if health < lastHealth then
			lastHit = os.clock()
			flash.FillTransparency = 0.55
			task.delay(0.07, function()
				flash.FillTransparency = 1
			end)
		end
		lastHealth = health
	end)

	-- Regenerate when left alone.
	task.spawn(function()
		while model.Parent and humanoid.Health > 0 do
			task.wait(0.5)
			if humanoid.Health > 0 and os.clock() - lastHit > 3 and humanoid.Health < humanoid.MaxHealth then
				humanoid.Health = math.min(humanoid.MaxHealth, humanoid.Health + humanoid.MaxHealth * 0.25)
			end
		end
	end)

	humanoid.Died:Once(function()
		for _, part in limbs do
			for _, weld in part:GetChildren() do
				if weld:IsA("WeldConstraint") then
					weld:Destroy()
				end
			end
			part.Anchored = false
			part.AssemblyLinearVelocity = Vector3.new(math.random(-6, 6), 4, math.random(4, 10))
		end
		task.delay(Config.Combat.TrainingDummyRespawn, function()
			model:Destroy()
			stand:Destroy()
			buildDummy(parent, base, index)
		end)
	end)
end

local function distanceBoard(parent: Instance, origin: CFrame, position: Vector3, text: string)
	local board = PartFactory.make({
		Name = "DistanceBoard",
		Size = Vector3.new(0.2, 1.2, 3),
		CFrame = origin * CFrame.new(position),
		Style = S.Board,
		CanCollide = true,
		Parent = parent,
	})
	PartFactory.make({
		Name = "BoardPost",
		Size = Vector3.new(0.2, position.Y, 0.2),
		CFrame = origin * CFrame.new(position.X, position.Y / 2, position.Z),
		Style = S.Steel,
		Parent = parent,
	})
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Right
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 50
	gui.LightInfluence = 0.6
	gui.Parent = board
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Text = text
	label.TextScaled = true
	label.TextColor3 = rgb(255, 168, 86)
	label.FontFace = Font.new("rbxasset://fonts/families/RobotoMono.json", Enum.FontWeight.Bold)
	label.Parent = gui
end

function TrainingRange.build(safehouse: Model)
	local existing = safehouse:FindFirstChild("TrainingRange")
	if existing then
		existing:Destroy()
	end
	local folder = PartFactory.folder("TrainingRange", safehouse)
	local origin = Config.World.Origin

	-- Dummies face -Z, toward the deploy points.
	local spots = { Vector3.new(0, 0, 24), Vector3.new(-6, 0, 40), Vector3.new(5, 0, 56) }
	for i, p in spots do
		buildDummy(folder, origin * CFrame.new(p), i)
	end

	-- Distance boards on the left sidewalk, readable from the deploy area.
	for _, z in { 24, 40, 56 } do
		distanceBoard(folder, origin, Vector3.new(-11.8, 2.4, z), string.format("%dm", math.floor((z + 2) * 0.28 + 0.5)))
	end

	-- Steel gong for impact sparks at the end of the lane.
	local gongCF = origin * CFrame.new(-1, 3.4, 68)
	PartFactory.make({ Name = "GongPlate", Size = Vector3.new(2.4, 2.4, 0.3), CFrame = gongCF, Style = S.Steel, CanCollide = true, Parent = folder })
	PartFactory.make({ Name = "GongChainL", Size = Vector3.new(0.08, 2.6, 0.08), CFrame = gongCF * CFrame.new(-0.9, 2.5, 0), Style = S.SteelDark, Parent = folder })
	PartFactory.make({ Name = "GongChainR", Size = Vector3.new(0.08, 2.6, 0.08), CFrame = gongCF * CFrame.new(0.9, 2.5, 0), Style = S.SteelDark, Parent = folder })
	PartFactory.make({ Name = "GongBeam", Size = Vector3.new(4.4, 0.3, 0.3), CFrame = gongCF * CFrame.new(0, 3.8, 0), Style = S.SteelDark, CanCollide = true, Parent = folder })
	for _, x in { -2.1, 2.1 } do
		PartFactory.make({ Name = "GongPost", Size = Vector3.new(0.3, 7.4, 0.3), CFrame = origin * CFrame.new(-1 + x, 3.7, 68), Style = S.SteelDark, CanCollide = true, Parent = folder })
	end
end

return TrainingRange
]]></ProtectedString></Properties></Item></Item></Item></Item><Item class="StarterPlayer" referent="RBX000058"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX000057"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="Folder" referent="RBX000056"><Properties><string name="Name">Client</string></Properties><Item class="LocalScript" referent="RBX000033"><Properties><string name="Name">ClientBootstrap</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	ClientBootstrap (LocalScript)
	Client entry point. Initialises controllers in dependency order and wires
	the menu ↔ gameplay lifecycle:

	  MenuController.Deployed  → movement, weapons and HUD attach to the character
	  MenuController.Entered   → they detach (death / return to safehouse)
]]

local Players = game:GetService("Players")

local Controllers = script.Parent.Controllers
local SettingsController = require(Controllers.SettingsController)
local AudioController = require(Controllers.AudioController)
local CinematicGrade = require(Controllers.CinematicGrade)
local AtmosphereController = require(Controllers.AtmosphereController)
local MenuCamera = require(Controllers.MenuCamera)
local MenuController = require(Controllers.MenuController)
local CharacterPoser = require(Controllers.CharacterPoser)
local MovementController = require(Controllers.MovementController)
local WeaponController = require(Controllers.WeaponController)
local LoadoutDisplay = require(Controllers.LoadoutDisplay)
local VehicleCamera = require(Controllers.VehicleCamera)
local VehicleController = require(Controllers.VehicleController)
local VehicleFx = require(Controllers.VehicleFx)
local HUD = require(script.Parent.UI.HUD)
local PromptUI = require(script.Parent.UI.PromptUI)

local player = Players.LocalPlayer

SettingsController.init()
AudioController.init()
CinematicGrade.init()
AtmosphereController.init({
	Flash = CinematicGrade.flash,
	Thunder = AudioController.thunder,
	EngineSound = function(): Sound?
		return AudioController.get("EngineIdle")
	end,
})

local function applyQuality(settings: any)
	AtmosphereController.applyQuality(settings.Quality)
	CinematicGrade.applyQuality(settings.Quality)
end
applyQuality(SettingsController.get())
SettingsController.Changed:Connect(applyQuality)

HUD.init()
PromptUI.init()
CharacterPoser.init()
WeaponController.init()
LoadoutDisplay.init()
VehicleCamera.init()
VehicleFx.init()
MenuCamera.init()
MenuController.init()

local carryConnection: RBXScriptConnection? = nil
MenuController.Deployed:Connect(function(character: any)
	MovementController.attach(character)
	WeaponController.attach(character, SettingsController.getLoadout())
	VehicleController.attach(character)
	HUD.setMode("OnFoot")
	HUD.setCarry(nil)
	if carryConnection then
		carryConnection:Disconnect()
	end
	carryConnection = character:GetAttributeChangedSignal("CarryValue"):Connect(function()
		local value = character:GetAttribute("CarryValue")
		HUD.setCarry(if typeof(value) == "number" and value > 0 then value else nil)
	end)
end)
MenuController.Entered:Connect(function()
	VehicleController.detach()
	WeaponController.detach()
	MovementController.detach()
	HUD.setCarry(nil)
	if carryConnection then
		carryConnection:Disconnect()
		carryConnection = nil
	end
end)

MenuController.enter(false)

player:GetAttributeChangedSignal("State"):Connect(function()
	if player:GetAttribute("State") == "Menu" and MenuController.isDeployed() then
		task.spawn(MenuController.returnFromRaid)
	end
end)
]]></ProtectedString></Properties></Item><Item class="Folder" referent="RBX000049"><Properties><string name="Name">Controllers</string></Properties><Item class="ModuleScript" referent="RBX000034"><Properties><string name="Name">AtmosphereController</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	AtmosphereController
	Everything weather/ambience that should run per-client:

	  • Camera-following rain volume (velocity-aligned streaks, wind drift)
	  • Ground splashes snapped to the surface under the camera
	  • Lightning: double-strike exposure flash + delayed thunder
	  • Flicker for anything tagged "FlickerLight" (lamps, neon sign, bulbs)
	  • Idle engine rumble + lope on the parked getaway car
	  • Quality preset toggles for mist, volumetric beams, exhaust smoke and
	    shadow-casting lights
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Types = require(Shared.Types)

type Hooks = {
	Flash: (amount: number) -> (),
	Thunder: (intensity: number) -> (),
	EngineSound: () -> Sound?,
}

local AtmosphereController = {}

local SPARK_TEXTURE = "rbxasset://textures/particles/sparkles_main.dds"
local RAIN_COLOR = Color3.fromRGB(200, 210, 225)

local preset: Types.QualityPreset = Config.Quality.High
local hooks: Hooks
local fxFolder: Folder
local rainPart: BasePart
local rainEmitter: ParticleEmitter
local splashPart: BasePart
local splashEmitter: ParticleEmitter
local rayParams = RaycastParams.new()
local groundY = 0
local groundTimer = 0
local rng = Random.new()

local carRoot: BasePart? = nil
local carBase: CFrame? = nil

local function makeFxPart(name: string, size: Vector3): BasePart
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Transparency = 1
	part.CastShadow = false
	part.Parent = fxFolder
	return part
end

local function buildRain()
	local area = Config.Weather.RainAreaSize
	rainPart = makeFxPart("RainVolume", Vector3.new(area, 1, area))
	rainEmitter = Instance.new("ParticleEmitter")
	rainEmitter.Name = "Rain"
	rainEmitter.Texture = SPARK_TEXTURE
	rainEmitter.EmissionDirection = Enum.NormalId.Bottom
	rainEmitter.Orientation = Enum.ParticleOrientation.VelocityParallel
	rainEmitter.Speed = Config.Weather.RainSpeed
	rainEmitter.SpreadAngle = Vector2.new(3, 3)
	rainEmitter.Acceleration = Config.Weather.Wind
	rainEmitter.Lifetime = NumberRange.new(0.55, 0.75)
	rainEmitter.Size = NumberSequence.new(0.16)
	rainEmitter.Squash = NumberSequence.new(-2.6)
	rainEmitter.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.55),
		NumberSequenceKeypoint.new(0.85, 0.62),
		NumberSequenceKeypoint.new(1, 1),
	})
	rainEmitter.Color = ColorSequence.new(RAIN_COLOR)
	rainEmitter.LightEmission = 0.15
	rainEmitter.LightInfluence = 0.9
	rainEmitter.Rate = preset.RainRate
	rainEmitter.Parent = rainPart

	splashPart = makeFxPart("SplashVolume", Vector3.new(40, 0.2, 40))
	splashEmitter = Instance.new("ParticleEmitter")
	splashEmitter.Name = "Splash"
	splashEmitter.Texture = SPARK_TEXTURE
	splashEmitter.EmissionDirection = Enum.NormalId.Top
	splashEmitter.Speed = NumberRange.new(2, 4)
	splashEmitter.SpreadAngle = Vector2.new(60, 60)
	splashEmitter.Acceleration = Vector3.new(0, -30, 0)
	splashEmitter.Lifetime = NumberRange.new(0.12, 0.22)
	splashEmitter.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.05),
		NumberSequenceKeypoint.new(1, 0.22),
	})
	splashEmitter.Squash = NumberSequence.new(0.8)
	splashEmitter.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.45),
		NumberSequenceKeypoint.new(1, 1),
	})
	splashEmitter.Color = ColorSequence.new(RAIN_COLOR)
	splashEmitter.LightInfluence = 1
	splashEmitter.Rate = preset.RainRate * 0.35
	splashEmitter.Parent = splashPart
end

local function refreshRayFilter()
	local ignore: { Instance } = { fxFolder }
	local character = Players.LocalPlayer.Character
	if character then
		table.insert(ignore, character)
	end
	rayParams.FilterType = Enum.RaycastFilterType.Exclude
	rayParams.FilterDescendantsInstances = ignore
end

local function followCamera(dt: number)
	local camera = Workspace.CurrentCamera
	if not camera then
		return
	end
	local cf = camera.CFrame
	local flatLook = Vector3.new(cf.LookVector.X, 0, cf.LookVector.Z)
	if flatLook.Magnitude > 1e-3 then
		flatLook = flatLook.Unit
	end
	-- Bias the volume ahead of the view and upwind so streaks fill the frame.
	local wind = Config.Weather.Wind
	local upwind = -Vector3.new(wind.X, 0, wind.Z) * 0.25
	rainPart.CFrame = CFrame.new(cf.Position + Vector3.new(0, Config.Weather.RainHeight, 0) + flatLook * 18 + upwind)

	groundTimer -= dt
	if groundTimer <= 0 then
		groundTimer = 0.25
		refreshRayFilter()
		local hit = Workspace:Raycast(cf.Position, Vector3.new(0, -200, 0), rayParams)
		if hit then
			groundY = hit.Position.Y
		end
	end
	splashPart.CFrame = CFrame.new(cf.Position.X + flatLook.X * 10, groundY + 0.15, cf.Position.Z + flatLook.Z * 10)
end

--------------------------------------------------------------------------------
-- Flicker
--------------------------------------------------------------------------------
type FlickerTarget = {
	Lights: { Light },
	Beams: { Beam },
	Neon: { BasePart },
	NeonColors: { Color3 },
	Guis: { SurfaceGui },
	GuiBrightness: { number },
}

local function collectFlicker(root: Instance): FlickerTarget
	local target: FlickerTarget = { Lights = {}, Beams = {}, Neon = {}, NeonColors = {}, Guis = {}, GuiBrightness = {} }
	local candidates = root:GetDescendants()
	table.insert(candidates, root)
	for _, d in candidates do
		if d:IsA("Light") then
			table.insert(target.Lights, d)
		elseif d:IsA("Beam") then
			table.insert(target.Beams, d)
		elseif d:IsA("BasePart") and d.Material == Enum.Material.Neon then
			table.insert(target.Neon, d)
			table.insert(target.NeonColors, d.Color)
		elseif d:IsA("SurfaceGui") then
			table.insert(target.Guis, d)
			table.insert(target.GuiBrightness, d.Brightness)
		end
	end
	return target
end

local function setFlickerOn(target: FlickerTarget, on: boolean, level: number)
	for _, light in target.Lights do
		light.Enabled = on
	end
	for _, beam in target.Beams do
		beam.Enabled = on and preset.Beams
	end
	for i, part in target.Neon do
		local base = target.NeonColors[i]
		part.Color = if on then base else base:Lerp(Color3.new(0, 0, 0), 0.82 * level)
	end
	for i, gui in target.Guis do
		gui.Brightness = if on then target.GuiBrightness[i] else target.GuiBrightness[i] * (1 - 0.85 * level)
	end
end

local function runFlicker(instance: Instance)
	local target = collectFlicker(instance)
	local isSign = instance:GetAttribute("FlickerStyle") == "Sign"
	task.spawn(function()
		while instance.Parent do
			-- Long stable stretch, then a burst of stutters.
			task.wait(if isSign then rng:NextNumber(5, 14) else rng:NextNumber(2.5, 8))
			local bursts = rng:NextInteger(2, if isSign then 4 else 7)
			for _ = 1, bursts do
				if not instance.Parent then
					return
				end
				setFlickerOn(target, false, rng:NextNumber(0.6, 1))
				task.wait(rng:NextNumber(0.03, 0.11))
				setFlickerOn(target, true, 1)
				task.wait(rng:NextNumber(0.04, 0.25))
			end
			-- Occasional long dropout on bad lamps.
			if not isSign and rng:NextNumber() < 0.18 then
				setFlickerOn(target, false, 1)
				task.wait(rng:NextNumber(0.4, 1.4))
				setFlickerOn(target, true, 1)
			end
		end
	end)
end

--------------------------------------------------------------------------------
-- Lightning
--------------------------------------------------------------------------------
local function runLightning()
	task.spawn(function()
		local interval = Config.Weather.LightningInterval
		while true do
			task.wait(rng:NextNumber(interval.Min, interval.Max))
			if preset.Lightning then
				local strength = rng:NextNumber(0.6, 1.25)
				hooks.Flash(1.1 * strength)
				task.wait(rng:NextNumber(0.07, 0.14))
				hooks.Flash(0.65 * strength)
				if rng:NextNumber() < 0.5 then
					task.wait(rng:NextNumber(0.12, 0.25))
					hooks.Flash(0.4 * strength)
				end
				local delay = Config.Weather.ThunderDelay
				task.delay(rng:NextNumber(delay.Min, delay.Max), hooks.Thunder, strength)
			end
		end
	end)
end

--------------------------------------------------------------------------------
-- Car idle
--------------------------------------------------------------------------------
local function bindCar()
	task.spawn(function()
		local safehouse = Workspace:WaitForChild(Config.World.SafehouseName, 60)
		local car = safehouse and safehouse:WaitForChild(Config.World.CarName, 30)
		local root = car and car:WaitForChild("Root", 30)
		if root and root:IsA("BasePart") and root.Anchored then
			carRoot = root
			carBase = root.CFrame
		end
	end)
end

local function idleCar()
	local root = carRoot
	local base = carBase
	local camera = Workspace.CurrentCamera
	if not root or not base or not camera then
		return
	end
	if (camera.CFrame.Position - base.Position).Magnitude > 140 then
		return
	end
	local t = os.clock()
	-- Muscle-car cam lope (~2.2 Hz) on top of high-frequency rumble.
	local lope = math.sin(t * 2.2 * 2 * math.pi) * math.sin(t * 0.7) * 0.5 + 0.5
	local rumble = math.noise(t * 22, 0.3) * 0.012
	local roll = math.noise(t * 17, 4.1) * 0.0016 + (lope - 0.5) * 0.0012
	local pitch = math.noise(t * 19, 9.2) * 0.0012
	root.CFrame = base * CFrame.new(0, rumble + lope * 0.004, 0) * CFrame.Angles(pitch, 0, roll)

	local engine = hooks.EngineSound()
	if engine then
		local def = Config.Audio.EngineIdle
		engine.PlaybackSpeed = def.Speed * (0.97 + lope * 0.05)
	end
end

--------------------------------------------------------------------------------
-- Quality
--------------------------------------------------------------------------------
local function applyTagged(tag: string, apply: (Instance) -> ())
	for _, instance in CollectionService:GetTagged(tag) do
		apply(instance)
	end
end

local function applyPresetToInstance(tag: string, instance: Instance)
	if tag == "GroundMist" and instance:IsA("ParticleEmitter") then
		instance.Enabled = preset.GroundMist
	elseif tag == "VolumetricBeam" and instance:IsA("Beam") then
		instance.Enabled = preset.Beams
	elseif tag == "ExhaustSmoke" and instance:IsA("ParticleEmitter") then
		instance.Enabled = preset.ExhaustSmoke
	elseif tag == "ShadowLight" and instance:IsA("Light") then
		instance.Shadows = preset.LightShadows
	end
end

local QUALITY_TAGS = { "GroundMist", "VolumetricBeam", "ExhaustSmoke", "ShadowLight" }

function AtmosphereController.applyQuality(quality: Types.QualityLevel)
	preset = Config.Quality[quality] or Config.Quality.High
	if rainEmitter then
		rainEmitter.Rate = preset.RainRate
		splashEmitter.Rate = preset.RainRate * 0.35
		splashEmitter.Enabled = preset.Splashes
	end
	for _, tag in QUALITY_TAGS do
		applyTagged(tag, function(instance: Instance)
			applyPresetToInstance(tag, instance)
		end)
	end
end

function AtmosphereController.init(injected: Hooks)
	hooks = injected
	local folder = Instance.new("Folder")
	folder.Name = "ClientFX"
	folder.Parent = Workspace
	fxFolder = folder

	buildRain()
	refreshRayFilter()

	for _, instance in CollectionService:GetTagged("FlickerLight") do
		runFlicker(instance)
	end
	CollectionService:GetInstanceAddedSignal("FlickerLight"):Connect(runFlicker)

	-- Late-streamed tagged instances still get the active preset.
	for _, tag in QUALITY_TAGS do
		CollectionService:GetInstanceAddedSignal(tag):Connect(function(instance: Instance)
			applyPresetToInstance(tag, instance)
		end)
	end

	runLightning()
	bindCar()

	RunService:BindToRenderStep("Atmosphere", Enum.RenderPriority.Camera.Value + 10, function(dt: number)
		followCamera(dt)
		idleCar()
	end)
end

return AtmosphereController
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000035"><Properties><string name="Name">AudioController</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	AudioController
	SoundGroups (UI / Ambience / World), 2D UI one-shots with pitch variance,
	looping rain bed, distant thunder, and the 3D engine idle on the car.
	Any Config.Audio entry with an empty Id is skipped cleanly.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)

local AudioController = {}

local groups: { [string]: SoundGroup } = {}
local sounds: { [string]: Sound } = {}
local rng = Random.new()

local function ensureGroup(name: string, volume: number): SoundGroup
	local existing = SoundService:FindFirstChild(name)
	if existing and existing:IsA("SoundGroup") then
		return existing
	end
	local group = Instance.new("SoundGroup")
	group.Name = name
	group.Volume = volume
	group.Parent = SoundService
	return group
end

local function makeSound(name: string, parent: Instance): Sound?
	local def = Config.Audio[name]
	if not def or def.Id == "" then
		return nil
	end
	local sound = Instance.new("Sound")
	sound.Name = name
	sound.SoundId = def.Id
	sound.Volume = def.Volume
	sound.PlaybackSpeed = def.Speed
	sound.SoundGroup = groups[def.Group]
	sound.Parent = parent
	sounds[name] = sound
	return sound
end

function AudioController.init()
	groups.UI = ensureGroup("UI", 1)
	groups.Ambience = ensureGroup("Ambience", 1)
	groups.World = ensureGroup("World", 1)

	local missing: { string } = {}
	for name, def in Config.Audio do
		if def.Id == "" then
			table.insert(missing, name)
		end
	end
	if #missing > 0 then
		table.sort(missing)
		warn(
			"[Audio] No asset id set for: "
				.. table.concat(missing, ", ")
				.. " — paste rbxassetid:// ids you own into Shared.Config.Audio to enable them."
		)
	end

	-- 2D one-shots: everything except the loops and per-shot gunfire (WeaponFx
	-- spawns those positionally at the muzzle).
	local SPECIAL = { RainLoop = true, EngineIdle = true, FireRifle = true, FireSMG = true, FirePistol = true }
	for name in Config.Audio do
		if not SPECIAL[name] then
			makeSound(name, SoundService)
		end
	end

	local rain = makeSound("RainLoop", SoundService)
	if rain then
		rain.Looped = true
		rain:Play()
	end

	-- Engine idle lives on the car so it falls off with distance.
	task.spawn(function()
		local safehouse = Workspace:WaitForChild(Config.World.SafehouseName, 60)
		local car = safehouse and safehouse:WaitForChild(Config.World.CarName, 30)
		local bay = car and car:WaitForChild("EngineBay", 30)
		if bay and bay:IsA("BasePart") then
			local engine = makeSound("EngineIdle", bay)
			if engine then
				engine.Looped = true
				engine.RollOffMode = Enum.RollOffMode.InverseTapered
				engine.RollOffMinDistance = 6
				engine.RollOffMaxDistance = 90
				engine:Play()
			end
		end
	end)
end

-- Fire-and-forget 2D one-shot with optional pitch variance (±fraction).
function AudioController.play(name: string, variance: number?)
	local sound = sounds[name]
	local def = Config.Audio[name]
	if not sound or not def then
		return
	end
	local v = variance or 0.04
	sound.PlaybackSpeed = def.Speed * (1 + rng:NextNumber(-v, v))
	SoundService:PlayLocalSound(sound)
end

function AudioController.thunder(intensity: number)
	local sound = sounds.Thunder
	local def = Config.Audio.Thunder
	if not sound or not def then
		return
	end
	sound.Volume = def.Volume * math.clamp(intensity, 0.2, 1.2)
	sound.PlaybackSpeed = def.Speed * rng:NextNumber(0.85, 1.05)
	sound:Play()
end

function AudioController.get(name: string): Sound?
	return sounds[name]
end

-- Ducks the world/ambience while in the menu so UI reads cleanly.
function AudioController.setMenuMix(inMenu: boolean, duration: number?)
	local info = TweenInfo.new(duration or 1.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
	local ambience = groups.Ambience
	local world = groups.World
	if ambience then
		TweenService:Create(ambience, info, { Volume = if inMenu then 0.75 else 1 }):Play()
	end
	if world then
		TweenService:Create(world, info, { Volume = if inMenu then 0.8 else 1 }):Play()
	end
end

return AudioController
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000036"><Properties><string name="Name">CharacterPoser</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	CharacterPoser
	Procedural third-person poses for EVERY character, solved locally on each
	client (no animation assets needed):

	  • Upper body follows aim pitch (Waist + Neck Motor6D C0 offsets)
	  • The weapon is welded into the right hand by the server. A target frame
	    on the UpperTorso (hold offsets: hip ↔ ADS blend, pitch, sprint
	    low-ready, recoil kick) is where the right-arm IK (position AND
	    rotation) puts the grip, so the gun is always in the hand and aimed
	  • The left hand is IK-locked to the weapon's GripLeft (foregrip)
	  • Crouch / slide: leg IK keeps feet planted while HipHeight drops, with a
	    procedural crouch-walk step cycle driven by velocity

	Inputs come from replicated character attributes (Stance, Sprinting,
	AimPitch, Aiming, WeaponClass). Your own character reads the live camera
	pitch instead, so it never lags behind your aim.

	Requires R15 rigs (Game Settings → Avatar → R15). R6 characters are skipped.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Spring = require(Shared.Spring)
local WeaponBuilder = require(Shared.Builders.WeaponBuilder)

local TacticalCamera = require(script.Parent.TacticalCamera)

local CharacterPoser = {}

local localPlayer = Players.LocalPlayer
local COMBAT = Config.Combat

type Record = {
	Character: Model,
	Humanoid: Humanoid,
	Root: BasePart,
	UpperTorso: BasePart,
	Waist: Motor6D?,
	Neck: Motor6D?,
	WaistC0: CFrame,
	NeckC0: CFrame,
	BaseHip: number,
	IsLocal: boolean,
	Pitch: number,
	Aim: number,
	Crouch: number,
	Slide: number,
	Sprint: number,
	StepPhase: number,
	Kick: Spring.Spring?,
	WeaponModel: Model?,
	ArmRight: IKControl,
	ArmLeft: IKControl,
	WeaponTarget: Attachment,
	LegRight: IKControl,
	LegLeft: IKControl,
	FootRight: Attachment,
	FootLeft: Attachment,
	Instances: { Instance },
}

local records: { [Model]: Record } = {}
local localAiming = false

local function smooth(current: number, target: number, rate: number, dt: number): number
	return current + (target - current) * (1 - math.exp(-rate * dt))
end

local function newAttachment(parent: BasePart, name: string, position: Vector3, list: { Instance }): Attachment
	local attachment = Instance.new("Attachment")
	attachment.Name = name
	attachment.Position = position
	attachment.Parent = parent
	table.insert(list, attachment)
	return attachment
end

local function newIK(
	record: { Humanoid: Humanoid },
	name: string,
	chainRoot: BasePart,
	endEffector: Instance,
	pole: Attachment,
	list: { Instance },
	ikType: Enum.IKControlType?,
	priority: number?
): IKControl
	local ik = Instance.new("IKControl")
	ik.Name = name
	ik.Type = ikType or Enum.IKControlType.Position
	ik.ChainRoot = chainRoot
	ik.EndEffector = endEffector
	ik.Pole = pole
	ik.Priority = priority or 1
	ik.Weight = 0
	ik.Enabled = false
	pcall(function()
		(ik :: any).SmoothTime = 0.03
	end)
	ik.Parent = record.Humanoid
	table.insert(list, ik)
	return ik
end

local function part(model: Model, name: string): BasePart?
	local found = model:FindFirstChild(name)
	return if found and found:IsA("BasePart") then found else nil
end

local function register(character: Model, isLocal: boolean)
	if records[character] then
		return
	end
	local humanoid = character:WaitForChild("Humanoid", 10)
	local root = character:WaitForChild("HumanoidRootPart", 10)
	local upper = character:WaitForChild("UpperTorso", 10)
	if not humanoid or not humanoid:IsA("Humanoid") or not root or not root:IsA("BasePart") or not upper or not upper:IsA("BasePart") then
		return -- R6 or broken rig: no procedural pose
	end
	if humanoid.RigType ~= Enum.HumanoidRigType.R15 then
		return
	end
	local rightUpperArm = part(character, "RightUpperArm")
	local rightHand = part(character, "RightHand")
	local leftUpperArm = part(character, "LeftUpperArm")
	local leftHand = part(character, "LeftHand")
	local rightUpperLeg = part(character, "RightUpperLeg")
	local rightFoot = part(character, "RightFoot")
	local leftUpperLeg = part(character, "LeftUpperLeg")
	local leftFoot = part(character, "LeftFoot")
	if not (rightUpperArm and rightHand and leftUpperArm and leftHand and rightUpperLeg and rightFoot and leftUpperLeg and leftFoot) then
		return
	end

	local waist = upper:FindFirstChild("Waist")
	local head = part(character, "Head")
	local neck = if head then head:FindFirstChild("Neck") else nil
	local instances: { Instance } = {}
	local holder = { Humanoid = humanoid }

	local armPoleR = newAttachment(upper, "PoseArmPoleR", Vector3.new(1.2, -2.0, 0.2), instances)
	local armPoleL = newAttachment(upper, "PoseArmPoleL", Vector3.new(-1.2, -2.0, -0.2), instances)
	local weaponTarget = newAttachment(upper, "PoseWeaponTarget", Vector3.new(0.35, 0, -0.75), instances)
	local gripAttachment = rightHand:FindFirstChild("RightGripAttachment")
	local rightEffector: Instance = if gripAttachment and gripAttachment:IsA("Attachment") then gripAttachment else rightHand
	local kneePoleR = newAttachment(root, "PoseKneePoleR", Vector3.new(0.6, -1, -3), instances)
	local kneePoleL = newAttachment(root, "PoseKneePoleL", Vector3.new(-0.6, -1, -3), instances)
	local footR = newAttachment(root, "PoseFootR", Vector3.new(0.45, -3, 0), instances)
	local footL = newAttachment(root, "PoseFootL", Vector3.new(-0.45, -3, 0), instances)

	local legR = newIK(holder, "PoseLegR", rightUpperLeg, rightFoot, kneePoleR, instances)
	local legL = newIK(holder, "PoseLegL", leftUpperLeg, leftFoot, kneePoleL, instances)
	legR.Target = footR
	legL.Target = footL

	local record: Record = {
		Character = character,
		Humanoid = humanoid,
		Root = root,
		UpperTorso = upper,
		Waist = if waist and waist:IsA("Motor6D") then waist else nil,
		Neck = if neck and neck:IsA("Motor6D") then neck else nil,
		WaistC0 = if waist and waist:IsA("Motor6D") then waist.C0 else CFrame.identity,
		NeckC0 = if neck and neck:IsA("Motor6D") then neck.C0 else CFrame.identity,
		BaseHip = humanoid.HipHeight,
		IsLocal = isLocal,
		Pitch = 0,
		Aim = 0,
		Crouch = 0,
		Slide = 0,
		Sprint = 0,
		StepPhase = 0,
		Kick = if isLocal then Spring.new(Vector3.zero, 11, 0.5) else nil,
		WeaponModel = nil,
		-- Right hand solves first (higher priority): it carries the weapon.
		ArmRight = newIK(holder, "PoseArmR", rightUpperArm, rightEffector, armPoleR, instances, Enum.IKControlType.Transform, 3),
		ArmLeft = newIK(holder, "PoseArmL", leftUpperArm, leftHand, armPoleL, instances, Enum.IKControlType.Position, 2),
		WeaponTarget = weaponTarget,
		LegRight = legR,
		LegLeft = legL,
		FootRight = footR,
		FootLeft = footL,
		Instances = instances,
	}
	record.ArmRight.Target = weaponTarget
	records[character] = record

	character.AncestryChanged:Connect(function(_, parent)
		if parent == nil then
			for _, inst in record.Instances do
				inst:Destroy()
			end
			records[character] = nil
		end
	end)
end

local function attrNumber(model: Model, name: string): number
	local v = model:GetAttribute(name)
	return if typeof(v) == "number" then v else 0
end

local function poseWeapon(record: Record, dt: number)
	local character = record.Character
	local model = character:FindFirstChild("EquippedWeapon")
	if not model or not model:IsA("Model") then
		record.ArmRight.Enabled = false
		record.ArmLeft.Enabled = false
		record.WeaponModel = nil
		return
	end

	if record.WeaponModel ~= model then
		local handles = WeaponBuilder.resolve(model)
		if not handles then
			return
		end
		record.WeaponModel = model
		record.ArmLeft.Target = handles.GripLeft
	end
	record.ArmRight.Enabled = true
	record.ArmLeft.Enabled = true
	record.ArmRight.Weight = 1
	record.ArmLeft.Weight = 1

	local class = character:GetAttribute("WeaponClass")
	local offsets = COMBAT.HoldOffsets[if typeof(class) == "string" then class else "RIFLE"] or COMBAT.HoldOffsets.RIFLE
	local position = offsets.Hip:Lerp(offsets.Ads, record.Aim)
	local pivot = COMBAT.PosePivot

	local kickBack, kickRot = 0, 0
	local kick = record.Kick
	if kick then
		kick.Target = Vector3.zero
		local k = kick:update(dt)
		kickBack, kickRot = k.X, k.Y
	end

	-- Low-ready when sprinting: barrel down and across the body.
	local sprint = record.Sprint
	local rotation = CFrame.Angles(record.Pitch * 0.55 - sprint * 0.75 + kickRot, sprint * 0.55, sprint * 0.2)
	-- Where the grip goes: -Z = barrel direction.
	record.WeaponTarget.CFrame = CFrame.new(pivot) * rotation * CFrame.new(position - pivot + Vector3.new(0, 0, kickBack))
end

local function poseLegs(record: Record, dt: number)
	local crouch = record.Crouch
	local enabled = crouch > 0.02
	record.LegRight.Enabled = enabled
	record.LegLeft.Enabled = enabled
	if not enabled then
		return
	end
	record.LegRight.Weight = crouch
	record.LegLeft.Weight = crouch

	local root = record.Root
	local hip = record.BaseHip - Config.Movement.CrouchHipDrop * crouch
	local groundY = -(hip + root.Size.Y * 0.5) + 0.12

	local velocity = root.AssemblyLinearVelocity
	local localVel = root.CFrame:VectorToObjectSpace(Vector3.new(velocity.X, 0, velocity.Z))
	local speed = localVel.Magnitude
	record.StepPhase += speed * dt * 1.4
	local stride = math.clamp(speed / 7, 0, 1) * 0.55 * (1 - record.Slide)
	local dir = if speed > 0.5 then localVel.Unit else Vector3.zero

	local function foot(attachment: Attachment, side: number, phaseOffset: number, idleZ: number, slideZ: number)
		local phase = record.StepPhase + phaseOffset
		local stepOffset = dir * math.sin(phase) * stride
		local lift = math.max(0, math.cos(phase)) * 0.3 * math.clamp(stride * 2, 0, 1)
		local z = idleZ + (slideZ - idleZ) * record.Slide
		attachment.Position = Vector3.new(side * 0.45 + stepOffset.X, groundY + lift + record.Slide * 0.25 * (if side > 0 then 1 else 0), z + stepOffset.Z)
	end
	foot(record.FootRight, 1, 0, -0.35, -1.2)
	foot(record.FootLeft, -1, math.pi, 0.25, -0.5)
end

local function step(dt: number)
	for character, record in records do
		if not character.Parent or record.Humanoid.Health <= 0 then
			record.ArmRight.Enabled = false
			record.ArmLeft.Enabled = false
			record.LegRight.Enabled = false
			record.LegLeft.Enabled = false
			continue
		end

		local pitchTarget = if record.IsLocal and TacticalCamera.isAttached()
			then TacticalCamera.getPitch()
			else attrNumber(character, "AimPitch")
		record.Pitch = smooth(record.Pitch, pitchTarget, if record.IsLocal then 30 else 12, dt)

		local aimTarget = if record.IsLocal then (if localAiming then 1 else 0) else (if character:GetAttribute("Aiming") == true then 1 else 0)
		record.Aim = smooth(record.Aim, aimTarget, 14, dt)

		local stance = character:GetAttribute("Stance")
		record.Crouch = smooth(record.Crouch, if stance == "Crouch" or stance == "Slide" then 1 else 0, 12, dt)
		record.Slide = smooth(record.Slide, if stance == "Slide" then 1 else 0, 14, dt)
		record.Sprint = smooth(record.Sprint, if character:GetAttribute("Sprinting") == true then 1 else 0, 10, dt)

		local waist = record.Waist
		if waist then
			waist.C0 = record.WaistC0 * CFrame.Angles(record.Pitch * 0.45 * (1 - record.Sprint * 0.6), 0, 0)
		end
		local neck = record.Neck
		if neck then
			neck.C0 = record.NeckC0 * CFrame.Angles(record.Pitch * 0.35, 0, 0)
		end

		poseWeapon(record, dt)
		poseLegs(record, dt)
	end
end

local function watchPlayer(player: Player)
	local isLocal = player == localPlayer
	if player.Character then
		task.spawn(register, player.Character, isLocal)
	end
	player.CharacterAdded:Connect(function(character: Model)
		register(character, isLocal)
	end)
end

function CharacterPoser.init()
	for _, player in Players:GetPlayers() do
		watchPlayer(player)
	end
	Players.PlayerAdded:Connect(watchPlayer)
	-- PreSimulation runs after the Animator, so these C0 offsets layer on top
	-- of the default animations and IK solves on the final pose.
	RunService.PreSimulation:Connect(step)
end

function CharacterPoser.setLocalAim(aiming: boolean)
	localAiming = aiming
end

-- Local weapon kick: back = studs pushed toward the shoulder, rise = radians.
function CharacterPoser.kick(back: number, rise: number)
	local character = localPlayer.Character
	local record = if character then records[character] else nil
	local spring = if record then record.Kick else nil
	if spring then
		spring:impulse(Vector3.new(back * 30, rise * 30, 0))
	end
end

return CharacterPoser
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000037"><Properties><string name="Name">CinematicGrade</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	CinematicGrade
	Client-side owner of the post-processing stack created by the server's
	LightingService. Every frame it writes:

		value = lerp(menuGrade, gameplayGrade, blend) + transient offsets

	• blend 0 = menu (heavy DOF focused on the current shot subject, darker,
	  punchier), blend 1 = gameplay grade from Config.Lighting.
	• Menu focus distance/radius glide on a spring when the shot changes.
	• flash() adds a decaying exposure spike (lightning).
	• Quality presets toggle DOF / SunRays and scale Bloom.

	Client writes to replicated Lighting objects stay local to this player.
]]

local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Spring = require(Shared.Spring)
local Types = require(Shared.Types)

local CinematicGrade = {}

local NAMES = {
	ColorCorrection = "Grade_ColorCorrection",
	Bloom = "Grade_Bloom",
	DepthOfField = "Grade_DepthOfField",
	SunRays = "Grade_SunRays",
}

local cc: ColorCorrectionEffect? = nil
local bloom: BloomEffect? = nil
local dof: DepthOfFieldEffect? = nil
local rays: SunRaysEffect? = nil

local blend = 0
local flashOffset = 0
local preset: Types.QualityPreset = Config.Quality.High
local focusSpring = Spring.new(Vector3.new(20, 9, 0), 0.9, 1)

local function lerp(a: number, b: number, t: number): number
	return a + (b - a) * t
end

local function find(name: string, className: string): Instance?
	local inst = Lighting:WaitForChild(name, 10)
	if inst and inst.ClassName == className then
		return inst
	end
	warn("[CinematicGrade] missing Lighting effect:", name)
	return nil
end

local function step(dt: number)
	local G = Config.Lighting
	local M = Config.MenuGrade
	local focus = focusSpring:update(dt)
	local t = blend

	local depth = dof
	if depth then
		depth.Enabled = preset.DepthOfField
		depth.FocusDistance = lerp(focus.X, G.DepthOfField.FocusDistance, t)
		depth.InFocusRadius = lerp(focus.Y, G.DepthOfField.InFocusRadius, t)
		depth.FarIntensity = lerp(M.FarIntensity, G.DepthOfField.FarIntensity, t)
		depth.NearIntensity = lerp(M.NearIntensity, G.DepthOfField.NearIntensity, t)
	end

	local grade = cc
	if grade then
		grade.Contrast = lerp(M.Contrast, G.ColorCorrection.Contrast, t)
		grade.Saturation = lerp(M.Saturation, G.ColorCorrection.Saturation, t)
	end

	local glow = bloom
	if glow then
		glow.Intensity = G.Bloom.Intensity * preset.BloomScale * (1 + flashOffset * 0.25)
	end

	local sun = rays
	if sun then
		sun.Enabled = preset.SunRays
	end

	Lighting.ExposureCompensation = lerp(M.ExposureCompensation, G.ExposureCompensation, t) + flashOffset
	flashOffset *= math.exp(-dt * 9)
	if flashOffset < 0.002 then
		flashOffset = 0
	end
end

function CinematicGrade.init()
	cc = find(NAMES.ColorCorrection, "ColorCorrectionEffect") :: any
	bloom = find(NAMES.Bloom, "BloomEffect") :: any
	dof = find(NAMES.DepthOfField, "DepthOfFieldEffect") :: any
	rays = find(NAMES.SunRays, "SunRaysEffect") :: any
	RunService:BindToRenderStep("CinematicGrade", Enum.RenderPriority.Last.Value, step)
end

-- 0 = menu grade, 1 = gameplay grade.
function CinematicGrade.setBlend(alpha: number)
	blend = math.clamp(alpha, 0, 1)
end

function CinematicGrade.getBlend(): number
	return blend
end

function CinematicGrade.setMenuFocus(distance: number, radius: number, instant: boolean?)
	local target = Vector3.new(distance, radius, 0)
	if instant then
		focusSpring:reset(target)
	else
		focusSpring.Target = target
	end
end

function CinematicGrade.flash(amount: number)
	flashOffset = math.max(flashOffset, amount)
end

function CinematicGrade.applyQuality(quality: Types.QualityLevel)
	preset = Config.Quality[quality] or Config.Quality.High
end

return CinematicGrade
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000038"><Properties><string name="Name">LoadoutDisplay</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	LoadoutDisplay
	Shows YOUR selected weapons lying on the safehouse workbench (client-local
	models at Safehouse.Workbench.WeaponDisplays). They rebuild with a small
	drop-in whenever the loadout changes, so the LOADOUT camera shot always
	shows the real kit you'll deploy with.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Types = require(Shared.Types)
local WeaponBuilder = require(Shared.Builders.WeaponBuilder)

local SettingsController = require(script.Parent.SettingsController)

local LoadoutDisplay = {}

-- Lying on the left side, barrel toward +Z, sights facing the alley (-X).
local LAY_FLAT = CFrame.Angles(0, math.pi, 0) * CFrame.Angles(0, 0, math.rad(-90))
local OFFSETS: { [Types.WeaponSlot]: CFrame } = {
	Primary = CFrame.new(-0.45, 0, -1.0),
	Secondary = CFrame.new(0.7, 0, -1.6),
}

local anchors: { [Types.WeaponSlot]: BasePart } = {}
local shown: { [Types.WeaponSlot]: { Id: string, Model: Model } } = {}

local function dropIn(model: Model, target: CFrame)
	local elapsed = 0
	local connection: RBXScriptConnection
	connection = RunService.RenderStepped:Connect(function(dt: number)
		elapsed += dt
		local t = math.clamp(elapsed / 0.35, 0, 1)
		local bounce = 1 - (1 - t) ^ 3
		if model.Parent == nil then
			connection:Disconnect()
			return
		end
		model:PivotTo(target * CFrame.new(0, (1 - bounce) * 0.6, 0) * CFrame.Angles(0, (1 - bounce) * 0.3, 0))
		if t >= 1 then
			connection:Disconnect()
		end
	end)
end

local function show(slot: Types.WeaponSlot, weaponId: string, animate: boolean)
	local anchor = anchors[slot]
	if not anchor or not WeaponBuilder.has(weaponId) then
		return
	end
	local existing = shown[slot]
	if existing and existing.Id == weaponId then
		return
	end
	if existing then
		existing.Model:Destroy()
	end
	local target = anchor.CFrame * OFFSETS[slot] * LAY_FLAT
	local handles = WeaponBuilder.build(weaponId, target, true)
	handles.Model.Name = "Display_" .. weaponId
	handles.Model.Parent = Workspace
	shown[slot] = { Id = weaponId, Model = handles.Model }
	if animate then
		dropIn(handles.Model, target)
	end
end

local function apply(loadout: Types.Loadout, animate: boolean)
	show("Primary", loadout.Primary, animate)
	show("Secondary", loadout.Secondary, animate)
end

function LoadoutDisplay.init()
	task.spawn(function()
		local safehouse = Workspace:WaitForChild(Config.World.SafehouseName, 60)
		local bench = safehouse and safehouse:WaitForChild("Workbench", 30)
		local displays = bench and bench:WaitForChild("WeaponDisplays", 30)
		if not displays then
			warn("[LoadoutDisplay] Workbench.WeaponDisplays not found")
			return
		end
		local primary = displays:WaitForChild("Display_Primary", 10)
		local secondary = displays:WaitForChild("Display_Secondary", 10)
		if primary and primary:IsA("BasePart") then
			anchors.Primary = primary
		end
		if secondary and secondary:IsA("BasePart") then
			anchors.Secondary = secondary
		end
		apply(SettingsController.getLoadout(), false)
		SettingsController.LoadoutChanged:Connect(function(loadout: any)
			apply(loadout, true)
		end)
	end)
end

return LoadoutDisplay
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000039"><Properties><string name="Name">MenuCamera</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	MenuCamera
	Cinematic camera for the safehouse menu.

	final = shotBase(eased between CameraRig parts) * dolly * breathing * parallax

	• Shots are invisible parts under Safehouse.CameraRig. Attributes on each
	  part (FieldOfView, FocusDistance, InFocusRadius) drive lens + DOF, so a
	  designer can re-frame shots in Studio without touching code.
	• Breathing = layered Perlin noise on position + rotation (handheld feel).
	• Parallax = spring-smoothed rotation toward the mouse/right stick.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Spring = require(Shared.Spring)

local CinematicGrade = require(script.Parent.CinematicGrade)

local MenuCamera = {}

local RENDER_NAME = "MenuCamera"
local C = Config.Camera.Menu

local rig: Instance? = nil
local running = false

local fromCF = CFrame.identity
local toCF = CFrame.identity
local fromFov = 38
local toFov = 38
local transitionTime = 0
local transitionDuration = 0

local dollySpring = Spring.new(Vector3.zero, 0.7, 1)
local parallaxSpring = Spring.new(Vector3.zero, C.ParallaxFrequency, 0.9)
local gamepadLook = Vector2.zero

local lastCF = CFrame.identity
local lastFov = 38

local function easeInOutQuint(t: number): number
	if t < 0.5 then
		return 16 * t * t * t * t * t
	end
	local f = -2 * t + 2
	return 1 - (f * f * f * f * f) / 2
end

local function getShot(name: string): BasePart?
	local container = rig
	if not container then
		return nil
	end
	local part = container:FindFirstChild(name)
	if part and part:IsA("BasePart") then
		return part
	end
	return nil
end

local function attrNumber(part: BasePart, name: string, fallback: number): number
	local value = part:GetAttribute(name)
	return if typeof(value) == "number" then value else fallback
end

local function currentBase(): (CFrame, number)
	if transitionDuration <= 0 then
		return toCF, toFov
	end
	local alpha = easeInOutQuint(math.clamp(transitionTime / transitionDuration, 0, 1))
	return fromCF:Lerp(toCF, alpha), fromFov + (toFov - fromFov) * alpha
end

local function step(dt: number)
	local camera = Workspace.CurrentCamera
	if not camera then
		return
	end
	camera.CameraType = Enum.CameraType.Scriptable

	if transitionDuration > 0 then
		transitionTime += dt
		if transitionTime >= transitionDuration then
			transitionDuration = 0
		end
	end
	local base, fov = currentBase()

	-- Breathing (handheld drift)
	local t = os.clock() * C.BreathSpeed
	local pos = Vector3.new(math.noise(t, 1.3), math.noise(t * 0.8, 7.1), math.noise(t * 0.7, 3.7)) * (C.BreathPosition * 2)
	local rotScale = math.rad(C.BreathRotation) * 2
	local breathRot = CFrame.Angles(
		math.noise(t * 1.2, 11.1) * rotScale,
		math.noise(t * 0.9, 5.3) * rotScale,
		math.noise(t * 0.6, 2.9) * rotScale * 0.5
	)

	-- Parallax toward pointer / right stick
	local viewport = camera.ViewportSize
	local mouse = UserInputService:GetMouseLocation()
	local nx = if viewport.X > 0 then math.clamp(mouse.X / viewport.X * 2 - 1, -1, 1) else 0
	local ny = if viewport.Y > 0 then math.clamp(mouse.Y / viewport.Y * 2 - 1, -1, 1) else 0
	if gamepadLook.Magnitude > 0.1 then
		nx, ny = gamepadLook.X, -gamepadLook.Y
	end
	parallaxSpring.Target = Vector3.new(-nx * math.rad(C.ParallaxYaw), -ny * math.rad(C.ParallaxPitch), 0)
	local parallax = parallaxSpring:update(dt)
	local dolly = dollySpring:update(dt)

	local final = base * CFrame.new(0, 0, -dolly.X) * CFrame.new(pos) * breathRot * CFrame.Angles(parallax.Y, parallax.X, 0)
	camera.CFrame = final
	camera.FieldOfView = fov
	lastCF = final
	lastFov = fov
end

function MenuCamera.init()
	local safehouse = Workspace:WaitForChild(Config.World.SafehouseName, 60)
	rig = if safehouse then safehouse:WaitForChild("CameraRig", 30) else nil
	if not rig then
		warn("[MenuCamera] Safehouse.CameraRig not found — menu camera will hold its last frame.")
	end

	UserInputService.InputChanged:Connect(function(input: InputObject)
		if input.KeyCode == Enum.KeyCode.Thumbstick2 then
			gamepadLook = Vector2.new(input.Position.X, input.Position.Y)
		end
	end)
end

-- Moves to a rig shot. instant = cut (used when entering the menu).
function MenuCamera.goTo(shotName: string, instant: boolean?)
	local shot = getShot(shotName)
	if not shot then
		return
	end
	local targetFov = attrNumber(shot, "FieldOfView", 38)
	if instant or not running then
		fromCF, toCF = shot.CFrame, shot.CFrame
		fromFov, toFov = targetFov, targetFov
		transitionDuration = 0
	else
		local currentCF, currentFov = currentBase()
		fromCF, fromFov = currentCF, currentFov
		toCF, toFov = shot.CFrame, targetFov
		transitionTime = 0
		transitionDuration = C.ShotTransitionTime
	end
	CinematicGrade.setMenuFocus(attrNumber(shot, "FocusDistance", 20), attrNumber(shot, "InFocusRadius", 8), instant)
end

function MenuCamera.start(shotName: string)
	dollySpring:reset(Vector3.zero)
	parallaxSpring:reset(Vector3.zero)
	running = false
	MenuCamera.goTo(shotName, true)
	running = true
	RunService:UnbindFromRenderStep(RENDER_NAME)
	RunService:BindToRenderStep(RENDER_NAME, Enum.RenderPriority.Camera.Value + 1, step)
	step(0)
end

function MenuCamera.stop()
	running = false
	RunService:UnbindFromRenderStep(RENDER_NAME)
end

-- Slow push-in while the server spawns the character.
function MenuCamera.pushIn(studs: number)
	dollySpring.Target = Vector3.new(studs, 0, 0)
end

function MenuCamera.getCFrame(): CFrame
	return lastCF
end

function MenuCamera.getFieldOfView(): number
	return lastFov
end

function MenuCamera.isRunning(): boolean
	return running
end

return MenuCamera
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000040"><Properties><string name="Name">MenuController</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	MenuController
	Orchestrates the safehouse menu experience:

	  enter()          CoreGui hidden, menu camera on MenuShot, UI in, input bound
	  LOADOUT/SETTINGS camera glides to the workbench / headlight shot + panel
	  DEPLOY           UI out → server spawns character → camera blends from the
	                   live menu frame into the live tactical camera (no cut),
	                   grade blends menu → gameplay, letterbox retracts
	  returnFromRaid() fade to black → back into the menu (death / extraction)
]]

local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local StarterGui = game:GetService("StarterGui")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local Signal = require(Shared.Signal)

local Controllers = script.Parent
local AudioController = require(Controllers.AudioController)
local CinematicGrade = require(Controllers.CinematicGrade)
local MenuCamera = require(Controllers.MenuCamera)
local SettingsController = require(Controllers.SettingsController)
local TacticalCamera = require(Controllers.TacticalCamera)
local MenuUI = require(Controllers.Parent.UI.MenuUI)

local player = Players.LocalPlayer

local MenuController = {}
MenuController.Deployed = Signal.new() -- (character) after the camera hand-off
MenuController.Entered = Signal.new() -- menu became active (initial load or back from a raid)

local INPUT_ACTION = "ZabourMenuNavigation"
local TRANSITION_STEP = "ZabourDeployTransition"

local ui: MenuUI.MenuUI
local active = false
local busy = false
local deployed = false

local function hasKey(list: { Enum.KeyCode }, key: Enum.KeyCode): boolean
	return table.find(list, key) ~= nil
end

local function setCoreGui(inMenu: boolean)
	pcall(function()
		StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.All, false)
		if not inMenu then
			for _, coreType in Config.CoreGui.Gameplay do
				StarterGui:SetCoreGuiEnabled(coreType, true)
			end
		end
	end)
end

local function smootherstep(t: number): number
	local x = math.clamp(t, 0, 1)
	return x * x * x * (x * (x * 6 - 15) + 10)
end

--------------------------------------------------------------------------------
-- Panels / camera shots
--------------------------------------------------------------------------------
local function closePanel()
	if ui:getPanel() == nil then
		return
	end
	ui:openPanel(nil)
	MenuCamera.goTo("MenuShot")
end

local function togglePanel(name: "Loadout" | "Settings")
	if ui:getPanel() == name then
		closePanel()
		return
	end
	ui:openPanel(name)
	MenuCamera.goTo(name .. "Shot")
end

--------------------------------------------------------------------------------
-- Input
--------------------------------------------------------------------------------
local function onMenuInput(_: string, state: Enum.UserInputState, input: InputObject): Enum.ContextActionResult
	if state ~= Enum.UserInputState.Begin or not active or busy then
		return Enum.ContextActionResult.Pass
	end
	local key = input.KeyCode
	local binds = Config.Keybinds
	if hasKey(binds.MenuUp, key) then
		ui:navigate(-1)
	elseif hasKey(binds.MenuDown, key) then
		ui:navigate(1)
	elseif hasKey(binds.MenuLeft, key) then
		ui:adjust(-1)
	elseif hasKey(binds.MenuRight, key) then
		ui:adjust(1)
	elseif hasKey(binds.MenuSelect, key) then
		ui:activate()
	elseif hasKey(binds.MenuBack, key) then
		if ui:getPanel() then
			AudioController.play("UIBack")
			closePanel()
		end
	else
		return Enum.ContextActionResult.Pass
	end
	return Enum.ContextActionResult.Sink
end

local function bindInput()
	local keys: { Enum.KeyCode } = {}
	local binds = Config.Keybinds
	for _, list in { binds.MenuUp, binds.MenuDown, binds.MenuLeft, binds.MenuRight, binds.MenuSelect, binds.MenuBack } do
		for _, key in list do
			if not table.find(keys, key) then
				table.insert(keys, key)
			end
		end
	end
	ContextActionService:BindActionAtPriority(INPUT_ACTION, onMenuInput, false, Enum.ContextActionPriority.High.Value, table.unpack(keys))
end

local function unbindInput()
	ContextActionService:UnbindAction(INPUT_ACTION)
end

--------------------------------------------------------------------------------
-- Deploy
--------------------------------------------------------------------------------
local function waitForDeployedCharacter(timeout: number): Model?
	local started = os.clock()
	local seenDeploying = false
	while os.clock() - started < timeout do
		local state = player:GetAttribute("State")
		local character = player.Character
		if state == "Deploying" then
			seenDeploying = true
		elseif state == "Deployed" and character and character:FindFirstChild("HumanoidRootPart") then
			return character
		elseif state == "Menu" and (seenDeploying or os.clock() - started > 3) then
			return nil -- rejected or failed server-side
		end
		task.wait()
	end
	return nil
end

local function blendIntoTactical()
	local camera = Workspace.CurrentCamera
	local fromCF = MenuCamera.getCFrame()
	local fromFov = MenuCamera.getFieldOfView()
	MenuCamera.stop()

	local duration = Config.Camera.DeployTransitionTime
	local elapsed = 0
	local finished = false
	UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
	UserInputService.MouseIconEnabled = false

	RunService:BindToRenderStep(TRANSITION_STEP, Enum.RenderPriority.Camera.Value + 1, function(dt: number)
		elapsed += dt
		local alpha = smootherstep(elapsed / duration)
		local targetCF, targetFov = TacticalCamera.evaluate(dt)
		if camera then
			camera.CameraType = Enum.CameraType.Scriptable
			camera.CFrame = fromCF:Lerp(targetCF, alpha)
			camera.FieldOfView = fromFov + (targetFov - fromFov) * alpha
		end
		UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
		CinematicGrade.setBlend(alpha)
		if elapsed >= duration then
			finished = true
		end
	end)
	while not finished do
		RunService.RenderStepped:Wait()
	end
	RunService:UnbindFromRenderStep(TRANSITION_STEP)
	CinematicGrade.setBlend(1)
	TacticalCamera.start()
end

local function deploy()
	if busy or not active then
		return
	end
	busy = true
	ui:hide(0.7)
	MenuCamera.goTo("MenuShot")
	MenuCamera.pushIn(Config.Camera.Menu.DeployPushIn)
	AudioController.setMenuMix(false, 2.5)
	Net.event(Net.Events.RequestDeploy):FireServer()

	local character = waitForDeployedCharacter(Config.Deploy.SpawnTimeout)
	if character then
		TacticalCamera.attach(character)
	end
	if not character or not TacticalCamera.isAttached() then
		MenuCamera.pushIn(0)
		AudioController.setMenuMix(true)
		ui:show(false)
		ui:toast("DEPLOY FAILED — TRY AGAIN")
		busy = false
		return
	end

	active = false
	unbindInput()
	blendIntoTactical()
	setCoreGui(false)
	deployed = true
	busy = false
	MenuController.Deployed:Fire(character)
end

--------------------------------------------------------------------------------
-- Public
--------------------------------------------------------------------------------
function MenuController.init()
	ui = MenuUI.new({
		DisplayName = player.DisplayName,
		Settings = SettingsController.get(),
		Loadout = SettingsController.getLoadout(),
		PlaySound = function(name: string)
			AudioController.play(name)
		end,
	})

	ui.OptionActivated:Connect(function(id: string)
		if id == "Deploy" then
			deploy()
		elseif id == "Loadout" then
			togglePanel("Loadout")
		elseif id == "Settings" then
			togglePanel("Settings")
		end
	end)
	ui.LoadoutSelected:Connect(function(slot: any, weaponId: any)
		SettingsController.setLoadout(slot, weaponId)
	end)
	ui.SettingChanged:Connect(function(key: any, value: any)
		SettingsController.set(key, value)
	end)
	SettingsController.LoadoutChanged:Connect(function(loadout: any)
		ui:setLoadout(loadout)
	end)
	SettingsController.Changed:Connect(function(settings: any)
		ui:setSettings(settings)
	end)
end

function MenuController.enter(instant: boolean)
	active = true
	busy = false
	deployed = false
	setCoreGui(true)
	TacticalCamera.detach()
	UserInputService.MouseBehavior = Enum.MouseBehavior.Default
	UserInputService.MouseIconEnabled = true
	CinematicGrade.setBlend(0)
	MenuCamera.start("MenuShot")
	AudioController.setMenuMix(true, if instant then 0.01 else 1.5)
	ui:openPanel(nil)
	ui:setLoadout(SettingsController.getLoadout())
	ui:show(instant)
	bindInput()
	player:SetAttribute("ClientMenuReady", true)
	MenuController.Entered:Fire()
end

function MenuController.returnFromRaid()
	if active or busy then
		return
	end
	busy = true
	ui:fade(true, 0.6)
	MenuController.enter(true)
	ui:fade(false, 1.4)
end

function MenuController.isDeployed(): boolean
	return deployed
end

return MenuController
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000041"><Properties><string name="Name">MovementController</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	MovementController
	Tactical locomotion for the local character:

	  • Walk / ADS walk / crouch / sprint speeds, eased (no instant snaps)
	  • Sprint (hold Shift / L3): only while moving forward, drains stamina,
	    blocked while aiming or right after firing
	  • Crouch (C / Ctrl / B): toggles; real collision change via HipHeight
	  • Slide: crouch while sprinting fast enough → momentum burst that decays
	    into a crouch; costs stamina; jump cancels it into a slide-hop
	  • Stamina with regen delay + exhaustion lockout; jumps cost stamina
	  • Can't stand up under low ceilings
	  • FOV kicks for sprint/slide through TacticalCamera
	  • Stance + sprint state replicated (throttled) so others see the pose
]]

local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local Signal = require(Shared.Signal)
local Trove = require(Shared.Trove)
local Types = require(Shared.Types)

local TacticalCamera = require(script.Parent.TacticalCamera)

local M = Config.Movement
local KEYS = Config.Combat.Keybinds
local player = Players.LocalPlayer

local MovementController = {}
MovementController.StanceChanged = Signal.new() -- (stance)

local character: Model? = nil
local humanoid: Humanoid? = nil
local root: BasePart? = nil
local trove: Trove.Trove? = nil

local stance: Types.Stance = "Stand"
local sprintHeld = false
local sprinting = false
local stamina = M.StaminaMax
local exhausted = false
local lastDrain = 0
local aiming = false
local speedMultiplier = 1
local sprintBlockedUntil = 0
local baseHipHeight = 2
local slideTime = 0
local slideDir = Vector3.zero
local lastSlideEnd = -math.huge
local lastSent = 0
local pendingSend = false
local controls: any = nil
local enabled = true

local function getControls(): any
	if controls then
		return controls
	end
	local ok, result = pcall(function(): any
		local scripts = player:WaitForChild("PlayerScripts")
		local module = scripts:WaitForChild("PlayerModule", 5)
		return if module then (require(module :: ModuleScript) :: any):GetControls() else nil
	end)
	if ok then
		controls = result
	end
	return controls
end

local function replicate()
	local model = character
	if not model then
		return
	end
	model:SetAttribute("Stance", stance)
	model:SetAttribute("Sprinting", sprinting)
	local now = os.clock()
	if now - lastSent >= M.StanceSendInterval then
		lastSent = now
		pendingSend = false
		Net.event(Net.Events.SetStance):FireServer(stance, sprinting)
	else
		pendingSend = true
	end
end

local function blockedAbove(): boolean
	local r = root
	if not r or not character then
		return false
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { character :: Model }
	local height = baseHipHeight + r.Size.Y * 0.5 + 0.6
	return Workspace:Spherecast(r.Position, 0.9, Vector3.new(0, height, 0), params) ~= nil
end

local function setStance(nextStance: Types.Stance): boolean
	local h = humanoid
	if not h or nextStance == stance then
		return false
	end
	if nextStance == "Stand" and blockedAbove() then
		return false
	end
	stance = nextStance
	h.HipHeight = if nextStance == "Stand" then baseHipHeight else baseHipHeight - M.CrouchHipDrop
	if nextStance ~= "Stand" then
		sprinting = false
		TacticalCamera.setFovOffset("Sprint", nil)
	end
	replicate()
	MovementController.StanceChanged:Fire(stance)
	return true
end

local function endSlide(toStance: Types.Stance)
	local c = getControls()
	if c then
		c:Enable()
	end
	TacticalCamera.setFovOffset("Slide", nil)
	lastSlideEnd = os.clock()
	if not setStance(toStance) and stance == "Slide" then
		setStance("Crouch")
	end
end

local function startSlide(): boolean
	local r = root
	local h = humanoid
	if not r or not h then
		return false
	end
	local now = os.clock()
	if stamina < M.SlideCost or now - lastSlideEnd < M.SlideCooldown or h.FloorMaterial == Enum.Material.Air then
		return false
	end
	local v = r.AssemblyLinearVelocity
	local flat = Vector3.new(v.X, 0, v.Z)
	if flat.Magnitude < M.SlideMinSpeed then
		return false
	end
	slideDir = flat.Unit
	slideTime = 0
	stamina -= M.SlideCost
	lastDrain = now
	setStance("Slide")
	local c = getControls()
	if c then
		c:Disable()
	end
	TacticalCamera.setFovOffset("Slide", M.SlideFovKick)
	return true
end

local function onCrouch()
	if stance == "Stand" then
		if sprinting and startSlide() then
			return
		end
		setStance("Crouch")
	elseif stance == "Crouch" then
		setStance("Stand")
	end
end

local function cameraForward(): Vector3
	local yaw = TacticalCamera.getYaw()
	return Vector3.new(-math.sin(yaw), 0, -math.cos(yaw))
end

local function update(dt: number)
	local h = humanoid
	local r = root
	if not h or not r or h.Health <= 0 or not enabled then
		return
	end
	local now = os.clock()
	local moveDir = h.MoveDirection
	local carrying = character ~= nil and (character :: Model):GetAttribute("CarryingBag") == true

	-- Crouch/slide + jump interplay
	if h.Jump then
		if stance == "Crouch" then
			h.Jump = false
			setStance("Stand")
		elseif stance == "Slide" then
			endSlide("Stand")
		end
	end
	h:SetStateEnabled(Enum.HumanoidStateType.Jumping, stamina >= M.JumpCost and stance ~= "Crouch")

	-- Slide physics: drive the humanoid along the slide direction, decaying.
	if stance == "Slide" then
		slideTime += dt
		local t = math.clamp(slideTime / M.SlideDuration, 0, 1)
		local eased = 1 - (1 - t) * (1 - t)
		h.WalkSpeed = M.SlideSpeed + (M.CrouchSpeed - M.SlideSpeed) * eased
		h:Move(slideDir, false)
		if t >= 1 then
			endSlide("Crouch")
		end
	else
		-- Sprint gate
		local forwardDot = if moveDir.Magnitude > 0.1 then moveDir.Unit:Dot(cameraForward()) else 0
		local canSprint = sprintHeld
			and not carrying
			and stance == "Stand"
			and not aiming
			and not exhausted
			and now >= sprintBlockedUntil
			and forwardDot > M.SprintForwardDot
			and h.FloorMaterial ~= Enum.Material.Air
		if canSprint ~= sprinting then
			sprinting = canSprint
			TacticalCamera.setFovOffset("Sprint", if sprinting then M.SprintFovKick else nil)
			replicate()
		end

		local target = M.WalkSpeed
		if stance == "Crouch" then
			target = M.CrouchSpeed
		elseif sprinting then
			target = M.SprintSpeed
		elseif aiming then
			target = M.AdsSpeed
		end
		target *= speedMultiplier
		if carrying then
			target *= Config.Loot.CarrySpeedMultiplier
		end
		h.WalkSpeed += (target - h.WalkSpeed) * (1 - math.exp(-dt * M.SpeedResponse))
	end

	-- Stamina
	if sprinting then
		stamina = math.max(0, stamina - M.SprintDrain * dt)
		lastDrain = now
		if stamina <= 0 then
			exhausted = true
		end
	elseif now - lastDrain > M.RegenDelay then
		stamina = math.min(M.StaminaMax, stamina + M.StaminaRegen * dt)
	end
	if exhausted and stamina >= M.MinStaminaToSprint * 2 then
		exhausted = false
	end

	if pendingSend and now - lastSent >= M.StanceSendInterval then
		replicate()
	end
end

local function bind()
	ContextActionService:BindAction("MoveSprint", function(_: string, state: Enum.UserInputState): Enum.ContextActionResult
		if state == Enum.UserInputState.Begin then
			sprintHeld = true
		elseif state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel then
			sprintHeld = false
		end
		return Enum.ContextActionResult.Sink
	end, false, table.unpack(KEYS.Sprint))

	ContextActionService:BindAction("MoveDropBag", function(_: string, state: Enum.UserInputState): Enum.ContextActionResult
		if state == Enum.UserInputState.Begin and character and (character :: Model):GetAttribute("CarryingBag") == true then
			Net.event(Net.Events.DropBag):FireServer()
			return Enum.ContextActionResult.Sink
		end
		return Enum.ContextActionResult.Pass
	end, false, table.unpack(KEYS.DropBag))

	ContextActionService:BindAction("MoveCrouch", function(_: string, state: Enum.UserInputState): Enum.ContextActionResult
		if state == Enum.UserInputState.Begin then
			onCrouch()
		end
		return Enum.ContextActionResult.Sink
	end, false, table.unpack(KEYS.Crouch))
end

local function unbind()
	ContextActionService:UnbindAction("MoveSprint")
	ContextActionService:UnbindAction("MoveCrouch")
	ContextActionService:UnbindAction("MoveDropBag")
end

function MovementController.attach(model: Model)
	MovementController.detach()
	local h = model:FindFirstChildOfClass("Humanoid")
	local r = model:FindFirstChild("HumanoidRootPart")
	if not h or not r or not r:IsA("BasePart") then
		return
	end
	character = model
	humanoid = h
	root = r
	enabled = true
	baseHipHeight = h.HipHeight
	stance = "Stand"
	sprinting = false
	sprintHeld = false
	stamina = M.StaminaMax
	exhausted = false
	h.WalkSpeed = M.WalkSpeed

	local t = Trove.new()
	trove = t
	t:Connect(RunService.Heartbeat, update)
	t:Connect(h.StateChanged, function(_, newState: Enum.HumanoidStateType)
		if newState == Enum.HumanoidStateType.Jumping then
			stamina = math.max(0, stamina - M.JumpCost)
			lastDrain = os.clock()
		end
	end)
	t:Connect(h.Died, function()
		MovementController.detach()
	end)
	bind()
	replicate()
end

function MovementController.detach()
	unbind()
	if trove then
		local t = trove
		trove = nil
		t:Clean()
	end
	if stance == "Slide" then
		local c = getControls()
		if c then
			c:Enable()
		end
	end
	TacticalCamera.setFovOffset("Sprint", nil)
	TacticalCamera.setFovOffset("Slide", nil)
	local h = humanoid
	if h and h.Parent then
		h.HipHeight = baseHipHeight
	end
	character = nil
	humanoid = nil
	root = nil
	stance = "Stand"
	sprinting = false
end

-- Vehicles: no sprint/crouch input while seated; stand up first.
function MovementController.setEnabled(value: boolean)
	if enabled == value then
		return
	end
	enabled = value
	if not value then
		unbind()
		if stance == "Slide" then
			endSlide("Stand")
		end
		if stance ~= "Stand" then
			stance = "Stand"
			local h = humanoid
			if h then
				h.HipHeight = baseHipHeight
			end
		end
		sprinting = false
		sprintHeld = false
		TacticalCamera.setFovOffset("Sprint", nil)
		replicate()
	elseif character then
		bind()
	end
end

function MovementController.setAiming(value: boolean)
	aiming = value
end

function MovementController.setSpeedMultiplier(value: number)
	speedMultiplier = value
end

-- Firing or reloading drops you out of sprint for a beat.
function MovementController.interruptSprint(duration: number?)
	sprintBlockedUntil = os.clock() + (duration or 0.3)
end

function MovementController.isSprinting(): boolean
	return sprinting
end

function MovementController.getStance(): Types.Stance
	return stance
end

function MovementController.getStamina01(): number
	return stamina / M.StaminaMax
end

function MovementController.isExhausted(): boolean
	return exhausted
end

return MovementController
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000042"><Properties><string name="Name">SettingsController</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	SettingsController
	Client copy of the player's settings + loadout. Pulls the profile from the
	server once, applies changes instantly (optimistic), debounces saves, and
	re-syncs loadout from the server-confirmed player attributes.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local Schema = require(Shared.Schema)
local Signal = require(Shared.Signal)
local Types = require(Shared.Types)

local player = Players.LocalPlayer

local SettingsController = {}
SettingsController.Changed = Signal.new() -- (settings: PlayerSettings)
SettingsController.LoadoutChanged = Signal.new() -- (loadout: Loadout)

local current: Types.PlayerSettings = Schema.sanitizeSettings(nil, Config.Settings.Defaults)
local loadout: Types.Loadout = Schema.sanitizeLoadout(nil, Config.DefaultLoadout)
local saveToken = 0

local function scheduleSave()
	saveToken += 1
	local token = saveToken
	task.delay(Config.Settings.SaveDebounce, function()
		if token == saveToken then
			Net.event(Net.Events.SaveSettings):FireServer(current)
		end
	end)
end

local function syncLoadoutFromAttributes()
	local confirmed = Schema.sanitizeLoadout({
		Primary = player:GetAttribute("Loadout_Primary"),
		Secondary = player:GetAttribute("Loadout_Secondary"),
	}, loadout)
	if confirmed.Primary ~= loadout.Primary or confirmed.Secondary ~= loadout.Secondary then
		loadout = confirmed
		SettingsController.LoadoutChanged:Fire(table.clone(loadout))
	end
end

function SettingsController.init()
	local ok, profile = pcall(function(): any
		return Net.func(Net.Functions.GetProfile):InvokeServer()
	end)
	if ok and typeof(profile) == "table" then
		current = Schema.sanitizeSettings(profile.Settings, current)
		loadout = Schema.sanitizeLoadout(profile.Loadout, loadout)
	else
		warn("[Settings] profile fetch failed, using defaults:", profile)
	end

	player:GetAttributeChangedSignal("Loadout_Primary"):Connect(syncLoadoutFromAttributes)
	player:GetAttributeChangedSignal("Loadout_Secondary"):Connect(syncLoadoutFromAttributes)
end

function SettingsController.get(): Types.PlayerSettings
	return table.clone(current)
end

function SettingsController.set(key: "Quality" | "FieldOfView" | "Sensitivity", value: any)
	local candidate: any = table.clone(current)
	candidate[key] = value
	local sanitized = Schema.sanitizeSettings(candidate, current)
	if
		sanitized.Quality == current.Quality
		and sanitized.FieldOfView == current.FieldOfView
		and sanitized.Sensitivity == current.Sensitivity
	then
		return
	end
	current = sanitized
	SettingsController.Changed:Fire(table.clone(current))
	scheduleSave()
end

function SettingsController.getLoadout(): Types.Loadout
	return table.clone(loadout)
end

function SettingsController.setLoadout(slot: Types.WeaponSlot, weaponId: string)
	if not Schema.isWeaponForSlot(slot, weaponId) then
		return
	end
	if slot == "Primary" then
		if loadout.Primary == weaponId then
			return
		end
		loadout.Primary = weaponId
	else
		if loadout.Secondary == weaponId then
			return
		end
		loadout.Secondary = weaponId
	end
	SettingsController.LoadoutChanged:Fire(table.clone(loadout))
	Net.event(Net.Events.SetLoadout):FireServer(slot, weaponId)
end

return SettingsController
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000043"><Properties><string name="Name">TacticalCamera</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	TacticalCamera
	Over-the-shoulder third-person camera.

	Phase 1: mouse/stick look, spring-smoothed pivot + shoulder, shoulder swap
	(V / D-pad right), sphere-cast collision, strafe roll, FOV spring, body
	turns to heading (AlignOrientation), close-camera character fade.

	Phase 2 adds:
	  • ADS: shoulder tucks in (AdsShoulderOffset), FOV × weapon multiplier,
	    sensitivity scaled down, timed by the weapon's AdsTime
	  • Recoil: permanent climb on pitch/yaw + a damped visual kick spring;
	    climb partially recovers once you stop firing
	  • Named FOV offsets (sprint / slide kicks) on the same FOV spring
	  • Head bob tied to distance travelled (not time), stronger when sprinting

	evaluate(dt) computes the camera without writing it; the deploy transition
	blends from the menu shot into it with zero cut.
]]

local ContextActionService = game:GetService("ContextActionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Spring = require(Shared.Spring)
local Trove = require(Shared.Trove)

local SettingsController = require(script.Parent.SettingsController)

local TacticalCamera = {}

local RENDER_NAME = "TacticalCamera"
local SWAP_ACTION = "TacticalShoulderSwap"
local C = Config.Camera.Tactical

local character: Model? = nil
local root: BasePart? = nil
local humanoid: Humanoid? = nil
local align: AlignOrientation? = nil
local trove: Trove.Trove? = nil

local yaw = 0
local pitch = 0
local bodyYaw = 0
local shoulder = 1
local currentDistance = C.ShoulderOffset.Z
local gamepadLook = Vector2.zero
local attached = false
local running = false

-- ADS
local aimTarget = 0
local aim = 0
local adsTime = 0.2
local adsFovMultiplier = 0.75

-- Recoil
local recoilDebt = 0
local lastRecoil = 0

-- FOV offsets (sprint, slide...)
local fovOffsets: { [string]: number } = {}

-- Bob
local bobPhase = 0
local bobWeight = 0

local pivotSpring = Spring.new(Vector3.zero, C.PivotFrequency, 1)
local shoulderSpring = Spring.new(Vector3.new(1, 0, 0), C.ShoulderFrequency, C.ShoulderDamping)
local rollSpring = Spring.new(Vector3.zero, 3, 0.7)
local fovSpring = Spring.new(Vector3.new(72, 0, 0), C.FovFrequency, 1)
local kickSpring = Spring.new(Vector3.zero, C.RecoilFrequency, C.RecoilDamping)

local castParams = RaycastParams.new()
castParams.FilterType = Enum.RaycastFilterType.Exclude

local lastCF = CFrame.identity
local lastFov = 72

-- Optional blend-in when (re)starting from another camera (e.g. leaving a car).
local blendFromCF: CFrame? = nil
local blendFromFov = 72
local blendTime = 0
local blendDuration = 0

local function sphereCast(origin: Vector3, offset: Vector3): Vector3
	if offset.Magnitude < 1e-3 then
		return origin + offset
	end
	local result = Workspace:Spherecast(origin, C.CollisionRadius, offset, castParams)
	if result then
		return origin + offset.Unit * math.max(result.Distance - 0.05, 0)
	end
	return origin + offset
end

local function setCharacterFade(alpha: number)
	local model = character
	if not model then
		return
	end
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") or d:IsA("Decal") then
			(d :: any).LocalTransparencyModifier = alpha
		end
	end
end

local function readInput(dt: number)
	local settings = SettingsController.get()
	local sensitivity = settings.Sensitivity * (1 + (C.AdsSensitivity - 1) * aim)
	if UserInputService.MouseBehavior == Enum.MouseBehavior.LockCenter then
		local delta = UserInputService:GetMouseDelta()
		local k = C.MouseRadiansPerPixel * sensitivity
		yaw -= delta.X * k
		pitch -= delta.Y * k
	end
	if gamepadLook.Magnitude > C.GamepadDeadzone then
		local speed = C.GamepadRadiansPerSecond * sensitivity * dt
		yaw -= gamepadLook.X * speed
		pitch += gamepadLook.Y * speed
	end

	-- Recover part of the recoil climb once firing stops.
	if recoilDebt > 0 and os.clock() - lastRecoil > C.RecoilRecoveryDelay then
		local step = math.min(recoilDebt, C.RecoilRecoveryRate * dt)
		recoilDebt -= step
		pitch -= step
	end
	pitch = math.clamp(pitch, math.rad(C.MinPitch), math.rad(C.MaxPitch))
end

local function updateBody(dt: number)
	local h = humanoid
	local constraint = align
	if not h or not constraint then
		return
	end
	if h.MoveDirection.Magnitude > 0.1 or aim > 0.2 then
		bodyYaw = yaw
	else
		local diff = math.atan2(math.sin(yaw - bodyYaw), math.cos(yaw - bodyYaw))
		if math.abs(diff) > math.rad(100) then
			bodyYaw += diff * math.min(1, dt * 6)
		end
	end
	constraint.CFrame = CFrame.Angles(0, bodyYaw, 0)
end

function TacticalCamera.evaluate(dt: number): (CFrame, number)
	local r = root
	if not r or not r.Parent then
		return lastCF, lastFov
	end

	aim += (aimTarget - aim) * (1 - math.exp(-dt * 3 / math.max(adsTime, 0.05)))

	readInput(dt)
	updateBody(dt)

	pivotSpring.Target = r.Position + Vector3.new(0, C.PivotHeight, 0)
	local pivot = pivotSpring:update(dt)

	shoulderSpring.Target = Vector3.new(shoulder, 0, 0)
	local side = shoulderSpring:update(dt).X

	local kick = kickSpring:update(dt)
	local rotation = CFrame.Angles(0, yaw + kick.Y, 0) * CFrame.Angles(pitch + kick.X, 0, 0)
	local offset = C.ShoulderOffset:Lerp(C.AdsShoulderOffset, aim)

	-- Head bob: phase advances with ground distance so it matches footsteps.
	local velocity = r.AssemblyLinearVelocity
	local flatSpeed = Vector3.new(velocity.X, 0, velocity.Z).Magnitude
	local h = humanoid
	local grounded = h ~= nil and h.FloorMaterial ~= Enum.Material.Air
	bobPhase += flatSpeed * dt * C.BobFrequency * math.pi
	local targetWeight = if grounded then math.clamp(flatSpeed / 23, 0, 1.2) * (1 - aim * 0.8) else 0
	bobWeight += (targetWeight - bobWeight) * (1 - math.exp(-dt * 8))
	local bobY = math.abs(math.sin(bobPhase)) * C.BobAmplitude * bobWeight
	local bobRoll = math.sin(bobPhase) * C.BobRoll * bobWeight

	local lateral = rotation.RightVector * (offset.X * side) + rotation.UpVector * (offset.Y - bobY)
	local back = rotation.LookVector * -offset.Z

	local shoulderPoint = sphereCast(pivot, lateral)
	local desired = sphereCast(shoulderPoint, back)
	local desiredDistance = (desired - shoulderPoint).Magnitude
	if desiredDistance < currentDistance then
		currentDistance = desiredDistance
	else
		currentDistance += (desiredDistance - currentDistance) * (1 - math.exp(-dt * 4))
	end
	-- ADS should tuck in quickly, not ease out like collision.
	currentDistance = math.min(currentDistance, offset.Z)
	local cameraPosition = shoulderPoint + rotation.LookVector * -currentDistance

	local lateralSpeed = rotation.RightVector:Dot(velocity)
	rollSpring.Target = Vector3.new(math.clamp(-lateralSpeed * C.RollPerStudPerSecond, -C.MaxRoll, C.MaxRoll), 0, 0)
	local roll = rollSpring:update(dt).X + bobRoll + kick.Z

	local fovTarget = SettingsController.get().FieldOfView * (1 + (adsFovMultiplier - 1) * aim)
	for _, extra in fovOffsets do
		fovTarget += extra * (1 - aim)
	end
	fovSpring.Target = Vector3.new(fovTarget, 0, 0)
	local fov = fovSpring:update(dt).X

	local fade = math.clamp((C.CloseFadeStart - currentDistance) / (C.CloseFadeStart - C.CloseFadeEnd), 0, 1)
	setCharacterFade(fade * 0.85)

	lastCF = CFrame.new(cameraPosition) * rotation.Rotation * CFrame.Angles(0, 0, roll)
	lastFov = fov
	return lastCF, lastFov
end

-- Binds to a freshly spawned character. Call before evaluate()/start().
function TacticalCamera.attach(model: Model)
	TacticalCamera.detach()
	local r = model:WaitForChild("HumanoidRootPart", 5)
	local h = model:FindFirstChildOfClass("Humanoid")
	if not r or not r:IsA("BasePart") or not h then
		warn("[TacticalCamera] character missing HumanoidRootPart/Humanoid")
		return
	end
	character = model
	root = r
	humanoid = h
	local t = Trove.new()
	trove = t

	local look = r.CFrame.LookVector
	yaw = math.atan2(-look.X, -look.Z)
	bodyYaw = yaw
	pitch = math.rad(-8)
	shoulder = 1
	aim, aimTarget = 0, 0
	recoilDebt = 0
	table.clear(fovOffsets)
	currentDistance = C.ShoulderOffset.Z
	pivotSpring:reset(r.Position + Vector3.new(0, C.PivotHeight, 0))
	shoulderSpring:reset(Vector3.new(1, 0, 0))
	rollSpring:reset(Vector3.zero)
	kickSpring:reset(Vector3.zero)
	fovSpring:reset(Vector3.new(SettingsController.get().FieldOfView, 0, 0))
	local ignore: { Instance } = { model }
	for _, name in { "ClientFX", "WeaponFX" } do
		local folder = Workspace:FindFirstChild(name)
		if folder then
			table.insert(ignore, folder)
		end
	end
	castParams.FilterDescendantsInstances = ignore

	h.AutoRotate = false
	local attachment = r:FindFirstChild("RootAttachment")
	if not attachment or not attachment:IsA("Attachment") then
		local created = Instance.new("Attachment")
		created.Name = "RootAttachment"
		created.Parent = r
		attachment = created
	end
	local constraint = Instance.new("AlignOrientation")
	constraint.Name = "TacticalFacing"
	constraint.Mode = Enum.OrientationAlignmentMode.OneAttachment
	constraint.Attachment0 = attachment :: Attachment
	constraint.Responsiveness = C.BodyResponsiveness
	constraint.MaxTorque = math.huge
	constraint.MaxAngularVelocity = math.huge
	constraint.RigidityEnabled = false
	constraint.CFrame = CFrame.Angles(0, yaw, 0)
	constraint.Parent = r
	align = constraint
	t:Add(constraint)

	t:Connect(UserInputService.InputChanged, function(input: InputObject)
		if input.KeyCode == Enum.KeyCode.Thumbstick2 then
			gamepadLook = Vector2.new(input.Position.X, input.Position.Y)
		end
	end)
	t:Connect(model.AncestryChanged, function(_, parent: Instance?)
		if parent == nil then
			TacticalCamera.detach()
		end
	end)

	attached = true
end

function TacticalCamera.start()
	if not attached or running then
		return
	end
	running = true
	UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
	UserInputService.MouseIconEnabled = false

	ContextActionService:BindAction(SWAP_ACTION, function(_: string, state: Enum.UserInputState): Enum.ContextActionResult
		if state == Enum.UserInputState.Begin then
			shoulder = -shoulder
			rollSpring:impulse(Vector3.new(shoulder * 0.06, 0, 0))
		end
		return Enum.ContextActionResult.Sink
	end, false, table.unpack(Config.Keybinds.ShoulderSwap))

	RunService:BindToRenderStep(RENDER_NAME, Enum.RenderPriority.Camera.Value + 1, function(dt: number)
		local camera = Workspace.CurrentCamera
		if not camera then
			return
		end
		camera.CameraType = Enum.CameraType.Scriptable
		UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
		local cf, fov = TacticalCamera.evaluate(dt)
		local from = blendFromCF
		if from and blendDuration > 0 then
			blendTime += dt
			local t = math.clamp(blendTime / blendDuration, 0, 1)
			local a = t * t * (3 - 2 * t)
			cf = from:Lerp(cf, a)
			fov = blendFromFov + (fov - blendFromFov) * a
			if t >= 1 then
				blendFromCF = nil
			end
		end
		camera.CFrame = cf
		camera.FieldOfView = fov
	end)
end

function TacticalCamera.stop()
	if running then
		running = false
		RunService:UnbindFromRenderStep(RENDER_NAME)
		ContextActionService:UnbindAction(SWAP_ACTION)
	end
	UserInputService.MouseBehavior = Enum.MouseBehavior.Default
	UserInputService.MouseIconEnabled = true
end

function TacticalCamera.detach()
	TacticalCamera.stop()
	if trove then
		local t = trove
		trove = nil
		t:Clean()
	end
	setCharacterFade(0)
	local h = humanoid
	if h and h.Parent then
		h.AutoRotate = true
	end
	character = nil
	root = nil
	humanoid = nil
	align = nil
	attached = false
end

--------------------------------------------------------------------------------
-- Phase 2 hooks (weapons / movement)
--------------------------------------------------------------------------------
function TacticalCamera.setAiming(aiming: boolean, fovMultiplier: number?, time: number?)
	aimTarget = if aiming then 1 else 0
	if fovMultiplier then
		adsFovMultiplier = fovMultiplier
	end
	if time then
		adsTime = time
	end
end

function TacticalCamera.getAim(): number
	return aim
end

-- pitchDeg climbs permanently (partially recovered later); yawDeg is random drift.
function TacticalCamera.addRecoil(pitchDeg: number, yawDeg: number, recoveryShare: number)
	local p = math.rad(pitchDeg)
	local y = math.rad(yawDeg)
	pitch += p
	yaw += y
	recoilDebt += p * math.clamp(recoveryShare, 0, 1)
	lastRecoil = os.clock()
	-- Visual punch on top of the real climb.
	kickSpring:impulse(Vector3.new(p * 14, y * 10, (math.random() - 0.5) * p * 6))
end

function TacticalCamera.setFovOffset(key: string, value: number?)
	fovOffsets[key] = value
end

-- Restart from another camera's frame without a cut.
function TacticalCamera.startBlended(fromCF: CFrame, fromFov: number, duration: number)
	blendFromCF = fromCF
	blendFromFov = fromFov
	blendTime = 0
	blendDuration = duration
	TacticalCamera.start()
end

-- Seated in a vehicle: the facing constraint must not fight the seat weld.
function TacticalCamera.setBodyControl(enabled: boolean)
	local constraint = align
	if constraint then
		constraint.Enabled = enabled
	end
	local h = humanoid
	if h and h.Parent then
		h.AutoRotate = false
	end
end

function TacticalCamera.setYaw(value: number)
	yaw = value
	bodyYaw = value
end

function TacticalCamera.getPitch(): number
	return pitch
end

function TacticalCamera.getYaw(): number
	return yaw
end

function TacticalCamera.getCFrame(): CFrame
	return lastCF
end

function TacticalCamera.getFieldOfView(): number
	return lastFov
end

function TacticalCamera.isAttached(): boolean
	return attached
end

function TacticalCamera.isRunning(): boolean
	return running
end

return TacticalCamera
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000044"><Properties><string name="Name">VehicleCamera</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	VehicleCamera
	Chase camera for the getaway car:

	  • trails the car's heading with lag (feels the slide in a drift)
	  • free-look orbit with mouse / right stick, auto-recentres when idle
	  • pulls back slightly and widens FOV with speed (speed kick)
	  • high-speed micro shake, sphere-cast collision against walls
	  • blends in from whatever camera was active, no cut
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Spring = require(Shared.Spring)

local SettingsController = require(script.Parent.SettingsController)

local VehicleCamera = {}

local RENDER_NAME = "VehicleCamera"
local V = Config.Vehicle

local car: Model? = nil
local root: BasePart? = nil
local running = false
local followYaw = 0
local orbitYaw = 0
local orbitPitch = 0
local lastLook = 0
local gamepadLook = Vector2.zero
local blendFromCF: CFrame? = nil
local blendFromFov = 70
local blendTime = 0
local lastCF = CFrame.identity
local lastFov = 70
local fovSpring = Spring.new(Vector3.new(70, 0, 0), 2.5, 1)
local params = RaycastParams.new()
params.FilterType = Enum.RaycastFilterType.Exclude

local function angleLerp(a: number, b: number, t: number): number
	local diff = math.atan2(math.sin(b - a), math.cos(b - a))
	return a + diff * t
end

local function headingOf(cf: CFrame): number
	local look = cf.LookVector
	return math.atan2(-look.X, -look.Z)
end

local function step(dt: number)
	local r = root
	local camera = Workspace.CurrentCamera
	if not r or not r.Parent or not camera then
		return
	end
	camera.CameraType = Enum.CameraType.Scriptable
	UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter

	local cf = r.CFrame
	local velocity = r.AssemblyLinearVelocity
	local speed = Vector3.new(velocity.X, 0, velocity.Z).Magnitude
	local speed01 = math.clamp(speed / V.MaxSpeed, 0, 1)

	-- Free look
	local sensitivity = SettingsController.get().Sensitivity
	local delta = UserInputService:GetMouseDelta()
	if delta.Magnitude > 0.5 then
		orbitYaw -= delta.X * 0.004 * sensitivity
		orbitPitch = math.clamp(orbitPitch - delta.Y * 0.004 * sensitivity, -0.5, 0.6)
		lastLook = os.clock()
	end
	if gamepadLook.Magnitude > 0.15 then
		orbitYaw -= gamepadLook.X * 3 * dt
		orbitPitch = math.clamp(orbitPitch + gamepadLook.Y * 2 * dt, -0.5, 0.6)
		lastLook = os.clock()
	end
	if os.clock() - lastLook > V.CameraRecenterDelay then
		local k = 1 - math.exp(-dt * 2.5)
		orbitYaw = angleLerp(orbitYaw, 0, k)
		orbitPitch += (0 - orbitPitch) * k
	end

	-- Heading follow with lag (looser at low speed so parking isn't twitchy).
	followYaw = angleLerp(followYaw, headingOf(cf), 1 - math.exp(-dt * (2 + speed01 * 4)))

	local yaw = followYaw + orbitYaw
	local pitch = -0.13 + orbitPitch
	local rotation = CFrame.Angles(0, yaw, 0) * CFrame.Angles(pitch, 0, 0)
	local pivot = cf.Position + Vector3.new(0, V.CameraHeight, 0)
	local offset = rotation:VectorToWorldSpace(Vector3.new(0, V.CameraLift, V.CameraDistance + speed01 * 3.5))

	local hit = Workspace:Spherecast(pivot, 0.6, offset, params)
	local position = if hit then pivot + offset.Unit * math.max(hit.Distance - 0.2, 2) else pivot + offset

	local t = os.clock()
	local shake = speed01 * speed01 * 0.006
	local target = CFrame.lookAt(position, pivot + rotation.LookVector * 6)
		* CFrame.Angles(math.noise(t * 9, 1.7) * shake, math.noise(t * 8, 4.2) * shake, 0)

	fovSpring.Target = Vector3.new(SettingsController.get().FieldOfView + speed01 * V.CameraFovKick, 0, 0)
	local fov = fovSpring:update(dt).X

	local from = blendFromCF
	if from then
		blendTime += dt
		local a = math.clamp(blendTime / 0.55, 0, 1)
		a = a * a * (3 - 2 * a)
		target = from:Lerp(target, a)
		fov = blendFromFov + (fov - blendFromFov) * a
		if a >= 1 then
			blendFromCF = nil
		end
	end

	camera.CFrame = target
	camera.FieldOfView = fov
	lastCF = target
	lastFov = fov
end

function VehicleCamera.init()
	UserInputService.InputChanged:Connect(function(input: InputObject)
		if input.KeyCode == Enum.KeyCode.Thumbstick2 then
			gamepadLook = Vector2.new(input.Position.X, input.Position.Y)
		end
	end)
end

function VehicleCamera.start(carModel: Model, fromCF: CFrame, fromFov: number, character: Model?)
	local r = carModel.PrimaryPart
	if not r then
		return
	end
	car = carModel
	root = r
	followYaw = headingOf(r.CFrame)
	orbitYaw, orbitPitch = 0, 0
	lastLook = 0
	blendFromCF = fromCF
	blendFromFov = fromFov
	blendTime = 0
	fovSpring:reset(Vector3.new(fromFov, 0, 0))
	local ignore: { Instance } = { carModel }
	if character then
		table.insert(ignore, character)
	end
	for _, name in { "ClientFX", "WeaponFX", "SkidMarks" } do
		local f = Workspace:FindFirstChild(name)
		if f then
			table.insert(ignore, f)
		end
	end
	params.FilterDescendantsInstances = ignore
	if not running then
		running = true
		RunService:BindToRenderStep(RENDER_NAME, Enum.RenderPriority.Camera.Value + 1, step)
	end
end

function VehicleCamera.stop(): (CFrame, number, number)
	if running then
		running = false
		RunService:UnbindFromRenderStep(RENDER_NAME)
	end
	car = nil
	root = nil
	return lastCF, lastFov, followYaw + orbitYaw
end

function VehicleCamera.isRunning(): boolean
	return running
end

return VehicleCamera
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000045"><Properties><string name="Name">VehicleController</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	VehicleController
	Local player in a car. The server gives the driver network ownership, so
	all physics control happens here with zero input lag:

	  • W/S (or triggers) from the VehicleSeat: throttle, brake, reverse
	  • RWD motor torque with a falling torque curve and engine braking
	  • speed-sensitive steering on the front servos (smoothed input)
	  • Space / X handbrake: rear wheels lock + rear grip drops → drift
	  • speed² downforce for stability
	  • simulated 5-speed gearbox → RPM for audio/HUD, shift torque cut,
	    backfires on hard upshifts and throttle lift-off
	  • L lights · H hazards · U underglow · F / Y exit
	  • state streamed to the server (unreliable) so everyone sees brake
	    lights, hears the engine and sees backfires

	Passengers get the chase camera and the exit key only.
]]

local CollectionService = game:GetService("CollectionService")
local ContextActionService = game:GetService("ContextActionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local Trove = require(Shared.Trove)

local Controllers = script.Parent
local AudioController = require(Controllers.AudioController)
local MovementController = require(Controllers.MovementController)
local TacticalCamera = require(Controllers.TacticalCamera)
local VehicleCamera = require(Controllers.VehicleCamera)
local WeaponController = require(Controllers.WeaponController)
local HUD = require(Controllers.Parent.UI.HUD)

local V = Config.Vehicle
local KEYS = Config.VehicleKeys

local VehicleController = {}

type Wheel = {
	Front: boolean,
	Tire: BasePart,
	Hinge: HingeConstraint,
	Slide: CylindricalConstraint,
}

local character: Model? = nil
local humanoid: Humanoid? = nil
local characterTrove: Trove.Trove? = nil
local rideTrove: Trove.Trove? = nil

local car: Model? = nil
local root: BasePart? = nil
local seat: VehicleSeat? = nil
local isDriver = false
local wheels: { Wheel } = {}
local downforce: VectorForce? = nil

local handbrake = false
local appliedHandbrake: boolean? = nil
local steer = 0
local gear = 1
local shiftUntil = 0
local backfires = 0
local lastThrottle = 0
local rpm = 0.12
local sendTimer = 0
local rng = Random.new()

local ACTIONS = { "CarHandbrake", "CarExit", "CarLights", "CarHazards", "CarUnderglow" }

local function collectWheels(model: Model): { Wheel }
	local list: { Wheel } = {}
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") and string.sub(d.Name, 1, 8) == "Knuckle_" then
			local hinge = d:FindFirstChild("Axle")
			local slide = d:FindFirstChild("Suspension")
			local wheelModel = d.Parent
			local tire = if wheelModel and wheelModel:IsA("Model") then wheelModel.PrimaryPart else nil
			if hinge and hinge:IsA("HingeConstraint") and slide and slide:IsA("CylindricalConstraint") and tire then
				table.insert(list, {
					Front = string.sub(d.Name, 9, 9) == "F",
					Tire = tire,
					Hinge = hinge,
					Slide = slide,
				})
			end
		end
	end
	return list
end

local function setRearGrip(locked: boolean)
	if appliedHandbrake == locked then
		return
	end
	appliedHandbrake = locked
	local friction = if locked then V.TireFrictionHandbrake else V.TireFriction
	for _, wheel in wheels do
		if not wheel.Front then
			wheel.Tire.CustomPhysicalProperties = PhysicalProperties.new(0.7, friction, 0, 100, 100)
		end
	end
end

local function gearFor(speed: number): number
	local gears = V.Gears
	for g = #gears - 1, 1, -1 do
		if speed >= gears[g] then
			return g
		end
	end
	return 1
end

local function drive(dt: number)
	local r = root
	local s = seat
	local force = downforce
	if not r or not s or not force then
		return
	end
	local now = os.clock()
	local throttleIn = s.ThrottleFloat
	local steerIn = s.SteerFloat

	local forward = r.CFrame.LookVector
	local velocity = r.AssemblyLinearVelocity
	local speed = velocity:Dot(forward)
	local absSpeed = math.abs(speed)
	local speed01 = math.clamp(absSpeed / V.MaxSpeed, 0, 1)

	-- Steering
	steer += (steerIn - steer) * (1 - math.exp(-dt * V.SteerSpeed * (if math.abs(steerIn) < 0.05 then 1.6 else 1)))
	local maxAngle = V.SteerAngleLow + (V.SteerAngleHigh - V.SteerAngleLow) * speed01
	-- Counter-steer room while drifting.
	if handbrake then
		maxAngle = math.max(maxAngle, V.SteerAngleLow * 0.8)
	end

	-- Gearbox (drives RPM, shift cut and backfires)
	local targetGear = if speed < -1 then -1 else gearFor(absSpeed)
	if targetGear > gear and gear >= 1 then
		shiftUntil = now + V.ShiftTime
		if throttleIn > 0.6 and rpm > 0.75 then
			backfires += 1
		end
	end
	gear = targetGear
	local gears = V.Gears
	local g = math.max(gear, 1)
	local low, high = gears[g], gears[math.min(g + 1, #gears)]
	local gearRpm = if high > low then (absSpeed - low) / (high - low) else 1
	local targetRpm = 0.12 + math.clamp(gearRpm, 0, 1) * 0.86
	if absSpeed < 3 and math.abs(throttleIn) > 0.05 then
		targetRpm = math.max(targetRpm, 0.2 + math.abs(throttleIn) * 0.3)
	end
	if now < shiftUntil then
		targetRpm *= 0.72
	end
	rpm += (targetRpm - rpm) * (1 - math.exp(-dt * 10))

	-- Throttle lift-off pop
	if lastThrottle > 0.8 and throttleIn < 0.1 and rpm > 0.65 and rng:NextNumber() < 0.6 then
		backfires += 1
	end
	lastThrottle = throttleIn

	-- Longitudinal
	local driveVelocity = 0
	local driveTorque = 0
	local brake = 0
	if throttleIn > 0.05 then
		if speed < -2 then
			brake = throttleIn
		else
			local curve = math.clamp(1.15 - speed01 * speed01 * 0.6, 0.3, 1)
			driveVelocity = V.MaxSpeed
			driveTorque = V.DriveTorque * throttleIn * curve * (if now < shiftUntil then 0.2 else 1)
		end
	elseif throttleIn < -0.05 then
		if speed > 2 then
			brake = -throttleIn
		else
			driveVelocity = -V.ReverseSpeed
			driveTorque = V.DriveTorque * 0.7 * -throttleIn
		end
	end

	for _, wheel in wheels do
		local hinge = wheel.Hinge
		if wheel.Front then
			wheel.Slide.TargetAngle = -steer * maxAngle
		end
		if handbrake and not wheel.Front then
			hinge.AngularVelocity = 0
			hinge.MotorMaxTorque = V.HandbrakeTorque
		elseif brake > 0 then
			hinge.AngularVelocity = 0
			hinge.MotorMaxTorque = V.BrakeTorque * brake
		elseif driveTorque > 0 and not wheel.Front then
			hinge.AngularVelocity = -driveVelocity / V.WheelRadius
			hinge.MotorMaxTorque = driveTorque
		elseif not wheel.Front then
			hinge.AngularVelocity = 0
			hinge.MotorMaxTorque = V.CoastTorque
		else
			hinge.MotorMaxTorque = 0
		end
	end
	setRearGrip(handbrake)
	force.Force = Vector3.new(0, -V.Downforce * absSpeed * absSpeed, 0)

	HUD.setVehicle(absSpeed, gear, rpm)

	sendTimer -= dt
	if sendTimer <= 0 and car then
		sendTimer = 1 / V.StateSendRate
		Net.unreliable(Net.Unreliable.VehicleState):FireServer(car, throttleIn, brake, steer, handbrake, rpm, gear, backfires)
	end
end

local function bindRide()
	local function exitAction(_: string, state: Enum.UserInputState): Enum.ContextActionResult
		if state == Enum.UserInputState.Begin then
			Net.event(Net.Events.VehicleExit):FireServer()
		end
		return Enum.ContextActionResult.Sink
	end
	ContextActionService:BindActionAtPriority("CarExit", exitAction, false, Enum.ContextActionPriority.High.Value, table.unpack(KEYS.Exit))
	if not isDriver then
		return
	end
	ContextActionService:BindActionAtPriority("CarHandbrake", function(_: string, state: Enum.UserInputState): Enum.ContextActionResult
		if state == Enum.UserInputState.Begin then
			handbrake = true
		elseif state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel then
			handbrake = false
		end
		-- Sink so Space doesn't make the humanoid jump out of the seat.
		return Enum.ContextActionResult.Sink
	end, false, Enum.ContextActionPriority.High.Value, table.unpack(KEYS.Handbrake))
	local function toggle(name: string): (string, Enum.UserInputState) -> Enum.ContextActionResult
		return function(_: string, state: Enum.UserInputState): Enum.ContextActionResult
			if state == Enum.UserInputState.Begin and car then
				Net.event(Net.Events.VehicleToggle):FireServer(car, name)
				AudioController.play("UITick")
			end
			return Enum.ContextActionResult.Sink
		end
	end
	ContextActionService:BindAction("CarLights", toggle("Lights"), false, table.unpack(KEYS.Lights))
	ContextActionService:BindAction("CarHazards", toggle("Hazards"), false, table.unpack(KEYS.Hazards))
	ContextActionService:BindAction("CarUnderglow", toggle("Underglow"), false, table.unpack(KEYS.Underglow))
end

local function leave()
	if not car then
		return
	end
	for _, name in ACTIONS do
		ContextActionService:UnbindAction(name)
	end
	if rideTrove then
		local t = rideTrove
		rideTrove = nil
		t:Clean()
	end
	handbrake = false
	appliedHandbrake = nil
	car = nil
	root = nil
	seat = nil
	wheels = {}
	downforce = nil
	HUD.setMode("OnFoot")

	local fromCF, fromFov, yaw = VehicleCamera.stop()
	if TacticalCamera.isAttached() then
		TacticalCamera.setBodyControl(true)
		TacticalCamera.setYaw(yaw)
		TacticalCamera.startBlended(fromCF, fromFov, 0.45)
	end
	MovementController.setEnabled(true)
	WeaponController.setEnabled(true)
end

local function enter(seatPart: BasePart)
	local model = seatPart.Parent
	if not model or not model:IsA("Model") or not CollectionService:HasTag(model, "DrivableCar") then
		return
	end
	local r = model.PrimaryPart
	if not r then
		return
	end
	car = model
	root = r
	isDriver = seatPart:IsA("VehicleSeat")
	seat = if seatPart:IsA("VehicleSeat") then seatPart else nil
	wheels = collectWheels(model)
	local force = r:FindFirstChild("Downforce")
	downforce = if force and force:IsA("VectorForce") then force else nil
	steer, gear, rpm, backfires, lastThrottle = 0, 1, 0.12, 0, 0
	appliedHandbrake = nil

	WeaponController.setEnabled(false)
	MovementController.setEnabled(false)
	TacticalCamera.setBodyControl(false)
	TacticalCamera.stop()
	local camera = Workspace.CurrentCamera
	VehicleCamera.start(model, if camera then camera.CFrame else r.CFrame, if camera then camera.FieldOfView else 70, character)
	AudioController.play("DoorOpen")
	HUD.setMode(if isDriver then "Vehicle" else "Passenger")

	local t = Trove.new()
	rideTrove = t
	if isDriver then
		t:Connect(RunService.Heartbeat, drive)
	end
	bindRide()
end

function VehicleController.attach(model: Model)
	VehicleController.detach()
	local h = model:FindFirstChildOfClass("Humanoid")
	if not h then
		return
	end
	character = model
	humanoid = h
	local t = Trove.new()
	characterTrove = t
	t:Connect(h.Seated, function(active: boolean, seatPart: BasePart?)
		if active and seatPart then
			enter(seatPart)
		else
			leave()
		end
	end)
	t:Connect(h.Died, leave)
end

function VehicleController.detach()
	leave()
	if characterTrove then
		local t = characterTrove
		characterTrove = nil
		t:Clean()
	end
	character = nil
	humanoid = nil
end

return VehicleController
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000046"><Properties><string name="Name">VehicleFx</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	VehicleFx
	Per-client audio/visuals for EVERY drivable car, driven by replicated
	physics + the attributes the driver streams:

	  • engine loop pitch/volume from RPM + throttle (off when parked)
	  • tyre smoke + skid sound + skid marks painted on the road while the
	    rear slides (lateral slip) or the handbrake is pulled
	  • exhaust backfires: flame burst, sparks, light pop, bang
]]

local CollectionService = game:GetService("CollectionService")
local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)

local VehicleFx = {}

local SMOKE = "rbxasset://textures/particles/smoke_main.dds"
local SPARK = "rbxasset://textures/particles/sparkles_main.dds"
local MAX_MARKS = 260

type RearWheel = {
	Tire: BasePart,
	Smoke: ParticleEmitter,
	LastMark: Vector3?,
}

type CarFx = {
	Model: Model,
	Root: BasePart,
	Engine: Sound?,
	Skid: Sound?,
	Rear: { RearWheel },
	Exhausts: { Attachment },
	LastBackfires: number,
}

local cars: { [Model]: CarFx } = {}
local marks: { BasePart } = {}
local markFolder: Folder
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local function soundFor(name: string, fallback: string?): string
	local def = Config.Audio[name]
	if def and def.Id ~= "" then
		return def.Id
	end
	local alt = if fallback then Config.Audio[fallback] else nil
	return if alt then alt.Id else ""
end

local function loopSound(parent: Instance, name: string, id: string): Sound?
	if id == "" then
		return nil
	end
	local sound = Instance.new("Sound")
	sound.Name = name
	sound.SoundId = id
	sound.Looped = true
	sound.Volume = 0
	sound.RollOffMode = Enum.RollOffMode.InverseTapered
	sound.RollOffMinDistance = 10
	sound.RollOffMaxDistance = 260
	local group = game:GetService("SoundService"):FindFirstChild("World")
	if group and group:IsA("SoundGroup") then
		sound.SoundGroup = group
	end
	sound.Parent = parent
	sound:Play()
	return sound
end

local function register(model: Instance)
	if not model:IsA("Model") or cars[model] then
		return
	end
	local root = model.PrimaryPart or model:WaitForChild("Root", 10)
	if not root or not root:IsA("BasePart") then
		return
	end
	local bay = model:FindFirstChild("EngineBay")
	local rear: { RearWheel } = {}
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") and (d.Name == "Knuckle_RL" or d.Name == "Knuckle_RR") then
			local wheelModel = d.Parent
			local tire = if wheelModel and wheelModel:IsA("Model") then wheelModel.PrimaryPart else nil
			if tire then
				local contact = Instance.new("Attachment")
				contact.Name = "SmokeContact"
				contact.Position = Vector3.new(0, -1.1, 0)
				contact.Parent = d
				local smoke = Instance.new("ParticleEmitter")
				smoke.Name = "TyreSmoke"
				smoke.Texture = SMOKE
				smoke.Rate = 0
				smoke.Lifetime = NumberRange.new(1.4, 2.4)
				smoke.Speed = NumberRange.new(1, 3)
				smoke.SpreadAngle = Vector2.new(40, 40)
				smoke.Drag = 1.5
				smoke.Acceleration = Vector3.new(0, 1.5, 0)
				smoke.Rotation = NumberRange.new(0, 360)
				smoke.RotSpeed = NumberRange.new(-30, 30)
				smoke.LightInfluence = 1
				smoke.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.2), NumberSequenceKeypoint.new(1, 6) })
				smoke.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.55), NumberSequenceKeypoint.new(1, 1) })
				smoke.Color = ColorSequence.new(Color3.fromRGB(200, 200, 205))
				smoke.Parent = contact
				table.insert(rear, { Tire = tire, Smoke = smoke, LastMark = nil })
			end
		end
	end
	local exhausts: { Attachment } = {}
	for _, child in root:GetChildren() do
		if child:IsA("Attachment") and string.sub(child.Name, 1, 8) == "Exhaust_" then
			table.insert(exhausts, child)
		end
	end
	local backfires = model:GetAttribute("Backfires")
	cars[model] = {
		Model = model,
		Root = root,
		Engine = loopSound(bay or root, "EngineLoop", soundFor("EngineLoop", "EngineIdle")),
		Skid = loopSound(root, "TireSkid", soundFor("TireSkid")),
		Rear = rear,
		Exhausts = exhausts,
		LastBackfires = if typeof(backfires) == "number" then backfires else 0,
	}
	model.AncestryChanged:Connect(function(_, parent)
		if parent == nil then
			cars[model] = nil
		end
	end)
end

local function backfire(fx: CarFx)
	for _, exhaust in fx.Exhausts do
		local flame = Instance.new("ParticleEmitter")
		flame.Texture = SPARK
		flame.EmissionDirection = Enum.NormalId.Back
		flame.Rate = 0
		flame.LightEmission = 1
		flame.LightInfluence = 0
		flame.Lifetime = NumberRange.new(0.06, 0.12)
		flame.Speed = NumberRange.new(8, 14)
		flame.SpreadAngle = Vector2.new(12, 12)
		flame.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.9), NumberSequenceKeypoint.new(1, 0.1) })
		flame.Color = ColorSequence.new(Color3.fromRGB(120, 170, 255), Color3.fromRGB(255, 140, 50))
		flame.Parent = exhaust
		flame:Emit(4)
		local light = Instance.new("PointLight")
		light.Color = Color3.fromRGB(255, 150, 70)
		light.Range = 10
		light.Brightness = 6
		light.Parent = exhaust
		Debris:AddItem(flame, 0.4)
		Debris:AddItem(light, 0.07)
	end
	local def = Config.Audio.Backfire
	if def and def.Id ~= "" and fx.Exhausts[1] then
		local bang = Instance.new("Sound")
		bang.SoundId = def.Id
		bang.Volume = def.Volume
		bang.PlaybackSpeed = def.Speed * (0.9 + math.random() * 0.2)
		bang.RollOffMaxDistance = 300
		bang.Parent = fx.Exhausts[1]
		bang:Play()
		Debris:AddItem(bang, 2)
	end
end

local function skidMark(from: Vector3, to: Vector3)
	local length = (to - from).Magnitude
	if length < 0.05 then
		return
	end
	local mark = Instance.new("Part")
	mark.Name = "SkidMark"
	mark.Anchored = true
	mark.CanCollide = false
	mark.CanQuery = false
	mark.CanTouch = false
	mark.CastShadow = false
	mark.Material = Enum.Material.SmoothPlastic
	mark.Color = Color3.fromRGB(12, 12, 12)
	mark.Transparency = 0.35
	mark.Size = Vector3.new(0.6, 0.02, length + 0.05)
	mark.CFrame = CFrame.lookAt((from + to) / 2, to)
	mark.Parent = markFolder
	table.insert(marks, mark)
	Debris:AddItem(mark, 15)
	if #marks > MAX_MARKS then
		local old = table.remove(marks, 1)
		if old and old.Parent then
			old:Destroy()
		end
	end
end

local function update(dt: number)
	local camera = Workspace.CurrentCamera
	local camPos = if camera then camera.CFrame.Position else Vector3.zero
	for model, fx in cars do
		local root = fx.Root
		if (root.Position - camPos).Magnitude > 320 then
			if fx.Engine then
				fx.Engine.Volume = 0
			end
			continue
		end
		local velocity = root.AssemblyLinearVelocity
		local flat = Vector3.new(velocity.X, 0, velocity.Z)
		local speed = flat.Magnitude
		local slip = math.abs(root.CFrame.RightVector:Dot(velocity))
		local driven = (model:GetAttribute("Driver") or 0) ~= 0
		local handbrake = model:GetAttribute("Handbrake") == true
		local drifting = speed > 12 and (slip > 9 or handbrake)
		local intensity = if drifting then math.clamp(slip / 30 + (if handbrake then 0.3 else 0), 0.2, 1) else 0

		local engine = fx.Engine
		if engine then
			local rpm = model:GetAttribute("RPM")
			local throttle = model:GetAttribute("Throttle")
			local r = if typeof(rpm) == "number" then rpm else 0
			local t = if typeof(throttle) == "number" then math.abs(throttle) else 0
			local targetVolume = if driven then 0.3 + t * 0.35 + r * 0.15 else 0
			engine.Volume += (targetVolume - engine.Volume) * (1 - math.exp(-dt * 6))
			engine.PlaybackSpeed = 0.7 + r * 1.3
		end
		local skid = fx.Skid
		if skid then
			skid.Volume += (intensity * 0.6 - skid.Volume) * (1 - math.exp(-dt * 10))
			skid.PlaybackSpeed = 0.9 + intensity * 0.2
		end

		rayParams.FilterDescendantsInstances = { model, markFolder }
		for _, wheel in fx.Rear do
			wheel.Smoke.Rate = intensity * 45
			if drifting then
				local hit = Workspace:Raycast(wheel.Tire.Position, Vector3.new(0, -2, 0), rayParams)
				if hit then
					local point = hit.Position + hit.Normal * 0.012
					local last = wheel.LastMark
					if last and (point - last).Magnitude < 4 then
						if (point - last).Magnitude > 0.6 then
							skidMark(last, point)
							wheel.LastMark = point
						end
					else
						wheel.LastMark = point
					end
				else
					wheel.LastMark = nil
				end
			else
				wheel.LastMark = nil
			end
		end

		local count = model:GetAttribute("Backfires")
		if typeof(count) == "number" and count ~= fx.LastBackfires then
			if count > fx.LastBackfires then
				backfire(fx)
			end
			fx.LastBackfires = count
		end
	end
end

function VehicleFx.init()
	local folder = Instance.new("Folder")
	folder.Name = "SkidMarks"
	folder.Parent = Workspace
	markFolder = folder
	for _, model in CollectionService:GetTagged("DrivableCar") do
		task.spawn(register, model)
	end
	CollectionService:GetInstanceAddedSignal("DrivableCar"):Connect(function(model: Instance)
		task.spawn(register, model)
	end)
	RunService.RenderStepped:Connect(update)
end

return VehicleFx
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000047"><Properties><string name="Name">WeaponController</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	WeaponController
	Client gunplay with server-authoritative results.

	Per shot (predicted instantly, then confirmed by CombatService):
	  1. Ray from the camera through the crosshair, inside the current cone of
	     fire (hip/ADS base + movement + bloom, tighter when crouched).
	  2. Real bullet ray from the muzzle to that aim point — cover between gun
	     and target is respected, like the server.
	  3. Muzzle flash, tracer, impact, shell, sound, camera recoil (climb +
	     kick spring), weapon kick on the procedural pose, crosshair bloom.
	  4. Fire(shotId, muzzle, direction) → server validates and raycasts.

	Also: ADS (hold RMB / L2), reload with physical mag drop (R / X), slot
	switch (1 / 2 / wheel / Y) with draw time, dry-fire + auto reload, sprint
	interruption, AmmoSync reconciliation, hitmarkers from HitConfirm, and
	replicated shot FX for other players.
]]

local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local Trove = require(Shared.Trove)
local Types = require(Shared.Types)
local WeaponBuilder = require(Shared.Builders.WeaponBuilder)

local Controllers = script.Parent
local AudioController = require(Controllers.AudioController)
local CharacterPoser = require(Controllers.CharacterPoser)
local MovementController = require(Controllers.MovementController)
local TacticalCamera = require(Controllers.TacticalCamera)
local WeaponFx = require(Controllers.WeaponFx)
local HUD = require(Controllers.Parent.UI.HUD)

local player = Players.LocalPlayer
local KEYS = Config.Combat.Keybinds
local RENDER_NAME = "WeaponController"

local WeaponController = {}

local SLOTS: { Types.WeaponSlot } = { "Primary", "Secondary" }

type SlotState = {
	Id: string,
	Def: Types.WeaponDef,
	Mag: number,
	Reserve: number,
}

local character: Model? = nil
local humanoid: Humanoid? = nil
local root: BasePart? = nil
local trove: Trove.Trove? = nil
local slots: { [Types.WeaponSlot]: SlotState } = {}
local equipped: Types.WeaponSlot = "Primary"
local handles: WeaponBuilder.WeaponHandles? = nil

local firingHeld = false
local aimingHeld = false
local dryClicked = false
local nextShotTime = 0
local readyAt = 0
local bloom = 0
local shotId = 0
local reloading = false
local reloadStart = 0
local reloadEnd = 0
local reloadToken = 0
local lastAimSend = 0
local enabled = true
local rng = Random.new()

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local function current(): SlotState?
	return slots[equipped]
end

local function refreshRayFilter()
	local ignore: { Instance } = {}
	if character then
		table.insert(ignore, character)
	end
	for _, name in { "ClientFX", "WeaponFX" } do
		local f = Workspace:FindFirstChild(name)
		if f then
			table.insert(ignore, f)
		end
	end
	rayParams.FilterDescendantsInstances = ignore
end

local function resolveHandles(): WeaponBuilder.WeaponHandles?
	local model = character
	local state = current()
	if not model or not state then
		return nil
	end
	local h = handles
	if h and h.Model.Parent == model and h.Model.Name == "EquippedWeapon" and h.Model:GetAttribute("WeaponId") == state.Id then
		return h
	end
	local weaponModel = model:FindFirstChild("EquippedWeapon")
	if weaponModel and weaponModel:IsA("Model") and weaponModel:GetAttribute("WeaponId") == state.Id then
		handles = WeaponBuilder.resolve(weaponModel)
		return handles
	end
	handles = nil
	return nil
end

local function updateHudWeapon()
	local state = current()
	if not state then
		return
	end
	HUD.setWeapon(state.Def.DisplayName, state.Def.Combat.FireMode, state.Def.Combat.MagSize)
	HUD.setAmmo(state.Mag, state.Reserve)
end

local function currentSpread(): number
	local state = current()
	local r = root
	if not state or not r then
		return 0
	end
	local combat = state.Def.Combat
	local aim = TacticalCamera.getAim()
	local base = combat.HipSpread + (combat.AdsSpread - combat.HipSpread) * aim
	local v = r.AssemblyLinearVelocity
	local speed01 = math.clamp(Vector3.new(v.X, 0, v.Z).Magnitude / Config.Movement.WalkSpeed, 0, 1.5)
	local move = speed01 * combat.MoveSpread * (1 - aim * 0.6)
	local airborne = if humanoid and humanoid.FloorMaterial == Enum.Material.Air then 2 else 0
	local stanceMul = if MovementController.getStance() ~= "Stand" then 0.75 else 1
	return (base + move + bloom + airborne) * stanceMul
end

-- Uniform random direction inside a cone of half-angle `angle` (radians).
local function coneDirection(forward: Vector3, angle: number): Vector3
	if angle <= 0 then
		return forward
	end
	local cosMax = math.cos(angle)
	local z = cosMax + (1 - cosMax) * rng:NextNumber()
	local r = math.sqrt(math.max(0, 1 - z * z))
	local phi = rng:NextNumber() * 2 * math.pi
	local basis = CFrame.lookAt(Vector3.zero, forward)
	return basis:VectorToWorldSpace(Vector3.new(r * math.cos(phi), r * math.sin(phi), -z)).Unit
end

--------------------------------------------------------------------------------
-- Reload
--------------------------------------------------------------------------------
local function cancelReload()
	if not reloading then
		return
	end
	reloading = false
	reloadToken += 1
	HUD.setReload(nil)
	local h = handles
	if h then
		WeaponFx.restoreMagazine(h.Magazine)
	end
end

local function reload()
	local state = current()
	local h = resolveHandles()
	if not state or reloading or not h then
		return
	end
	local combat = state.Def.Combat
	if state.Mag >= combat.MagSize or state.Reserve <= 0 then
		return
	end
	reloading = true
	reloadToken += 1
	local token = reloadToken
	local duration = (if state.Mag == 0 then combat.EmptyReloadTime else combat.ReloadTime) + 0.1
	reloadStart = os.clock()
	reloadEnd = reloadStart + duration
	MovementController.interruptSprint(0.2)
	Net.event(Net.Events.Reload):FireServer()

	WeaponFx.sound("ReloadOut", h.Handle)
	WeaponFx.dropMagazine(h.Magazine, duration * 0.62)
	task.delay(duration * 0.62, function()
		if token == reloadToken and h.Handle.Parent then
			WeaponFx.sound("ReloadIn", h.Handle)
		end
	end)
	task.delay(duration, function()
		if token ~= reloadToken or not reloading then
			return
		end
		-- Predicted fill; AmmoSync from the server is authoritative.
		local take = math.min(combat.MagSize - state.Mag, state.Reserve)
		state.Mag += take
		state.Reserve -= take
		reloading = false
		HUD.setReload(nil)
		HUD.setAmmo(state.Mag, state.Reserve)
	end)
end

--------------------------------------------------------------------------------
-- Fire
--------------------------------------------------------------------------------
local function fireOnce(state: SlotState, h: WeaponBuilder.WeaponHandles)
	local combat = state.Def.Combat
	local camCF = TacticalCamera.getCFrame()
	local muzzle = h.Muzzle.WorldPosition

	-- 1. Aim point through the crosshair (ray starts level with the muzzle so
	--    things between the camera and the player are never targeted).
	local dir = coneDirection(camCF.LookVector, math.rad(currentSpread()))
	local startT = math.max((muzzle - camCF.Position):Dot(dir), 0)
	local aimOrigin = camCF.Position + dir * startT
	local aimHit = Workspace:Raycast(aimOrigin, dir * combat.Range, rayParams)
	local aimPoint = if aimHit then aimHit.Position else aimOrigin + dir * combat.Range

	-- 2. Bullet from the muzzle.
	local shotDir = aimPoint - muzzle
	if shotDir.Magnitude < 0.05 then
		shotDir = dir
	end
	shotDir = shotDir.Unit
	local hit = Workspace:Raycast(muzzle, shotDir * combat.Range, rayParams)
	local hitPos = if hit then hit.Position else muzzle + shotDir * combat.Range

	-- 3. Feedback
	WeaponFx.muzzleFlash(h.Muzzle, combat.Suppressed)
	WeaponFx.tracer(muzzle, hitPos, combat.TracerColor)
	if hit then
		WeaponFx.impact(hit.Position, hit.Normal, hit.Material.Name, hit.Instance)
	end
	local r = root
	WeaponFx.shell(h.Ejection, state.Def.Class, if r then r.AssemblyLinearVelocity else Vector3.zero)
	WeaponFx.sound(combat.FireSound, h.Muzzle, if combat.Suppressed then 0.55 else 1)

	local aim = TacticalCamera.getAim()
	local stanceMul = if MovementController.getStance() ~= "Stand" then 0.8 else 1
	local recoilScale = (1 - aim * 0.3) * stanceMul
	TacticalCamera.addRecoil(combat.RecoilPitch * recoilScale, rng:NextNumber(-combat.RecoilYaw, combat.RecoilYaw) * recoilScale, combat.RecoilRecovery)
	local kickBack = if state.Def.Class == "PISTOL" then 0.12 else 0.08
	CharacterPoser.kick(kickBack, math.rad(combat.RecoilPitch * 1.6))
	bloom = math.min(bloom + combat.SpreadPerShot, combat.MaxBloom)
	HUD.pulse(4 + combat.SpreadPerShot * 6)

	state.Mag -= 1
	HUD.setAmmo(state.Mag, state.Reserve)

	-- 4. Server
	shotId += 1
	Net.event(Net.Events.Fire):FireServer(shotId, muzzle, shotDir)
end

local function tryFire(): boolean
	local state = current()
	local h = humanoid
	if not state or not h or h.Health <= 0 then
		return false
	end
	local now = os.clock()
	if now < readyAt or reloading then
		return false
	end
	if MovementController.isSprinting() then
		MovementController.interruptSprint(0.35)
		readyAt = now + 0.12 -- sprint-out time
		return false
	end
	local weapon = resolveHandles()
	if not weapon then
		return false
	end
	if state.Mag <= 0 then
		if not dryClicked then
			dryClicked = true
			WeaponFx.sound("DryFire", weapon.Handle)
			if state.Reserve > 0 then
				task.delay(0.2, reload)
			end
		end
		return false
	end
	local interval = 60 / state.Def.Combat.RPM
	if now < nextShotTime then
		return false
	end
	if nextShotTime < now - interval then
		nextShotTime = now
	end
	nextShotTime += interval
	MovementController.interruptSprint(0.35)
	fireOnce(state, weapon)
	return true
end

--------------------------------------------------------------------------------
-- Equip
--------------------------------------------------------------------------------
local function equip(slot: Types.WeaponSlot)
	if slot == equipped or not slots[slot] then
		return
	end
	cancelReload()
	equipped = slot
	handles = nil
	local state = slots[slot]
	readyAt = os.clock() + state.Def.Combat.DrawTime
	nextShotTime = readyAt
	bloom = 0
	dryClicked = false
	Net.event(Net.Events.EquipSlot):FireServer(slot)
	AudioController.play("Equip")
	updateHudWeapon()
end

--------------------------------------------------------------------------------
-- Frame loop
--------------------------------------------------------------------------------
local function step(dt: number)
	local state = current()
	local h = humanoid
	if not state or not h then
		return
	end
	local combat = state.Def.Combat
	local alive = h.Health > 0 and enabled

	-- Aim
	local aiming = alive and aimingHeld and not reloading and os.clock() >= readyAt - combat.DrawTime * 0.5
	TacticalCamera.setAiming(aiming, combat.AdsFovMultiplier, combat.AdsTime)
	CharacterPoser.setLocalAim(aiming)
	MovementController.setAiming(aiming)
	MovementController.setSpeedMultiplier(combat.MoveSpeedMultiplier)

	-- Automatic fire
	if alive and firingHeld and combat.FireMode == "Auto" then
		local shots = 0
		while shots < 3 and tryFire() do
			shots += 1
		end
	end

	bloom = math.max(0, bloom - combat.BloomRecovery * dt)

	-- HUD
	local spread = currentSpread()
	HUD.setSpread(spread, TacticalCamera.getFieldOfView(), TacticalCamera.getAim(), not MovementController.isSprinting() and alive)
	HUD.setStamina(MovementController.getStamina01())
	if reloading then
		HUD.setReload((os.clock() - reloadStart) / math.max(reloadEnd - reloadStart, 0.01))
	end

	-- Replicate aim pitch for other players' views of you.
	local now = os.clock()
	if now - lastAimSend >= 1 / Config.Combat.AimSendRate then
		lastAimSend = now
		Net.unreliable(Net.Unreliable.AimState):FireServer(TacticalCamera.getPitch(), aiming)
	end
end

--------------------------------------------------------------------------------
-- Input
--------------------------------------------------------------------------------
local ACTIONS = { "WeaponFire", "WeaponAim", "WeaponReload", "WeaponPrimary", "WeaponSecondary", "WeaponSwap" }

local function bind()
	ContextActionService:BindAction("WeaponFire", function(_: string, state: Enum.UserInputState): Enum.ContextActionResult
		if state == Enum.UserInputState.Begin then
			firingHeld = true
			dryClicked = false
			local s = current()
			if s and s.Def.Combat.FireMode == "Semi" then
				tryFire()
			end
		elseif state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel then
			firingHeld = false
		end
		return Enum.ContextActionResult.Sink
	end, false, table.unpack(KEYS.Fire))

	ContextActionService:BindAction("WeaponAim", function(_: string, state: Enum.UserInputState): Enum.ContextActionResult
		if state == Enum.UserInputState.Begin then
			aimingHeld = true
		elseif state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel then
			aimingHeld = false
		end
		return Enum.ContextActionResult.Sink
	end, false, table.unpack(KEYS.Aim))

	ContextActionService:BindAction("WeaponReload", function(_: string, state: Enum.UserInputState): Enum.ContextActionResult
		if state == Enum.UserInputState.Begin then
			reload()
		end
		return Enum.ContextActionResult.Sink
	end, false, table.unpack(KEYS.Reload))

	ContextActionService:BindAction("WeaponPrimary", function(_: string, state: Enum.UserInputState): Enum.ContextActionResult
		if state == Enum.UserInputState.Begin then
			equip("Primary")
		end
		return Enum.ContextActionResult.Sink
	end, false, table.unpack(KEYS.Primary))

	ContextActionService:BindAction("WeaponSecondary", function(_: string, state: Enum.UserInputState): Enum.ContextActionResult
		if state == Enum.UserInputState.Begin then
			equip("Secondary")
		end
		return Enum.ContextActionResult.Sink
	end, false, table.unpack(KEYS.Secondary))

	ContextActionService:BindAction("WeaponSwap", function(_: string, state: Enum.UserInputState): Enum.ContextActionResult
		if state == Enum.UserInputState.Begin then
			equip(if equipped == "Primary" then "Secondary" else "Primary")
		end
		return Enum.ContextActionResult.Sink
	end, false, table.unpack(KEYS.SwapWeapon))
end

local function unbind()
	for _, name in ACTIONS do
		ContextActionService:UnbindAction(name)
	end
	firingHeld = false
	aimingHeld = false
end

--------------------------------------------------------------------------------
-- Network handlers (connected once)
--------------------------------------------------------------------------------
local function onAmmoSync(slot: any, mag: any, reserve: any, serverReloading: any)
	local state = slots[slot :: Types.WeaponSlot]
	if not state or typeof(mag) ~= "number" or typeof(reserve) ~= "number" then
		return
	end
	state.Mag = mag
	state.Reserve = reserve
	if slot == equipped then
		if serverReloading ~= true and reloading and os.clock() >= reloadEnd - 0.35 then
			reloading = false
			HUD.setReload(nil)
		end
		HUD.setAmmo(state.Mag, state.Reserve)
	end
end

local function onHitConfirm(kind: any, damage: any, position: any)
	if typeof(kind) ~= "string" then
		return
	end
	HUD.hitmarker(kind)
	if Config.Combat.DamageNumbers and kind ~= "Blocked" and typeof(damage) == "number" and typeof(position) == "Vector3" then
		WeaponFx.damageNumber(position, damage, kind)
	end
	if kind == "Kill" then
		AudioController.play("HitKill", 0.02)
	elseif kind == "Head" then
		AudioController.play("HitHead", 0.02)
	elseif kind == "Body" then
		AudioController.play("HitBody", 0.05)
	elseif kind == "Blocked" then
		HUD.toast("SAFE ZONE — PLAYERS PROTECTED")
	end
end

local function onShotFx(shooter: any, weaponId: any, origin: any, hitPos: any, normal: any, material: any)
	if typeof(shooter) ~= "Instance" or not shooter:IsA("Model") or shooter == character then
		return
	end
	if typeof(origin) ~= "Vector3" or typeof(hitPos) ~= "Vector3" or typeof(normal) ~= "Vector3" then
		return
	end
	local def = if typeof(weaponId) == "string" then Config.Weapons[weaponId] else nil
	if not def then
		return
	end
	local camera = Workspace.CurrentCamera
	local far = camera ~= nil and (camera.CFrame.Position - origin).Magnitude > 450

	local weaponModel = shooter:FindFirstChild("EquippedWeapon")
	local remote = if weaponModel and weaponModel:IsA("Model") then WeaponBuilder.resolve(weaponModel) else nil
	local from = if remote then remote.Muzzle.WorldPosition else origin
	if remote then
		WeaponFx.sound(def.Combat.FireSound, remote.Muzzle, if def.Combat.Suppressed then 0.55 else 1)
	end
	if far then
		return
	end
	if remote then
		WeaponFx.muzzleFlash(remote.Muzzle, def.Combat.Suppressed)
		WeaponFx.shell(remote.Ejection, def.Class, Vector3.zero)
	end
	WeaponFx.tracer(from, hitPos, def.Combat.TracerColor)
	if typeof(material) == "string" and material ~= "Air" then
		local probe = Workspace:Raycast(hitPos + normal * 0.2, -normal * 0.4, rayParams)
		WeaponFx.impact(hitPos, normal, material, if probe then probe.Instance else nil)
	end
end

--------------------------------------------------------------------------------
-- Public
--------------------------------------------------------------------------------
function WeaponController.init()
	WeaponFx.init()
	Net.event(Net.Events.AmmoSync).OnClientEvent:Connect(onAmmoSync)
	Net.event(Net.Events.HitConfirm).OnClientEvent:Connect(onHitConfirm)
	Net.unreliable(Net.Unreliable.ShotFx).OnClientEvent:Connect(onShotFx)

	UserInputService.InputChanged:Connect(function(input: InputObject, processed: boolean)
		if processed or not trove or input.UserInputType ~= Enum.UserInputType.MouseWheel then
			return
		end
		equip(if equipped == "Primary" then "Secondary" else "Primary")
	end)
end

-- Vehicles: weapons are holstered by the server; drop all weapon input.
function WeaponController.setEnabled(value: boolean)
	if enabled == value then
		return
	end
	enabled = value
	if not value then
		unbind()
		cancelReload()
		TacticalCamera.setAiming(false)
		CharacterPoser.setLocalAim(false)
	elseif trove then
		local state = current()
		readyAt = os.clock() + (if state then state.Def.Combat.DrawTime else 0.4)
		nextShotTime = readyAt
		handles = nil
		bind()
	end
end

function WeaponController.attach(model: Model, loadout: Types.Loadout)
	WeaponController.detach()
	local h = model:FindFirstChildOfClass("Humanoid")
	local r = model:FindFirstChild("HumanoidRootPart")
	if not h or not r or not r:IsA("BasePart") then
		return
	end
	character = model
	humanoid = h
	root = r
	enabled = true
	slots = {}
	for _, slot in SLOTS do
		local id = if slot == "Primary" then loadout.Primary else loadout.Secondary
		local def = Config.Weapons[id]
		slots[slot] = { Id = id, Def = def, Mag = def.Combat.MagSize, Reserve = def.Combat.Reserve }
	end
	equipped = "Primary"
	handles = nil
	reloading = false
	bloom = 0
	readyAt = os.clock() + slots.Primary.Def.Combat.DrawTime
	nextShotTime = readyAt
	refreshRayFilter()

	local t = Trove.new()
	trove = t
	t:BindToRenderStep(RENDER_NAME, Enum.RenderPriority.Camera.Value + 5, step)
	t:Connect(h.HealthChanged, function(health: number)
		HUD.setHealth(health, h.MaxHealth)
	end)
	t:Connect(h.Died, function()
		unbind()
		cancelReload()
		TacticalCamera.setAiming(false)
		HUD.hide()
	end)

	bind()
	HUD.resetHealth(h.MaxHealth)
	updateHudWeapon()
	HUD.show()
end

function WeaponController.detach()
	unbind()
	cancelReload()
	if trove then
		local t = trove
		trove = nil
		t:Clean()
	end
	TacticalCamera.setAiming(false)
	CharacterPoser.setLocalAim(false)
	HUD.hide(true)
	character = nil
	humanoid = nil
	root = nil
	handles = nil
end

return WeaponController
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000048"><Properties><string name="Name">WeaponFx</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	WeaponFx
	Client-side gunfire visuals and audio, used for your own predicted shots
	and for other players' replicated shots:

	  muzzleFlash   PointLight pop + star burst + smoke wisp (smaller if suppressed)
	  tracer        neon streak travelling at bullet speed, culled when done
	  impact        sparks on metal, dust elsewhere, hit puff on characters,
	                plus pooled bullet holes on static geometry
	  shell         physical brass ejecting right/up (Debris collision group)
	  dropMagazine  physical mag falls out during reloads
	  sound         3D one-shots at the muzzle (skipped if no asset id)
	  damageNumber  floating, colour-coded damage pop at the hit point
]]

local Debris = game:GetService("Debris")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)

local WeaponFx = {}

local SPARK = "rbxasset://textures/particles/sparkles_main.dds"
local SMOKE = "rbxasset://textures/particles/smoke_main.dds"
local TRACER_SPEED = 1100
local TRACER_LENGTH = 3.5
local MAX_TRACERS = 48
local MAX_HOLES = 60
local MAX_SHELLS = 30

local METALLIC: { [string]: boolean } = {
	Metal = true,
	DiamondPlate = true,
	CorrodedMetal = true,
	Foil = true,
}

type Tracer = {
	Part: BasePart,
	From: Vector3,
	Dir: Vector3,
	Total: number,
	Travelled: number,
}

local folder: Folder
local tracers: { Tracer } = {}
local holes: { BasePart } = {}
local shells: { BasePart } = {}
local rng = Random.new()

local function particle(parent: Instance, name: string, props: { [string]: any }): ParticleEmitter
	local emitter = Instance.new("ParticleEmitter")
	emitter.Name = name
	emitter.Enabled = false
	emitter.Rate = 0
	for key, value in props do
		(emitter :: any)[key] = value
	end
	emitter.Parent = parent
	return emitter
end

-- Lazily equips a muzzle attachment with its flash rig.
local function flashRig(muzzle: Attachment): (PointLight, ParticleEmitter, ParticleEmitter)
	local light = muzzle:FindFirstChild("FxFlash")
	local core = muzzle:FindFirstChild("FxFlashCore")
	local smoke = muzzle:FindFirstChild("FxFlashSmoke")
	if light and light:IsA("PointLight") and core and core:IsA("ParticleEmitter") and smoke and smoke:IsA("ParticleEmitter") then
		return light, core, smoke
	end
	local newLight = Instance.new("PointLight")
	newLight.Name = "FxFlash"
	newLight.Color = Color3.fromRGB(255, 190, 110)
	newLight.Range = 12
	newLight.Brightness = 8
	newLight.Shadows = false
	newLight.Enabled = false
	newLight.Parent = muzzle
	local newCore = particle(muzzle, "FxFlashCore", {
		Texture = SPARK,
		LightEmission = 1,
		LightInfluence = 0,
		LockedToPart = true,
		Lifetime = NumberRange.new(0.04, 0.06),
		Speed = NumberRange.new(0, 0),
		Rotation = NumberRange.new(0, 360),
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.7), NumberSequenceKeypoint.new(1, 0.1) }),
		Color = ColorSequence.new(Color3.fromRGB(255, 200, 120), Color3.fromRGB(255, 120, 40)),
		ZOffset = 0.5,
	})
	local newSmoke = particle(muzzle, "FxFlashSmoke", {
		Texture = SMOKE,
		EmissionDirection = Enum.NormalId.Front,
		LightInfluence = 1,
		Lifetime = NumberRange.new(0.4, 0.8),
		Speed = NumberRange.new(2, 4),
		SpreadAngle = Vector2.new(15, 15),
		Drag = 3,
		Acceleration = Vector3.new(0, 1.5, 0),
		Rotation = NumberRange.new(0, 360),
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1.2) }),
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.7), NumberSequenceKeypoint.new(1, 1) }),
		Color = ColorSequence.new(Color3.fromRGB(170, 170, 170)),
	})
	return newLight, newCore, newSmoke
end

function WeaponFx.muzzleFlash(muzzle: Attachment, suppressed: boolean)
	local light, core, smoke = flashRig(muzzle)
	light.Brightness = if suppressed then 2.5 else 8
	light.Range = if suppressed then 7 else 12
	light.Enabled = true
	task.delay(0.045, function()
		light.Enabled = false
	end)
	if not suppressed then
		core:Emit(2)
	end
	smoke:Emit(if suppressed then 2 else 1)
end

function WeaponFx.tracer(from: Vector3, to: Vector3, color: Color3)
	local offset = to - from
	local total = offset.Magnitude
	if total < 4 then
		return
	end
	if #tracers >= MAX_TRACERS then
		local oldest = table.remove(tracers, 1)
		if oldest then
			oldest.Part:Destroy()
		end
	end
	local part = Instance.new("Part")
	part.Name = "Tracer"
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Material = Enum.Material.Neon
	part.Color = color
	part.Transparency = 0.25
	part.Size = Vector3.new(0.05, 0.05, 0.1)
	part.CFrame = CFrame.lookAt(from, to)
	part.Parent = folder
	table.insert(tracers, { Part = part, From = from, Dir = offset.Unit, Total = total, Travelled = 0 })
end

local function updateTracers(dt: number)
	for i = #tracers, 1, -1 do
		local t = tracers[i]
		t.Travelled += TRACER_SPEED * dt
		local headDist = math.min(t.Travelled, t.Total)
		local tailDist = math.clamp(t.Travelled - TRACER_LENGTH, 0, t.Total)
		if tailDist >= t.Total then
			t.Part:Destroy()
			table.remove(tracers, i)
		else
			local head = t.From + t.Dir * headDist
			local tail = t.From + t.Dir * tailDist
			local length = math.max((head - tail).Magnitude, 0.05)
			t.Part.Size = Vector3.new(0.05, 0.05, length)
			t.Part.CFrame = CFrame.lookAt((head + tail) / 2, head)
		end
	end
end

local function burst(position: Vector3, normal: Vector3, props: { [string]: any }, count: number)
	local attachment = Instance.new("Attachment")
	attachment.WorldCFrame = CFrame.lookAt(position, position + normal)
	attachment.Parent = Workspace.Terrain
	local emitter = particle(attachment, "Burst", props)
	emitter.EmissionDirection = Enum.NormalId.Front
	emitter:Emit(count)
	Debris:AddItem(attachment, 2)
end

function WeaponFx.impact(position: Vector3, normal: Vector3, materialName: string, hitInstance: Instance?)
	local isCharacter = false
	if hitInstance then
		local model = hitInstance:FindFirstAncestorOfClass("Model")
		isCharacter = model ~= nil and model:FindFirstChildOfClass("Humanoid") ~= nil
	end

	if isCharacter then
		burst(position, normal, {
			Texture = SMOKE,
			LightInfluence = 1,
			Lifetime = NumberRange.new(0.2, 0.35),
			Speed = NumberRange.new(2, 5),
			SpreadAngle = Vector2.new(40, 40),
			Drag = 4,
			Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 0.9) }),
			Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(1, 1) }),
			Color = ColorSequence.new(Color3.fromRGB(110, 20, 20)),
		}, 4)
		return
	end

	if METALLIC[materialName] then
		burst(position, normal, {
			Texture = SPARK,
			LightEmission = 1,
			LightInfluence = 0,
			Orientation = Enum.ParticleOrientation.VelocityParallel,
			Lifetime = NumberRange.new(0.12, 0.3),
			Speed = NumberRange.new(14, 28),
			SpreadAngle = Vector2.new(55, 55),
			Acceleration = Vector3.new(0, -60, 0),
			Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.12), NumberSequenceKeypoint.new(1, 0) }),
			Squash = NumberSequence.new(-2),
			Color = ColorSequence.new(Color3.fromRGB(255, 210, 140), Color3.fromRGB(255, 120, 40)),
		}, 9)
	end
	burst(position, normal, {
		Texture = SMOKE,
		LightInfluence = 1,
		Lifetime = NumberRange.new(0.5, 1.0),
		Speed = NumberRange.new(2, 5),
		SpreadAngle = Vector2.new(30, 30),
		Drag = 3,
		Acceleration = Vector3.new(0, -2, 0),
		Rotation = NumberRange.new(0, 360),
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(1, 1.6) }),
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.55), NumberSequenceKeypoint.new(1, 1) }),
		Color = ColorSequence.new(Color3.fromRGB(120, 112, 104)),
	}, if METALLIC[materialName] then 2 else 5)

	-- Bullet hole on static geometry only.
	if hitInstance and hitInstance:IsA("BasePart") and hitInstance.Anchored then
		local hole = Instance.new("Part")
		hole.Name = "BulletHole"
		hole.Shape = Enum.PartType.Cylinder
		hole.Size = Vector3.new(0.02, 0.16, 0.16)
		hole.Anchored = true
		hole.CanCollide = false
		hole.CanQuery = false
		hole.CanTouch = false
		hole.CastShadow = false
		hole.Material = Enum.Material.SmoothPlastic
		hole.Color = Color3.fromRGB(14, 13, 12)
		hole.CFrame = CFrame.lookAt(position + normal * 0.012, position + normal * 2) * CFrame.Angles(0, math.rad(90), 0)
		hole.Parent = folder
		table.insert(holes, hole)
		if #holes > MAX_HOLES then
			local old = table.remove(holes, 1)
			if old then
				old:Destroy()
			end
		end
	end
end

local function debrisPart(name: string, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material): BasePart
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.CFrame = cf
	part.Color = color
	part.Material = material
	part.CanCollide = true
	part.CanQuery = false
	part.CanTouch = false
	part.Massless = true
	part.CollisionGroup = "Debris"
	part.Parent = folder
	return part
end

function WeaponFx.shell(ejection: Attachment, class: string, inheritVelocity: Vector3)
	local cf = ejection.WorldCFrame
	local length = if class == "PISTOL" then 0.1 else 0.16
	local shell = debrisPart("Shell", Vector3.new(0.05, 0.05, length), cf, Color3.fromRGB(190, 150, 70), Enum.Material.Metal)
	shell.Reflectance = 0.2
	shell.AssemblyLinearVelocity = inheritVelocity + cf.RightVector * rng:NextNumber(6, 9) + cf.UpVector * rng:NextNumber(4, 6) + cf.LookVector * rng:NextNumber(-1, 1)
	shell.AssemblyAngularVelocity = Vector3.new(rng:NextNumber(-30, 30), rng:NextNumber(-30, 30), rng:NextNumber(-30, 30))
	table.insert(shells, shell)
	if #shells > MAX_SHELLS then
		local old = table.remove(shells, 1)
		if old then
			old:Destroy()
		end
	end
	Debris:AddItem(shell, 2.5)
end

-- Clones the magazine parts as falling debris and hides the originals until restoreAfter.
function WeaponFx.dropMagazine(parts: { BasePart }, restoreAfter: number)
	if #parts == 0 then
		return
	end
	local first: BasePart? = nil
	for _, original in parts do
		local copy = debrisPart("DroppedMag", original.Size, original.CFrame, original.Color, original.Material)
		if first then
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = first
			weld.Part1 = copy
			weld.Parent = copy
		else
			first = copy
		end
		Debris:AddItem(copy, 4)
		original.LocalTransparencyModifier = 1
	end
	local lead = first
	if lead then
		lead.AssemblyLinearVelocity = Vector3.new(0, -4, 0)
		lead.AssemblyAngularVelocity = Vector3.new(rng:NextNumber(-4, 4), 0, rng:NextNumber(-4, 4))
	end
	task.delay(restoreAfter, function()
		for _, original in parts do
			original.LocalTransparencyModifier = 0
		end
	end)
end

function WeaponFx.restoreMagazine(parts: { BasePart })
	for _, original in parts do
		original.LocalTransparencyModifier = 0
	end
end

function WeaponFx.sound(name: string, at: Instance, volumeScale: number?)
	local def = Config.Audio[name]
	if not def or def.Id == "" then
		return
	end
	local sound = Instance.new("Sound")
	sound.SoundId = def.Id
	sound.Volume = def.Volume * (volumeScale or 1)
	sound.PlaybackSpeed = def.Speed * rng:NextNumber(0.95, 1.05)
	sound.RollOffMode = Enum.RollOffMode.InverseTapered
	sound.RollOffMinDistance = 8
	sound.RollOffMaxDistance = 350
	local group = game:GetService("SoundService"):FindFirstChild(def.Group)
	if group and group:IsA("SoundGroup") then
		sound.SoundGroup = group
	end
	sound.Parent = at
	sound:Play()
	Debris:AddItem(sound, 4)
end

local DAMAGE_COLORS: { [string]: Color3 } = {
	Body = Color3.fromRGB(255, 255, 255),
	Head = Color3.fromRGB(255, 70, 70),
	Kill = Color3.fromRGB(255, 200, 80),
}

-- Floating damage number: pops in, drifts up and sideways, fades out.
function WeaponFx.damageNumber(position: Vector3, damage: number, kind: string)
	local color = DAMAGE_COLORS[kind] or DAMAGE_COLORS.Body
	local big = kind == "Head" or kind == "Kill"

	local anchor = Instance.new("Attachment")
	anchor.Name = "DamageNumber"
	anchor.WorldPosition = position
	anchor.Parent = Workspace.Terrain

	local gui = Instance.new("BillboardGui")
	gui.Adornee = anchor
	gui.AlwaysOnTop = true
	gui.LightInfluence = 0
	gui.MaxDistance = 400
	gui.Size = UDim2.fromOffset(140, 44)
	gui.StudsOffsetWorldSpace = Vector3.new(rng:NextNumber(-0.6, 0.6), 0.6, 0)
	gui.Parent = anchor

	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Text = tostring(math.max(1, math.round(damage)))
	label.TextColor3 = color
	label.TextScaled = false
	label.TextSize = if big then 30 else 22
	label.FontFace = Font.new("rbxasset://fonts/families/Montserrat.json", Enum.FontWeight.ExtraBold)
	label.Parent = gui
	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.new(0, 0, 0)
	stroke.Thickness = 1.5
	stroke.Transparency = 0.25
	stroke.Parent = label
	local scale = Instance.new("UIScale")
	scale.Scale = if big then 1.7 else 1.35
	scale.Parent = label

	if kind == "Head" or kind == "Kill" then
		local tag = Instance.new("TextLabel")
		tag.BackgroundTransparency = 1
		tag.AnchorPoint = Vector2.new(0.5, 0)
		tag.Position = UDim2.fromScale(0.5, 0.92)
		tag.Size = UDim2.fromOffset(140, 14)
		tag.Text = if kind == "Kill" then "ELIMINATED" else "HEADSHOT"
		tag.TextColor3 = color
		tag.TextSize = 11
		tag.FontFace = Font.new("rbxasset://fonts/families/RobotoMono.json", Enum.FontWeight.Bold)
		tag.Parent = label
		local tagStroke = stroke:Clone()
		tagStroke.Parent = tag
	end

	local pop = TweenInfo.new(0.18, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
	TweenService:Create(scale, pop, { Scale = 1 }):Play()
	local drift = TweenInfo.new(0.9, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
	TweenService:Create(gui, drift, {
		StudsOffsetWorldSpace = gui.StudsOffsetWorldSpace + Vector3.new(rng:NextNumber(-0.5, 0.5), 2.2, 0),
	}):Play()
	local fade = TweenInfo.new(0.35, Enum.EasingStyle.Sine, Enum.EasingDirection.In, 0, false, if big then 0.75 else 0.5)
	TweenService:Create(label, fade, { TextTransparency = 1 }):Play()
	TweenService:Create(stroke, fade, { Transparency = 1 }):Play()
	for _, child in label:GetChildren() do
		if child:IsA("TextLabel") then
			TweenService:Create(child, fade, { TextTransparency = 1 }):Play()
			local childStroke = child:FindFirstChildOfClass("UIStroke")
			if childStroke then
				TweenService:Create(childStroke, fade, { Transparency = 1 }):Play()
			end
		end
	end
	Debris:AddItem(anchor, 1.4)
end

function WeaponFx.getFolder(): Folder
	return folder
end

function WeaponFx.init()
	local f = Instance.new("Folder")
	f.Name = "WeaponFX"
	f.Parent = Workspace
	folder = f
	RunService.RenderStepped:Connect(updateTracers)
end

return WeaponFx
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX000055"><Properties><string name="Name">UI</string></Properties><Item class="ModuleScript" referent="RBX000050"><Properties><string name="Name">HUD</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	HUD
	Minimal combat HUD, same typography as the menu:

	  centre        dynamic crosshair (gap = real cone of fire in pixels),
	                shrinks to a dot when aiming, hides while sprinting
	  centre        hitmarker: white body, red head, gold kill (+ grey when the
	                target is protected, e.g. players in the safe zone)
	  bottom-right  weapon name, fire mode, big magazine count / reserve,
	                reload progress line, low-ammo tint
	  bottom-centre stamina line (fades out when full)
	  bottom-left   health line + number, red edge flash on damage
	  top-centre    short toasts (weapon switch, "SAFE ZONE")
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Theme = require(script.Parent.Theme)
local Widgets = require(script.Parent.Widgets)

local HUD = {}

local gui: ScreenGui
local root: CanvasGroup
local crosshair: Frame
local lines: { Frame } = {}
local dot: Frame
local hitmarker: Frame
local hitScale: UIScale
local hitLines: { Frame } = {}
local ammoMag: TextLabel
local ammoReserve: TextLabel
local weaponLabel: TextLabel
local modeLabel: TextLabel
local reloadTrack: Frame
local reloadFill: Frame
local staminaTrack: Frame
local staminaFill: Frame
local healthFill: Frame
local healthLabel: TextLabel
local damageEdges: Frame
local toastLabel: TextLabel
local scales: { UIScale } = {}
local ammoFrame: Frame
local vehicleFrame: Frame
local speedLabel: TextLabel
local gearLabel: TextLabel
local rpmFill: Frame
local carryLabel: TextLabel
local mode: "OnFoot" | "Vehicle" | "Passenger" = "OnFoot"
local shownSpeed = 0

local gapTarget = 12
local gap = 12
local pulse = 0
local crosshairAlphaTarget = 1
local crosshairAlpha = 1
local dotOnly = 0
local staminaShown = 0
local staminaTarget = 0
local lastHealth = 100
local hitToken = 0
local toastToken = 0
local magSize = 30

local HIT_COLORS: { [string]: Color3 } = {
	Body = Color3.fromRGB(255, 255, 255),
	Head = Color3.fromRGB(255, 70, 70),
	Kill = Color3.fromRGB(255, 200, 80),
	Blocked = Color3.fromRGB(140, 140, 140),
}

local function line(parent: Instance, name: string, size: UDim2): Frame
	local frame = Widgets.frame(parent, {
		Name = name,
		Size = size,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Color = Theme.Colors.White,
		Transparency = 0,
	})
	local stroke = Instance.new("UIStroke")
	stroke.Color = Theme.Colors.Black
	stroke.Transparency = 0.6
	stroke.Thickness = 1
	stroke.Parent = frame
	return frame
end

local function scaled(frame: Instance)
	local s = Instance.new("UIScale")
	s.Parent = frame
	table.insert(scales, s)
end

local function build()
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
	gui = Instance.new("ScreenGui")
	gui.Name = "HUD"
	gui.IgnoreGuiInset = true
	gui.ResetOnSpawn = false
	gui.DisplayOrder = 6
	gui.Enabled = false
	gui.Parent = playerGui

	local group = Instance.new("CanvasGroup")
	group.Name = "Root"
	group.Size = UDim2.fromScale(1, 1)
	group.BackgroundTransparency = 1
	group.GroupTransparency = 1
	group.Parent = gui
	root = group

	-- Damage edges (outside the scaled panels, full screen)
	damageEdges = Widgets.frame(root, { Name = "DamageEdges", Size = UDim2.fromScale(1, 1) })
	for _, spec in {
		{ UDim2.fromScale(0.25, 1), UDim2.new(), Vector2.zero, 0 },
		{ UDim2.fromScale(0.25, 1), UDim2.fromScale(1, 0), Vector2.new(1, 0), 180 },
		{ UDim2.fromScale(1, 0.25), UDim2.new(), Vector2.zero, 90 },
		{ UDim2.fromScale(1, 0.25), UDim2.fromScale(0, 1), Vector2.new(0, 1), -90 },
	} do
		local edge = Widgets.frame(damageEdges, {
			Name = "Edge",
			Size = spec[1],
			Position = spec[2],
			AnchorPoint = spec[3],
			Color = Color3.fromRGB(160, 0, 0),
			Transparency = 0,
		})
		local gradient = Instance.new("UIGradient")
		gradient.Rotation = spec[4]
		gradient.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1) })
		gradient.Parent = edge
	end
	damageEdges.Visible = false

	-- Crosshair
	crosshair = Widgets.frame(root, {
		Name = "Crosshair",
		Size = UDim2.fromOffset(200, 200),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
	})
	for i = 1, 4 do
		local horizontal = i <= 2
		lines[i] = line(crosshair, "Line" .. i, if horizontal then UDim2.fromOffset(10, 2) else UDim2.fromOffset(2, 10))
	end
	dot = line(crosshair, "Dot", UDim2.fromOffset(3, 3))
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(1, 0)
	corner.Parent = dot

	-- Hitmarker
	hitmarker = Widgets.frame(root, {
		Name = "Hitmarker",
		Size = UDim2.fromOffset(60, 60),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
	})
	hitScale = Instance.new("UIScale")
	hitScale.Parent = hitmarker
	for i, angle in { 45, 135, 225, 315 } do
		local rad = math.rad(angle)
		local hm = line(hitmarker, "Tick" .. i, UDim2.fromOffset(10, 2))
		hm.Position = UDim2.new(0.5, math.cos(rad) * 11, 0.5, -math.sin(rad) * 11)
		hm.Rotation = -angle
		hm.BackgroundTransparency = 1
		local stroke = hm:FindFirstChildOfClass("UIStroke")
		if stroke then
			stroke.Transparency = 1
		end
		hitLines[i] = hm
	end

	-- Ammo (bottom-right)
	local ammo = Widgets.frame(root, {
		Name = "Ammo",
		Size = UDim2.fromOffset(300, 110),
		Position = UDim2.fromScale(0.955, 0.925),
		AnchorPoint = Vector2.new(1, 1),
	})
	scaled(ammo)
	weaponLabel = Widgets.label(ammo, {
		Name = "Weapon",
		Text = "",
		Font = Theme.Fonts.MonoBold,
		TextSize = 11,
		Color = Theme.Colors.Text,
		Transparency = 0.25,
		Size = UDim2.new(1, 0, 0, 16),
		XAlign = Enum.TextXAlignment.Right,
	})
	modeLabel = Widgets.label(ammo, {
		Name = "Mode",
		Text = "",
		Font = Theme.Fonts.Mono,
		TextSize = 10,
		Color = Theme.Colors.Accent,
		Size = UDim2.new(1, 0, 0, 14),
		Position = UDim2.fromOffset(0, 16),
		XAlign = Enum.TextXAlignment.Right,
	})
	ammoReserve = Widgets.label(ammo, {
		Name = "Reserve",
		Text = "",
		Font = Theme.Fonts.Mono,
		TextSize = 16,
		Color = Theme.Colors.Dim,
		Size = UDim2.fromOffset(80, 48),
		Position = UDim2.new(1, 0, 0, 34),
		AnchorPoint = Vector2.new(1, 0),
		XAlign = Enum.TextXAlignment.Right,
		YAlign = Enum.TextYAlignment.Bottom,
	})
	ammoMag = Widgets.label(ammo, {
		Name = "Mag",
		Text = "",
		Font = Theme.Fonts.Display,
		TextSize = 46,
		Size = UDim2.fromOffset(140, 52),
		Position = UDim2.new(1, -86, 0, 30),
		AnchorPoint = Vector2.new(1, 0),
		XAlign = Enum.TextXAlignment.Right,
		YAlign = Enum.TextYAlignment.Bottom,
	})
	reloadTrack = Widgets.frame(ammo, {
		Name = "ReloadTrack",
		Size = UDim2.fromOffset(160, 2),
		Position = UDim2.new(1, 0, 0, 92),
		AnchorPoint = Vector2.new(1, 0),
		Color = Theme.Colors.White,
		Transparency = 0.85,
	})
	reloadFill = Widgets.frame(reloadTrack, { Name = "Fill", Size = UDim2.fromScale(0, 1), Color = Theme.Colors.Accent, Transparency = 0 })
	reloadTrack.Visible = false
	ammoFrame = ammo

	-- Vehicle cluster (bottom-right, replaces ammo while driving)
	local vehicle = Widgets.frame(root, {
		Name = "Vehicle",
		Size = UDim2.fromOffset(300, 110),
		Position = UDim2.fromScale(0.955, 0.925),
		AnchorPoint = Vector2.new(1, 1),
	})
	scaled(vehicle)
	vehicle.Visible = false
	vehicleFrame = vehicle
	Widgets.label(vehicle, {
		Name = "Caption",
		Text = Theme.track("ZABOUR  ·  KM/H"),
		Font = Theme.Fonts.MonoBold,
		TextSize = 11,
		Transparency = 0.25,
		Size = UDim2.new(1, 0, 0, 16),
		XAlign = Enum.TextXAlignment.Right,
	})
	gearLabel = Widgets.label(vehicle, {
		Name = "Gear",
		Text = "N",
		Font = Theme.Fonts.Heading,
		TextSize = 26,
		Color = Theme.Colors.Accent,
		Size = UDim2.fromOffset(40, 52),
		Position = UDim2.new(1, 0, 0, 30),
		AnchorPoint = Vector2.new(1, 0),
		XAlign = Enum.TextXAlignment.Right,
		YAlign = Enum.TextYAlignment.Bottom,
	})
	speedLabel = Widgets.label(vehicle, {
		Name = "Speed",
		Text = "0",
		Font = Theme.Fonts.Display,
		TextSize = 46,
		Size = UDim2.fromOffset(160, 52),
		Position = UDim2.new(1, -52, 0, 30),
		AnchorPoint = Vector2.new(1, 0),
		XAlign = Enum.TextXAlignment.Right,
		YAlign = Enum.TextYAlignment.Bottom,
	})
	local rpmTrack = Widgets.frame(vehicle, {
		Name = "RpmTrack",
		Size = UDim2.fromOffset(200, 2),
		Position = UDim2.new(1, 0, 0, 92),
		AnchorPoint = Vector2.new(1, 0),
		Color = Theme.Colors.White,
		Transparency = 0.85,
	})
	rpmFill = Widgets.frame(rpmTrack, { Name = "Fill", Size = UDim2.fromScale(0, 1), Color = Theme.Colors.Text, Transparency = 0 })

	carryLabel = Widgets.label(root, {
		Name = "Carry",
		Text = "",
		Font = Theme.Fonts.MonoBold,
		TextSize = 12,
		Color = Theme.Colors.Accent,
		Transparency = 1,
		Size = UDim2.fromOffset(500, 18),
		Position = UDim2.fromScale(0.5, 0.86),
		AnchorPoint = Vector2.new(0.5, 0.5),
		XAlign = Enum.TextXAlignment.Center,
	})
	scaled(carryLabel)

	-- Stamina (bottom-centre)
	staminaTrack = Widgets.frame(root, {
		Name = "Stamina",
		Size = UDim2.fromOffset(200, 2),
		Position = UDim2.fromScale(0.5, 0.9),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Color = Theme.Colors.White,
		Transparency = 1,
	})
	scaled(staminaTrack)
	staminaFill = Widgets.frame(staminaTrack, { Name = "Fill", Size = UDim2.fromScale(1, 1), Color = Theme.Colors.Text, Transparency = 1 })

	-- Health (bottom-left)
	local health = Widgets.frame(root, {
		Name = "Health",
		Size = UDim2.fromOffset(240, 50),
		Position = UDim2.fromScale(0.045, 0.925),
		AnchorPoint = Vector2.new(0, 1),
	})
	scaled(health)
	Widgets.label(health, {
		Name = "Caption",
		Text = Theme.track("VITALS"),
		Font = Theme.Fonts.MonoBold,
		TextSize = 10,
		Color = Theme.Colors.Dim,
		Size = UDim2.new(1, 0, 0, 14),
	})
	healthLabel = Widgets.label(health, {
		Name = "Value",
		Text = "100",
		Font = Theme.Fonts.Heading,
		TextSize = 22,
		Size = UDim2.new(1, 0, 0, 26),
		Position = UDim2.fromOffset(0, 14),
	})
	local healthTrack = Widgets.frame(health, {
		Name = "Track",
		Size = UDim2.fromOffset(180, 2),
		Position = UDim2.fromOffset(0, 44),
		Color = Theme.Colors.White,
		Transparency = 0.85,
	})
	healthFill = Widgets.frame(healthTrack, { Name = "Fill", Size = UDim2.fromScale(1, 1), Color = Theme.Colors.Text, Transparency = 0 })

	toastLabel = Widgets.label(root, {
		Name = "Toast",
		Text = "",
		Font = Theme.Fonts.MonoBold,
		TextSize = 12,
		Color = Theme.Colors.Text,
		Transparency = 1,
		Size = UDim2.fromOffset(500, 20),
		Position = UDim2.fromScale(0.5, 0.14),
		AnchorPoint = Vector2.new(0.5, 0.5),
		XAlign = Enum.TextXAlignment.Center,
	})

	local function rescale()
		local camera = Workspace.CurrentCamera
		local s = math.clamp((if camera then camera.ViewportSize.Y else 1080) / 1080, 0.62, 1.35)
		for _, scale in scales do
			scale.Scale = s
		end
	end
	rescale()
	local camera = Workspace.CurrentCamera
	if camera then
		camera:GetPropertyChangedSignal("ViewportSize"):Connect(rescale)
	end
end

local function render(dt: number)
	if not gui.Enabled then
		return
	end
	local k = 1 - math.exp(-dt * 18)
	pulse *= math.exp(-dt * 14)
	gap += (gapTarget + pulse - gap) * k
	crosshairAlpha += (crosshairAlphaTarget - crosshairAlpha) * (1 - math.exp(-dt * 12))
	local g = gap * (1 - dotOnly) + 2

	lines[1].Position = UDim2.new(0.5, -g - 5, 0.5, 0)
	lines[2].Position = UDim2.new(0.5, g + 5, 0.5, 0)
	lines[3].Position = UDim2.new(0.5, 0, 0.5, -g - 5)
	lines[4].Position = UDim2.new(0.5, 0, 0.5, g + 5)
	local lineAlpha = 1 - crosshairAlpha * (1 - dotOnly)
	for _, l in lines do
		l.BackgroundTransparency = lineAlpha
		local stroke = l:FindFirstChildOfClass("UIStroke")
		if stroke then
			stroke.Transparency = 0.6 + 0.4 * lineAlpha
		end
	end
	dot.BackgroundTransparency = 1 - crosshairAlpha * 0.9

	staminaShown += (staminaTarget - staminaShown) * (1 - math.exp(-dt * 10))
	staminaFill.Size = UDim2.fromScale(staminaShown, 1)
	local staminaVisible = if staminaTarget < 0.995 then 1 else 0
	local staminaAlpha = staminaTrack:GetAttribute("Alpha")
	local current = if typeof(staminaAlpha) == "number" then staminaAlpha else 0
	current += (staminaVisible - current) * (1 - math.exp(-dt * (if staminaVisible > 0 then 10 else 2)))
	staminaTrack:SetAttribute("Alpha", current)
	staminaTrack.BackgroundTransparency = 1 - current * 0.15
	staminaFill.BackgroundTransparency = 1 - current * 0.9
end

function HUD.init()
	build()
	RunService.RenderStepped:Connect(render)
end

function HUD.show()
	gui.Enabled = true
	Widgets.tween(root, Theme.Tween.Fade, { GroupTransparency = 0 })
end

function HUD.hide(instant: boolean?)
	if instant then
		root.GroupTransparency = 1
		gui.Enabled = false
		return
	end
	local tween = Widgets.tween(root, Theme.Tween.Medium, { GroupTransparency = 1 })
	tween.Completed:Once(function()
		if root.GroupTransparency >= 0.99 then
			gui.Enabled = false
		end
	end)
end

function HUD.setWeapon(name: string, fireMode: string, size: number)
	magSize = size
	weaponLabel.Text = Theme.track(name)
	modeLabel.Text = Theme.track(string.upper(fireMode))
	HUD.toast(name)
end

function HUD.setAmmo(mag: number, reserve: number)
	ammoMag.Text = tostring(mag)
	ammoReserve.Text = "/ " .. tostring(reserve)
	local low = mag <= math.max(1, math.floor(magSize * 0.25))
	ammoMag.TextColor3 = if mag == 0 then Theme.Colors.Danger elseif low then Theme.Colors.Accent else Theme.Colors.Text
end

function HUD.setReload(progress: number?)
	if progress == nil then
		reloadTrack.Visible = false
	ammoFrame = ammo

	-- Vehicle cluster (bottom-right, replaces ammo while driving)
	local vehicle = Widgets.frame(root, {
		Name = "Vehicle",
		Size = UDim2.fromOffset(300, 110),
		Position = UDim2.fromScale(0.955, 0.925),
		AnchorPoint = Vector2.new(1, 1),
	})
	scaled(vehicle)
	vehicle.Visible = false
	vehicleFrame = vehicle
	Widgets.label(vehicle, {
		Name = "Caption",
		Text = Theme.track("ZABOUR  ·  KM/H"),
		Font = Theme.Fonts.MonoBold,
		TextSize = 11,
		Transparency = 0.25,
		Size = UDim2.new(1, 0, 0, 16),
		XAlign = Enum.TextXAlignment.Right,
	})
	gearLabel = Widgets.label(vehicle, {
		Name = "Gear",
		Text = "N",
		Font = Theme.Fonts.Heading,
		TextSize = 26,
		Color = Theme.Colors.Accent,
		Size = UDim2.fromOffset(40, 52),
		Position = UDim2.new(1, 0, 0, 30),
		AnchorPoint = Vector2.new(1, 0),
		XAlign = Enum.TextXAlignment.Right,
		YAlign = Enum.TextYAlignment.Bottom,
	})
	speedLabel = Widgets.label(vehicle, {
		Name = "Speed",
		Text = "0",
		Font = Theme.Fonts.Display,
		TextSize = 46,
		Size = UDim2.fromOffset(160, 52),
		Position = UDim2.new(1, -52, 0, 30),
		AnchorPoint = Vector2.new(1, 0),
		XAlign = Enum.TextXAlignment.Right,
		YAlign = Enum.TextYAlignment.Bottom,
	})
	local rpmTrack = Widgets.frame(vehicle, {
		Name = "RpmTrack",
		Size = UDim2.fromOffset(200, 2),
		Position = UDim2.new(1, 0, 0, 92),
		AnchorPoint = Vector2.new(1, 0),
		Color = Theme.Colors.White,
		Transparency = 0.85,
	})
	rpmFill = Widgets.frame(rpmTrack, { Name = "Fill", Size = UDim2.fromScale(0, 1), Color = Theme.Colors.Text, Transparency = 0 })

	carryLabel = Widgets.label(root, {
		Name = "Carry",
		Text = "",
		Font = Theme.Fonts.MonoBold,
		TextSize = 12,
		Color = Theme.Colors.Accent,
		Transparency = 1,
		Size = UDim2.fromOffset(500, 18),
		Position = UDim2.fromScale(0.5, 0.86),
		AnchorPoint = Vector2.new(0.5, 0.5),
		XAlign = Enum.TextXAlignment.Center,
	})
	scaled(carryLabel)
		return
	end
	reloadTrack.Visible = true
	reloadFill.Size = UDim2.fromScale(math.clamp(progress, 0, 1), 1)
end

function HUD.setStamina(alpha: number)
	staminaTarget = math.clamp(alpha, 0, 1)
end

-- spreadDeg = current cone half-angle; converted to pixels from the real FOV.
function HUD.setSpread(spreadDeg: number, fieldOfView: number, aim: number, visible: boolean)
	local camera = Workspace.CurrentCamera
	local halfHeight = if camera then camera.ViewportSize.Y / 2 else 540
	local px = math.tan(math.rad(spreadDeg)) / math.tan(math.rad(fieldOfView / 2)) * halfHeight
	gapTarget = math.clamp(px, 3, 140)
	dotOnly = math.clamp(aim, 0, 1)
	crosshairAlphaTarget = if visible then 1 else 0
end

function HUD.pulse(amount: number)
	pulse = math.min(pulse + amount, 30)
end

function HUD.hitmarker(kind: string)
	hitToken += 1
	local token = hitToken
	local color = HIT_COLORS[kind] or HIT_COLORS.Body
	local big = kind == "Kill" or kind == "Head"
	for _, l in hitLines do
		l.BackgroundColor3 = color
		l.BackgroundTransparency = 0
		l.Size = UDim2.fromOffset(if big then 14 else 10, 2)
		local stroke = l:FindFirstChildOfClass("UIStroke")
		if stroke then
			stroke.Transparency = 0.5
		end
	end
	hitScale.Scale = if kind == "Kill" then 1.8 else 1.4
	Widgets.tween(hitScale, Theme.Tween.Medium, { Scale = 1 })
	task.delay(if kind == "Kill" then 0.45 else 0.18, function()
		if token ~= hitToken then
			return
		end
		for _, l in hitLines do
			Widgets.tween(l, Theme.Tween.Medium, { BackgroundTransparency = 1 })
			local stroke = l:FindFirstChildOfClass("UIStroke")
			if stroke then
				Widgets.tween(stroke, Theme.Tween.Medium, { Transparency = 1 })
			end
		end
	end)
end

function HUD.setHealth(health: number, maxHealth: number)
	local alpha = math.clamp(health / math.max(maxHealth, 1), 0, 1)
	Widgets.tween(healthFill, Theme.Tween.Medium, {
		Size = UDim2.fromScale(alpha, 1),
		BackgroundColor3 = if alpha < 0.3 then Theme.Colors.Danger else Theme.Colors.Text,
	})
	healthLabel.Text = tostring(math.ceil(health))
	if health < lastHealth - 0.5 then
		damageEdges.Visible = true
		damageEdges:SetAttribute("Flash", os.clock())
		for _, edge in damageEdges:GetChildren() do
			if edge:IsA("Frame") then
				edge.BackgroundTransparency = 0
				Widgets.tween(edge, TweenInfo.new(0.9, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), { BackgroundTransparency = 1 })
			end
		end
	end
	lastHealth = health
end

function HUD.resetHealth(maxHealth: number)
	lastHealth = maxHealth
	HUD.setHealth(maxHealth, maxHealth)
end

function HUD.setMode(newMode: "OnFoot" | "Vehicle" | "Passenger")
	mode = newMode
	ammoFrame.Visible = newMode == "OnFoot"
	vehicleFrame.Visible = newMode == "Vehicle"
	crosshair.Visible = newMode == "OnFoot"
	staminaTrack.Visible = newMode == "OnFoot"
end

function HUD.setVehicle(speed: number, gear: number, rpm: number)
	if mode ~= "Vehicle" then
		return
	end
	shownSpeed += (speed - shownSpeed) * 0.25
	speedLabel.Text = tostring(math.floor(shownSpeed + 0.5))
	gearLabel.Text = if gear < 0 then "R" elseif speed < 0.5 then "N" else tostring(gear)
	rpmFill.Size = UDim2.fromScale(math.clamp(rpm, 0, 1), 1)
	rpmFill.BackgroundColor3 = if rpm > 0.88 then Theme.Colors.Danger else Theme.Colors.Text
end

local function money(value: number): string
	local s = tostring(math.floor(value))
	local out = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	if out:sub(1, 1) == "," then
		out = out:sub(2)
	end
	return "$" .. out
end

function HUD.setCarry(value: number?)
	if value and value > 0 then
		carryLabel.Text = Theme.track("CARRYING  " .. money(value) .. "   ·   G  DROP")
		Widgets.tween(carryLabel, Theme.Tween.Medium, { TextTransparency = 0.05 })
	else
		Widgets.tween(carryLabel, Theme.Tween.Medium, { TextTransparency = 1 })
	end
end

function HUD.toast(text: string)
	toastToken += 1
	local token = toastToken
	toastLabel.Text = Theme.track(text)
	toastLabel.TextTransparency = 1
	Widgets.tween(toastLabel, Theme.Tween.Medium, { TextTransparency = 0.1 })
	task.delay(1.6, function()
		if token == toastToken then
			Widgets.tween(toastLabel, Theme.Tween.Slow, { TextTransparency = 1 })
		end
	end)
end

return HUD
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000051"><Properties><string name="Name">MenuUI</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	MenuUI
	Ultra-minimal main menu: boxless left-aligned typography over the live 3D
	scene, cinematic letterbox + edge vignette, and two slide-in panels
	(LOADOUT, SETTINGS). Mouse, keyboard and gamepad share one focus model.

	MenuUI only renders and reports intent through signals; MenuController
	decides what intent means (camera moves, deploy, saving).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Schema = require(Shared.Schema)
local Signal = require(Shared.Signal)
local Types = require(Shared.Types)

local Theme = require(script.Parent.Theme)
local Widgets = require(script.Parent.Widgets)

export type PanelName = "Loadout" | "Settings"

export type Context = {
	DisplayName: string,
	Settings: Types.PlayerSettings,
	Loadout: Types.Loadout,
	PlaySound: (name: string) -> (),
}

export type MenuUI = {
	OptionActivated: Signal.Signal, -- (id: "Deploy" | "Loadout" | "Settings")
	BackRequested: Signal.Signal,
	LoadoutSelected: Signal.Signal, -- (slot: WeaponSlot, weaponId: string)
	SettingChanged: Signal.Signal, -- (key: string, value: any)

	show: (self: MenuUI, instant: boolean?) -> (),
	hide: (self: MenuUI, duration: number?) -> (),
	openPanel: (self: MenuUI, name: PanelName?) -> (),
	getPanel: (self: MenuUI) -> PanelName?,
	setLoadout: (self: MenuUI, loadout: Types.Loadout) -> (),
	setSettings: (self: MenuUI, settings: Types.PlayerSettings) -> (),
	navigate: (self: MenuUI, delta: number) -> (),
	adjust: (self: MenuUI, delta: number) -> (),
	activate: (self: MenuUI) -> (),
	fade: (self: MenuUI, toBlack: boolean, duration: number) -> (),
	toast: (self: MenuUI, text: string) -> (),
	isInteractive: (self: MenuUI) -> boolean,
}

type FocusList = "Main" | "Panel"

type MainOption = {
	Id: string,
	Text: string,
	Hint: string,
	Size: number,
}

local MAIN_OPTIONS: { MainOption } = {
	{ Id = "Deploy", Text = "DEPLOY", Hint = "Drop into the zone. Whatever you carry out is yours.", Size = 36 },
	{ Id = "Loadout", Text = "LOADOUT", Hint = "Pick your kit at the workbench.", Size = 26 },
	{ Id = "Settings", Text = "SETTINGS", Hint = "Effects quality, field of view, sensitivity.", Size = 26 },
}

local SLOTS: { Types.WeaponSlot } = { "Primary", "Secondary" }
local STAT_KEYS = { "Damage", "FireRate", "Handling", "Range" }
local STAT_LABELS = { Damage = "DAMAGE", FireRate = "FIRE RATE", Handling = "HANDLING", Range = "RANGE" }

local LETTERBOX_HEIGHT = 0.065

local function formatThousands(n: number): string
	local s = tostring(math.floor(n))
	local formatted = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	if formatted:sub(1, 1) == "," then
		formatted = formatted:sub(2)
	end
	return formatted
end

local function gradientEdge(parent: Instance, name: string, size: UDim2, position: UDim2, anchor: Vector2, rotation: number, startAlpha: number)
	local frame = Widgets.frame(parent, {
		Name = name,
		Size = size,
		Position = position,
		AnchorPoint = anchor,
		Color = Theme.Colors.Black,
		Transparency = 0,
	})
	local gradient = Instance.new("UIGradient")
	gradient.Rotation = rotation
	gradient.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, startAlpha),
		NumberSequenceKeypoint.new(1, 1),
	})
	gradient.Parent = frame
end

local function addScale(target: Instance): UIScale
	local scale = Instance.new("UIScale")
	scale.Parent = target
	return scale
end

local MenuUI = {}

function MenuUI.new(ctx: Context): MenuUI
	local player = Players.LocalPlayer
	local playerGui = player:WaitForChild("PlayerGui")

	local ui = {} :: MenuUI
	ui.OptionActivated = Signal.new()
	ui.BackRequested = Signal.new()
	ui.LoadoutSelected = Signal.new()
	ui.SettingChanged = Signal.new()

	local interactive = false
	local openPanelName: PanelName? = nil
	local focusList: FocusList = "Main"
	local focusIndex: { [FocusList]: number } = { Main = 1, Panel = 1 }
	local currentLoadout: Types.Loadout = table.clone(ctx.Loadout)
	local scales: { UIScale } = {}

	----------------------------------------------------------------------------
	-- Roots
	----------------------------------------------------------------------------
	local gui = Instance.new("ScreenGui")
	gui.Name = "MainMenu"
	gui.IgnoreGuiInset = true
	gui.ResetOnSpawn = false
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.DisplayOrder = 10
	gui.Parent = playerGui

	local root = Instance.new("CanvasGroup")
	root.Name = "Root"
	root.Size = UDim2.fromScale(1, 1)
	root.BackgroundTransparency = 1
	root.GroupTransparency = 1
	root.Parent = gui

	local faderGui = Instance.new("ScreenGui")
	faderGui.Name = "Fader"
	faderGui.IgnoreGuiInset = true
	faderGui.ResetOnSpawn = false
	faderGui.DisplayOrder = 100
	faderGui.Parent = playerGui
	local fader = Widgets.frame(faderGui, { Name = "Black", Size = UDim2.fromScale(1, 1), Color = Theme.Colors.Black, Transparency = 1 })

	-- Cinematic letterbox (outside the CanvasGroup so it retracts on its own)
	local barTop = Widgets.frame(gui, { Name = "LetterboxTop", Size = UDim2.fromScale(1, 0), Color = Theme.Colors.Black, Transparency = 0, ZIndex = 20 })
	local barBottom = Widgets.frame(gui, {
		Name = "LetterboxBottom",
		Size = UDim2.fromScale(1, 0),
		Position = UDim2.fromScale(0, 1),
		AnchorPoint = Vector2.new(0, 1),
		Color = Theme.Colors.Black,
		Transparency = 0,
		ZIndex = 20,
	})

	-- Edge vignette: heavier on the left where the type sits.
	local vignette = Widgets.frame(root, { Name = "Vignette", Size = UDim2.fromScale(1, 1) })
	gradientEdge(vignette, "Left", UDim2.fromScale(0.5, 1), UDim2.new(), Vector2.zero, 0, 0.2)
	gradientEdge(vignette, "Right", UDim2.fromScale(0.3, 1), UDim2.fromScale(1, 0), Vector2.new(1, 0), 180, 0.45)
	gradientEdge(vignette, "Top", UDim2.fromScale(1, 0.25), UDim2.new(), Vector2.zero, 90, 0.5)
	gradientEdge(vignette, "Bottom", UDim2.fromScale(1, 0.3), UDim2.fromScale(0, 1), Vector2.new(0, 1), -90, 0.35)

	----------------------------------------------------------------------------
	-- Left column: title + options + hint
	----------------------------------------------------------------------------
	local column = Widgets.frame(root, {
		Name = "LeftColumn",
		Size = UDim2.fromOffset(480, 560),
		Position = UDim2.new(0.065, 0, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
	})
	table.insert(scales, addScale(column))

	local titleGroup = Widgets.frame(column, { Name = "TitleGroup", Size = UDim2.new(1, 0, 0, 130) })
	Widgets.label(titleGroup, {
		Name = "Title",
		Text = Theme.track(Config.Branding.Title),
		Font = Theme.Fonts.Display,
		TextSize = 76,
		Size = UDim2.new(1, 0, 0, 84),
	})
	Widgets.label(titleGroup, {
		Name = "Subtitle",
		Text = Theme.track(Config.Branding.Subtitle),
		Font = Theme.Fonts.MonoBold,
		TextSize = 12,
		Color = Theme.Colors.Accent,
		Size = UDim2.new(1, 0, 0, 18),
		Position = UDim2.fromOffset(4, 86),
	})
	Widgets.frame(titleGroup, {
		Name = "Rule",
		Size = UDim2.fromOffset(44, 2),
		Position = UDim2.fromOffset(4, 118),
		Color = Theme.Colors.Accent,
		Transparency = 0.2,
	})

	local optionsFrame = Widgets.frame(column, { Name = "Options", Size = UDim2.new(1, 0, 0, 220), Position = UDim2.fromOffset(0, 158) })
	Widgets.list(optionsFrame, 2)

	local hint = Widgets.label(column, {
		Name = "Hint",
		Text = MAIN_OPTIONS[1].Hint,
		Font = Theme.Fonts.Body,
		TextSize = 14,
		Color = Theme.Colors.Dim,
		Transparency = 0.1,
		Size = UDim2.fromOffset(380, 40),
		Position = UDim2.fromOffset(4, 392),
		Wrapped = true,
		YAlign = Enum.TextYAlignment.Top,
	})

	local mainRows: { Widgets.Row } = {}
	local optionRows: { [string]: Widgets.OptionRow } = {}
	local panelRows: { [PanelName]: { Widgets.Row } } = { Loadout = {}, Settings = {} }
	-- Extra behaviour when a row gains focus (e.g. weapon detail preview).
	local focusHooks: { [any]: () -> () } = {}

	local function rowsFor(list: FocusList): { Widgets.Row }
		if list == "Panel" then
			local name = openPanelName
			if name then
				return panelRows[name]
			end
			return {}
		end
		return mainRows
	end

	local updateDetail: (weaponId: string?) -> () = function(_: string?) end

	local function setHint(text: string)
		if hint.Text == text then
			return
		end
		hint.TextTransparency = 1
		hint.Text = text
		Widgets.tween(hint, Theme.Tween.Medium, { TextTransparency = 0.1 })
	end

	local function setFocus(list: FocusList, index: number, silent: boolean?)
		local previousRows = rowsFor(focusList)
		local previous = previousRows[focusIndex[focusList]]
		local nextRows = rowsFor(list)
		if #nextRows == 0 then
			return
		end
		local clamped = ((index - 1) % #nextRows) + 1
		local nextRow = nextRows[clamped]
		if previous == nextRow then
			return
		end
		if previous then
			previous.SetFocused(false)
		end
		focusList = list
		focusIndex[list] = clamped
		nextRow.SetFocused(true)
		if list == "Main" then
			setHint(MAIN_OPTIONS[clamped].Hint)
		end
		local hook = focusHooks[nextRow]
		if hook then
			hook()
		end
		if not silent then
			ctx.PlaySound("UIHover")
		end
	end

	local function focusRow(list: FocusList, row: Widgets.Row)
		if not interactive then
			return
		end
		local index = table.find(rowsFor(list), row)
		if index then
			setFocus(list, index)
		end
	end

	for i, def in MAIN_OPTIONS do
		local row: Widgets.OptionRow
		row = Widgets.menuOption(optionsFrame, {
			Name = def.Id,
			Index = i,
			Text = def.Text,
			TextSize = def.Size,
			LayoutOrder = i,
			OnHover = function()
				focusRow("Main", row)
			end,
			OnActivate = function()
				if not interactive then
					return
				end
				ctx.PlaySound(if def.Id == "Deploy" then "UIDeploy" else "UIClick")
				ui.OptionActivated:Fire(def.Id)
			end,
		})
		table.insert(mainRows, row)
		optionRows[def.Id] = row
	end

	----------------------------------------------------------------------------
	-- Corners: operator, footer, key hints, toast
	----------------------------------------------------------------------------
	local topRight = Widgets.frame(root, {
		Name = "Operator",
		Size = UDim2.fromOffset(320, 70),
		Position = UDim2.fromScale(0.935, 0.095),
		AnchorPoint = Vector2.new(1, 0),
	})
	table.insert(scales, addScale(topRight))
	Widgets.label(topRight, {
		Name = "Role",
		Text = Theme.track("OPERATOR"),
		Font = Theme.Fonts.Mono,
		TextSize = 10,
		Color = Theme.Colors.Dim,
		Size = UDim2.new(1, 0, 0, 16),
		XAlign = Enum.TextXAlignment.Right,
	})
	Widgets.label(topRight, {
		Name = "Name",
		Text = Theme.track(string.upper(ctx.DisplayName)),
		Font = Theme.Fonts.Heading,
		TextSize = 16,
		Size = UDim2.new(1, 0, 0, 22),
		Position = UDim2.fromOffset(0, 16),
		XAlign = Enum.TextXAlignment.Right,
	})
	local stashLabel = Widgets.label(topRight, {
		Name = "Stash",
		Text = "",
		Font = Theme.Fonts.Mono,
		TextSize = 11,
		Color = Theme.Colors.Accent,
		Size = UDim2.new(1, 0, 0, 16),
		Position = UDim2.fromOffset(0, 42),
		XAlign = Enum.TextXAlignment.Right,
	})
	local function refreshStash()
		local value = player:GetAttribute("StashValue")
		stashLabel.Text = if typeof(value) == "number" then Theme.track("STASH  $" .. formatThousands(value)) else ""
	end
	refreshStash()
	player:GetAttributeChangedSignal("StashValue"):Connect(refreshStash)

	local footer = Widgets.frame(root, {
		Name = "Footer",
		Size = UDim2.fromOffset(520, 40),
		Position = UDim2.fromScale(0.065, 0.905),
		AnchorPoint = Vector2.new(0, 1),
	})
	table.insert(scales, addScale(footer))
	local locationLabel = Widgets.label(footer, {
		Name = "Location",
		Text = "",
		Font = Theme.Fonts.Mono,
		TextSize = 11,
		Color = Theme.Colors.Text,
		Transparency = 0.35,
		Size = UDim2.new(1, 0, 0, 18),
	})
	Widgets.label(footer, {
		Name = "Build",
		Text = Theme.track(Config.Branding.Build),
		Font = Theme.Fonts.Mono,
		TextSize = 10,
		Color = Theme.Colors.Dim,
		Transparency = 0.4,
		Size = UDim2.new(1, 0, 0, 16),
		Position = UDim2.fromOffset(0, 20),
	})
	task.spawn(function()
		while gui.Parent do
			locationLabel.Text = Theme.track(Config.Branding.Location .. "   ·   " .. tostring(os.date("%H:%M")))
			task.wait(1)
		end
	end)

	local keyHints = Widgets.label(root, {
		Name = "KeyHints",
		Text = "",
		Font = Theme.Fonts.Mono,
		TextSize = 11,
		Color = Theme.Colors.Dim,
		Transparency = 0.25,
		Size = UDim2.fromOffset(520, 18),
		Position = UDim2.fromScale(0.935, 0.905),
		AnchorPoint = Vector2.new(1, 1),
		XAlign = Enum.TextXAlignment.Right,
	})
	table.insert(scales, addScale(keyHints))
	local function refreshHints()
		local last = UserInputService:GetLastInputType()
		local gamepad = last.Name:sub(1, 7) == "Gamepad"
		keyHints.Text = Theme.track(if gamepad then "DPAD  NAVIGATE    A  SELECT    B  BACK" else "↑↓  NAVIGATE    ENTER  SELECT    BKSP  BACK")
	end
	refreshHints()
	UserInputService.LastInputTypeChanged:Connect(refreshHints)

	local toastLabel = Widgets.label(root, {
		Name = "Toast",
		Text = "",
		Font = Theme.Fonts.MonoBold,
		TextSize = 12,
		Color = Theme.Colors.Danger,
		Transparency = 1,
		Size = UDim2.fromOffset(600, 20),
		Position = UDim2.fromScale(0.5, 0.84),
		AnchorPoint = Vector2.new(0.5, 0.5),
		XAlign = Enum.TextXAlignment.Center,
	})

	----------------------------------------------------------------------------
	-- Panels
	----------------------------------------------------------------------------
	local panels: { [PanelName]: CanvasGroup } = {}

	local function makePanel(name: PanelName, title: string, subtitle: string): Frame
		local group = Instance.new("CanvasGroup")
		group.Name = name .. "Panel"
		group.Size = UDim2.fromOffset(440, 600)
		group.AnchorPoint = Vector2.new(1, 0.5)
		group.Position = UDim2.new(0.935, 40, 0.5, 0)
		group.BackgroundTransparency = 1
		group.GroupTransparency = 1
		group.Visible = false
		group.Parent = root
		table.insert(scales, addScale(group))
		panels[name] = group

		Widgets.label(group, {
			Name = "Header",
			Text = Theme.track(title),
			Font = Theme.Fonts.Heading,
			TextSize = 30,
			Size = UDim2.new(1, 0, 0, 36),
		})
		Widgets.label(group, {
			Name = "Sub",
			Text = Theme.track(subtitle),
			Font = Theme.Fonts.Mono,
			TextSize = 10,
			Color = Theme.Colors.Dim,
			Size = UDim2.new(1, 0, 0, 16),
			Position = UDim2.fromOffset(2, 38),
		})
		Widgets.frame(group, {
			Name = "Rule",
			Size = UDim2.new(1, 0, 0, 1),
			Position = UDim2.fromOffset(0, 64),
			Color = Theme.Colors.White,
			Transparency = 0.88,
		})
		local body = Widgets.frame(group, { Name = "Body", Size = UDim2.new(1, 0, 1, -76), Position = UDim2.fromOffset(0, 76) })
		Widgets.list(body, 4)
		return body
	end

	-- LOADOUT -----------------------------------------------------------------
	local loadoutBody = makePanel("Loadout", "LOADOUT", "SELECT YOUR KIT  ·  LOCKED ON DEPLOY")
	local weaponRows: { [string]: Widgets.WeaponRow } = {}
	local order = 0
	local function nextOrder(): number
		order += 1
		return order
	end

	for _, slot in SLOTS do
		Widgets.section(loadoutBody, string.upper(slot), nextOrder())
		for _, weaponId in Schema.weaponsForSlot(slot) do
			local def = Config.Weapons[weaponId]
			local row: Widgets.WeaponRow
			row = Widgets.weaponRow(loadoutBody, {
				Name = weaponId,
				Title = def.DisplayName,
				Tag = def.Class,
				LayoutOrder = nextOrder(),
				OnHover = function()
					focusRow("Panel", row)
				end,
				OnActivate = function()
					if not interactive then
						return
					end
					ctx.PlaySound("UIClick")
					ui.LoadoutSelected:Fire(slot, weaponId)
				end,
			})
			weaponRows[weaponId] = row
			focusHooks[row] = function()
				updateDetail(weaponId)
			end
			table.insert(panelRows.Loadout, row)
		end
	end

	Widgets.frame(loadoutBody, { Name = "Spacer", Size = UDim2.new(1, 0, 0, 14), LayoutOrder = nextOrder() })
	local detail = Widgets.frame(loadoutBody, { Name = "Detail", Size = UDim2.new(1, 0, 0, 190), LayoutOrder = nextOrder() })
	local detailName = Widgets.label(detail, {
		Name = "Name",
		Text = "",
		Font = Theme.Fonts.Heading,
		TextSize = 16,
		Size = UDim2.new(1, 0, 0, 22),
	})
	local detailDesc = Widgets.label(detail, {
		Name = "Description",
		Text = "",
		Font = Theme.Fonts.Body,
		TextSize = 13,
		Color = Theme.Colors.Dim,
		Size = UDim2.new(1, 0, 0, 40),
		Position = UDim2.fromOffset(0, 26),
		Wrapped = true,
		YAlign = Enum.TextYAlignment.Top,
	})
	local statsFrame = Widgets.frame(detail, { Name = "Stats", Size = UDim2.new(1, 0, 0, 100), Position = UDim2.fromOffset(0, 80) })
	Widgets.list(statsFrame, 2)
	local statBars: { [string]: Widgets.StatBar } = {}
	for i, key in STAT_KEYS do
		statBars[key] = Widgets.statBar(statsFrame, STAT_LABELS[key], i)
	end

	updateDetail = function(weaponId: string?)
		local id = weaponId or currentLoadout.Primary
		local def = Config.Weapons[id]
		if not def then
			return
		end
		if detailName.Text ~= def.DisplayName then
			detailName.TextTransparency = 1
			detailDesc.TextTransparency = 1
			Widgets.tween(detailName, Theme.Tween.Medium, { TextTransparency = 0 })
			Widgets.tween(detailDesc, Theme.Tween.Medium, { TextTransparency = 0 })
		end
		detailName.Text = def.DisplayName
		detailDesc.Text = def.Description
		for _, key in STAT_KEYS do
			statBars[key].Set((def.Stats :: any)[key])
		end
	end

	-- SETTINGS ----------------------------------------------------------------
	local settingsBody = makePanel("Settings", "SETTINGS", "SAVED AUTOMATICALLY")
	order = 0
	local qualityLevels = Config.Settings.QualityLevels

	Widgets.section(settingsBody, "DISPLAY", nextOrder())
	local qualityRow: Widgets.CycleRow
	qualityRow = Widgets.cycle(settingsBody, {
		Name = "Quality",
		Label = "EFFECTS QUALITY",
		Options = qualityLevels :: any,
		Index = table.find(qualityLevels, ctx.Settings.Quality) or 3,
		LayoutOrder = nextOrder(),
		OnHover = function()
			focusRow("Panel", qualityRow)
		end,
		OnTick = function()
			ctx.PlaySound("UITick")
		end,
		OnChanged = function(index: number)
			ui.SettingChanged:Fire("Quality", qualityLevels[index])
		end,
	})
	table.insert(panelRows.Settings, qualityRow)

	local fovRow: Widgets.SliderRow
	fovRow = Widgets.slider(settingsBody, {
		Name = "FieldOfView",
		Label = "FIELD OF VIEW",
		Min = Config.Settings.FovMin,
		Max = Config.Settings.FovMax,
		Step = 1,
		KeyStep = 2,
		Value = ctx.Settings.FieldOfView,
		Format = function(v: number): string
			return string.format("%d°", v)
		end,
		LayoutOrder = nextOrder(),
		OnHover = function()
			focusRow("Panel", fovRow)
		end,
		OnTick = function()
			ctx.PlaySound("UITick")
		end,
		OnChanged = function(v: number)
			ui.SettingChanged:Fire("FieldOfView", v)
		end,
	})
	table.insert(panelRows.Settings, fovRow)

	Widgets.section(settingsBody, "CONTROLS", nextOrder())
	local sensRow: Widgets.SliderRow
	sensRow = Widgets.slider(settingsBody, {
		Name = "Sensitivity",
		Label = "LOOK SENSITIVITY",
		Min = Config.Settings.SensitivityMin,
		Max = Config.Settings.SensitivityMax,
		Step = 0.05,
		KeyStep = 0.05,
		Value = ctx.Settings.Sensitivity,
		Format = function(v: number): string
			return string.format("%.2f", v)
		end,
		LayoutOrder = nextOrder(),
		OnHover = function()
			focusRow("Panel", sensRow)
		end,
		OnTick = function()
			ctx.PlaySound("UITick")
		end,
		OnChanged = function(v: number)
			ui.SettingChanged:Fire("Sensitivity", v)
		end,
	})
	table.insert(panelRows.Settings, sensRow)

	Widgets.frame(settingsBody, { Name = "Spacer", Size = UDim2.new(1, 0, 0, 10), LayoutOrder = nextOrder() })
	Widgets.label(settingsBody, {
		Name = "Note",
		Text = "Effects quality scales rain, mist, light shafts, shadows and post FX. Engine graphics level stays in the Roblox menu.",
		Font = Theme.Fonts.Body,
		TextSize = 12,
		Color = Theme.Colors.Dim,
		Transparency = 0.2,
		Size = UDim2.new(1, 0, 0, 34),
		Wrapped = true,
		YAlign = Enum.TextYAlignment.Top,
		LayoutOrder = nextOrder(),
	})

	----------------------------------------------------------------------------
	-- Responsive scale
	----------------------------------------------------------------------------
	local function rescale()
		local camera = Workspace.CurrentCamera
		local height = if camera then camera.ViewportSize.Y else 1080
		local s = math.clamp(height / 1080, 0.62, 1.35)
		for _, scale in scales do
			scale.Scale = s
		end
	end
	rescale()
	local function bindViewport()
		local camera = Workspace.CurrentCamera
		if camera then
			camera:GetPropertyChangedSignal("ViewportSize"):Connect(rescale)
		end
	end
	bindViewport()
	Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
		bindViewport()
		rescale()
	end)

	----------------------------------------------------------------------------
	-- Methods
	----------------------------------------------------------------------------
	local function refreshActiveOptions()
		for id, row in optionRows do
			row.SetActive(openPanelName ~= nil and id == openPanelName)
		end
	end

	function ui.getPanel(_self: MenuUI): PanelName?
		return openPanelName
	end

	function ui.openPanel(_self: MenuUI, name: PanelName?)
		if name == openPanelName then
			return
		end
		local previous = openPanelName
		if previous then
			local group = panels[previous]
			for _, row in panelRows[previous] do
				row.SetFocused(false)
			end
			Widgets.tween(group, Theme.Tween.Medium, { GroupTransparency = 1, Position = UDim2.new(0.935, 40, 0.5, 0) })
			task.delay(Theme.Tween.Medium.Time, function()
				if openPanelName ~= previous then
					group.Visible = false
				end
			end)
		end
		openPanelName = name
		if focusList == "Panel" then
			focusList = "Main"
		end
		if name then
			local group = panels[name]
			group.Visible = true
			group.Position = UDim2.new(0.935, 40, 0.5, 0)
			Widgets.tween(group, Theme.Tween.Slow, { GroupTransparency = 0, Position = UDim2.new(0.935, 0, 0.5, 0) })
			focusIndex.Panel = 1
			if name == "Loadout" then
				updateDetail(nil)
			end
		end
		refreshActiveOptions()
	end

	function ui.setLoadout(_self: MenuUI, loadout: Types.Loadout)
		currentLoadout = table.clone(loadout)
		for weaponId, row in weaponRows do
			row.SetSelected(weaponId == loadout.Primary or weaponId == loadout.Secondary)
		end
		if openPanelName == "Loadout" then
			updateDetail(nil)
		end
	end

	function ui.setSettings(_self: MenuUI, settings: Types.PlayerSettings)
		qualityRow.Set(table.find(qualityLevels, settings.Quality) or 3, true)
		fovRow.Set(settings.FieldOfView, true)
		sensRow.Set(settings.Sensitivity, true)
	end

	function ui.navigate(_self: MenuUI, delta: number)
		if not interactive then
			return
		end
		setFocus(focusList, focusIndex[focusList] + delta)
	end

	function ui.adjust(_self: MenuUI, delta: number)
		if not interactive then
			return
		end
		local row = rowsFor(focusList)[focusIndex[focusList]]
		if focusList == "Panel" and row and row.Adjust then
			row.Adjust(delta)
		elseif focusList == "Main" and delta > 0 and openPanelName then
			setFocus("Panel", focusIndex.Panel)
		elseif focusList == "Panel" and delta < 0 then
			local name = openPanelName
			local mainIndex = if name then table.find({ "Deploy", "Loadout", "Settings" }, name) else nil
			setFocus("Main", mainIndex or 1)
		end
	end

	function ui.activate(_self: MenuUI)
		if not interactive then
			return
		end
		local row = rowsFor(focusList)[focusIndex[focusList]]
		if row and row.Activate then
			row.Activate()
		end
	end

	function ui.isInteractive(_self: MenuUI): boolean
		return interactive
	end

	function ui.show(_self: MenuUI, instant: boolean?)
		gui.Enabled = true
		root.Visible = true
		interactive = true
		focusList = "Main"
		for _, row in mainRows do
			row.SetFocused(false)
		end
		focusIndex.Main = 0
		setFocus("Main", 1, true)

		if instant then
			root.GroupTransparency = 0
			barTop.Size = UDim2.fromScale(1, LETTERBOX_HEIGHT)
			barBottom.Size = UDim2.fromScale(1, LETTERBOX_HEIGHT)
		else
			Widgets.tween(root, Theme.Tween.Fade, { GroupTransparency = 0 })
			Widgets.tween(barTop, Theme.Tween.Slow, { Size = UDim2.fromScale(1, LETTERBOX_HEIGHT) })
			Widgets.tween(barBottom, Theme.Tween.Slow, { Size = UDim2.fromScale(1, LETTERBOX_HEIGHT) })
		end

		-- Staggered slide-in for the title and options.
		titleGroup.Position = UDim2.fromOffset(-30, 0)
		Widgets.tween(titleGroup, Theme.Tween.Slow, { Position = UDim2.fromOffset(0, 0) })
		for i, def in MAIN_OPTIONS do
			local content = optionRows[def.Id].Content
			content.Position = UDim2.fromOffset(-40, 0)
			task.delay(0.12 + i * 0.07, function()
				Widgets.tween(content, Theme.Tween.Slow, { Position = UDim2.fromOffset(0, 0) })
			end)
		end
	end

	function ui.hide(_self: MenuUI, duration: number?)
		local d = duration or 0.8
		interactive = false
		ui:openPanel(nil)
		local info = TweenInfo.new(d, Enum.EasingStyle.Quint, Enum.EasingDirection.InOut)
		Widgets.tween(root, info, { GroupTransparency = 1 })
		Widgets.tween(barTop, TweenInfo.new(d * 1.4, Enum.EasingStyle.Quint, Enum.EasingDirection.InOut), { Size = UDim2.fromScale(1, 0) })
		Widgets.tween(barBottom, TweenInfo.new(d * 1.4, Enum.EasingStyle.Quint, Enum.EasingDirection.InOut), { Size = UDim2.fromScale(1, 0) })
		for i, def in MAIN_OPTIONS do
			local content = optionRows[def.Id].Content
			task.delay((i - 1) * 0.04, function()
				Widgets.tween(content, info, { Position = UDim2.fromOffset(-60, 0) })
			end)
		end
		task.delay(d * 1.4, function()
			if not interactive then
				root.Visible = false
			end
		end)
	end

	function ui.fade(_self: MenuUI, toBlack: boolean, duration: number)
		local tween = Widgets.tween(fader, TweenInfo.new(duration, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
			BackgroundTransparency = if toBlack then 0 else 1,
		})
		tween.Completed:Wait()
	end

	local toastToken = 0
	function ui.toast(_self: MenuUI, text: string)
		toastToken += 1
		local token = toastToken
		toastLabel.Text = Theme.track(text)
		Widgets.tween(toastLabel, Theme.Tween.Medium, { TextTransparency = 0 })
		task.delay(3, function()
			if token == toastToken then
				Widgets.tween(toastLabel, Theme.Tween.Slow, { TextTransparency = 1 })
			end
		end)
	end

	ui:setLoadout(currentLoadout)
	ui:setSettings(ctx.Settings)
	return ui
end

return MenuUI
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000052"><Properties><string name="Name">PromptUI</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	PromptUI
	Minimal custom renderer for every ProximityPrompt with Style = Custom:

	   [E]  GRAB
	        LOOT · $6,800
	        ───────────  ← hold progress

	Key cap adapts to keyboard / gamepad / touch, the hold line fills over
	HoldDuration, triggers flash, and the card slides in/out. Tapping the card
	works on touch screens. Object/action text updates live (trunk counts).
]]

local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local TweenService = game:GetService("TweenService")

local Theme = require(script.Parent.Theme)
local Widgets = require(script.Parent.Widgets)

local PromptUI = {}

local active: { [ProximityPrompt]: BillboardGui } = {}

local function keyText(prompt: ProximityPrompt, inputType: Enum.ProximityPromptInputType): string
	if inputType == Enum.ProximityPromptInputType.Gamepad then
		return (string.gsub(prompt.GamepadKeyCode.Name, "^Button", ""))
	elseif inputType == Enum.ProximityPromptInputType.Touch then
		return "TAP"
	end
	return prompt.KeyboardKeyCode.Name
end

local function show(prompt: ProximityPrompt, inputType: Enum.ProximityPromptInputType)
	if prompt.Style ~= Enum.ProximityPromptStyle.Custom or active[prompt] then
		return
	end
	local adornee = prompt.Parent
	if not adornee or not (adornee:IsA("BasePart") or adornee:IsA("Attachment") or adornee:IsA("Model")) then
		return
	end

	local gui = Instance.new("BillboardGui")
	gui.Name = "Prompt"
	gui.Adornee = adornee
	gui.AlwaysOnTop = true
	gui.LightInfluence = 0
	gui.Size = UDim2.fromOffset(240, 64)
	gui.StudsOffsetWorldSpace = Vector3.new(0, 1.2, 0)
	gui.Active = true
	gui.ResetOnSpawn = false
	gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")

	local card = Instance.new("CanvasGroup")
	card.Name = "Card"
	card.BackgroundTransparency = 1
	card.Size = UDim2.fromScale(1, 1)
	card.Position = UDim2.fromOffset(-14, 0)
	card.GroupTransparency = 1
	card.Parent = gui

	local cap = Widgets.frame(card, {
		Name = "KeyCap",
		Size = UDim2.fromOffset(30, 30),
		Position = UDim2.fromOffset(0, 6),
		Color = Theme.Colors.Black,
		Transparency = 0.45,
	})
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 4)
	corner.Parent = cap
	local stroke = Instance.new("UIStroke")
	stroke.Color = Theme.Colors.Text
	stroke.Thickness = 1.5
	stroke.Transparency = 0.1
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Parent = cap
	local key = Widgets.label(cap, {
		Name = "Key",
		Text = keyText(prompt, inputType),
		Font = Theme.Fonts.MonoBold,
		TextSize = 13,
		Size = UDim2.fromScale(1, 1),
		XAlign = Enum.TextXAlignment.Center,
	})

	local action = Widgets.label(card, {
		Name = "Action",
		Text = Theme.track(string.upper(prompt.ActionText)),
		Font = Theme.Fonts.Heading,
		TextSize = 16,
		Size = UDim2.new(1, -42, 0, 20),
		Position = UDim2.fromOffset(42, 4),
	})
	local object = Widgets.label(card, {
		Name = "Object",
		Text = Theme.track(prompt.ObjectText),
		Font = Theme.Fonts.Mono,
		TextSize = 10,
		Color = Theme.Colors.Accent,
		Size = UDim2.new(1, -42, 0, 14),
		Position = UDim2.fromOffset(42, 24),
	})
	local track = Widgets.frame(card, {
		Name = "HoldTrack",
		Size = UDim2.new(1, -42, 0, 2),
		Position = UDim2.fromOffset(42, 44),
		Color = Theme.Colors.White,
		Transparency = if prompt.HoldDuration > 0 then 0.8 else 1,
	})
	local fill = Widgets.frame(track, { Name = "Fill", Size = UDim2.fromScale(0, 1), Color = Theme.Colors.Accent, Transparency = 0 })

	local hit = Widgets.hitbox(card, "Tap")
	hit.InputBegan:Connect(function(input: InputObject)
		if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
			prompt:InputHoldBegin()
		end
	end)
	hit.InputEnded:Connect(function(input: InputObject)
		if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
			prompt:InputHoldEnd()
		end
	end)

	local connections: { RBXScriptConnection } = {}
	local holdTween: Tween? = nil
	table.insert(connections, prompt.PromptButtonHoldBegan:Connect(function()
		fill.Size = UDim2.fromScale(0, 1)
		holdTween = TweenService:Create(fill, TweenInfo.new(prompt.HoldDuration, Enum.EasingStyle.Linear), { Size = UDim2.fromScale(1, 1) })
		local tween = holdTween :: Tween
		tween:Play()
		Widgets.tween(cap, Theme.Tween.Fast, { BackgroundTransparency = 0.1 })
	end))
	table.insert(connections, prompt.PromptButtonHoldEnded:Connect(function()
		if holdTween then
			holdTween:Cancel()
		end
		Widgets.tween(fill, Theme.Tween.Fast, { Size = UDim2.fromScale(0, 1) })
		Widgets.tween(cap, Theme.Tween.Fast, { BackgroundTransparency = 0.45 })
	end))
	table.insert(connections, prompt.Triggered:Connect(function()
		stroke.Color = Theme.Colors.Accent
		key.TextColor3 = Theme.Colors.Accent
		task.delay(0.2, function()
			stroke.Color = Theme.Colors.Text
			key.TextColor3 = Theme.Colors.Text
		end)
	end))
	table.insert(connections, prompt:GetPropertyChangedSignal("ObjectText"):Connect(function()
		object.Text = Theme.track(prompt.ObjectText)
	end))
	table.insert(connections, prompt:GetPropertyChangedSignal("ActionText"):Connect(function()
		action.Text = Theme.track(string.upper(prompt.ActionText))
	end))

	active[prompt] = gui
	Widgets.tween(card, Theme.Tween.Medium, { GroupTransparency = 0, Position = UDim2.fromOffset(0, 0) })

	local hidden: RBXScriptConnection
	hidden = prompt.PromptHidden:Connect(function()
		hidden:Disconnect()
		for _, c in connections do
			c:Disconnect()
		end
		active[prompt] = nil
		local out = Widgets.tween(card, Theme.Tween.Fast, { GroupTransparency = 1, Position = UDim2.fromOffset(-10, 0) })
		out.Completed:Once(function()
			gui:Destroy()
		end)
	end)
end

function PromptUI.init()
	ProximityPromptService.PromptShown:Connect(show)
end

return PromptUI
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000053"><Properties><string name="Name">Theme</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Theme
	Typography, colour and motion tokens for every client UI.
]]

local Theme = {}

local MONTSERRAT = "rbxasset://fonts/families/Montserrat.json"
local GOTHAM = "rbxasset://fonts/families/GothamSSm.json"
local MONO = "rbxasset://fonts/families/RobotoMono.json"

Theme.Fonts = {
	Display = Font.new(MONTSERRAT, Enum.FontWeight.ExtraBold),
	Heading = Font.new(MONTSERRAT, Enum.FontWeight.Bold),
	Option = Font.new(MONTSERRAT, Enum.FontWeight.SemiBold),
	Body = Font.new(GOTHAM, Enum.FontWeight.Medium),
	Mono = Font.new(MONO, Enum.FontWeight.Regular),
	MonoBold = Font.new(MONO, Enum.FontWeight.Bold),
}

Theme.Colors = {
	Text = Color3.fromRGB(236, 234, 228),
	Dim = Color3.fromRGB(150, 150, 146),
	Accent = Color3.fromRGB(255, 168, 86),
	AccentCool = Color3.fromRGB(90, 210, 255),
	Danger = Color3.fromRGB(255, 72, 72),
	Black = Color3.new(0, 0, 0),
	White = Color3.new(1, 1, 1),
}

Theme.Tween = {
	Fast = TweenInfo.new(0.16, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
	Medium = TweenInfo.new(0.32, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
	Slow = TweenInfo.new(0.7, Enum.EasingStyle.Quint, Enum.EasingDirection.InOut),
	Fade = TweenInfo.new(0.9, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
}

Theme.Text = {
	IdleTransparency = 0.42,
	DimTransparency = 0.55,
}

-- Wide tracking for small caps labels (thin spaces between glyphs).
local THIN = utf8.char(0x2009)
function Theme.track(text: string): string
	local out = {}
	for _, code in utf8.codes(text) do
		local char = utf8.char(code)
		if char == " " then
			table.insert(out, THIN .. THIN .. THIN)
		else
			table.insert(out, char)
		end
	end
	return table.concat(out, THIN)
end

return Theme
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000054"><Properties><string name="Name">Widgets</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Widgets
	Minimal, boxless UI primitives with motion baked in. Every interactive
	widget returns a Row so MenuUI can drive mouse, keyboard and gamepad
	focus through one navigation model.
]]

local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Theme = require(script.Parent.Theme)

export type Row = {
	Root: GuiObject,
	SetFocused: (focused: boolean) -> (),
	Activate: (() -> ())?,
	Adjust: ((direction: number) -> ())?,
}

export type OptionRow = {
	Root: GuiObject,
	Content: Frame,
	SetFocused: (focused: boolean) -> (),
	Activate: (() -> ())?,
	Adjust: ((direction: number) -> ())?,
	SetActive: (active: boolean) -> (),
}

export type SliderRow = {
	Root: GuiObject,
	SetFocused: (focused: boolean) -> (),
	Activate: (() -> ())?,
	Adjust: ((direction: number) -> ())?,
	Set: (value: number, silent: boolean?) -> (),
}

export type CycleRow = {
	Root: GuiObject,
	SetFocused: (focused: boolean) -> (),
	Activate: (() -> ())?,
	Adjust: ((direction: number) -> ())?,
	Set: (index: number, silent: boolean?) -> (),
}

export type WeaponRow = {
	Root: GuiObject,
	SetFocused: (focused: boolean) -> (),
	Activate: (() -> ())?,
	Adjust: ((direction: number) -> ())?,
	SetSelected: (selected: boolean) -> (),
}

export type StatBar = {
	Root: Frame,
	Set: (alpha: number) -> (),
}

export type LabelProps = {
	Name: string,
	Text: string,
	Font: Font,
	TextSize: number,
	Color: Color3?,
	Transparency: number?,
	Size: UDim2?,
	Position: UDim2?,
	AnchorPoint: Vector2?,
	XAlign: Enum.TextXAlignment?,
	YAlign: Enum.TextYAlignment?,
	AutomaticSize: Enum.AutomaticSize?,
	Wrapped: boolean?,
	LayoutOrder: number?,
	ZIndex: number?,
}

export type FrameProps = {
	Name: string,
	Size: UDim2,
	Position: UDim2?,
	AnchorPoint: Vector2?,
	Color: Color3?,
	Transparency: number?,
	LayoutOrder: number?,
	ZIndex: number?,
	ClipsDescendants: boolean?,
}

local Widgets = {}

function Widgets.tween(instance: Instance, info: TweenInfo, goals: { [string]: any }): Tween
	local tween = TweenService:Create(instance, info, goals)
	tween:Play()
	return tween
end

function Widgets.label(parent: Instance, p: LabelProps): TextLabel
	local label = Instance.new("TextLabel")
	label.Name = p.Name
	label.BackgroundTransparency = 1
	label.BorderSizePixel = 0
	label.Text = p.Text
	label.FontFace = p.Font
	label.TextSize = p.TextSize
	label.TextColor3 = p.Color or Theme.Colors.Text
	label.TextTransparency = p.Transparency or 0
	label.Size = p.Size or UDim2.new(1, 0, 0, p.TextSize + 6)
	label.Position = p.Position or UDim2.new()
	label.AnchorPoint = p.AnchorPoint or Vector2.zero
	label.TextXAlignment = p.XAlign or Enum.TextXAlignment.Left
	label.TextYAlignment = p.YAlign or Enum.TextYAlignment.Center
	label.AutomaticSize = p.AutomaticSize or Enum.AutomaticSize.None
	label.TextWrapped = p.Wrapped == true
	label.LayoutOrder = p.LayoutOrder or 0
	label.ZIndex = p.ZIndex or 1
	label.Parent = parent
	return label
end

function Widgets.frame(parent: Instance, p: FrameProps): Frame
	local frame = Instance.new("Frame")
	frame.Name = p.Name
	frame.Size = p.Size
	frame.Position = p.Position or UDim2.new()
	frame.AnchorPoint = p.AnchorPoint or Vector2.zero
	frame.BackgroundColor3 = p.Color or Theme.Colors.Black
	frame.BackgroundTransparency = if p.Transparency == nil then 1 else p.Transparency
	frame.BorderSizePixel = 0
	frame.LayoutOrder = p.LayoutOrder or 0
	frame.ZIndex = p.ZIndex or 1
	frame.ClipsDescendants = p.ClipsDescendants == true
	frame.Parent = parent
	return frame
end

function Widgets.hitbox(parent: Instance, name: string, size: UDim2?, position: UDim2?): TextButton
	local button = Instance.new("TextButton")
	button.Name = name
	button.Text = ""
	button.AutoButtonColor = false
	button.BackgroundTransparency = 1
	button.BorderSizePixel = 0
	button.Selectable = false
	button.Size = size or UDim2.fromScale(1, 1)
	button.Position = position or UDim2.new()
	button.ZIndex = 5
	button.Parent = parent
	return button
end

function Widgets.list(parent: Instance, padding: number, horizontal: boolean?): UIListLayout
	local layout = Instance.new("UIListLayout")
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Padding = UDim.new(0, padding)
	layout.FillDirection = if horizontal then Enum.FillDirection.Horizontal else Enum.FillDirection.Vertical
	layout.Parent = parent
	return layout
end

function Widgets.section(parent: Instance, text: string, order: number): TextLabel
	return Widgets.label(parent, {
		Name = "Section_" .. text,
		Text = Theme.track(text),
		Font = Theme.Fonts.MonoBold,
		TextSize = 11,
		Color = Theme.Colors.Accent,
		Transparency = 0.1,
		Size = UDim2.new(1, 0, 0, 26),
		YAlign = Enum.TextYAlignment.Bottom,
		LayoutOrder = order,
	})
end

--------------------------------------------------------------------------------
-- Main menu option: "01 — DEPLOY"
--------------------------------------------------------------------------------
export type OptionOpts = {
	Name: string,
	Index: number,
	Text: string,
	TextSize: number,
	LayoutOrder: number,
	OnActivate: () -> (),
	OnHover: () -> (),
}

function Widgets.menuOption(parent: Instance, opts: OptionOpts): OptionRow
	local height = opts.TextSize + 22
	local root = Widgets.frame(parent, { Name = opts.Name, Size = UDim2.new(1, 0, 0, height), LayoutOrder = opts.LayoutOrder })
	local content = Widgets.frame(root, { Name = "Content", Size = UDim2.fromScale(1, 1) })

	local index = Widgets.label(content, {
		Name = "Index",
		Text = string.format("%02d", opts.Index),
		Font = Theme.Fonts.Mono,
		TextSize = 12,
		Color = Theme.Colors.Dim,
		Transparency = 0.6,
		Size = UDim2.new(0, 28, 1, 0),
	})
	local bar = Widgets.frame(content, {
		Name = "Bar",
		Size = UDim2.fromOffset(0, 2),
		Position = UDim2.new(0, 34, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		Color = Theme.Colors.Accent,
		Transparency = 0,
	})
	local label = Widgets.label(content, {
		Name = "Label",
		Text = Theme.track(opts.Text),
		Font = if opts.TextSize >= 30 then Theme.Fonts.Heading else Theme.Fonts.Option,
		TextSize = opts.TextSize,
		Transparency = Theme.Text.IdleTransparency,
		Size = UDim2.new(1, -40, 1, 0),
		Position = UDim2.new(0, 34, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
	})
	local hit = Widgets.hitbox(root, "Hit")

	local focused = false
	local active = false
	local function render()
		local lit = focused or active
		Widgets.tween(label, Theme.Tween.Medium, {
			Position = UDim2.new(0, if lit then 64 else 34, 0.5, 0),
			TextTransparency = if lit then 0 else Theme.Text.IdleTransparency,
			TextColor3 = if active then Theme.Colors.Accent else Theme.Colors.Text,
		})
		Widgets.tween(bar, Theme.Tween.Medium, { Size = UDim2.fromOffset(if lit then 22 else 0, 2) })
		Widgets.tween(index, Theme.Tween.Fast, {
			TextTransparency = if lit then 0.15 else 0.6,
			TextColor3 = if active then Theme.Colors.Accent else Theme.Colors.Dim,
		})
	end

	hit.MouseEnter:Connect(opts.OnHover)
	hit.Activated:Connect(opts.OnActivate)

	return {
		Root = root,
		Content = content,
		SetFocused = function(value: boolean)
			if focused ~= value then
				focused = value
				render()
			end
		end,
		Activate = opts.OnActivate,
		Adjust = nil,
		SetActive = function(value: boolean)
			if active ~= value then
				active = value
				render()
			end
		end,
	}
end

--------------------------------------------------------------------------------
-- Slider
--------------------------------------------------------------------------------
export type SliderOpts = {
	Name: string,
	Label: string,
	Min: number,
	Max: number,
	Step: number,
	KeyStep: number,
	Value: number,
	Format: (value: number) -> string,
	LayoutOrder: number,
	OnChanged: (value: number) -> (),
	OnHover: () -> (),
	OnTick: () -> (),
}

function Widgets.slider(parent: Instance, opts: SliderOpts): SliderRow
	local root = Widgets.frame(parent, { Name = opts.Name, Size = UDim2.new(1, 0, 0, 64), LayoutOrder = opts.LayoutOrder })
	local caption = Widgets.label(root, {
		Name = "Caption",
		Text = Theme.track(opts.Label),
		Font = Theme.Fonts.Mono,
		TextSize = 12,
		Color = Theme.Colors.Text,
		Transparency = Theme.Text.DimTransparency,
		Size = UDim2.new(0.7, 0, 0, 22),
	})
	local valueLabel = Widgets.label(root, {
		Name = "Value",
		Text = opts.Format(opts.Value),
		Font = Theme.Fonts.Heading,
		TextSize = 18,
		Size = UDim2.new(0.3, 0, 0, 22),
		Position = UDim2.fromScale(1, 0),
		AnchorPoint = Vector2.new(1, 0),
		XAlign = Enum.TextXAlignment.Right,
	})
	local track = Widgets.frame(root, {
		Name = "Track",
		Size = UDim2.new(1, 0, 0, 2),
		Position = UDim2.new(0, 0, 0, 44),
		Color = Theme.Colors.White,
		Transparency = 0.85,
	})
	local fill = Widgets.frame(track, {
		Name = "Fill",
		Size = UDim2.fromScale(0, 1),
		Color = Theme.Colors.Accent,
		Transparency = 0,
	})
	local knob = Widgets.frame(track, {
		Name = "Knob",
		Size = UDim2.fromOffset(10, 10),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0, 0.5),
		Color = Theme.Colors.White,
		Transparency = 0,
		ZIndex = 2,
	})
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(1, 0)
	corner.Parent = knob
	local hit = Widgets.hitbox(root, "Hit")

	local value = opts.Value
	local dragging = false
	local focused = false

	local function alphaOf(v: number): number
		return math.clamp((v - opts.Min) / (opts.Max - opts.Min), 0, 1)
	end

	local function render(animate: boolean)
		local a = alphaOf(value)
		local info = if animate then Theme.Tween.Fast else TweenInfo.new(0)
		Widgets.tween(fill, info, { Size = UDim2.fromScale(a, 1) })
		Widgets.tween(knob, info, { Position = UDim2.fromScale(a, 0.5) })
		valueLabel.Text = opts.Format(value)
	end

	local function set(v: number, silent: boolean?)
		local stepped = math.round(v / opts.Step) * opts.Step
		stepped = math.clamp(stepped, opts.Min, opts.Max)
		-- Kill float noise (0.30000000004)
		stepped = math.round(stepped * 1000) / 1000
		if stepped == value then
			return
		end
		value = stepped
		render(true)
		if not silent then
			opts.OnTick()
			opts.OnChanged(value)
		end
	end

	local function setFromScreenX(x: number)
		local absPos = track.AbsolutePosition.X
		local absSize = track.AbsoluteSize.X
		if absSize <= 0 then
			return
		end
		local a = math.clamp((x - absPos) / absSize, 0, 1)
		set(opts.Min + a * (opts.Max - opts.Min))
	end

	local function renderFocus()
		local lit = focused or dragging
		Widgets.tween(caption, Theme.Tween.Fast, { TextTransparency = if lit then 0.05 else Theme.Text.DimTransparency })
		Widgets.tween(knob, Theme.Tween.Fast, { Size = UDim2.fromOffset(if lit then 14 else 10, if lit then 14 else 10) })
		Widgets.tween(track, Theme.Tween.Fast, { BackgroundTransparency = if lit then 0.7 else 0.85 })
	end

	hit.MouseEnter:Connect(opts.OnHover)
	hit.InputBegan:Connect(function(input: InputObject)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			renderFocus()
			setFromScreenX(input.Position.X)
		end
	end)
	UserInputService.InputChanged:Connect(function(input: InputObject)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			setFromScreenX(input.Position.X)
		end
	end)
	UserInputService.InputEnded:Connect(function(input: InputObject)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
			dragging = false
			renderFocus()
		end
	end)

	render(false)

	return {
		Root = root,
		SetFocused = function(v: boolean)
			if focused ~= v then
				focused = v
				renderFocus()
			end
		end,
		Activate = nil,
		Adjust = function(direction: number)
			set(value + direction * opts.KeyStep)
		end,
		Set = function(v: number, silent: boolean?)
			set(v, if silent == nil then true else silent)
		end,
	}
end

--------------------------------------------------------------------------------
-- Cycle selector: LABEL ........ ‹ HIGH ›
--------------------------------------------------------------------------------
export type CycleOpts = {
	Name: string,
	Label: string,
	Options: { string },
	Index: number,
	LayoutOrder: number,
	OnChanged: (index: number) -> (),
	OnHover: () -> (),
	OnTick: () -> (),
}

function Widgets.cycle(parent: Instance, opts: CycleOpts): CycleRow
	local root = Widgets.frame(parent, { Name = opts.Name, Size = UDim2.new(1, 0, 0, 48), LayoutOrder = opts.LayoutOrder })
	local caption = Widgets.label(root, {
		Name = "Caption",
		Text = Theme.track(opts.Label),
		Font = Theme.Fonts.Mono,
		TextSize = 12,
		Transparency = Theme.Text.DimTransparency,
		Size = UDim2.new(0.5, 0, 1, 0),
	})
	local valueLabel = Widgets.label(root, {
		Name = "Value",
		Text = string.upper(opts.Options[opts.Index] or ""),
		Font = Theme.Fonts.Heading,
		TextSize = 18,
		Size = UDim2.new(0, 120, 1, 0),
		Position = UDim2.new(1, -26, 0, 0),
		AnchorPoint = Vector2.new(1, 0),
		XAlign = Enum.TextXAlignment.Center,
	})
	local left = Widgets.label(root, {
		Name = "Left",
		Text = "‹",
		Font = Theme.Fonts.Heading,
		TextSize = 22,
		Color = Theme.Colors.Accent,
		Transparency = 0.5,
		Size = UDim2.new(0, 24, 1, 0),
		Position = UDim2.new(1, -146, 0, 0),
		AnchorPoint = Vector2.new(1, 0),
		XAlign = Enum.TextXAlignment.Center,
	})
	local right = Widgets.label(root, {
		Name = "Right",
		Text = "›",
		Font = Theme.Fonts.Heading,
		TextSize = 22,
		Color = Theme.Colors.Accent,
		Transparency = 0.5,
		Size = UDim2.new(0, 24, 1, 0),
		Position = UDim2.fromScale(1, 0),
		AnchorPoint = Vector2.new(1, 0),
		XAlign = Enum.TextXAlignment.Center,
	})
	local rowHit = Widgets.hitbox(root, "Hit")
	local leftHit = Widgets.hitbox(root, "LeftHit", UDim2.new(0, 40, 1, 0), UDim2.new(1, -170, 0, 0))
	local rightHit = Widgets.hitbox(root, "RightHit", UDim2.new(0, 40, 1, 0), UDim2.new(1, -40, 0, 0))
	leftHit.ZIndex = 6
	rightHit.ZIndex = 6

	local index = opts.Index
	local focused = false

	local function set(i: number, silent: boolean?)
		local count = #opts.Options
		local wrapped = ((i - 1) % count) + 1
		if wrapped == index then
			return
		end
		local direction = if i > index then 1 else -1
		index = wrapped
		valueLabel.Text = string.upper(opts.Options[index])
		-- Slide-in micro motion
		valueLabel.Position = UDim2.new(1, -26 + direction * 10, 0, 0)
		valueLabel.TextTransparency = 0.6
		Widgets.tween(valueLabel, Theme.Tween.Medium, { Position = UDim2.new(1, -26, 0, 0), TextTransparency = 0 })
		if not silent then
			opts.OnTick()
			opts.OnChanged(index)
		end
	end

	local function renderFocus()
		Widgets.tween(caption, Theme.Tween.Fast, { TextTransparency = if focused then 0.05 else Theme.Text.DimTransparency })
		Widgets.tween(left, Theme.Tween.Fast, { TextTransparency = if focused then 0 else 0.5 })
		Widgets.tween(right, Theme.Tween.Fast, { TextTransparency = if focused then 0 else 0.5 })
	end

	for _, hit in { rowHit, leftHit, rightHit } do
		hit.MouseEnter:Connect(opts.OnHover)
	end
	rowHit.Activated:Connect(function()
		set(index + 1)
	end)
	leftHit.Activated:Connect(function()
		set(index - 1)
	end)
	rightHit.Activated:Connect(function()
		set(index + 1)
	end)

	return {
		Root = root,
		SetFocused = function(v: boolean)
			if focused ~= v then
				focused = v
				renderFocus()
			end
		end,
		Activate = function()
			set(index + 1)
		end,
		Adjust = function(direction: number)
			set(index + direction)
		end,
		Set = function(i: number, silent: boolean?)
			set(i, if silent == nil then true else silent)
		end,
	}
end

--------------------------------------------------------------------------------
-- Weapon row (loadout list)
--------------------------------------------------------------------------------
export type WeaponRowOpts = {
	Name: string,
	Title: string,
	Tag: string,
	LayoutOrder: number,
	OnActivate: () -> (),
	OnHover: () -> (),
}

function Widgets.weaponRow(parent: Instance, opts: WeaponRowOpts): WeaponRow
	local root = Widgets.frame(parent, {
		Name = opts.Name,
		Size = UDim2.new(1, 0, 0, 48),
		LayoutOrder = opts.LayoutOrder,
		Color = Theme.Colors.White,
		Transparency = 1,
	})
	local marker = Widgets.frame(root, {
		Name = "Marker",
		Size = UDim2.new(0, 3, 0, 0),
		Position = UDim2.fromScale(0, 0.5),
		AnchorPoint = Vector2.new(0, 0.5),
		Color = Theme.Colors.Accent,
		Transparency = 0,
	})
	local title = Widgets.label(root, {
		Name = "Title",
		Text = opts.Title,
		Font = Theme.Fonts.Option,
		TextSize = 19,
		Transparency = Theme.Text.IdleTransparency,
		Size = UDim2.new(1, -110, 1, 0),
		Position = UDim2.new(0, 16, 0, 0),
	})
	local tag = Widgets.label(root, {
		Name = "Tag",
		Text = Theme.track(opts.Tag),
		Font = Theme.Fonts.Mono,
		TextSize = 11,
		Color = Theme.Colors.Dim,
		Transparency = 0.3,
		Size = UDim2.new(0, 100, 1, 0),
		Position = UDim2.new(1, -12, 0, 0),
		AnchorPoint = Vector2.new(1, 0),
		XAlign = Enum.TextXAlignment.Right,
	})
	local hit = Widgets.hitbox(root, "Hit")

	local focused = false
	local selected = false
	local function render()
		Widgets.tween(root, Theme.Tween.Fast, { BackgroundTransparency = if focused then 0.94 else 1 })
		Widgets.tween(marker, Theme.Tween.Medium, { Size = UDim2.new(0, 3, if selected then 0.62 else 0, 0) })
		Widgets.tween(title, Theme.Tween.Fast, {
			TextTransparency = if selected or focused then 0 else Theme.Text.IdleTransparency,
			TextColor3 = if selected then Theme.Colors.Accent else Theme.Colors.Text,
		})
		Widgets.tween(tag, Theme.Tween.Fast, { TextTransparency = if selected or focused then 0.1 else 0.3 })
	end

	hit.MouseEnter:Connect(opts.OnHover)
	hit.Activated:Connect(opts.OnActivate)

	return {
		Root = root,
		SetFocused = function(v: boolean)
			if focused ~= v then
				focused = v
				render()
			end
		end,
		Activate = opts.OnActivate,
		Adjust = nil,
		SetSelected = function(v: boolean)
			if selected ~= v then
				selected = v
				render()
			end
		end,
	}
end

--------------------------------------------------------------------------------
-- Stat bar
--------------------------------------------------------------------------------
function Widgets.statBar(parent: Instance, name: string, order: number): StatBar
	local root = Widgets.frame(parent, { Name = "Stat_" .. name, Size = UDim2.new(1, 0, 0, 22), LayoutOrder = order })
	Widgets.label(root, {
		Name = "Caption",
		Text = Theme.track(name),
		Font = Theme.Fonts.Mono,
		TextSize = 10,
		Color = Theme.Colors.Dim,
		Size = UDim2.new(0, 110, 1, 0),
	})
	local track = Widgets.frame(root, {
		Name = "Track",
		Size = UDim2.new(1, -120, 0, 2),
		Position = UDim2.new(0, 120, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		Color = Theme.Colors.White,
		Transparency = 0.86,
	})
	local fill = Widgets.frame(track, {
		Name = "Fill",
		Size = UDim2.fromScale(0, 1),
		Color = Theme.Colors.Text,
		Transparency = 0,
	})
	return {
		Root = root,
		Set = function(alpha: number)
			Widgets.tween(fill, Theme.Tween.Slow, { Size = UDim2.fromScale(math.clamp(alpha, 0, 1), 1) })
		end,
	}
end

return Widgets
